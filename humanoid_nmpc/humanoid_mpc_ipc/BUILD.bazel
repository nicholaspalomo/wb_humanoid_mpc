    size = "small",
    srcs = ["test/testRemoteMpcLinkParity.cpp"],
    copts = FIRST_PARTY_COPTS,
    deps = _MPC_LINK_TEST_DEPS,
)

# The realtime thread's calls on the link, and its evaluation of the policy in use, allocate nothing once warmed up;
# OCS2's evaluatePolicy() is measured. A binary of its own, because the allocation counter replaces malloc for the whole
# process.
cc_test(
    name = "test_remote_mpc_link_allocations",
    size = "small",
    srcs = ["test/testRemoteMpcLinkAllocations.cpp"],
    copts = FIRST_PARTY_COPTS,
    linkstatic = True,
    deps = _MPC_LINK_TEST_DEPS + [
        ":policy_test_data",
        ":realtime_policy_evaluator",
        "//robot_runtime/robot_realtime:allocation_counter",
    ],
)

# RealtimePolicyEvaluator computes the doubles OCS2's MRT_BASE::evaluatePolicy() computes, and refuses what it cannot
