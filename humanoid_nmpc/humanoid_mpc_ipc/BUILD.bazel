# The link end to end over loopback: first policy, resets with a policy in flight, lost observations, solver failures,
# the policy timeout.
cc_test(
    name = "test_remote_mpc_link",
    size = "small",
    srcs = ["test/testRemoteMpcLink.cpp"],
    copts = FIRST_PARTY_COPTS,
    deps = _MPC_LINK_TEST_DEPS,
