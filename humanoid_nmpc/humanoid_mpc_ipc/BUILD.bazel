    size = "small",
    srcs = ["test/testRemoteMpcLinkProtocol.cpp"],
    copts = FIRST_PARTY_COPTS,
    deps = _MPC_LINK_TEST_DEPS,
)

# The MPC side against a robot the test scripts: resets, stamps, statuses, solution window, hooks, pacing, back-off.
cc_test(
    name = "test_mpc_server",
    size = "small",
    srcs = ["test/testMpcServer.cpp"],
    copts = FIRST_PARTY_COPTS,
    deps = _MPC_LINK_TEST_DEPS,
