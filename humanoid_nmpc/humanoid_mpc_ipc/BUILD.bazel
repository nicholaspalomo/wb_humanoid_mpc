load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc//cc:cc_test.bzl", "cc_test")
load("@rules_python//python:defs.bzl", "py_library", "py_test")
load("//bazel:copts.bzl", "FIRST_PARTY_COPTS")

# humanoid_mpc_ipc - the MPC link's side of the IPC bus (humanoid_nmpc/docs/distributed_runtime/README.md): the topic
# names in C++ and Python, the lossless conversions between OCS2 types and the humanoid_mpc_msgs messages, and the two
# ends of the network MPC link (:remote_mpc_link on the robot, :mpc_server on the MPC machine). Builds on OCS2, the
# messages, the bus and the reset supervisor alone: no Pinocchio, no robot model, no ROS.

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "humanoid_mpc_ipc",
    srcs = [
        "src/MpcMessageConversions.cpp",
        "src/PolicyControllers.cpp",
        "src/SolutionTimeWindow.cpp",
    ],
    hdrs = [
        "include/humanoid_mpc_ipc/MpcMessageConversions.h",
        "include/humanoid_mpc_ipc/PolicyControllers.h",
        "include/humanoid_mpc_ipc/SolutionTimeWindow.h",
        "include/humanoid_mpc_ipc/Topics.h",
    ],
    copts = FIRST_PARTY_COPTS,
    includes = ["include"],
    deps = [
        "//humanoid_nmpc/humanoid_mpc_msgs:messages_cc_proto",
        "//lib/ocs2:ocs2_core",
        "//lib/ocs2:ocs2_mpc",
        "//lib/ocs2:ocs2_oc",
        "@abseil-cpp//absl/base:nullability",
        "@abseil-cpp//absl/status",
        "@abseil-cpp//absl/strings",
        "@abseil-cpp//absl/strings:string_view",
        "@eigen",
    ],
)

# The robot side of the network MPC link: an ocs2::MRT_BASE whose solver is an MpcServer on the bus.
cc_library(
    name = "remote_mpc_link",
    srcs = ["src/RemoteMpcLink.cpp"],
    hdrs = ["include/humanoid_mpc_ipc/RemoteMpcLink.h"],
    copts = FIRST_PARTY_COPTS,
    includes = ["include"],
    deps = [
        ":humanoid_mpc_ipc",
        "//humanoid_nmpc/humanoid_common_mpc:humanoid_common_mpc_types",
        "//humanoid_nmpc/humanoid_common_mpc:mpc_reset_supervisor",
        "//humanoid_nmpc/humanoid_mpc_msgs:messages_cc_proto",
        "//humanoid_nmpc/humanoid_mpc_msgs:messages_nproto",
        "//lib/ocs2:ocs2_core",
        "//lib/ocs2:ocs2_mpc",
        "//lib/ocs2:ocs2_oc",
        "//robot_runtime/robot_core",
        "//robot_runtime/robot_ipc",
        "@abseil-cpp//absl/base:core_headers",
        "@abseil-cpp//absl/base:nullability",
        "@abseil-cpp//absl/log",
        "@abseil-cpp//absl/memory",
        "@abseil-cpp//absl/status",
        "@abseil-cpp//absl/status:statusor",
        "@abseil-cpp//absl/strings",
        "@abseil-cpp//absl/synchronization",
        "@abseil-cpp//absl/time",
        "@eigen",
    ],
)

# Evaluates the policy in use on the realtime thread as MRT_BASE::evaluatePolicy() does, without allocating or logging.
cc_library(
    name = "realtime_policy_evaluator",
    srcs = ["src/RealtimePolicyEvaluator.cpp"],
    hdrs = ["include/humanoid_mpc_ipc/RealtimePolicyEvaluator.h"],
    copts = FIRST_PARTY_COPTS,
    includes = ["include"],
    deps = [
        ":humanoid_mpc_ipc",
        "//lib/ocs2:ocs2_core",
        "//lib/ocs2:ocs2_oc",
        "@abseil-cpp//absl/base:nullability",
        "@eigen",
    ],
)

# The MPC side of the network MPC link: the solve loop, driven by the observations on the bus.
cc_library(
    name = "mpc_server",
    srcs = ["src/MpcServer.cpp"],
    hdrs = ["include/humanoid_mpc_ipc/MpcServer.h"],
    copts = FIRST_PARTY_COPTS,
    includes = ["include"],
    deps = [
        ":humanoid_mpc_ipc",
        "//humanoid_nmpc/humanoid_common_mpc:humanoid_common_mpc_types",
        "//humanoid_nmpc/humanoid_common_mpc:mpc_reset_supervisor",
        "//humanoid_nmpc/humanoid_mpc_msgs:messages_cc_proto",
        "//lib/ocs2:ocs2_core",
        "//lib/ocs2:ocs2_mpc",
        "//lib/ocs2:ocs2_oc",
        "//robot_runtime/robot_ipc",
        "//robot_runtime/robot_realtime",
        "@abseil-cpp//absl/base:core_headers",
        "@abseil-cpp//absl/base:nullability",
        "@abseil-cpp//absl/functional:function_ref",
        "@abseil-cpp//absl/log",
        "@abseil-cpp//absl/memory",
        "@abseil-cpp//absl/status",
        "@abseil-cpp//absl/status:statusor",
        "@abseil-cpp//absl/strings",
        "@abseil-cpp//absl/strings:string_view",
        "@abseil-cpp//absl/synchronization",
        "@abseil-cpp//absl/time",
        "@eigen",
    ],
)

# The topic names of the Python operator tools, the twin of include/humanoid_mpc_ipc/Topics.h.
py_library(
    name = "topics_py",
    srcs = [
        "python/humanoid_mpc_ipc/__init__.py",
        "python/humanoid_mpc_ipc/topics.py",
    ],
    imports = ["python"],
)

# Random OCS2 policies shaped like those of the multiple-shooting solvers, for the conversion tests.
cc_library(
    name = "policy_test_data",
    testonly = True,
    srcs = ["test/PolicyTestData.cpp"],
    hdrs = ["test/PolicyTestData.h"],
    copts = FIRST_PARTY_COPTS,
    deps = [
        "//lib/ocs2:ocs2_core",
        "//lib/ocs2:ocs2_mpc",
        "//lib/ocs2:ocs2_oc",
        "@abseil-cpp//absl/base:nullability",
        "@eigen",
    ],
)

cc_test(
