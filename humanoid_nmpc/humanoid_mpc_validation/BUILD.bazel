        "//humanoid_nmpc/humanoid_common_mpc:mrt_control_thread",
        "//humanoid_nmpc/humanoid_common_mpc:orientation",
        "//humanoid_nmpc/humanoid_common_mpc_app/node:mpc_node",
        "//humanoid_nmpc/humanoid_common_mpc_app/robot:robot_process",
        "//humanoid_nmpc/humanoid_mpc_config:config_nproto",
        "//humanoid_nmpc/humanoid_mpc_msgs:messages_cc_proto",
        "//humanoid_nmpc/humanoid_wb_mpc",
        "//lib/ocs2:ocs2_core",
        "//lib/ocs2:ocs2_mpc",
        "//lib/ocs2:ocs2_oc",
        "//lib/ocs2:ocs2_pinocchio_interface",
        "//lib/ocs2:ocs2_robotic_tools",
        "//lib/ocs2:ocs2_sqp",
        "//robot_runtime/mujoco_sim_interface",
        "//robot_runtime/robot_core",
        "//robot_runtime/robot_model",
        "@abseil-cpp//absl/base:nullability",
        "@abseil-cpp//absl/log",
        "@abseil-cpp//absl/memory",
        "@abseil-cpp//absl/status",
        "@abseil-cpp//absl/status:statusor",
        "@abseil-cpp//absl/strings",
        "@abseil-cpp//absl/time",
        "@abseil-cpp//absl/types:span",
        "@eigen",
        "@pinocchio",
    ],
)

