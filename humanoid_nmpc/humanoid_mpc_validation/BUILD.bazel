# humanoid_mpc_validation - the measurement infrastructure of the quaternion base orientation switch
# (humanoid_nmpc/docs/quaternion_base_orientation/README.md, Step 1): golden files, the lockstep MuJoCo closed loop with its
# metrics, and the solve benchmark. Nothing here talks to the bus: the closed loop runs the MPC node's and the robot
# process's pieces in one thread.

package(default_visibility = ["//visibility:public"])

# SHA-256, JSON documents, golden files and the provenance of a recording. Free of the MPC.
cc_library(
    name = "validation_io",
    srcs = [
        "src/io/GoldenIo.cpp",
        "src/io/JsonValue.cpp",
        "src/io/RunProvenance.cpp",
        "src/io/Sha256.cpp",
    ],
    hdrs = [
        "include/humanoid_mpc_validation/io/GoldenIo.h",
        "include/humanoid_mpc_validation/io/JsonValue.h",
        "include/humanoid_mpc_validation/io/RunProvenance.h",
        "include/humanoid_mpc_validation/io/Sha256.h",
    ],
    copts = FIRST_PARTY_COPTS,
    includes = ["include"],
    deps = [
        "@abseil-cpp//absl/base:nullability",
        "@abseil-cpp//absl/container:flat_hash_set",
        "@abseil-cpp//absl/log:check",
        "@abseil-cpp//absl/status",
        "@abseil-cpp//absl/status:statusor",
        "@abseil-cpp//absl/strings",
        "@abseil-cpp//absl/strings:str_format",
        "@eigen",
    ],
)

# The scenarios, the metrics with their schema, the bands against a baseline and the robot configurations: what a
# closed-loop run commands and how it is judged, without the MPC or the simulator.
cc_library(
    name = "closed_loop_metrics",
    srcs = [
        "src/closed_loop/ClosedLoopMetrics.cpp",
        "src/closed_loop/ClosedLoopMetricsSchema.cpp",
        "src/closed_loop/ClosedLoopScenario.cpp",
        "src/closed_loop/MetricBands.cpp",
        "src/closed_loop/RobotConfiguration.cpp",
    ],
    hdrs = [
        "include/humanoid_mpc_validation/closed_loop/ClosedLoopMetrics.h",
        "include/humanoid_mpc_validation/closed_loop/ClosedLoopMetricsSchema.h",
        "include/humanoid_mpc_validation/closed_loop/ClosedLoopScenario.h",
        "include/humanoid_mpc_validation/closed_loop/MetricBands.h",
        "include/humanoid_mpc_validation/closed_loop/RobotConfiguration.h",
        "include/humanoid_mpc_validation/closed_loop/TimeSeriesLabels.h",
    ],
    copts = FIRST_PARTY_COPTS,
    includes = ["include"],
    deps = [
        ":validation_io",
        "//humanoid_nmpc/humanoid_common_mpc:orientation",
        "//humanoid_nmpc/humanoid_common_mpc:walking_velocity_command",
        "//humanoid_nmpc/humanoid_common_mpc_app/node:walking_velocity_command_conversions",
        "@abseil-cpp//absl/base:no_destructor",
        "@abseil-cpp//absl/base:nullability",
        "@abseil-cpp//absl/container:flat_hash_map",
        "@abseil-cpp//absl/status",
        "@abseil-cpp//absl/status:statusor",
        "@abseil-cpp//absl/strings",
        "@eigen",
    ],
)

# The robot at the solves of a closed-loop run, as a golden file: the input of the solve benchmark.
cc_library(
    name = "recorded_robot_states",
    srcs = ["src/closed_loop/RecordedRobotStates.cpp"],
    hdrs = ["include/humanoid_mpc_validation/closed_loop/RecordedRobotStates.h"],
    copts = FIRST_PARTY_COPTS,
    includes = ["include"],
    deps = [
        ":validation_io",
        "//robot_runtime/robot_model",
        "@abseil-cpp//absl/base:nullability",
        "@abseil-cpp//absl/container:flat_hash_set",
        "@abseil-cpp//absl/status",
        "@abseil-cpp//absl/status:statusor",
        "@abseil-cpp//absl/strings",
        "@eigen",
    ],
)

# When the lockstep closed loop solves: the solver thread's pacing and failure back-off on the simulation's clock.
cc_library(
    name = "lockstep_solve_schedule",
    srcs = ["src/closed_loop/LockstepSolveSchedule.cpp"],
    hdrs = ["include/humanoid_mpc_validation/closed_loop/LockstepSolveSchedule.h"],
    copts = FIRST_PARTY_COPTS,
    includes = ["include"],
    deps = ["@abseil-cpp//absl/base:nullability"],
)

# What the closed-loop driver reads of the configuration files itself, beside the roots it builds the MPC and the
# controller with: the GUI's command scaling of the reference file, and the contact wrench gate a task file's
# controller-side settings set, as the robot process applies them.
cc_library(
    name = "driver_settings",
    srcs = ["src/closed_loop/DriverSettingsFromConfig.cpp"],
    hdrs = ["include/humanoid_mpc_validation/closed_loop/DriverSettingsFromConfig.h"],
    copts = FIRST_PARTY_COPTS,
    includes = ["include"],
