# exclusive: one at a time.
[
    cc_test(
        name = "closed_loop_" + robot,
        size = "enormous",
        srcs = ["test/closedLoopScenarios.cpp"],
        args = ["--robot=" + robot],
        copts = FIRST_PARTY_COPTS,
        data = data + [
            "//humanoid_nmpc/humanoid_common_mpc:gait_config",
        ] + glob(
            [
                "data/closed_loop/**/*.json",
