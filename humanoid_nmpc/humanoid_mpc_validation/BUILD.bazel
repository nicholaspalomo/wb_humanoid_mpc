# humanoid_mpc_validation - closed-loop measurements of the MPC formulations (README.md): the lockstep MuJoCo closed loop
# with its metrics and their comparison between two recorded labels, the solve benchmark with its real-time gate, and
# the Euler chart of the equivalence suites. Nothing here talks to the bus: the closed loop runs the MPC node's and the
# robot process's pieces in one thread.

package(default_visibility = ["//visibility:public"])

# SHA-256, JSON documents, golden files and the provenance of a recording. Free of the MPC.
cc_library(
    name = "validation_io",
    srcs = [
        "src/io/GoldenIo.cpp",
        "src/io/JsonValue.cpp",
        "src/io/RunProvenance.cpp",
        "src/io/Sha256.cpp",
    ],
    hdrs = [
        "include/humanoid_mpc_validation/io/GoldenIo.h",
        "include/humanoid_mpc_validation/io/JsonValue.h",
        "include/humanoid_mpc_validation/io/RunProvenance.h",
        "include/humanoid_mpc_validation/io/Sha256.h",
    ],
    copts = FIRST_PARTY_COPTS,
    includes = ["include"],
    deps = [
        "@abseil-cpp//absl/base:nullability",
        "@abseil-cpp//absl/container:flat_hash_set",
        "@abseil-cpp//absl/log:check",
        "@abseil-cpp//absl/status",
        "@abseil-cpp//absl/status:statusor",
        "@abseil-cpp//absl/strings",
        "@abseil-cpp//absl/strings:str_format",
        "@eigen",
    ],
)

