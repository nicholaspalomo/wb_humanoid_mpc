]

# The same scenarios as one binary for every configuration, not manual, so that `bazel build //...` and `make lint-tidy`
# compile the tests' source: `bazel run`-able with --robot=<robot> --label=<label> [--baseline=<label>]
# [--output_dir=<directory>]. The Make target runs the tests above, under Bazel's machine lock.
cc_binary(
    name = "closed_loop_scenarios",
