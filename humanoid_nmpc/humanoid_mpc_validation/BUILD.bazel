# The same per robot as a test, so that `make benchmark-mpc-solve ROBOT=<robot> LABEL=<label>` runs it under Bazel's
# machine lock (tools/bazel serializes `bazel test`, not `bazel run`). Manual and exclusive: the timings are only worth
# something on a quiet machine.
[
    cc_test(
        name = "benchmark_mpc_solve_" + robot,
        size = "enormous",
        srcs = ["exe/benchmarkMpcSolveMain.cpp"],
        args = ["--robot=" + robot],
        copts = FIRST_PARTY_COPTS,
        data = data + [
