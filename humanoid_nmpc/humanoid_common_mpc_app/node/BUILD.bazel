        "@abseil-cpp//absl/status:statusor",
        "@abseil-cpp//absl/strings:string_view",
        "@googletest//:gtest_main",
    ],
)

# SIGTERM asks for the shutdown; the network of an empty --network_config is the shipped one; an unknown node is refused.
cc_test(
    name = "test_node_process",
    size = "small",
    srcs = ["test/testNodeProcess.cpp"],
    copts = FIRST_PARTY_COPTS,
    data = ["//config/ipc:network.textproto"],
    deps = [
        ":node_process",
        "//robot_runtime/robot_core:resource_paths",
        "//robot_runtime/robot_ipc",
        "@abseil-cpp//absl/base:nullability",
        "@abseil-cpp//absl/status",
        "@abseil-cpp//absl/status:statusor",
        "@abseil-cpp//absl/strings",
        "@googletest//:gtest_main",
    ],
)

# The MPC node's runtime against a scripted robot and operator over loopback buses, around the DRC Atlas references and
# motion manager with OCS2's scripted MPC (no CppAD): observation in, policy out, the reset handshake through the
# observation's counters, the velocity command reaching the motion manager, the parameter updates reaching the solver
# before the next solve, the annotations and the visualization seam.
cc_test(
    name = "test_mpc_node_runtime",
    size = "small",
    srcs = ["test/testMpcNodeRuntime.cpp"],
    copts = FIRST_PARTY_COPTS,
    data = [
        "//humanoid_nmpc/humanoid_common_mpc:gait_config",
        "//robot_models/drc_atlas/drc_atlas_centroidal_mpc",
        "//robot_models/drc_atlas/drc_atlas_description",
    ],
    deps = [
        ":mpc_node",
        ":scripted_robot",
        "//humanoid_nmpc/humanoid_centroidal_mpc:reference_stack_support",
        "//humanoid_nmpc/humanoid_common_mpc",
        "//humanoid_nmpc/humanoid_mpc_config:config_cc_proto",
        "//humanoid_nmpc/humanoid_mpc_config:config_nproto",
        "//humanoid_nmpc/humanoid_mpc_ipc",
        "//humanoid_nmpc/humanoid_mpc_ipc:mpc_link_test_support",
        "//humanoid_nmpc/humanoid_mpc_msgs:messages_cc_proto",
        "//lib/ocs2:ocs2_core",
        "//lib/ocs2:ocs2_mpc",
        "//lib/ocs2:ocs2_oc",
        "//robot_runtime/robot_ipc",
        "@abseil-cpp//absl/base:core_headers",
        "@abseil-cpp//absl/base:nullability",
        "@abseil-cpp//absl/status",
        "@abseil-cpp//absl/status:statusor",
        "@abseil-cpp//absl/synchronization",
        "@abseil-cpp//absl/time",
        "@googletest//:gtest_main",
    ],
)

# The dummy simulator's loop against an MPC server with OCS2's scripted MPC over loopback: synchronized with the MPC (one
# policy per update, solved from the observation sent for it) and in real time, with no reset after the first; a plant
# whose rollout throws ends the loop with an error.
cc_test(
    name = "test_dummy_sim_loop",
    size = "small",
    srcs = ["test/testDummySimLoop.cpp"],
    copts = FIRST_PARTY_COPTS,
    deps = [
        ":mpc_node",
        "//humanoid_nmpc/humanoid_mpc_ipc",
        "//humanoid_nmpc/humanoid_mpc_ipc:mpc_link_test_support",
        "//humanoid_nmpc/humanoid_mpc_ipc:mpc_server",
        "//lib/ocs2:ocs2_core",
        "//lib/ocs2:ocs2_mpc",
        "//lib/ocs2:ocs2_oc",
        "//robot_runtime/robot_ipc",
        "@abseil-cpp//absl/base:nullability",
        "@abseil-cpp//absl/status",
        "@abseil-cpp//absl/status:statusor",
        "@abseil-cpp//absl/strings",
        "@abseil-cpp//absl/time",
        "@googletest//:gtest_main",
    ],
)
