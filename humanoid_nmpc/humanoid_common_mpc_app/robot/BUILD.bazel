# humanoid_common_mpc_app/robot - the robot process of the distributed runtime (humanoid_nmpc/docs/distributed_runtime/
# README.md): the realtime loop that runs on the robot's realtime computer (and, with the MuJoCo backend, in simulation)
# over a robot backend selected by name and an MRT joint controller of either formulation, and the mailboxes, telemetry
# and FSM around it on the bus. The binaries are humanoid_centroidal_mpc_app:humanoid_centroidal_mpc_robot and
# humanoid_wb_mpc_app:humanoid_wb_mpc_robot. See README.md.

package(default_visibility = ["//visibility:public"])

# The realtime thread's own building blocks: the loop runner (absolute-deadline pacing, loop timing through a triple
# buffer) and the event log that replaces its log lines. Abseil and robot_runtime only.
cc_library(
    name = "realtime_loop",
    srcs = [
        "src/FallRecoveryTypes.cpp",
        "src/RealtimeEventLog.cpp",
        "src/RealtimeLoopRunner.cpp",
    ],
    hdrs = [
        "include/humanoid_common_mpc_app/robot/FallRecoveryTypes.h",
        "include/humanoid_common_mpc_app/robot/RealtimeEventLog.h",
        "include/humanoid_common_mpc_app/robot/RealtimeLoopRunner.h",
    ],
    copts = FIRST_PARTY_COPTS,
    includes = ["include"],
    deps = [
        "//humanoid_nmpc/humanoid_common_mpc:controller_event",
        "//robot_runtime/robot_core",
        "//robot_runtime/robot_realtime",
        "@abseil-cpp//absl/base:core_headers",
        "@abseil-cpp//absl/base:nullability",
        "@abseil-cpp//absl/log",
        "@abseil-cpp//absl/status",
        "@abseil-cpp//absl/strings",
        "@abseil-cpp//absl/strings:string_view",
        "@abseil-cpp//absl/synchronization",
    ],
)

