load("@rules_cc//cc:cc_library.bzl", "cc_library")
# humanoid_mpc_msgs - ROS2 message package (pre-generated headers)
#
# Generated C++ headers are checked into generated/ directory.
# Type support shared libraries come from the colcon install.
# To regenerate: run `make build-all` then copy from install dir.

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "humanoid_mpc_msgs",
    hdrs = glob(["generated/**/*.hpp"]),
    includes = ["generated"],
    linkopts = [
        "-L/wb_humanoid_mpc_ws/install/humanoid_mpc_msgs/lib",
        "-lhumanoid_mpc_msgs__rosidl_typesupport_cpp",
        "-lhumanoid_mpc_msgs__rosidl_generator_c",
    ],
    deps = [
        "@ros2_rcl_interfaces",
        "@ros2_builtin_interfaces",
        "@ros2_geometry_msgs",
        "@ros2_std_msgs",
        "@ros2_unique_identifier_msgs",
        "@ros2_rosidl",
    ],
)
