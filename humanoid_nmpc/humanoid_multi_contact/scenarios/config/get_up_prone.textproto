    joint_positions { joint: "r_leg_hpz" position: -0.2905 }
    joint_positions { joint: "r_leg_hpx" position: 0.4227 }
    joint_positions { joint: "r_leg_hpy" position: -1.7032 }
    joint_positions { joint: "r_leg_kny" position: 2.2112 }
    joint_positions { joint: "r_leg_aky" position: -0.5148 }
    joint_positions { joint: "r_leg_akx" position: -0.0383 }
