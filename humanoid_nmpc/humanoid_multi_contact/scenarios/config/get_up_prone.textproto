    active_contacts: "foot_r_contact"
  }
}

allowed_contacts: "foot_l_contact"
allowed_contacts: "foot_r_contact"
allowed_contacts: "knee_l_contact"
allowed_contacts: "knee_r_contact"
allowed_contacts: "hand_l_contact"
allowed_contacts: "hand_r_contact"
allowed_contacts: "forearm_l_contact"
allowed_contacts: "forearm_r_contact"
allowed_contacts: "seat_contact"
allowed_contacts: "thigh_l_contact"
allowed_contacts: "thigh_r_contact"
allowed_contacts: "torso_back_contact"
allowed_contacts: "torso_front_contact"

# Planner B: its quasi-static plan, checked between its knots as the MPC tracks it, is the one the dummy sim tracks
# (design section 5.5).
planner: "stance_graph"
static_margin: 0.03
# The plan respects the joint position limits widened by 0.1 rad, not the effort limits (design section 11,
# decisions 6 and 8): the dummy sims show the contact sequences, Atlas's arms (elbow 112 N m, shoulder 87-99 N m)
# cannot carry its body, and the squat on the hands folds the knees, the hips and the back to the end of their range.
joint_limits: "relaxed_position"
joint_limit_relaxation: 0.1
# A kneel on the flat floor lets the end of the thigh beside the knee rest 6 mm into it, no deeper (design section
# 5.4): exempt, the planned kneels pressed it 1 cm in, and lifting the knee then swept it 9 mm through the floor.
point_pad_link_above: "rests"
duration: 12

# The robot starts lying, its base pitched by 90 degrees, which would trip the tilt catch at once: the
# tilt catch and the gantry stay disarmed until it stands (design section 8.1, scenario 4).
simulation_start {
  tilt_catch_arming: "when_standing"
  gantry_arming: "when_standing"
  standing_base_height: 0.85
}
