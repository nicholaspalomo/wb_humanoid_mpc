# proto-file: humanoid_nmpc/humanoid_multi_contact/scenarios/scenario.proto
# proto-message: humanoid_multi_contact.Scenario
# Climbing onto a box (design section 8.1, scenario 2) with the feet, knees, hands and forearms. The expected
# sequence, which planner A is not told: hands on the top edge, a knee onto the top face, the other knee, a foot,
# then stand up. The stance graph planner is told it through the waypoints below (design section 5.5, "Waypoints").

name: "box_climb"
robot: "drc_atlas"
urdf_file: "robot_models/drc_atlas/drc_atlas_description/urdf/atlas.urdf"
contact_set_file: "robot_models/drc_atlas/drc_atlas_centroidal_mpc/config/mpc/multi_contact/contact_set.textproto"
collision_model_file: "robot_models/drc_atlas/drc_atlas_centroidal_mpc/config/mpc/multi_contact/collision_model.textproto"
mpc_task_file: "robot_models/drc_atlas/drc_atlas_centroidal_mpc/config/mpc/multi_contact/task.textproto"
mpc_reference_file: "robot_models/drc_atlas/drc_atlas_centroidal_mpc/config/mpc/multi_contact/reference.textproto"

terrain_scene {
  name: "box_climb"
  # The floor: its top face is z = 0.
  primitives {
    name: "ground"
    friction: 0.8
    box { center: [0, 0, -0.5] half_extents: [20, 20, 0.5] }
  }
  # 1.0 x 1.0 m, 0.6 m high, its front face 0.4 m in front of the robot.
  primitives {
    name: "box"
    friction: 0.8
    box { center: [0.9, 0, 0.3] half_extents: [0.5, 0.5, 0.3] }
  }
}

# Standing on the floor at the nominal pose: knees bent, arms down, the soles at z = 0.
initial_pose {
  name: "standing"
  base_position: [0, 0, 0.9232]
  base_orientation_xyzw: [0, 0, 0, 1]
  joint_positions { joint: "l_leg_hpy" position: -0.3 }
  joint_positions { joint: "r_leg_hpy" position: -0.3 }
  joint_positions { joint: "l_leg_kny" position: 0.6 }
  joint_positions { joint: "r_leg_kny" position: 0.6 }
  joint_positions { joint: "l_leg_aky" position: -0.3 }
  joint_positions { joint: "r_leg_aky" position: -0.3 }
  joint_positions { joint: "l_arm_shx" position: -1.3 }
  joint_positions { joint: "r_arm_shx" position: 1.3 }
  active_contacts: "foot_l_contact"
  active_contacts: "foot_r_contact"
}

goal {
  contacts { contact: "foot_l_contact" primitive: "box" }
  contacts { contact: "foot_r_contact" primitive: "box" }
  base_region { center: [0.9, 0, 1.5232] half_extents: [0.3, 0.3, 0.15] }
  pose {
    name: "standing"
    base_position: [0.9, 0, 1.5232]
    base_orientation_xyzw: [0, 0, 0, 1]
    joint_positions { joint: "l_leg_hpy" position: -0.3 }
    joint_positions { joint: "r_leg_hpy" position: -0.3 }
    joint_positions { joint: "l_leg_kny" position: 0.6 }
    joint_positions { joint: "r_leg_kny" position: 0.6 }
    joint_positions { joint: "l_leg_aky" position: -0.3 }
    joint_positions { joint: "r_leg_aky" position: -0.3 }
    joint_positions { joint: "l_arm_shx" position: -1.3 }
    joint_positions { joint: "r_arm_shx" position: 1.3 }
    active_contacts: "foot_l_contact"
    active_contacts: "foot_r_contact"
  }
}

# The stances the climb passes through, in order, each with a pose that the stance IK holds within the URDF's joint
# limits at the scenario's margins (found with a prototype of the IK): the hands on the box's top 0.3 m behind its
# front edge, the right foot a step closer, the left knee on the top 5 cm behind the edge with the shin hanging over
# it (the thigh keeps clear of the box only so), both knees there, the hands 15 cm further forward, the right foot on
# the top, the left beside it. The search finds the changes between them and the stand-up after the last.
waypoints {
  contacts { contact: "foot_l_contact" primitive: "ground" }
  contacts { contact: "hand_l_contact" primitive: "box" }
  contacts { contact: "hand_r_contact" primitive: "box" }
  pose {
    name: "left_foot_and_hands"
    base_position: [0.2538, -0.0053, 0.9888]
    base_orientation_xyzw: [0.102381112, 0.329665756, 0.146754473, 0.926985287]
    joint_positions { joint: "back_bkz" position: -0.3131 }
    joint_positions { joint: "back_bky" position: 0.5088 }
    joint_positions { joint: "back_bkx" position: -0.4936 }
    joint_positions { joint: "l_arm_shz" position: -1.2509 }
    joint_positions { joint: "l_arm_shx" position: 0.7391 }
    joint_positions { joint: "l_arm_ely" position: 2.5766 }
    joint_positions { joint: "l_arm_elx" position: 1.8377 }
    joint_positions { joint: "l_arm_wry" position: 0.0300 }
    joint_positions { joint: "l_arm_wrx" position: -0.4423 }
    joint_positions { joint: "neck_ry" position: 1.1132 }
    joint_positions { joint: "r_arm_shz" position: 1.3788 }
    joint_positions { joint: "r_arm_shx" position: 1.5408 }
    joint_positions { joint: "r_arm_ely" position: 0.0300 }
    joint_positions { joint: "r_arm_elx" position: -1.7978 }
    joint_positions { joint: "r_arm_wry" position: 0.0300 }
    joint_positions { joint: "r_arm_wrx" position: 0.9835 }
    joint_positions { joint: "l_leg_hpz" position: -0.1444 }
    joint_positions { joint: "l_leg_hpx" position: -0.4936 }
    joint_positions { joint: "l_leg_hpy" position: -1.5823 }
    joint_positions { joint: "l_leg_kny" position: 2.3264 }
    joint_positions { joint: "l_leg_aky" position: -0.9700 }
    joint_positions { joint: "l_leg_akx" position: 0.7700 }
    joint_positions { joint: "r_leg_hpz" position: -0.7568 }
    joint_positions { joint: "r_leg_hpx" position: 0.2228 }
    joint_positions { joint: "r_leg_hpy" position: -0.7666 }
    joint_positions { joint: "r_leg_kny" position: 0.1677 }
    joint_positions { joint: "r_leg_aky" position: -0.0685 }
    joint_positions { joint: "r_leg_akx" position: 0.0176 }
    active_contacts: "foot_l_contact"
    active_contacts: "hand_l_contact"
    active_contacts: "hand_r_contact"
  }
}
