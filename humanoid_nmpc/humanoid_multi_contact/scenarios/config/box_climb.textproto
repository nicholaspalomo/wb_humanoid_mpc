allowed_contacts: "foot_l_contact"
allowed_contacts: "foot_r_contact"
allowed_contacts: "knee_l_contact"
allowed_contacts: "knee_r_contact"
allowed_contacts: "hand_l_contact"
allowed_contacts: "hand_r_contact"
allowed_contacts: "forearm_l_contact"
allowed_contacts: "forearm_r_contact"

# Planner B: its quasi-static plan, checked between its knots as the MPC tracks it, is the one the dummy sim tracks
# (design section 5.5). Planner A's solve 3 on an earlier sequence of it failed 868 of 2401 knots (section 4.4).
planner: "stance_graph"
static_margin: 0.03
# The plan respects the joint position limits, widened by 0.1 rad, not the effort limits (design section 11,
# decisions 6 and 8): the dummy sims show the contact sequences, Atlas's arms (elbow 112 N m, shoulder 87-99 N m)
# cannot carry its body, and setting the second foot onto the box from a kneel needs the hips, knees and back up to
# 0.1 rad past their range.
joint_limits: "relaxed_position"
joint_limit_relaxation: 0.1
duration: 12
