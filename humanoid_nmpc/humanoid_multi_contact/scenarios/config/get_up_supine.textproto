# proto-file: humanoid_nmpc/humanoid_multi_contact/scenarios/scenario.proto
# proto-message: humanoid_multi_contact.Scenario
# Getting up from lying on the back (design section 8.1, scenario 4), on the floor alone. Atlas lies on the back
# face of its torso box, the knees drawn up and the soles flat on the floor: its collision boxes put the torso's
# back 9 cm below the pelvis's and 20 cm below the backs of the thighs, so neither the seat pad nor the thighs touch
# the floor when the back does. Sitting up from the back is beyond its hips and arms (design section 5.5): it rolls
# onto the back-right edge of its torso box (the torso edge pads, allowed in this scenario alone), puts the right
# foot and hand down, comes onto the feet and the hands, squats and stands.

name: "get_up_supine"
robot: "drc_atlas"
urdf_file: "robot_models/drc_atlas/drc_atlas_description/urdf/atlas.urdf"
contact_set_file: "robot_models/drc_atlas/drc_atlas_centroidal_mpc/config/mpc/multi_contact/contact_set.textproto"
collision_model_file: "robot_models/drc_atlas/drc_atlas_centroidal_mpc/config/mpc/multi_contact/collision_model.textproto"
mpc_task_file: "robot_models/drc_atlas/drc_atlas_centroidal_mpc/config/mpc/multi_contact/task.textproto"
mpc_reference_file: "robot_models/drc_atlas/drc_atlas_centroidal_mpc/config/mpc/multi_contact/reference.textproto"

terrain_scene {
  name: "floor"
  # The floor: its top face is z = 0.
  primitives {
    name: "ground"
    friction: 0.8
    box { center: [0, 0, -0.5] half_extents: [20, 20, 0.5] }
  }
}

initial_pose {
  name: "lying_supine"
  base_position: [0, 0, 0.2325]
  base_orientation_xyzw: [0, -0.7071068, 0, 0.7071068]
  joint_positions { joint: "l_leg_hpy" position: -0.679 }
  joint_positions { joint: "r_leg_hpy" position: -0.679 }
  joint_positions { joint: "l_leg_kny" position: 1.9 }
  joint_positions { joint: "r_leg_kny" position: 1.9 }
  joint_positions { joint: "l_leg_aky" position: 0.3498 }
  joint_positions { joint: "r_leg_aky" position: 0.3498 }
  joint_positions { joint: "l_arm_shx" position: -1.3 }
  joint_positions { joint: "r_arm_shx" position: 1.3 }
  active_contacts: "torso_back_contact"
  active_contacts: "foot_l_contact"
  active_contacts: "foot_r_contact"
}

goal {
  contacts { contact: "foot_l_contact" primitive: "ground" }
  contacts { contact: "foot_r_contact" primitive: "ground" }
  base_region { center: [0, 0, 0.9232] half_extents: [0.6, 0.4, 0.15] }
  pose {
    name: "standing"
    base_position: [0, 0, 0.9232]
    base_orientation_xyzw: [0, 0, 0, 1]
    joint_positions { joint: "l_leg_hpy" position: -0.3 }
    joint_positions { joint: "r_leg_hpy" position: -0.3 }
    joint_positions { joint: "l_leg_kny" position: 0.6 }
    joint_positions { joint: "r_leg_kny" position: 0.6 }
    joint_positions { joint: "l_leg_aky" position: -0.3 }
    joint_positions { joint: "r_leg_aky" position: -0.3 }
    joint_positions { joint: "l_arm_shx" position: -1.3 }
    joint_positions { joint: "r_arm_shx" position: 1.3 }
    active_contacts: "foot_l_contact"
    active_contacts: "foot_r_contact"
  }
}

# The stances the get-up passes through, in order, each with a pose that the stance IK holds within the URDF's joint
# limits widened by 0.05 rad and 2 cm off the floor (found with a prototype of the IK): the right arm raised along the
# head, the right foot off and the back-right edge of the torso box down beside the back; the back off, onto that edge
# and the left foot; on both pairs of the edge's pads, then its steeper pads alone; the right foot set down behind; the
# right hand down past the head; the right foot off and down in front of the hips; the edge off and the left hand down,
# on the feet and the hands; a squat on the hands nearer the goal; the right hand alone, then the feet alone (a squat).
# A sole keeps its yaw from one pose to the next while it stays down, as the stance IK holds it, and each pose holds its
# CoM inside the polygon of the stance it shares with a neighbor one change away, so that the pose seeds that change,
# and the free right arm moves little between such neighbors. With the right hand down, the poses keep the right forearm
# 2.5 cm off the floor. The search finds the changes between them (the feet and the hands walked under the body and
# toward the goal) and the stand-up after the last, which faces the head's way, -x.
waypoints {
  contacts { contact: "foot_l_contact" primitive: "ground" }
  contacts { contact: "torso_back_contact" primitive: "ground" }
  contacts { contact: "torso_edge_r_low_25_contact" primitive: "ground" }
  contacts { contact: "torso_edge_r_high_25_contact" primitive: "ground" }
  pose {
    name: "right_foot_up_on_the_back_edge"
    base_position: [-0.0338, -0.1136, 0.2009]
    base_orientation_xyzw: [-0.019590062, -0.638062514, -0.375469928, 0.671948504]
    joint_positions { joint: "back_bkz" position: 0.4789 }
    joint_positions { joint: "back_bky" position: -0.1861 }
    joint_positions { joint: "back_bkx" position: 0.5402 }
    joint_positions { joint: "l_arm_shz" position: -1.6158 }
    joint_positions { joint: "l_arm_shx" position: -1.5167 }
    joint_positions { joint: "l_arm_ely" position: 0.0381 }
    joint_positions { joint: "l_arm_elx" position: 0.0285 }
    joint_positions { joint: "l_arm_wry" position: 0.0239 }
    joint_positions { joint: "neck_ry" position: -0.1183 }
    joint_positions { joint: "r_arm_shx" position: 0.4298 }
    joint_positions { joint: "r_arm_ely" position: 0.0008 }
    joint_positions { joint: "r_arm_elx" position: 0.0447 }
    joint_positions { joint: "r_arm_wry" position: 0.0018 }
    joint_positions { joint: "l_leg_hpz" position: -0.2194 }
    joint_positions { joint: "l_leg_hpx" position: 0.5319 }
    joint_positions { joint: "l_leg_hpy" position: -0.2452 }
    joint_positions { joint: "l_leg_kny" position: 1.7683 }
    joint_positions { joint: "l_leg_aky" position: 0.2584 }
    joint_positions { joint: "l_leg_akx" position: -0.6923 }
    joint_positions { joint: "r_leg_hpz" position: -0.2548 }
    joint_positions { joint: "r_leg_hpx" position: -0.0027 }
    joint_positions { joint: "r_leg_hpy" position: -0.6328 }
    joint_positions { joint: "r_leg_kny" position: 0.6773 }
    joint_positions { joint: "r_leg_aky" position: 0.3136 }
    joint_positions { joint: "r_leg_akx" position: 0.0022 }
    active_contacts: "foot_l_contact"
    active_contacts: "torso_back_contact"
    active_contacts: "torso_edge_r_low_25_contact"
    active_contacts: "torso_edge_r_high_25_contact"
  }
}
