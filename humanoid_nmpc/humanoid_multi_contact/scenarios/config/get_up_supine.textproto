allowed_contacts: "foot_l_contact"
allowed_contacts: "foot_r_contact"
allowed_contacts: "knee_l_contact"
allowed_contacts: "knee_r_contact"
allowed_contacts: "hand_l_contact"
allowed_contacts: "hand_r_contact"
allowed_contacts: "forearm_l_contact"
allowed_contacts: "forearm_r_contact"
allowed_contacts: "seat_contact"
allowed_contacts: "thigh_l_contact"
allowed_contacts: "thigh_r_contact"
allowed_contacts: "torso_back_contact"
allowed_contacts: "torso_front_contact"
allowed_contacts: "torso_edge_r_low_25_contact"
allowed_contacts: "torso_edge_r_high_25_contact"
allowed_contacts: "torso_edge_r_low_65_contact"
allowed_contacts: "torso_edge_r_high_65_contact"

# Planner B: its quasi-static plan, checked between its knots as the MPC tracks it, is the one the dummy sim tracks
# (design section 5.5).
planner: "stance_graph"
static_margin: 0.03
# The plan respects the joint position limits widened by 0.05 rad, not the effort limits (design
# section 11, decisions 6 and 8): the dummy sims show the contact sequences, and Atlas's arms (elbow 112 N m, shoulder
# 87-99 N m) cannot carry its body. Not the other scenarios' 0.1 rad: the MPC holds the URDF's limits with a soft
# barrier, and diverged where a plan held both hips 0.1 rad past their ranges with one foot in the air.
joint_limits: "relaxed_position"
joint_limit_relaxation: 0.05
point_pad_link_above: "rests"
# The roll stands on two pads along the torso's edge and a foot: a thin polygon whose corner at the inner pad lies
# between two of the margin directions, which the sampled hull cuts off or keeps by how an LP breaks a tie. The
# planner and the certifier refine it (design section 2), so the plan and its tracked trajectory are judged on the
# polygon they stand on.
support_polygon: "refined"
# The MPC has no collision spheres on its links and tracked the right forearm, beside the right hand on the floor,
# up to 2 cm below a plan that held it at the planner's usual 1 cm.
sphere_clearance: 0.02
duration: 12

# The robot starts lying, its base pitched by 90 degrees, which would trip the tilt catch at once: the
# tilt catch and the gantry stay disarmed until it stands (design section 8.1, scenario 4).
simulation_start {
  tilt_catch_arming: "when_standing"
  gantry_arming: "when_standing"
  standing_base_height: 0.85
}
