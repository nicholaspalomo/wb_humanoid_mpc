# proto-file: humanoid_nmpc/humanoid_multi_contact/scenarios/scenario.proto
# proto-message: humanoid_multi_contact.Scenario
# Getting out of a utility vehicle (design section 8.1, scenario 3), the egress task of the DRC Finals. The
# hard part is the transfer of the weight from the seat to one foot on the ground 0.75 m below, with a hand
# pushing on the pillar or the seat (push only, design section 11, decision 3).

name: "car_egress"
robot: "drc_atlas"
urdf_file: "robot_models/drc_atlas/drc_atlas_description/urdf/atlas.urdf"
contact_set_file: "robot_models/drc_atlas/drc_atlas_centroidal_mpc/config/mpc/multi_contact/contact_set.textproto"
collision_model_file: "robot_models/drc_atlas/drc_atlas_centroidal_mpc/config/mpc/multi_contact/collision_model.textproto"
mpc_task_file: "robot_models/drc_atlas/drc_atlas_centroidal_mpc/config/mpc/multi_contact/task.textproto"
mpc_reference_file: "robot_models/drc_atlas/drc_atlas_centroidal_mpc/config/mpc/multi_contact/reference.textproto"

terrain_scene {
  name: "car_egress"
  # The floor: its top face is z = 0.
  primitives {
    name: "ground"
    friction: 0.8
    box { center: [0, 0, -0.5] half_extents: [20, 20, 0.5] }
  }
  # The vehicle, modeled on the Polaris Ranger XP 900 of the DRC Finals, its driver's side (+y) open.
  # Every dimension is a scene parameter, to be checked against the vehicle before the scenario
  # is used as evidence. The floor pan, its top 0.30 m above the ground.
  primitives {
    name: "floor_pan"
    friction: 0.8
    box { center: [0.35, 0, 0.15] half_extents: [0.65, 0.55, 0.15] }
  }
  # The seat cushion, its top 0.45 m above the floor pan: Atlas's shins (0.50 m from the knee
  # to the sole) need more than the 0.35 m of the design's first estimate. It is 0.50 m deep,
  # a utility vehicle's bench: the hip pitch limit (-1.61 rad) keeps Atlas's thigh capsules
  # sloping about 6 degrees down to the knees, so they rest on its front edge, and a deeper
  # cushion would put the thighs 1 cm into it ahead of the thigh pads.
  primitives {
    name: "seat_cushion"
    friction: 0.8
    box { center: [0, 0, 0.525] half_extents: [0.25, 0.3, 0.225] }
  }
  # The seat back, behind the torso.
  primitives {
    name: "seat_back"
    friction: 0.8
    box { center: [-0.31, 0, 1.1] half_extents: [0.05, 0.3, 0.35] }
  }
  # The dashboard.
  primitives {
    name: "dashboard"
    friction: 0.8
    box { center: [1.05, 0, 1] half_extents: [0.1, 0.55, 0.15] }
  }
  # The driver's A-pillar and roof rail of the roll cage.
  primitives {
    name: "a_pillar"
    friction: 0.6
    capsule { start: [1, 0.55, 0.85] end: [0.65, 0.55, 2] radius: 0.025 }
  }
  primitives {
    name: "roof_rail"
    friction: 0.6
    capsule { start: [0.65, 0.55, 2] end: [-0.45, 0.55, 2] radius: 0.025 }
  }
}

# Seated: the seat pad and the backs of the thighs on the cushion, the feet on the floor pan.
initial_pose {
  name: "sitting"
  base_position: [0, 0, 0.893]
  base_orientation_xyzw: [0, 0, 0, 1]
  joint_positions { joint: "l_leg_hpy" position: -1.6 }
  joint_positions { joint: "r_leg_hpy" position: -1.6 }
  joint_positions { joint: "l_leg_kny" position: 1.3232 }
  joint_positions { joint: "r_leg_kny" position: 1.3232 }
  joint_positions { joint: "l_leg_aky" position: 0.2768 }
  joint_positions { joint: "r_leg_aky" position: 0.2768 }
  joint_positions { joint: "l_arm_shx" position: -1.3 }
  joint_positions { joint: "r_arm_shx" position: 1.3 }
  active_contacts: "seat_contact"
  active_contacts: "thigh_l_contact"
  active_contacts: "thigh_r_contact"
  active_contacts: "foot_l_contact"
  active_contacts: "foot_r_contact"
}

goal {
  contacts { contact: "foot_l_contact" primitive: "ground" }
  contacts { contact: "foot_r_contact" primitive: "ground" }
  base_region { center: [0.3, 1.1, 0.9232] half_extents: [0.4, 0.3, 0.15] }
  pose {
    name: "standing"
    base_position: [0.3, 1.1, 0.9232]
    base_orientation_xyzw: [0, 0, 0, 1]
    joint_positions { joint: "l_leg_hpy" position: -0.3 }
    joint_positions { joint: "r_leg_hpy" position: -0.3 }
    joint_positions { joint: "l_leg_kny" position: 0.6 }
    joint_positions { joint: "r_leg_kny" position: 0.6 }
    joint_positions { joint: "l_leg_aky" position: -0.3 }
    joint_positions { joint: "r_leg_aky" position: -0.3 }
    joint_positions { joint: "l_arm_shx" position: -1.3 }
    joint_positions { joint: "r_arm_shx" position: 1.3 }
    active_contacts: "foot_l_contact"
    active_contacts: "foot_r_contact"
  }
}

allowed_contacts: "foot_l_contact"
allowed_contacts: "foot_r_contact"
allowed_contacts: "knee_l_contact"
allowed_contacts: "knee_r_contact"
allowed_contacts: "hand_l_contact"
allowed_contacts: "hand_r_contact"
allowed_contacts: "forearm_l_contact"
allowed_contacts: "forearm_r_contact"
allowed_contacts: "seat_contact"
allowed_contacts: "thigh_l_contact"
allowed_contacts: "thigh_r_contact"

planner: "stance_graph_then_contact_invariant"
static_margin: 0.03
# The plan respects the joint position limits only, not the effort limits (design section 11, decision 6): the
# dummy sims show the contact sequences, and Atlas's arms (elbow 112 N m, shoulder 87-99 N m) cannot carry its body.
joint_limits: "position_only"
duration: 15

# The robot starts seated, below the gantry's hold and with its base pitched back: the tilt catch and
# the gantry stay disarmed until it stands (design section 8.3).
simulation_start {
  tilt_catch_arming: "when_standing"
  gantry_arming: "when_standing"
  standing_base_height: 0.85
}
