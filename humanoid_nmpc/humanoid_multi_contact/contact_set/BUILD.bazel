load("@protobuf//bazel:cc_proto_library.bzl", "cc_proto_library")
load("@protobuf//bazel:proto_library.bzl", "proto_library")
load("@protobuf//bazel:py_proto_library.bzl", "py_proto_library")
load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc//cc:cc_test.bzl", "cc_test")
load("//bazel:copts.bzl", "FIRST_PARTY_COPTS")
load("//tools/nproto:nproto.bzl", "nproto_cc_library")

# humanoid_multi_contact/contact_set - the runtime contact candidates of a robot (humanoid_nmpc/docs/
# multi_contact_planning/README.md, section 3.1): the ContactSet schema and its validated C++ form. The DRC Atlas's set
# is robot_models/drc_atlas/drc_atlas_centroidal_mpc/config/mpc/multi_contact/contact_set.textproto.

package(default_visibility = ["//visibility:public"])

proto_library(
    name = "contact_set_proto",
    srcs = ["contact_set.proto"],
    strip_import_prefix = "/humanoid_nmpc",
    deps = ["//tools/nproto:options_proto"],
)

cc_proto_library(
    name = "contact_set_cc_proto",
    deps = [":contact_set_proto"],
)

py_proto_library(
    name = "contact_set_py_proto",
    deps = [":contact_set_proto"],
)

nproto_cc_library(
    name = "contact_set_nproto",
    deps = [":contact_set_proto"],
)

cc_library(
    name = "contact_set",
    srcs = ["src/ContactSet.cpp"],
    hdrs = ["include/humanoid_multi_contact/contact_set/ContactSet.h"],
    copts = FIRST_PARTY_COPTS,
    includes = ["include"],
    deps = [
        ":contact_set_cc_proto",
        ":contact_set_nproto",
        "//humanoid_nmpc/humanoid_common_mpc:humanoid_common_mpc_types",
        "//lib/ocs2:ocs2_dimensions",
        "//tools/nproto:nproto_runtime",
        "@abseil-cpp//absl/container:flat_hash_map",
        "@abseil-cpp//absl/status",
        "@abseil-cpp//absl/status:statusor",
        "@abseil-cpp//absl/strings",
        "@abseil-cpp//absl/strings:string_view",
        "@abseil-cpp//absl/types:span",
        "@eigen",
    ],
)

# The validation of a set, masks and names, and the shipped DRC Atlas set: seventeen candidates with the pads of the
# design's table.
cc_test(
    name = "contact_set_test",
    size = "small",
    srcs = ["test/testContactSet.cpp"],
    copts = FIRST_PARTY_COPTS,
    data = ["//robot_models/drc_atlas/drc_atlas_centroidal_mpc"],
    deps = [
        ":contact_set",
        ":contact_set_nproto",
        "//robot_runtime/robot_core:resource_paths",
        "@abseil-cpp//absl/status",
        "@abseil-cpp//absl/status:statusor",
        "@abseil-cpp//absl/strings",
        "@abseil-cpp//absl/strings:string_view",
        "@eigen",
        "@googletest//:gtest_main",
    ],
)
