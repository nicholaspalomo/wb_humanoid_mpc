# The MPC-level equivalence of one configuration (MPC_EQUIVALENCE_CONFIGURATION): the dynamics, their linearization and
# the SQP's shooting interval against the oracle (testMpcDynamicsEquivalence), RK4 rollouts through ordinary attitudes,
# across a yaw of +-pi and through gimbal lock (testMpcRolloutEquivalence), the quadratic state costs to second order
# under the task file's Euler-written weights (testMpcOrientationCostEquivalence) and one real-time SQP iteration on the
# quaternion manifold against the Euler-chart iteration (EulerChartStateManifold, testMpcSqpStepEquivalence). The four
# test files share one binary so that the robot's CppAD libraries are generated once. Exclusive: one at a time.
[
    cc_test(
        name = "testMpcEquivalence_" + robot,
        size = "enormous",
        srcs = [
            "testMpcDynamicsEquivalence.cpp",
            "testMpcOrientationCostEquivalence.cpp",
            "testMpcRolloutEquivalence.cpp",
            "testMpcSqpStepEquivalence.cpp",
        ],
        copts = FIRST_PARTY_COPTS,
        data = data,
        env = {"MPC_EQUIVALENCE_CONFIGURATION": robot},
        tags = ["exclusive"],
        deps = _MPC_TEST_DEPS,
    )
    for robot, data in _MPC_EQUIVALENCE_ROBOTS.items()
]

# The deterministic evaluation points of the two term tests below, built from the configuration's shipped task file, and
# the points inside the bands of the piecewise polynomial barriers; the precomputation requests that precede every
# evaluation of a term, the checks that a test covered every term of its collections, each where it is not zero, and the
# ICP weight of the tests' problem copies.
cc_library(
    name = "term_probe_points",
    testonly = True,
    srcs = ["TermProbePoints.cpp"],
    hdrs = ["TermProbePoints.h"],
    copts = FIRST_PARTY_COPTS,
    deps = [
        ":mpc_equivalence",
        "//humanoid_nmpc/humanoid_centroidal_mpc",
        "//humanoid_nmpc/humanoid_common_mpc",
        "//humanoid_nmpc/humanoid_common_mpc:humanoid_common_mpc_types",
        "//humanoid_nmpc/humanoid_common_mpc:orientation",
        "//humanoid_nmpc/humanoid_mpc_validation:euler_chart",
        "//lib/ocs2:ocs2_core",
        "//lib/ocs2:ocs2_oc",
        "@abseil-cpp//absl/base:nullability",
        "@abseil-cpp//absl/container:flat_hash_set",
        "@abseil-cpp//absl/strings",
        "@abseil-cpp//absl/strings:string_view",
        "@abseil-cpp//absl/types:span",
        "@eigen",
        "@pinocchio",
    ],
)

# Every term of one configuration's optimal control problem on the quaternion root, at deterministic points built from
# the shipped task file (TermProbePoints.h), to first and second order. First (testQuaternionRootTermDerivatives.cpp):
# each cost, soft constraint and constraint, intermediate and final, and the flow map against Richardson-extrapolated
# central differences of their double-precision values along the state manifold and the inputs, at every point - the
# stance feet's twist constraint with the term its held rate map drops from its state Jacobian added. Second
# (testQuaternionRootTermHessians.cpp): each cost's and soft constraint's Hessian, pulled back as the solver pulls it
# back, against the Gauss-Newton or penalty model its class prescribes, built from its verified first order, and
# against its exact Hessian minus the curvature that model drops. Each fails a term of its collections that no point
# checks, or that it checks only where what it checks is zero. The two test files share one binary so that the robot's
# CppAD libraries are generated once. Exclusive: one at a time.
[
    cc_test(
        name = "testQuaternionRootTermDerivatives_" + robot,
        size = "enormous",
        srcs = [
            "testQuaternionRootTermDerivatives.cpp",
            "testQuaternionRootTermHessians.cpp",
        ],
        copts = FIRST_PARTY_COPTS,
        data = data,
        env = {"MPC_EQUIVALENCE_CONFIGURATION": robot},
        tags = ["exclusive"],
        deps = _MPC_TEST_DEPS + [
            ":term_probe_points",
            "//humanoid_nmpc/humanoid_centroidal_mpc",
            "//lib/ocs2:ocs2_pinocchio_interface",
            "@abseil-cpp//absl/container:flat_hash_set",
        ],
    )
    for robot, data in _MPC_EQUIVALENCE_ROBOTS.items()
]
