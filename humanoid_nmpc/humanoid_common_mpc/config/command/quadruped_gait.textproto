# proto-file: humanoid_nmpc/humanoid_mpc_config/gait_file.proto
# proto-message: humanoid_mpc_config.GaitFile
#
# The shared gait file of the quadrupeds. It is read against a contact set ordered LF, RF, LH, RH (left front, right
# front, left hind, right hind) with one leg of the same name per contact, so the mode bits are LF = 8, RF = 4, LH = 2
# and RH = 1 and a trot is LF_RH (9) then RF_LH (6). A mode names the legs in stance, joined by '_'
# (mode_sequence_template_config.proto).
#
# The gaits, their modes and their switching times follow the gait file of the OCS2 legged_robot ANYmal example
# (ocs2_robotic_examples/ocs2_legged_robot/config/command/gait.info), Copyright (c) 2017, Farbod Farshidian, under the
# BSD 3-Clause License of lib/ocs2/LICENCE.txt. NOLINT(american-spelling): the name of the license file.
gait_list: "stance"
gait_list: "trot"
gait_list: "standing_trot"
gait_list: "flying_trot"
gait_list: "pace"
gait_list: "static_walk"
gait_list: "dynamic_walk"

gaits {
  name: "stance"
  mode_sequence: "STANCE"
  switching_times: 0.0
  switching_times: 0.5
}

gaits {
  name: "trot"
  mode_sequence: "LF_RH"
  mode_sequence: "RF_LH"
  switching_times: 0.0
  switching_times: 0.35
  switching_times: 0.70
}

gaits {
  name: "standing_trot"
  mode_sequence: "LF_RH"
  mode_sequence: "STANCE"
  mode_sequence: "RF_LH"
  mode_sequence: "STANCE"
  switching_times: 0.0
  switching_times: 0.30
  switching_times: 0.35
  switching_times: 0.65
  switching_times: 0.70
}

gaits {
  name: "flying_trot"
  mode_sequence: "LF_RH"
  mode_sequence: "FLY"
  mode_sequence: "RF_LH"
  mode_sequence: "FLY"
  switching_times: 0.0
  switching_times: 0.27
  switching_times: 0.30
  switching_times: 0.57
  switching_times: 0.60
}

gaits {
  name: "pace"
  mode_sequence: "LF_LH"
  mode_sequence: "FLY"
  mode_sequence: "RF_RH"
  mode_sequence: "FLY"
  switching_times: 0.0
  switching_times: 0.28
  switching_times: 0.30
  switching_times: 0.58
  switching_times: 0.60
}

gaits {
  name: "static_walk"
  mode_sequence: "LF_RF_RH"
  mode_sequence: "RF_LH_RH"
  mode_sequence: "LF_RF_LH"
  mode_sequence: "LF_LH_RH"
  switching_times: 0.0
  switching_times: 0.3
  switching_times: 0.6
  switching_times: 0.9
  switching_times: 1.2
}

gaits {
  name: "dynamic_walk"
  mode_sequence: "LF_RF_RH"
  mode_sequence: "RF_RH"
  mode_sequence: "RF_LH_RH"
  mode_sequence: "LF_RF_LH"
  mode_sequence: "LF_LH"
  mode_sequence: "LF_LH_RH"
  switching_times: 0.0
  switching_times: 0.2
  switching_times: 0.3
  switching_times: 0.5
  switching_times: 0.7
  switching_times: 0.8
  switching_times: 1.0
}

# The gaits the walking velocity command switches between, slowest first (gait_switching_table_config.proto), with
# thresholds set from ANYmal B's closed-loop runs (humanoid_mpc_validation, label 2026-11-10_anymal_b):
# - stance leaves on the command alone (error thresholds of 10), as the bipeds' does;
# - trot takes every command from stance up to 0.8 m/s and 0.6 rad/s, the range a 0.7 s trot cycle reaches;
# - flying_trot takes every faster command.
# static_walk is not a row. With it between stance and trot, the trot waited for a stride-mean speed of 0.15 m/s
# reached in static_walk, and a 0.5 m/s command walked about 2.4 s in static_walk before it trotted, averaging
# 0.38 m/s. Each row's lower bounds sit below the upper bounds of the row before, so that a command near one bound
# does not switch back and forth.
gait_switching {
  rows {
    gait: "stance"
    cmd_min_linvel_base_rt_world_ewrt_heading_xy: -0.1
    cmd_max_linvel_base_rt_world_ewrt_heading_xy: 0.1
    cmd_min_angvel_base_rt_world_ewrt_world_z: -0.1
    cmd_max_angvel_base_rt_world_ewrt_world_z: 0.1
    max_err_linvel_base_rt_world_ewrt_heading_xy: 10.0
    max_err_angvel_base_rt_world_ewrt_world_z: 10.0
  }
  rows {
    gait: "trot"
    cmd_min_linvel_base_rt_world_ewrt_heading_xy: 0.05
    cmd_max_linvel_base_rt_world_ewrt_heading_xy: 0.8
    cmd_min_angvel_base_rt_world_ewrt_world_z: 0.05
    cmd_max_angvel_base_rt_world_ewrt_world_z: 0.6
    max_err_linvel_base_rt_world_ewrt_heading_xy: 0.1
    max_err_angvel_base_rt_world_ewrt_world_z: 0.1
  }
  rows {
    gait: "flying_trot"
    cmd_min_linvel_base_rt_world_ewrt_heading_xy: 0.7
    cmd_max_linvel_base_rt_world_ewrt_heading_xy: 10.0
    cmd_min_angvel_base_rt_world_ewrt_world_z: 0.5
    cmd_max_angvel_base_rt_world_ewrt_world_z: 10.0
    max_err_linvel_base_rt_world_ewrt_heading_xy: 0.2
    max_err_angvel_base_rt_world_ewrt_world_z: 0.2
  }
}
