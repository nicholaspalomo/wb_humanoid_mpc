# humanoid_common_mpc - Core humanoid MPC library

package(default_visibility = ["//visibility:public"])

_COMMON_COPTS = [
    "-std=c++20",
    "-Wall",
    "-Wextra",
    "-Wpedantic",
    "-Werror=return-type",
]

# Headers shared by the planner core and the rest of the library (types, the mode-number conventions and the
# absl::Status propagation macros, header only).
_COMMON_TYPES_HDRS = [
    "include/humanoid_common_mpc/common/StatusMacros.h",
    "include/humanoid_common_mpc/common/Types.h",
    "include/humanoid_common_mpc/gait/MotionPhaseDefinition.h",
]

cc_library(
    name = "humanoid_common_mpc_types",
    hdrs = _COMMON_TYPES_HDRS,
    includes = ["include"],
    copts = _COMMON_COPTS,
    deps = [
        "//lib/ocs2:ocs2_core",
        "@abseil-cpp//absl/status",
        "@abseil-cpp//absl/status:statusor",
        "@eigen",
    ],
)

# The reset and failure policy of the MRT joint controllers (include/humanoid_common_mpc/mrt/MpcResetSupervisor.h). A
# target of its own, without the robot model, Pinocchio or ROS, because the network MPC link
# (//humanoid_nmpc/humanoid_mpc_ipc) serves its resets and mirrors its health on both sides of the bus.
cc_library(
    name = "mpc_reset_supervisor",
    srcs = ["src/mrt/MpcResetSupervisor.cpp"],
    hdrs = ["include/humanoid_common_mpc/mrt/MpcResetSupervisor.h"],
    includes = ["include"],
    copts = _COMMON_COPTS,
    deps = [
        ":humanoid_common_mpc_types",
        "@abseil-cpp//absl/log",
        "@abseil-cpp//absl/status",
    ],
)

# What the MRT joint controllers report from the control thread instead of logging there (ControllerEvent.h), the sink
# it goes to and the sink that logs at once. A target of its own, without Pinocchio or OCS2, because the robot process's
# realtime event log is a sink.
_CONTROLLER_EVENT_HDRS = [
    "include/humanoid_common_mpc/mrt/ControllerEvent.h",
    "include/humanoid_common_mpc/mrt/ControllerEventSink.h",
    "include/humanoid_common_mpc/mrt/LoggingControllerEventSink.h",
]

cc_library(
    name = "controller_event",
    srcs = [
        "src/mrt/ControllerEvent.cpp",
        "src/mrt/LoggingControllerEventSink.cpp",
    ],
    hdrs = _CONTROLLER_EVENT_HDRS,
    includes = ["include"],
    copts = _COMMON_COPTS,
    deps = [
        "@abseil-cpp//absl/log",
        "@abseil-cpp//absl/strings",
        "@abseil-cpp//absl/strings:string_view",
    ],
)

# The name of the state layout the CppAD library folders are tagged with (design decision D14 of
# humanoid_nmpc/docs/quaternion_base_orientation/README.md), header only.
_STATE_LAYOUT_HDRS = [
    "include/humanoid_common_mpc/common/StateLayout.h",
]

cc_library(
    name = "state_layout",
    hdrs = _STATE_LAYOUT_HDRS,
    includes = ["include"],
    copts = _COMMON_COPTS,
    deps = ["@abseil-cpp//absl/strings:string_view"],
)

# The operator's walking command (command/WalkingVelocityCommand.h), a plain value, header only, so that the MPC node's
# conversion of the bus message (//humanoid_nmpc/humanoid_common_mpc_app/node:walking_velocity_command_conversions) and
# the closed-loop metrics that apply it build without the robot model.
_WALKING_VELOCITY_COMMAND_HDRS = [
    "include/humanoid_common_mpc/command/WalkingVelocityCommand.h",
]

cc_library(
    name = "walking_velocity_command",
    hdrs = _WALKING_VELOCITY_COMMAND_HDRS,
    includes = ["include"],
    copts = _COMMON_COPTS,
    deps = [":humanoid_common_mpc_types"],
)

# The base orientation as a unit quaternion (humanoid_nmpc/docs/quaternion_base_orientation/README.md, sections 2.1,
# 2.6, 2.8.1 and 4.2): the safe normalization, the quaternion rate matrix and the tangent lift, the heading-tilt residual
# with its closed-form Jacobian, and the Euler boundary, the only humanoid home of the Euler conversions. No Pinocchio, no
# ROS.
_ORIENTATION_HDRS = [
    "include/humanoid_common_mpc/orientation/BaseOrientation.h",
    "include/humanoid_common_mpc/orientation/EulerBoundary.h",
]

cc_library(
    name = "orientation",
    srcs = [
        "src/orientation/BaseOrientation.cpp",
        "src/orientation/EulerBoundary.cpp",
    ],
    hdrs = _ORIENTATION_HDRS,
    includes = ["include"],
    copts = _COMMON_COPTS,
    deps = [
        ":humanoid_common_mpc_types",
        "//lib/ocs2:ocs2_core",
        "//lib/ocs2:ocs2_robotic_tools",
        "@abseil-cpp//absl/status",
        "@abseil-cpp//absl/status:statusor",
        "@abseil-cpp//absl/strings",
        "@abseil-cpp//absl/strings:string_view",
        "@eigen",
    ],
)

