# humanoid_common_mpc - Core humanoid MPC library

package(default_visibility = ["//visibility:public"])

_COMMON_COPTS = [
    "-std=c++20",
    "-Wall",
    "-Wextra",
    "-Wpedantic",
    "-Werror=return-type",
    "-DBOOST_MPL_CFG_NO_PREPROCESSED_HEADERS",
    "-DBOOST_MPL_LIMIT_LIST_SIZE=50",
    "-DBOOST_VARIANT_LIMIT_TYPES=50",
    "-DBOOST_FUSION_INVOKE_MAX_ARITY=10",
]

# Headers shared by the planner core and the rest of the library (types and the mode-number conventions, header only).
_COMMON_TYPES_HDRS = [
    "include/humanoid_common_mpc/common/Types.h",
    "include/humanoid_common_mpc/gait/MotionPhaseDefinition.h",
]

cc_library(
    name = "humanoid_common_mpc_types",
    hdrs = _COMMON_TYPES_HDRS,
    includes = ["include"],
    copts = _COMMON_COPTS,
    deps = [
        "//lib/ocs2:ocs2_core",
        "@eigen",
    ],
)

# The contact planner's core: the problem assembled from terms (problem/, model/, cost/, constraint/, logic/), the
# search stages, the execution rules that need no robot model, the mixed-integer solver and the HPIPM wrapper, the
# configuration and the plan. No Pinocchio, no reference manager: the planner's unit tests build against this target.
_CONTACT_PLANNING_CORE_HDRS = [
    "include/humanoid_common_mpc/contact_planning/ContactPlan.h",
    "include/humanoid_common_mpc/contact_planning/ContactPlannerFactory.h",
    "include/humanoid_common_mpc/contact_planning/ContactPlannerInterface.h",
    "include/humanoid_common_mpc/contact_planning/ContactPlanningConfig.h",
    "include/humanoid_common_mpc/contact_planning/ContactPlanningFormulation.h",
    "include/humanoid_common_mpc/contact_planning/ContactPlanningTermFactory.h",
    "include/humanoid_common_mpc/contact_planning/ContactScheduleAdaptation.h",
    "include/humanoid_common_mpc/contact_planning/LipContactPlanner.h",
    "include/humanoid_common_mpc/contact_planning/MixedIntegerOcpQp.h",
    "include/humanoid_common_mpc/contact_planning/OcpQpHpipm.h",
    "include/humanoid_common_mpc/contact_planning/TargetContactPose.h",
] + glob(
    [
        "include/humanoid_common_mpc/contact_planning/hlip/*.h",
        "include/humanoid_common_mpc/contact_planning/problem/*.h",
        "include/humanoid_common_mpc/contact_planning/model/*.h",
        "include/humanoid_common_mpc/contact_planning/cost/*.h",
        "include/humanoid_common_mpc/contact_planning/constraint/*.h",
        "include/humanoid_common_mpc/contact_planning/logic/*.h",
        "include/humanoid_common_mpc/contact_planning/search/*.h",
        "include/humanoid_common_mpc/contact_planning/execution/*.h",
    ],
    exclude = [
        "include/humanoid_common_mpc/contact_planning/execution/PlannedComOverride.h",
        "include/humanoid_common_mpc/contact_planning/execution/PlannedHeadingOverride.h",
    ],
)

