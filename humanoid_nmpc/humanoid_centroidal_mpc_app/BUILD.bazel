# The node on the DRC Atlas task file with the real SQP solver, over loopback buses: a scripted robot and operator
# (observation in, policy out, resets through the observation's counters, the velocity command reaching the motion
# manager, a parameter document applied before the next solve, the visualization fed), the reset target the controller
# hands its in-process link, the dummy simulator standing on the node's policies for a few seconds without a reset, and
# the hardware topology end to end: the node binary and the robot binary (MuJoCo, headless) as two processes, the robot
# standing, walking and stopping on the node's policies. Large: it builds the Atlas MPC's CppAD libraries on a cold
# cache, once; the end-to-end case's node binary loads them from the same working directory. About 300 s on a 20-core
# workstation; CI's 4-vCPU runner starts with no CppAD cache, so the timeout is the longest Bazel has (3600 s).
cc_test(
    name = "test_centroidal_mpc_node",
    size = "large",
    timeout = "eternal",
    srcs = ["test/testCentroidalMpcNode.cpp"],
    copts = FIRST_PARTY_COPTS,
    data = [
        ":humanoid_centroidal_mpc_node",
        ":humanoid_centroidal_mpc_robot",
        "//humanoid_nmpc/humanoid_common_mpc:gait_config",
        "//robot_models/drc_atlas/drc_atlas_centroidal_mpc",
        "//robot_models/drc_atlas/drc_atlas_description",
    ],
    deps = [
        ":centroidal_mpc_node",
        "//humanoid_nmpc/humanoid_centroidal_mpc",
        "//humanoid_nmpc/humanoid_common_mpc",
        "//humanoid_nmpc/humanoid_common_mpc_app/node:mpc_node",
        "//humanoid_nmpc/humanoid_common_mpc_app/node:node_process",
        "//humanoid_nmpc/humanoid_common_mpc_app/node:scripted_robot",
        "//humanoid_nmpc/humanoid_common_mpc_app/robot:end_to_end_test_support",
        "//humanoid_nmpc/humanoid_common_mpc_app/teleop",
        "//humanoid_nmpc/humanoid_common_mpc_app/visualization",
        "//humanoid_nmpc/humanoid_mpc_ipc",
        "//humanoid_nmpc/humanoid_mpc_msgs:messages_cc_proto",
        "//lib/ocs2:ocs2_core",
        "//lib/ocs2:ocs2_mpc",
        "//lib/ocs2:ocs2_mpc_test_support",
        "//lib/ocs2:ocs2_sqp",
        "//robot_runtime/robot_core:resource_paths",
        "//robot_runtime/robot_ipc",
        "//robot_runtime/robot_model",
        "@abseil-cpp//absl/base:nullability",
        "@abseil-cpp//absl/status",
        "@abseil-cpp//absl/status:statusor",
        "@abseil-cpp//absl/strings",
        "@abseil-cpp//absl/time",
        "@googletest//:gtest_main",
        "@pinocchio",
    ],
)

