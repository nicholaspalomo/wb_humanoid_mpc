load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc//cc:cc_binary.bzl", "cc_binary")
load("@rules_cc//cc:cc_test.bzl", "cc_test")
# humanoid_common_mpc_ros2 - ROS2 interface library for humanoid MPC

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "humanoid_common_mpc_ros2",
    srcs = [
        "src/gait/GaitKeyboardPublisher.cpp",
        "src/gait/GaitScheduleUpdaterRos2.cpp",
        "src/visualization/HumanoidVisualizer.cpp",
        "src/visualization/HumanoidVisualizerRos2Interface.cpp",
        "src/visualization/EquivalentContactCornerForcesVisualizer.cpp",
        "src/ros_comm/MRTPolicySubscriber.cpp",
        "src/ros_comm/Ros2ProceduralMpcMotionManager.cpp",
        "src/ros_comm/VelocityCommandKeyboardPublisher.cpp",
        "src/ros_comm/JointTargetSubscriber.cpp",
        "src/benchmarks/SqpBenchmarksPublisher.cpp",
        "src/benchmarks/DdpBenchmarksPublisher.cpp",
        "src/fsm/DodgeballThrowParser.cpp",
        "src/fsm/SimFallRecovery.cpp",
        "src/fsm/SimFsmBridge.cpp",
        "src/telemetry/HumanoidTelemetryPublisher.cpp",
        "src/telemetry/PinocchioTelemetryPublisher.cpp",
    ],
    hdrs = glob(["include/**"], allow_empty = True),
    includes = ["include"],
    copts = [
        "-std=c++20",
        "-Wall",
        "-Wextra",
        "-Wpedantic",
        "-Werror=return-type",
        "-DBOOST_MPL_CFG_NO_PREPROCESSED_HEADERS",
        "-DBOOST_MPL_LIMIT_LIST_SIZE=50",
        "-DBOOST_VARIANT_LIMIT_TYPES=50",
        "-DBOOST_FUSION_INVOKE_MAX_ARITY=10",
    ],
    data = glob(["rviz/**"], allow_empty = True),
    deps = [
        "//humanoid_nmpc/humanoid_common_mpc",
        "//humanoid_nmpc/humanoid_mpc_msgs",
        "//robot_runtime/mujoco_sim_interface",
        "//robot_runtime/robot_model",
        "//lib/ocs2:ocs2_ros2_interfaces",
        "//lib/ocs2:ocs2_ros2_msgs",
        "//lib/ocs2:ocs2_sqp",
        "@abseil-cpp//absl/container:flat_hash_map",
        "@abseil-cpp//absl/log:log",
        "@abseil-cpp//absl/log:globals",
        "@abseil-cpp//absl/log:initialize",
        "@abseil-cpp//absl/strings",
        "@eigen",
        "@boost",
        "@pinocchio",
        "@ros2_rclcpp",
        "@yaml_cpp",
        "@ros2_ament_index_cpp",
        "@ros2_tf2_ros",
        "@ros2_tf2_eigen",
        "@urdf",
        "@ros2_kdl_parser",
        "@ros2_visualization_msgs",
        "@ros2_geometry_msgs",
        "@ros2_sensor_msgs",
        "@ros2_std_msgs",
    ],
)

cc_binary(
    name = "gait_keyboard_command_node",
    srcs = ["src/HumanoidGaitCommandNode.cpp"],
    deps = [":humanoid_common_mpc_ros2"],
)

cc_binary(
    name = "velocity_keyboard_command_node",
    srcs = ["src/MpcKeyboardVelocityCommandNode.cpp"],
    deps = [":humanoid_common_mpc_ros2"],
)

cc_test(
    name = "testDodgeballThrowParser",
    size = "small",
    srcs = ["test/testDodgeballThrowParser.cpp"],
    # The payload the GUI publishes, captured from remote_control's throw_payload; the Python tests check that the GUI
    # still produces exactly these keys, so a key renamed on either side fails a test on that side.
    data = ["test/data/dodgeball_payload.yaml"],
    deps = [
        ":humanoid_common_mpc_ros2",
        "@googletest//:gtest_main",
    ],
)

# The /humanoid/fsm_state message: the mode, the gantry and the controller resets the remote control re-centers its
# joysticks on (remote_control/test/test_fsm_state.py pins the parser on the same strings).
cc_test(
    name = "testFsmStateMessage",
    size = "small",
    srcs = ["test/testFsmStateMessage.cpp"],
    deps = [
        ":humanoid_common_mpc_ros2",
        "@googletest//:gtest_main",
    ],
)

cc_test(
    name = "testBaseTiltAngle",
    size = "small",
    srcs = ["test/testBaseTiltAngle.cpp"],
    deps = [
        ":humanoid_common_mpc_ros2",
        "@googletest//:gtest_main",
    ],
)

# GaitScheduleUpdaterRos2 fed through its topic, in a ROS context of the test's own: a received gait is inserted before
# the next solve, and one received before an MPC reset is dropped with it.
cc_test(
    name = "testGaitScheduleUpdaterRos2",
    size = "small",
    srcs = ["test/testGaitScheduleUpdaterRos2.cpp"],
    deps = [
        ":humanoid_common_mpc_ros2",
        "@abseil-cpp//absl/strings",
        "@googletest//:gtest_main",
    ],
)

# The fall recovery of the MuJoCo sims against the real simulator, headless, on the DRC Atlas scene: every simulator
# reset and every catch is one discontinuity, and a caught robot settles on the gantry before WB_MPC is accepted.
cc_test(
    name = "testSimFallRecovery",
    size = "medium",
    srcs = ["test/testSimFallRecovery.cpp"],
    data = [
        "//robot_models/drc_atlas/drc_atlas_centroidal_mpc",
        "//robot_models/drc_atlas/drc_atlas_description",
    ],
    deps = [
        ":humanoid_common_mpc_ros2",
        "//humanoid_nmpc/humanoid_common_mpc",
        "@abseil-cpp//absl/strings",
        "@googletest//:gtest_main",
        "@pinocchio",
        "@yaml_cpp",
    ],
)
