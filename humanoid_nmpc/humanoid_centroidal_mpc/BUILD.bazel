load("@rules_cc//cc:cc_library.bzl", "cc_library")
# humanoid_centroidal_mpc - Centroidal MPC library

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "humanoid_centroidal_mpc",
    srcs = [
        "src/dynamics/CentroidalDynamicsAD.cpp",
        "src/cost/CentroidalMpcEndEffectorFootCost.cpp",
        "src/cost/ICPCost.cpp",
        "src/constraint/ZeroVelocityConstraintCppAd.cpp",
        "src/constraint/NormalVelocityConstraintCppAd.cpp",
        "src/constraint/JointMimicKinematicConstraint.cpp",
        "src/initialization/CentroidalWeightCompInitializer.cpp",
        "src/CentroidalMpcInterface.cpp",
        "src/command/CentroidalMpcTargetTrajectoriesCalculator.cpp",
        "src/mrt/CentroidalMpcMrtJointController.cpp",
    ],
    hdrs = glob(["include/**"], allow_empty = True),
    includes = ["include"],
    copts = [
        "-std=c++20",
        "-Wall",
        "-Wextra",
        "-Wpedantic",
        "-Werror=return-type",
    ],
    deps = [
        "//humanoid_nmpc/humanoid_common_mpc",
        "//robot_runtime/robot_model",
        "//lib/ocs2:ocs2_core",
        "//lib/ocs2:ocs2_centroidal_model",
        "//lib/ocs2:ocs2_ros2_interfaces",
        "//lib/ocs2:ocs2_ddp",
        "//lib/ocs2:ocs2_mpc",
        "//lib/ocs2:ocs2_sqp",
        "//lib/ocs2:ocs2_pinocchio_interface",
        "@eigen",
        "@pinocchio",
        "@abseil-cpp//absl/status",
        "@abseil-cpp//absl/status:statusor",
        "@ros2_rclcpp",
        "@ros2_ament_index_cpp",
    ],
)
