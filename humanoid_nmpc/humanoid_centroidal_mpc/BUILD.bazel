# A live update of every RELOAD_HOT field of the task file gives the problem a fresh start from the edited file builds,
# weight for weight and solve for solve (L4, L4t), also with every base-orientation and ACoM row weighed, and an updater
# fed nothing changes nothing (L5): on the DRC Atlas and the variants the updater tests build. Generates the Atlas CppAD
# libraries on a cold cache.
cc_test(
    name = "testLiveUpdateEqualsFreshStart",
    size = "large",
    # Its last run under //... took 899 s against large's 900 s: eternal, as the whole body's test_wb_live_tuning.
    timeout = "eternal",
    srcs = ["test/testLiveUpdateEqualsFreshStart.cpp"],
    copts = FIRST_PARTY_COPTS,
    # About 10 GB at its peak while it generates the CppAD libraries: next to another test under --local_test_jobs=2 it
    # passed the 14 GB container cap and was killed, so it runs alone.
    tags = ["exclusive"],
    data = [
        "//humanoid_nmpc/humanoid_common_mpc:gait_config",
        "//robot_models/drc_atlas/drc_atlas_centroidal_mpc",
        "//robot_models/drc_atlas/drc_atlas_description",
    ],
    deps = [
        ":humanoid_centroidal_mpc",
        ":shipped_centroidal_robot",
        ":typed_config_support",
        "//humanoid_nmpc/humanoid_common_mpc",
        "//humanoid_nmpc/humanoid_common_mpc:orientation",
        "//robot_runtime/robot_core:resource_paths",
        "//tools/nproto:options_cc_proto",
        "//humanoid_nmpc/humanoid_mpc_config:config_cc_proto",
        "//humanoid_nmpc/humanoid_mpc_config:config_nproto",
        "//lib/ocs2:ocs2_core",
        "//lib/ocs2:ocs2_mpc",
        "//lib/ocs2:ocs2_oc",
        "//lib/ocs2:ocs2_sqp",
        "@abseil-cpp//absl/base:nullability",
        "@abseil-cpp//absl/functional:function_ref",
        "@abseil-cpp//absl/status",
        "@abseil-cpp//absl/status:statusor",
        "@abseil-cpp//absl/strings",
        "@abseil-cpp//absl/strings:str_format",
        "@abseil-cpp//absl/strings:string_view",
        "@googletest//:gtest_main",
        "@protobuf",
