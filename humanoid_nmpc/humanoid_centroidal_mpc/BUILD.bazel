# The end-to-end test of milestones 4 and 5: the multi-contact MPC (thirteen contacts, the wrists unlocked) tracking
# milestone 1's hand-written sway, the hand-written stair step and the stairs and box_climb scenarios' shipped plans
# (humanoid_multi_contact/plans/*.binpb) in the dummy simulator's loop, faster than real time, to the goal, with
# the stability certifier passing on the tracked trajectory. Large: it generates the multi-contact model's
# CppAD libraries on a cold cache (the dynamics of thirteen contacts, the kinematics of each, its terrain
# non-penetration tapes), once for both cases.
cc_test(
    name = "test_multi_contact_plan_tracking",
    size = "large",
    timeout = "eternal",
    srcs = ["test/multi_contact/testMultiContactPlanTracking.cpp"],
    copts = FIRST_PARTY_COPTS,
    data = [
        ":multi_contact_test_scenarios",
        "//humanoid_nmpc/humanoid_multi_contact/app:test_plans",
        "//humanoid_nmpc/humanoid_multi_contact/plans",
        "//humanoid_nmpc/humanoid_multi_contact/scenarios:scenario_files",
        "//robot_models/drc_atlas/drc_atlas_centroidal_mpc",
        "//robot_models/drc_atlas/drc_atlas_description",
    ],
    deps = [
        ":humanoid_centroidal_mpc",
        ":multi_contact_plan_loop",
        ":multi_contact_test_files",
        ":stair_step_plan",
        ":typed_config_support",
        "//humanoid_nmpc/humanoid_common_mpc",
        "//humanoid_nmpc/humanoid_common_mpc:status_test_macros",
        "//humanoid_nmpc/humanoid_multi_contact/plan:plan_file",
        "//humanoid_nmpc/humanoid_multi_contact/scenarios",
        "//humanoid_nmpc/humanoid_multi_contact/stability:certifier",
        "//robot_runtime/robot_core:resource_paths",
        "@abseil-cpp//absl/strings",
        "@eigen",
        "@googletest//:gtest_main",
        "@pinocchio",
    ],
)
