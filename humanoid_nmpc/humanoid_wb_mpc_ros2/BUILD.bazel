load("@rules_cc//cc:cc_binary.bzl", "cc_binary")
load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc//cc:cc_test.bzl", "cc_test")
# humanoid_wb_mpc_ros2 - ROS2 nodes for whole-body MPC

package(default_visibility = ["//visibility:public"])

_COMMON_DEPS = [
    "//humanoid_nmpc/humanoid_wb_mpc",
    "//humanoid_nmpc/humanoid_common_mpc",
    "//humanoid_nmpc/humanoid_common_mpc_ros2",
    "//robot_runtime/mujoco_sim_interface",
    "//lib/ocs2:ocs2_core",
    "//lib/ocs2:ocs2_ddp",
    "//lib/ocs2:ocs2_mpc",
    "//lib/ocs2:ocs2_sqp",
    "//lib/ocs2:ocs2_robotic_tools",
    "//lib/ocs2:ocs2_pinocchio_interface",
    "//lib/ocs2:ocs2_ros2_interfaces",
    "//lib/ocs2:ocs2_ros2_msgs",
    "@abseil-cpp//absl/log:log",
    "@abseil-cpp//absl/log:globals",
    "@eigen",
    "@boost",
    "@pinocchio",
    "@ros2_rclcpp",
    "@ros2_ament_index_cpp",
    "@ros2_tf2_ros",
    "@ros2_tf2_eigen",
    "@urdf",
    "@ros2_kdl_parser",
    "@ros2_visualization_msgs",
    "@ros2_geometry_msgs",
    "@ros2_sensor_msgs",
    "@ros2_std_msgs",
]

_COMMON_COPTS = [
    "-std=c++20",
    "-Wall",
    "-Wextra",
    "-Wpedantic",
    "-Werror=return-type",
    "-DBOOST_MPL_CFG_NO_PREPROCESSED_HEADERS",
    "-DBOOST_MPL_LIMIT_LIST_SIZE=50",
    "-DBOOST_VARIANT_LIMIT_TYPES=50",
    "-DBOOST_FUSION_INVOKE_MAX_ARITY=10",
]

# Dummy simulator node
cc_binary(
    name = "humanoid_wb_mpc_dummy_sim_node",
    srcs = ["src/WBMpcDummySimNode.cpp"],
    copts = _COMMON_COPTS,
    deps = _COMMON_DEPS,
)

# SQP MPC node
cc_binary(
    name = "humanoid_wb_mpc_sqp_node",
    srcs = ["src/WBMpcSqpNode.cpp"],
    copts = _COMMON_COPTS,
    deps = _COMMON_DEPS,
)

# The target of the pose command node, built by the whole-body target calculator. Free of ROS.
cc_library(
    name = "wb_mpc_pose_command",
    srcs = ["src/WBMpcPoseCommand.cpp"],
    hdrs = ["include/humanoid_wb_mpc_ros2/WBMpcPoseCommand.h"],
    includes = ["include"],
    copts = _COMMON_COPTS,
    deps = [
        "//humanoid_nmpc/humanoid_common_mpc",
        "//humanoid_nmpc/humanoid_wb_mpc",
        "//lib/ocs2:ocs2_core",
        "//lib/ocs2:ocs2_mpc",
        "@abseil-cpp//absl/status",
        "@abseil-cpp//absl/status:statusor",
        "@abseil-cpp//absl/strings",
    ],
)

# Pose command node
cc_binary(
    name = "humanoid_wb_mpc_pose_command_node",
    srcs = ["src/WBMpcPoseCommandNode.cpp"],
    copts = _COMMON_COPTS,
    deps = _COMMON_DEPS + [
        ":wb_mpc_pose_command",
        "@abseil-cpp//absl/log:check",
        "@abseil-cpp//absl/log:initialize",
        "@abseil-cpp//absl/status:statusor",
    ],
)

# The pose command's target on a raised ground, against the whole-body target calculator, and its missing-file errors.
# Builds no CppAD model.
cc_test(
    name = "testWBMpcPoseCommand",
    size = "small",
    srcs = ["test/testWBMpcPoseCommand.cpp"],
    copts = _COMMON_COPTS,
    data = [
        "//robot_models/unitree_g1/g1_description",
        "//robot_models/unitree_g1/g1_wb_mpc",
    ],
    deps = [
        ":wb_mpc_pose_command",
        "//humanoid_nmpc/humanoid_common_mpc",
        "//humanoid_nmpc/humanoid_wb_mpc",
        "//lib/ocs2:ocs2_core",
        "@abseil-cpp//absl/status",
        "@abseil-cpp//absl/status:statusor",
        "@abseil-cpp//absl/strings",
        "@googletest//:gtest_main",
    ],
)

# MuJoCo simulator
cc_binary(
    name = "humanoid_wb_mpc_sim",
    srcs = ["src/WBMpcRobotSim.cpp"],
    copts = _COMMON_COPTS,
    deps = _COMMON_DEPS + [
        "@abseil-cpp//absl/log:check",
        "@abseil-cpp//absl/log:initialize",
        "@glfw",
        "@glew",
    ],
)
