# The recording bus and publisher, the repository's files and the Tk skip (test/operator_test_support.py).
py_library(
    name = "test_support",
    testonly = True,
    srcs = ["test/operator_test_support.py"],
    imports = ["test"],
    deps = [
        ":remote_control",
        "//robot_runtime/robot_ipc:robot_ipc_py",
        requirement("protobuf"),
    ],
)

# The configuration of every robot (the tuning tabs load them, the coverage tests walk all of them) and the models.
_ROBOT_CONFIGS = [
    "//robot_models/drc_atlas/drc_atlas_centroidal_mpc",
    "//robot_models/engineai_sa01/engineai_sa01_centroidal_mpc",
    "//robot_models/unitree_g1/g1_centroidal_mpc",
    "//robot_models/unitree_g1/g1_wb_mpc",
    "//robot_models/unitree_r1/unitree_r1_centroidal_mpc",
]

_ROBOT_DESCRIPTIONS = [
    "//robot_models/drc_atlas/drc_atlas_description",
    "//robot_models/engineai_sa01/engineai_sa01_description",
    "//robot_models/unitree_g1/g1_description",
    "//robot_models/unitree_r1/unitree_r1_description",
]

_TEST_DEPS = [
    ":remote_control",
    ":test_support",
    requirement("pyyaml"),
]

# The Tk tests open withdrawn windows on the caller's display, or on an Xvfb of their own where there is none. They are
# skipped only where neither works, and fail instead on CI (the CI variable set), where a skip would pass them unrun
# (operator_test_support.py).
# LINT.IfChange(tk_environment)
_TK_ENV = [
    "CI",
    "DISPLAY",
]
