load("@operator_deps//:requirements.bzl", "requirement")
load("@protobuf//bazel:proto_library.bzl", "proto_library")
load("@protobuf//bazel:py_proto_library.bzl", "py_proto_library")
load("@rules_cc//cc:cc_binary.bzl", "cc_binary")
load("@rules_python//python:defs.bzl", "py_binary", "py_library", "py_test")
load("//bazel:copts.bzl", "FIRST_PARTY_COPTS")

# remote_control - the operator GUI (Tk) and the teleoperation publishers of the humanoid, on the IPC bus
# (humanoid_nmpc/docs/distributed_runtime/README.md). See README.md.
#
#   bazel run //humanoid_nmpc/remote_control:base_velocity_controller_gui -- --task_file=<task.textproto>
#   bazel run //humanoid_nmpc/remote_control:xbox_velocity_publisher
#   bazel run //humanoid_nmpc/remote_control:keyboard_velocity_publisher
#   bazel run //humanoid_nmpc/remote_control:push_robot_config -- <task, reference or joint PD gains textproto>

package(default_visibility = ["//visibility:public"])

# The hermetic interpreter must not import what a shell's PYTHONPATH points at: setup_env.sh puts robotpkg's Python 3.12
# bindings and directories of the checkout on it, and another copy of a package there would shadow this package and
# the generated messages (test_package_import_path.py checks it). `bazel run` and `bazel test` apply it; a launch file
# that runs the binary directly clears PYTHONPATH itself.
_HERMETIC_ENV = {"PYTHONPATH": ""}

# `import remote_control`: the package directory is remote_control/.
py_library(
    name = "remote_control",
    srcs = glob(["remote_control/**/*.py"]),
    imports = ["."],
    deps = [
        "//humanoid_nmpc/humanoid_mpc_config:config_py_proto",
        "//humanoid_nmpc/humanoid_mpc_config/python:textproto_document",
        "//humanoid_nmpc/humanoid_mpc_config/python:textproto_save",
        "//humanoid_nmpc/humanoid_mpc_ipc:topics_py",
        "//humanoid_nmpc/humanoid_mpc_msgs:messages_py_proto",
        "//robot_runtime/robot_ipc:robot_ipc_py",
        "//tools/nproto:nproto_schema",
        "//tools/nproto:nproto_textproto",
        "//tools/nproto:options_py_proto",
        requirement("protobuf"),
        requirement("pygame"),
    ],
)

# The binaries find the network file and the robot's files in the checkout (BUILD_WORKSPACE_DIRECTORY under `bazel
# run`); the network file is also data, for a binary started from its runfiles.
py_binary(
    name = "base_velocity_controller_gui",
    srcs = ["bin/base_velocity_controller_gui.py"],
    data = ["//config/ipc:network.textproto"],
    env = _HERMETIC_ENV,
    main = "bin/base_velocity_controller_gui.py",
    deps = [":remote_control"],
)

py_binary(
    name = "xbox_velocity_publisher",
    srcs = ["bin/xbox_velocity_publisher.py"],
    data = ["//config/ipc:network.textproto"],
    env = _HERMETIC_ENV,
    main = "bin/xbox_velocity_publisher.py",
    deps = [":remote_control"],
)

py_binary(
    name = "keyboard_velocity_publisher",
    srcs = ["bin/keyboard_velocity_publisher.py"],
    data = ["//config/ipc:network.textproto"],
    env = _HERMETIC_ENV,
    main = "bin/keyboard_velocity_publisher.py",
    deps = [":remote_control"],
)

# Sends a configuration file to the robot's store, as the GUI's Save does (remote_control/push_robot_config.py).
py_binary(
    name = "push_robot_config",
    srcs = ["bin/push_robot_config.py"],
    data = ["//config/ipc:network.textproto"],
    env = _HERMETIC_ENV,
    main = "bin/push_robot_config.py",
    deps = [":remote_control"],
)

