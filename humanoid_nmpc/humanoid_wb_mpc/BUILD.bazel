# End-effector dynamics whose kinematics are fixed affine maps of the state and the input (test/AffineEndEffectorDynamics.h),
# for the tests of the terms built on end-effector dynamics without a robot model or CppAD.
cc_library(
    name = "affine_end_effector_dynamics",
    testonly = True,
    hdrs = ["test/AffineEndEffectorDynamics.h"],
    copts = FIRST_PARTY_COPTS,
    deps = [
        ":humanoid_wb_mpc",
        "@abseil-cpp//absl/base:nullability",
    ],
)

# A numerical oracle for the time derivatives of the stance foot's orientation error (test/OrientationErrorRateOracle.h):
# the production error differenced along a motion of prescribed angular velocity and acceleration.
cc_library(
    name = "orientation_error_rate_oracle",
    testonly = True,
    srcs = ["test/OrientationErrorRateOracle.cpp"],
    hdrs = ["test/OrientationErrorRateOracle.h"],
    copts = FIRST_PARTY_COPTS,
    deps = [
        "//humanoid_nmpc/humanoid_common_mpc",
        "//lib/ocs2:ocs2_robotic_tools",
        "@eigen",
    ],
)

# The math of the stance foot's orientation rates (end_effector/OrientationErrorWrtPlaneRates.h), taped, generated and
# compiled as the end-effector dynamics' libraries are, against the oracle: level, tilted up to 80 degrees, steep (80
# degrees to 1 + v.n = 1e-2) and near the anti-parallel normal (to 1e-5); near the guard and inside it, the tape against
# its plain double instantiation; the level closed form, the guard's fallback and finite Jacobian, and the tape's
# Jacobian against its differences, entry by entry, rejecting a 1e-6 change of its maps. Compiles one small CppAD
# library.
cc_test(
    name = "testOrientationErrorWrtPlaneRates",
    size = "small",
    srcs = ["test/testOrientationErrorWrtPlaneRates.cpp"],
    copts = FIRST_PARTY_COPTS,
    deps = [
        ":humanoid_wb_mpc",
        ":orientation_error_rate_oracle",
        "//humanoid_nmpc/humanoid_common_mpc",
        "//lib/ocs2:ocs2_core",
        "@abseil-cpp//absl/base:nullability",
        "@abseil-cpp//absl/strings",
        "@abseil-cpp//absl/strings:str_format",
        "@eigen",
        "@googletest//:gtest_main",
    ],
)

# The orientation error with respect to a plane of ocs2_robotic_tools (rotationMatrixDistanceToPlane(),
# quaternionDistanceToPlane()): the closed form on random attitudes and planes, finite with a finite taped Jacobian where
# the end-effector normal points away from the plane (the shortest arc used to divide 0 by 0), continuous across the
# clamp of the shortest arc's norm, and its taped Jacobian against central differences. Tapes, compiles nothing.
cc_test(
    name = "testOrientationErrorWrtPlaneGuard",
    size = "small",
    srcs = ["test/testOrientationErrorWrtPlaneGuard.cpp"],
    copts = FIRST_PARTY_COPTS,
    deps = [
        "//humanoid_nmpc/humanoid_common_mpc",
        "//lib/ocs2:ocs2_core",
        "//lib/ocs2:ocs2_robotic_tools",
        "@abseil-cpp//absl/strings",
        "@eigen",
        "@googletest//:gtest_main",
    ],
)

# The whole-body stance-foot constraint on the G1 (ZeroAccelerationConstraintCppAd with the shipped gains): Pinocchio's
# frame rates are the derivatives along the robot's motion, the value is the PD law Kp e + Kd de/dt + Ka d2e/dt2
# assembled from double-precision kinematics and the oracle, the rescaled gains hold a level foot as the former law did,
# and the linearization is the derivative along the state manifold (rejecting a 1e-6 change and the frozen-map form).
# Large: it tapes and compiles the six end-effector dynamics libraries of one foot.
cc_test(
    name = "testStanceFootOrientationRates",
    size = "large",
    srcs = ["test/testStanceFootOrientationRates.cpp"],
    copts = FIRST_PARTY_COPTS,
    # LINT.IfChange(stance_foot_orientation_rates_test_data)
    data = [
        "//robot_models/unitree_g1/g1_description",
        "//robot_models/unitree_g1/g1_wb_mpc",
    ],
    # LINT.ThenChange(//humanoid_nmpc/humanoid_wb_mpc/test/testStanceFootOrientationRates.cpp:robot_files)
    deps = [
        ":humanoid_wb_mpc",
        ":orientation_error_rate_oracle",
        "//humanoid_nmpc/humanoid_common_mpc",
        "//lib/ocs2:ocs2_core",
        "//lib/ocs2:ocs2_pinocchio_interface",
        "//lib/ocs2:ocs2_robotic_tools",
        "@abseil-cpp//absl/base:nullability",
        "@abseil-cpp//absl/functional:function_ref",
        "@abseil-cpp//absl/status:statusor",
        "@abseil-cpp//absl/strings",
        "@abseil-cpp//absl/strings:str_format",
        "@eigen",
        "@googletest//:gtest_main",
        "@pinocchio",
    ],
)

