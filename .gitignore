.git-completion.bash
# Bazel
bazel-*
.bazel/
.bazel-cache/
MODULE.bazel.lock

# clangd's compilation database, written in the dev container (tools/ide/README.md), and the temporary file a refresh
# renames over it; the index is in .cache/clangd/.
# LINT.IfChange(compile_commands_file)
/compile_commands.json
/.compile_commands.*.tmp
# LINT.ThenChange(//tools/ide/compile_commands.py:compile_commands_file)

# CppAD generated code (runtime)
cppad_code_gen/
.env
cartpole_renders/

# Jupyter notebook checkpoints, wherever a notebook is opened
.ipynb_checkpoints/

# LINT.IfChange(robot_file_excludes)
*.bak
# LINT.ThenChange(//bazel/robot_files.bzl:robot_file_excludes)

# Local Bazel overrides (see .bazelrc, e.g. a higher --jobs on a machine with more RAM)
user.bazelrc

# The lock tools/bazel takes so that the builds of every container on the machine take turns
.bazel_machine.lock

# The lock the heavy steps of tools/hooks/lint_code.py (cpplint, pylint, mypy) take turns through, and mypy's cache
# LINT.IfChange(lint_lock)
.lint_machine.lock
# LINT.ThenChange(//tools/hooks/lint_code.py:lint_lock)
.mypy_cache/

# The robot deployment's working files: the bundle copied out of Bazel for docker build, and the PID of a launch
# target's laptop side (tools/deploy).
.deploy/
robot_config/
