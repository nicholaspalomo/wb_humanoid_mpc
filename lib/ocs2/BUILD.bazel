# PinocchioEndEffectorKinematics on a model whose configuration is larger than its velocity (an unbounded revolute joint,
# nq = 3, nv = 2): the frame Jacobians are sized by nv, and the linearizations are the derivatives of the values.
cc_test(
    name = "test_end_effector_kinematics_tangent_jacobians",
    size = "small",
    srcs = ["pinocchio/pinocchio_interface/test/testEndEffectorKinematicsTangentJacobians.cpp"],
    copts = _OCS2_COPTS,
    linkopts = _OCS2_LINKOPTS,
    deps = [
        ":ocs2_core",
        ":ocs2_pinocchio_interface",
        "@abseil-cpp//absl/base:nullability",
        "@eigen",
        "@googletest//:gtest_main",
        "@pinocchio",
    ],
)

