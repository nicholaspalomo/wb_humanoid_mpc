# ==============================================================================
# 14. ocs2_ros2_msgs (pre-generated headers + type support from colcon install)
# ==============================================================================

alias(
    name = "ocs2_ros2_msgs",
    actual = "@ocs2_ros2_msgs_repo//:ocs2_ros2_msgs",
)

# ==============================================================================
# 15. ocs2_ros2_interfaces
# ==============================================================================

cc_library(
    name = "ocs2_ros2_interfaces",
    srcs = glob(
        ["ros2_interfaces/src/**/*.cpp"],
        exclude = [
            "ros2_interfaces/src/**/test/**",
            "ros2_interfaces/src/lintTarget.cpp",
            "ros2_interfaces/src/multiplot/MultiplotRemap.cpp",
        ],
        allow_empty = True,
    ),
    hdrs = glob(["ros2_interfaces/include/**"], allow_empty = True),
    copts = _OCS2_COPTS,
    includes = ["ros2_interfaces/include"],
    linkopts = _OCS2_LINKOPTS,
    deps = [
        ":ocs2_core",
        ":ocs2_ddp",
        ":ocs2_oc",
        ":ocs2_mpc",
        ":ocs2_ros2_msgs",
        "@ros2_rclcpp",
        "@ros2_std_msgs",
        "@ros2_geometry_msgs",
        "@ros2_visualization_msgs",
        "@ros2_interactive_markers",
        "@eigen",
        "@boost",
    ],
)

# ==============================================================================
# Tests
# ==============================================================================

cc_test(
    name = "test_load_data_yaml",
    size = "small",
    srcs = ["core/test/misc/testLoadDataYaml.cpp"],
    copts = _OCS2_COPTS,
    data = glob(["core/test/misc/data/**"]),
    deps = [
        ":ocs2_core",
        "@eigen",
        "@boost",
        "@yaml_cpp",
        "@googletest//:gtest_main",
    ],
)
