# ==============================================================================
# OCS2 ROS2 Library - Native Bazel cc_library build
# ==============================================================================
#
# Each OCS2 sub-package is built as a native cc_library in topological
# dependency order. Source files use glob() for maintainability.
#
# Build order (dependency chain):
# 1. ocs2_thirdparty          (header-only)
# 2. ocs2_core                (depends on ocs2_thirdparty, Eigen, Boost, OpenMP)
# 3. ocs2_oc                  (depends on ocs2_core)
# 4. ocs2_robotic_tools       (depends on ocs2_oc)
# 5. ocs2_mpc                 (depends on ocs2_core, ocs2_oc)
# 6. ocs2_qp_solver           (depends on ocs2_core, ocs2_oc)
# 7. ocs2_ddp                 (depends on ocs2_core, ocs2_oc, ocs2_mpc, ocs2_qp_solver)
# 8. blasfeo_catkin            (cmake() - downloads external C lib)
# 9. hpipm_catkin              (cmake() - depends on blasfeo)
# 10. ocs2_sqp                 (depends on ocs2_core, ocs2_mpc, ocs2_qp_solver, hpipm)
# 11. ocs2_pinocchio_interface  (depends on ocs2_core, ocs2_robotic_tools, Pinocchio)
# 12. ocs2_centroidal_model     (depends on ocs2_pinocchio_interface)
# 13. ocs2_self_collision        (depends on ocs2_pinocchio_interface)
# 14. ocs2_ros2_msgs            (pre-generated headers + type support libs)
# 15. ocs2_ros2_interfaces      (depends on ocs2_core, ocs2_ddp, ocs2_mpc, ocs2_ros2_msgs)

load("@rules_cc//cc:cc_library.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

# ==============================================================================
# Shared compile options for all OCS2 packages
# ==============================================================================

_OCS2_COPTS = [
    "-std=c++20",
    "-pthread",
    "-Wfatal-errors",
    "-DBOOST_ALL_DYN_LINK",
    "-fopenmp",
    "-Wno-ignored-attributes",
    "-fPIC",
]

_OCS2_LINKOPTS = [
    "-lpthread",
    "-ldl",
    "-fopenmp",
]

# Pinocchio-specific compile options
_PINOCCHIO_COPTS = _OCS2_COPTS + [
    "-DPINOCCHIO_URDFDOM_TYPEDEF_SHARED_PTR",
    "-DPINOCCHIO_URDFDOM_USE_STD_SHARED_PTR",
]

# ==============================================================================
# 1. ocs2_thirdparty (header-only)
# ==============================================================================

cc_library(
    name = "ocs2_thirdparty",
    hdrs = glob(["ocs2_thirdparty/include/**"]),
    includes = ["ocs2_thirdparty/include"],
)

# ==============================================================================
# 2. ocs2_core
# ==============================================================================

cc_library(
    name = "ocs2_core",
    srcs = glob(
        ["ocs2_core/src/**/*.cpp"],
        exclude = ["ocs2_core/src/**/test/**", "ocs2_core/src/lintTarget.cpp"],
    ),
    hdrs = glob(["ocs2_core/include/**"]),
    copts = _OCS2_COPTS,
    includes = ["ocs2_core/include"],
    linkopts = _OCS2_LINKOPTS,
    deps = [
        ":ocs2_thirdparty",
        "@eigen",
        "@boost",
    ],
)

# ==============================================================================
# 3. ocs2_oc
# ==============================================================================

cc_library(
    name = "ocs2_oc",
    srcs = glob(
        ["ocs2_oc/src/**/*.cpp"],
        exclude = ["ocs2_oc/src/**/test/**", "ocs2_oc/src/lintTarget.cpp"],
    ),
    hdrs = glob(["ocs2_oc/include/**"]),
    copts = _OCS2_COPTS,
    includes = ["ocs2_oc/include"],
    linkopts = _OCS2_LINKOPTS,
    deps = [
        ":ocs2_core",
        ":ocs2_thirdparty",
        "@eigen",
        "@boost",
    ],
)

# ==============================================================================
# 4. ocs2_robotic_tools
# ==============================================================================

cc_library(
    name = "ocs2_robotic_tools",
    srcs = glob(
        ["ocs2_robotic_tools/src/**/*.cpp"],
        exclude = ["ocs2_robotic_tools/src/**/test/**", "ocs2_robotic_tools/src/lintTarget.cpp"],
    ),
    hdrs = glob(["ocs2_robotic_tools/include/**"]),
    copts = _OCS2_COPTS,
    includes = ["ocs2_robotic_tools/include"],
    linkopts = _OCS2_LINKOPTS,
    deps = [
        ":ocs2_core",
        ":ocs2_oc",
        ":ocs2_thirdparty",
        "@eigen",
        "@boost",
    ],
)

# ==============================================================================
# 5. ocs2_mpc
# ==============================================================================

cc_library(
    name = "ocs2_mpc",
    srcs = glob(
        ["ocs2_mpc/src/**/*.cpp"],
        exclude = ["ocs2_mpc/src/**/test/**", "ocs2_mpc/src/lintTarget.cpp"],
    ),
    hdrs = glob(["ocs2_mpc/include/**"]),
    copts = _OCS2_COPTS,
    includes = ["ocs2_mpc/include"],
    linkopts = _OCS2_LINKOPTS,
    deps = [
        ":ocs2_core",
        ":ocs2_oc",
        "@eigen",
        "@boost",
    ],
)

# ==============================================================================
# 6. ocs2_qp_solver
# ==============================================================================

cc_library(
    name = "ocs2_qp_solver",
    srcs = glob(
        ["ocs2_test_tools/ocs2_qp_solver/src/**/*.cpp"],
        exclude = ["ocs2_test_tools/ocs2_qp_solver/src/**/test/**"],
    ),
    hdrs = glob(["ocs2_test_tools/ocs2_qp_solver/include/**"]),
    copts = _OCS2_COPTS,
    includes = ["ocs2_test_tools/ocs2_qp_solver/include"],
    linkopts = _OCS2_LINKOPTS,
    deps = [
        ":ocs2_core",
        ":ocs2_oc",
        "@eigen",
        "@boost",
    ],
)

# ==============================================================================
# 7. ocs2_ddp
# ==============================================================================

cc_library(
    name = "ocs2_ddp",
    srcs = glob(
        ["ocs2_ddp/src/**/*.cpp"],
        exclude = [
            "ocs2_ddp/src/**/test/**",
            "ocs2_ddp/src/unsupported/**",
            "ocs2_ddp/src/DDP_DataCollector.cpp",
            "ocs2_ddp/src/lintTarget.cpp",
        ],
    ),
    hdrs = glob(
        ["ocs2_ddp/include/**"],
        exclude = [
            "ocs2_ddp/include/**/unsupported/**",
            "ocs2_ddp/include/**/DDP_DataCollector.h",
        ],
    ),
    copts = _OCS2_COPTS,
    includes = ["ocs2_ddp/include"],
    linkopts = _OCS2_LINKOPTS,
    deps = [
        ":ocs2_core",
        ":ocs2_oc",
        ":ocs2_mpc",
        ":ocs2_qp_solver",
        "@eigen",
        "@boost",
    ],
)

# ==============================================================================
# 8-9. blasfeo + hpipm: provided as @blasfeo and @hpipm system repos
# ==============================================================================

# ==============================================================================
# 10. ocs2_sqp
# ==============================================================================

cc_library(
    name = "ocs2_sqp",
    srcs = glob(
        ["ocs2_sqp/ocs2_sqp/src/**/*.cpp"],
        exclude = ["ocs2_sqp/ocs2_sqp/src/**/test/**"],
    ),
    hdrs = glob(["ocs2_sqp/ocs2_sqp/include/**"]),
    copts = _OCS2_COPTS,
    includes = ["ocs2_sqp/ocs2_sqp/include"],
    linkopts = _OCS2_LINKOPTS,
    deps = [
        ":ocs2_core",
        ":ocs2_oc",
        ":ocs2_mpc",
        ":ocs2_qp_solver",
        "@blasfeo",
        "@hpipm",
        "@eigen",
        "@boost",
    ],
)

# ==============================================================================
# 11. ocs2_pinocchio_interface
# ==============================================================================

cc_library(
    name = "ocs2_pinocchio_interface",
    srcs = glob(
        ["ocs2_pinocchio/ocs2_pinocchio_interface/src/**/*.cpp"],
        exclude = ["ocs2_pinocchio/ocs2_pinocchio_interface/src/**/test/**"],
    ),
    hdrs = glob(["ocs2_pinocchio/ocs2_pinocchio_interface/include/**"]),
    copts = _PINOCCHIO_COPTS,
    includes = ["ocs2_pinocchio/ocs2_pinocchio_interface/include"],
    linkopts = _OCS2_LINKOPTS,
    deps = [
        ":ocs2_core",
        ":ocs2_oc",
        ":ocs2_robotic_tools",
        ":ocs2_thirdparty",
        "@pinocchio",
        "@urdf",
        "@eigen",
        "@boost",
    ],
)

# ==============================================================================
# 12. ocs2_centroidal_model
# ==============================================================================

cc_library(
    name = "ocs2_centroidal_model",
    srcs = glob(
        ["ocs2_pinocchio/ocs2_centroidal_model/src/**/*.cpp"],
        exclude = ["ocs2_pinocchio/ocs2_centroidal_model/src/**/test/**"],
    ),
    hdrs = glob(["ocs2_pinocchio/ocs2_centroidal_model/include/**"]),
    copts = _PINOCCHIO_COPTS,
    includes = ["ocs2_pinocchio/ocs2_centroidal_model/include"],
    linkopts = _OCS2_LINKOPTS,
    deps = [
        ":ocs2_core",
        ":ocs2_robotic_tools",
        ":ocs2_pinocchio_interface",
        "@pinocchio",
        "@urdf",
        "@eigen",
        "@boost",
    ],
)

# ==============================================================================
# 13. ocs2_self_collision (DISABLED - requires hpp-fcl, replaced by coal in Jazzy)
# ==============================================================================
# Not used by any downstream humanoid_nmpc package.
# To re-enable: port from hpp-fcl to coal API.

# ==============================================================================
# 14. ocs2_ros2_msgs (pre-generated headers + type support from colcon install)
# ==============================================================================

cc_library(
    name = "ocs2_ros2_msgs",
    hdrs = glob(["ocs2_ros2_msgs/generated/**/*.hpp"]),
    includes = ["ocs2_ros2_msgs/generated"],
    linkopts = [
        "-L/wb_humanoid_mpc_ws/install/ocs2_ros2_msgs/lib",
        "-locs2_ros2_msgs__rosidl_typesupport_cpp",
        "-locs2_ros2_msgs__rosidl_generator_c",
    ],
    deps = [
        "@ros2_std_msgs",
        "@ros2_geometry_msgs",
        "@ros2_rosidl",
    ],
)

# ==============================================================================
# 15. ocs2_ros2_interfaces
# ==============================================================================

cc_library(
    name = "ocs2_ros2_interfaces",
    srcs = glob(
        ["ocs2_ros2_interfaces/src/**/*.cpp"],
        exclude = [
            "ocs2_ros2_interfaces/src/**/test/**",
            "ocs2_ros2_interfaces/src/lintTarget.cpp",
            "ocs2_ros2_interfaces/src/multiplot/MultiplotRemap.cpp",
        ],
    ),
    hdrs = glob(["ocs2_ros2_interfaces/include/**"]),
    copts = _OCS2_COPTS,
    includes = ["ocs2_ros2_interfaces/include"],
    linkopts = _OCS2_LINKOPTS,
    deps = [
        ":ocs2_core",
        ":ocs2_ddp",
        ":ocs2_oc",
        ":ocs2_mpc",
        ":ocs2_ros2_msgs",
        "@ros2_rclcpp",
        "@ros2_std_msgs",
        "@ros2_geometry_msgs",
        "@ros2_visualization_msgs",
        "@ros2_interactive_markers",
        "@eigen",
        "@boost",
    ],
)
