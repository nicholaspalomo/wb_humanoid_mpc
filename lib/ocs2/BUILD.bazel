# ==============================================================================
# OCS2 Library - Native Bazel cc_library build (monorepo layout)
# ==============================================================================
#
# Flattened directory layout: lib/ocs2/<package>/
#   core/          (was ocs2_core)
#   oc/            (was ocs2_oc)
#   ddp/           (was ocs2_ddp)
#   sqp/sqp/       (was ocs2_sqp/ocs2_sqp)
#   mpc/           (was ocs2_mpc)
#   robotic_tools/ (was ocs2_robotic_tools)
#   thirdparty/    (was ocs2_thirdparty)
#   test_tools/qp_solver/ (was ocs2_test_tools/ocs2_qp_solver)
#   pinocchio/pinocchio_interface/ (was ocs2_pinocchio/ocs2_pinocchio_interface)
#   pinocchio/centroidal_model/    (was ocs2_pinocchio/ocs2_centroidal_model)

load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc//cc:cc_test.bzl", "cc_test")

package(default_visibility = ["//visibility:public"])

# ==============================================================================
# Shared compile options for all OCS2 packages
# ==============================================================================

_OCS2_COPTS = [
    "-std=c++20",
    "-pthread",
    "-fopenmp",
    "-Wno-ignored-attributes",
    "-fPIC",
]

_OCS2_LINKOPTS = [
    "-lpthread",
    "-ldl",
    "-fopenmp",
]

# ==============================================================================
# 1. ocs2_thirdparty (header-only)
# ==============================================================================

cc_library(
    name = "ocs2_thirdparty",
    hdrs = glob(["thirdparty/include/**"], allow_empty = True),
    includes = ["thirdparty/include"],
)

# ==============================================================================
# 2. ocs2_core_types and ocs2_core
# ==============================================================================

# The value types of ocs2_core (scalar_t, vector_t, matrix_t and the function approximations) and the linear algebra
# their checks use, with nothing but Eigen: no CppAD, no integrators, no YAML. Code that needs only the types, such as
# the state estimator, depends on this rather than on ocs2_core, which re-exports it.
_OCS2_CORE_TYPES_SRCS = [
    "core/src/Types.cpp",
    "core/src/misc/LinearAlgebra.cpp",
]

_OCS2_CORE_TYPES_HDRS = [
    "core/include/ocs2_core/NumericTraits.h",
    "core/include/ocs2_core/Types.h",
    "core/include/ocs2_core/misc/LinearAlgebra.h",
    "core/include/ocs2_core/misc/randomMatrices.h",
]

cc_library(
    name = "ocs2_core_types",
    srcs = _OCS2_CORE_TYPES_SRCS,
    hdrs = _OCS2_CORE_TYPES_HDRS,
    copts = _OCS2_COPTS,
    includes = ["core/include"],
    linkopts = _OCS2_LINKOPTS,
    deps = ["@eigen"],
)

cc_library(
    name = "ocs2_core",
    srcs = glob(
        ["core/src/**/*.cpp"],
        exclude = ["core/src/**/test/**"] + _OCS2_CORE_TYPES_SRCS,
        allow_empty = True,
    ),
    hdrs = glob(
        ["core/include/**"],
        exclude = _OCS2_CORE_TYPES_HDRS,
        allow_empty = True,
    ),
    copts = _OCS2_COPTS,
    includes = ["core/include"],
    linkopts = _OCS2_LINKOPTS,
    deps = [
        ":ocs2_core_types",
        ":ocs2_thirdparty",
        "@abseil-cpp//absl/log:check",
        "@abseil-cpp//absl/status",
        "@abseil-cpp//absl/status:statusor",
        "@abseil-cpp//absl/strings",
        "@eigen",
        "@yaml_cpp",
    ],
)

