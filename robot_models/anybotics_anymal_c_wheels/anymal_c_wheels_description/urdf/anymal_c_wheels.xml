              <geom name="RH_wheel_collision" class="wheel_collision"/>
              <site name="RH_wheel_center"/>
            </body>
          </body>
        </body>
      </body>
    </body>
  </worldbody>

  <contact>
    <exclude body1="base" body2="LF_THIGH"/>
    <exclude body1="base" body2="RF_THIGH"/>
    <exclude body1="base" body2="LH_THIGH"/>
    <exclude body1="base" body2="RH_THIGH"/>
  </contact>

  <!-- One torque motor per joint (gear 1): the simulator writes each joint's torque into its ctrl, limited to the
       URDF's effort (80 N m on every joint, wheels included). -->
  <actuator>
    <motor name="LF_HAA" joint="LF_HAA" ctrlrange="-80 80" forcerange="-80 80"/>
    <motor name="LF_HFE" joint="LF_HFE" ctrlrange="-80 80" forcerange="-80 80"/>
    <motor name="LF_KFE" joint="LF_KFE" ctrlrange="-80 80" forcerange="-80 80"/>
    <motor name="LF_wheel" joint="LF_wheel" ctrlrange="-80 80" forcerange="-80 80"/>
    <motor name="RF_HAA" joint="RF_HAA" ctrlrange="-80 80" forcerange="-80 80"/>
    <motor name="RF_HFE" joint="RF_HFE" ctrlrange="-80 80" forcerange="-80 80"/>
    <motor name="RF_KFE" joint="RF_KFE" ctrlrange="-80 80" forcerange="-80 80"/>
    <motor name="RF_wheel" joint="RF_wheel" ctrlrange="-80 80" forcerange="-80 80"/>
    <motor name="LH_HAA" joint="LH_HAA" ctrlrange="-80 80" forcerange="-80 80"/>
    <motor name="LH_HFE" joint="LH_HFE" ctrlrange="-80 80" forcerange="-80 80"/>
    <motor name="LH_KFE" joint="LH_KFE" ctrlrange="-80 80" forcerange="-80 80"/>
    <motor name="LH_wheel" joint="LH_wheel" ctrlrange="-80 80" forcerange="-80 80"/>
    <motor name="RH_HAA" joint="RH_HAA" ctrlrange="-80 80" forcerange="-80 80"/>
    <motor name="RH_HFE" joint="RH_HFE" ctrlrange="-80 80" forcerange="-80 80"/>
    <motor name="RH_KFE" joint="RH_KFE" ctrlrange="-80 80" forcerange="-80 80"/>
    <motor name="RH_wheel" joint="RH_wheel" ctrlrange="-80 80" forcerange="-80 80"/>
  </actuator>

  <!-- Virtual gantry. A real weld the constraint solver satisfies inside mj_step, so the base is supported
       WHILE the dynamics are integrated. MujocoSimInterface drives eq_active from the lock state and writes
       the suspension height into the relpose translation, so the values here are only a starting point. -->
  <equality>
    <weld name="gantry" body1="world" body2="base" relpose="0 0 0.7 1 0 0 0" active="false"/>
  </equality>
</mujoco>
