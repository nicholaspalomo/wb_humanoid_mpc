<mujoco model="anymal_c_wheels">
  <!-- The wheeled ANYmal C of LuanDev3/anymal_with_wheels (BSD-3-Clause, LICENSE beside urdf/), written for this
       repository from urdf/anymal_c_wheels.urdf: one body per moving URDF link at the URDF's link frame, each with the
       URDF's inertial lumped with those of its fixed children as Pinocchio lumps them, the URDF's collision
       primitives and the meshes of ANYbotics' anymal_c_simple_description. README.md beside urdf/ lists every
       difference from the URDF. -->
  <default>
    <default class="anymal_c_wheels">
      <site group="3" size="0.005" rgba="1 0 0 0.66"/>
      <joint type="hinge" damping="2"/>
      <!-- The wheel hinges spin freely: no range, and the light damping of a bearing. -->
      <default class="wheel">
        <joint limited="false" damping="0.1"/>
      </default>
      <!-- Visual-only geoms: no collision, group 1 for rendering. -->
      <default class="visual">
        <geom type="mesh" contype="0" conaffinity="0" group="1" density="0"/>
      </default>
      <!-- Collision geoms: the URDF's primitives with the contact parameters of the other robots' collision class. -->
      <default class="collision">
        <geom group="2" rgba="0.5 0.5 0.5 0.3" density="0" friction="1.0 0.005 0.0001" solimp="0.95 0.99 0.001"
              solref="0.004 1.0"/>
        <!-- One cylinder per wheel, coaxial with the wheel joint (y) and centered at the wheel center, the origin of
             the wheel link: the rolling contact's wheel, radius 0.098 m and width 0.04 m as in the URDF. -->
        <default class="wheel_collision">
          <geom type="cylinder" size="0.098 0.02" quat="0.707106781 0.707106781 0 0" priority="1" condim="3"
                rgba="0.1 0.1 0.1 1"/>
        </default>
      </default>
    </default>
  </default>
  <compiler angle="radian" meshdir="../meshes"/>
  <option timestep="0.001" gravity="0 0 -9.81"/>

  <statistic center="0 0 0.4" extent="1.2"/>
  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.1 0.1 0.1" specular="0.9 0.9 0.9"/>
