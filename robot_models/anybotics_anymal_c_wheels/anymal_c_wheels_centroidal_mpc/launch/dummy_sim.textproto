# proto-file: tools/launch/proto/launch_file.proto
# proto-message: launch_proto.LaunchFile
#
# The wheeled ANYbotics ANYmal C, centroidal MPC against the dummy simulator: the MPC node, the robot played by the rollout of the
# MPC's own model (no MuJoCo) as the bus node "robot", the remote-control GUI and the Rerun bridge, all on the laptop.
#
#   make launch-anymal-c-wheels-dummy-sim
#   bazel run //tools/launch -- robot_models/anybotics_anymal_c_wheels/anymal_c_wheels_centroidal_mpc/launch/dummy_sim.textproto

variables { name: "bin_dir" value: ".bazel/bin" }
variables { name: "robot_dir" value: "robot_models/anybotics_anymal_c_wheels" }
variables { name: "config_dir" value: "{robot_dir}/anymal_c_wheels_centroidal_mpc/config" }
variables { name: "task_file" value: "{config_dir}/mpc/task.textproto" }
variables { name: "reference_file" value: "{config_dir}/command/reference.textproto" }
variables { name: "urdf_file" value: "{robot_dir}/anymal_c_wheels_description/urdf/anymal_c_wheels.urdf" }
# The wheeled quadrupeds' gaits and their switching table: stance and drive on four wheels, and a trot to turn.
# LINT.IfChange(gait_file)
variables { name: "gait_file" value: "legged_nmpc/legged_common_mpc/config/command/wheeled_quadruped_gait.textproto" }
# LINT.ThenChange(//legged_nmpc/legged_centroidal_mpc/test/support/ShippedCentroidalRobot.cpp:wheeled_quadruped_gait_file, //legged_nmpc/legged_common_mpc/test/config/testConfigRoots.cpp:wheeled_quadruped_gait_file, //robot_models/anybotics_anymal_c_wheels/anymal_c_wheels_centroidal_mpc/launch/mpc.textproto:gait_file, //legged_nmpc/legged_mpc_validation/src/closed_loop/RobotConfiguration.cpp:wheeled_quadruped_gait_file)
# The bus's network file: the shipped one is every node on this machine (config/ipc/network.textproto).
variables { name: "network_file" value: "config/ipc/network.textproto" }
# The Rerun bridge's sink, by name (legged_nmpc/legged_rerun_viewer/README.md): spawn, connect, serve_web, save;
# save writes the recording to rrd_path.
variables { name: "rerun_sink" value: "serve_web" }
variables { name: "rrd_path" value: "" }
variables { name: "plot_config" value: "legged_nmpc/legged_rerun_viewer/config/plot_config.textproto" }
# Whether the GUI publishes the walking command: publish, or off to leave it to a teleoperation publisher
# (legged_nmpc/remote_control/README.md).
variables { name: "gui_walking_commands" value: "publish" }

# The processes: their binaries are those the Makefile's launch target of this file builds first.
# LINT.IfChange(processes)
processes {
  name: "mpc"
  machine: MACHINE_LAPTOP
  command: [
    "{bin_dir}/legged_nmpc/legged_centroidal_mpc_app/legged_centroidal_mpc_node",
    "--robot_name=anymal_c_wheels",
    "--task_file={task_file}",
    "--reference_file={reference_file}",
    "--urdf_file={urdf_file}",
    "--gait_file={gait_file}",
    "--network_config={network_file}"
  ]
  required: true
}

processes {
  name: "dummy_sim"
  machine: MACHINE_LAPTOP
  command: [
    "{bin_dir}/legged_nmpc/legged_centroidal_mpc_app/legged_centroidal_mpc_dummy_sim",
    "--robot_name=anymal_c_wheels",
    "--task_file={task_file}",
    "--reference_file={reference_file}",
    "--urdf_file={urdf_file}",
    "--network_config={network_file}"
  ]
  required: true
}

processes {
  name: "gui"
  machine: MACHINE_LAPTOP
  command: [
    "{bin_dir}/legged_nmpc/remote_control/base_velocity_controller_gui",
    "--task_file={task_file}",
    "--reference_file={reference_file}",
    "--urdf_file={urdf_file}",
    "--walking_commands={gui_walking_commands}",
    "--network_config={network_file}"
  ]
  delay: 1.0
}

processes {
  name: "rerun"
  machine: MACHINE_LAPTOP
  command: [
    "{bin_dir}/legged_nmpc/legged_rerun_viewer/legged_rerun_viewer",
    "--urdf={urdf_file}",
    "--network_config={network_file}",
    "--rerun_sink={rerun_sink}",
    "--rrd_path={rrd_path}",
    "--plot_config={plot_config}"
  ]
}
# LINT.ThenChange(//Makefile:launch_binaries)
