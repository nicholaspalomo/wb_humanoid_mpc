# proto-file: legged_nmpc/legged_mpc_config/joint_pd_gains_file.proto
# proto-message: legged_mpc_config.JointPdGainsFile
# Wheeled ANYbotics ANYmal C (16-DoF) joint proportional and derivative (PD) controller gains.
# Units: Kp in [N*m/rad], Kd in [N*m*s/rad]
# The leg joints get the gains of ANYmal B's legs, which hold them while the MPC is off (JOINT_PD) and stiffen the
# MPC's feedforward torques against its joint targets. A wheel has no position to hold: its angle has no reference, so
# its kp is 0 and its kd damps its speed toward the MPC's wheel velocity, with the MPC's feedforward torque on top.
# robot_models/tests/test_joint_pd_stability.py checks that the explicit PD is stable at the simulator's step with the
# joint damping of urdf/anymal_c_wheels.xml; a wheel's kd must stay below about 9 N m s/rad there
# (robot_models/anybotics_anymal_c_wheels/anymal_c_wheels_description/README.md, "The MuJoCo model"). The wheels' kd of
# 4 N m s/rad is from the closed-loop runs (legged_mpc_validation, label 2026-11-12_anymal_c_wheels): at 1 N m s/rad
# the 0.5 m/s drive held 0.488 m/s, at 4 N m s/rad 0.496 m/s; a turning trot with no four-wheel phase fell at
# 8 N m s/rad.

# max_joint_torque is read by the MRT joint controller, which clamps the commanded feedforward torque of every joint against
# it, in every mode; a joint this file does not name gets default_gains' limit, which default_gains must set (the
# controller has no gains of its own). 80 N m is the URDF's effort limit of every joint, the wheels included, and the
# MuJoCo motors' forcerange, so the controller and the simulator agree on what each actuator can deliver.
default_gains {
  kp: 400.0
  kd: 10.0
  max_joint_torque: 80.0
}
# Left front leg
joint_gains { joint: "LF_HAA" kp: 400.0 kd: 10.0 max_joint_torque: 80.0 }
joint_gains { joint: "LF_HFE" kp: 400.0 kd: 10.0 max_joint_torque: 80.0 }
joint_gains { joint: "LF_KFE" kp: 400.0 kd: 10.0 max_joint_torque: 80.0 }
joint_gains { joint: "LF_wheel" kp: 0.0 kd: 4.0 max_joint_torque: 80.0 }

# Right front leg
joint_gains { joint: "RF_HAA" kp: 400.0 kd: 10.0 max_joint_torque: 80.0 }
joint_gains { joint: "RF_HFE" kp: 400.0 kd: 10.0 max_joint_torque: 80.0 }
joint_gains { joint: "RF_KFE" kp: 400.0 kd: 10.0 max_joint_torque: 80.0 }
joint_gains { joint: "RF_wheel" kp: 0.0 kd: 4.0 max_joint_torque: 80.0 }

# Left hind leg
joint_gains { joint: "LH_HAA" kp: 400.0 kd: 10.0 max_joint_torque: 80.0 }
joint_gains { joint: "LH_HFE" kp: 400.0 kd: 10.0 max_joint_torque: 80.0 }
joint_gains { joint: "LH_KFE" kp: 400.0 kd: 10.0 max_joint_torque: 80.0 }
joint_gains { joint: "LH_wheel" kp: 0.0 kd: 4.0 max_joint_torque: 80.0 }

# Right hind leg
joint_gains { joint: "RH_HAA" kp: 400.0 kd: 10.0 max_joint_torque: 80.0 }
joint_gains { joint: "RH_HFE" kp: 400.0 kd: 10.0 max_joint_torque: 80.0 }
joint_gains { joint: "RH_KFE" kp: 400.0 kd: 10.0 max_joint_torque: 80.0 }
joint_gains { joint: "RH_wheel" kp: 0.0 kd: 4.0 max_joint_torque: 80.0 }
