# proto-file: tools/launch/proto/launch_file.proto
# proto-message: launch_proto.LaunchFile
#
# The laptop side of ANYbotics ANYmal B, centroidal MPC: the MPC node, the remote-control GUI and the Rerun bridge
# (humanoid_nmpc/docs/distributed_runtime/README.md). The robot side is robot.textproto, as a separate process on the
# robot's computer or, in simulation, in the robot-sim container on this one.
#
#   make launch-anymal-b-sim    # with the robot side in the robot-sim container
#   make launch-anymal-b-mpc NETWORK=<network file>    # against the robot of the network file
#   bazel run //tools/launch -- robot_models/anybotics_anymal_b/anymal_b_centroidal_mpc/launch/mpc.textproto --set network_file=<file>

variables { name: "bin_dir" value: ".bazel/bin" }
variables { name: "robot_dir" value: "robot_models/anybotics_anymal_b" }
variables { name: "config_dir" value: "{robot_dir}/anymal_b_centroidal_mpc/config" }
variables { name: "task_file" value: "{config_dir}/mpc/task.textproto" }
variables { name: "reference_file" value: "{config_dir}/command/reference.textproto" }
variables { name: "urdf_file" value: "{robot_dir}/anymal_b_description/urdf/anymal_b.urdf" }
# The shared quadruped gaits and their switching table (stance, trot, standing_trot, ...).
# LINT.IfChange(gait_file)
variables { name: "gait_file" value: "humanoid_nmpc/humanoid_common_mpc/config/command/quadruped_gait.textproto" }
# LINT.ThenChange(//humanoid_nmpc/humanoid_mpc_validation/src/closed_loop/RobotConfiguration.cpp:quadruped_gait_file, //humanoid_nmpc/humanoid_centroidal_mpc/test/support/ShippedCentroidalRobot.cpp:anymal_b_gait_file, //humanoid_nmpc/humanoid_common_mpc/test/config/testConfigRoots.cpp:quadruped_gait_file, //robot_models/anybotics_anymal_b/anymal_b_centroidal_mpc/launch/dummy_sim.textproto:gait_file)
# The bus's network file: the shipped one is every node on this machine (config/ipc/network.textproto).
variables { name: "network_file" value: "config/ipc/network.textproto" }
# The Rerun bridge's sink, by name (humanoid_nmpc/humanoid_rerun_viewer/README.md): spawn, connect, serve_web, save;
# save writes the recording to rrd_path.
variables { name: "rerun_sink" value: "serve_web" }
variables { name: "rrd_path" value: "" }
variables { name: "plot_config" value: "humanoid_nmpc/humanoid_rerun_viewer/config/plot_config.textproto" }
# Whether the GUI publishes the walking command: publish, or off to leave it to a teleoperation publisher
# (humanoid_nmpc/remote_control/README.md).
variables { name: "gui_walking_commands" value: "publish" }

# The processes: their binaries are those the Makefile's launch target of this file builds first.
# LINT.IfChange(processes)
processes {
  name: "mpc"
  machine: MACHINE_LAPTOP
  command: [
    "{bin_dir}/humanoid_nmpc/humanoid_centroidal_mpc_app/humanoid_centroidal_mpc_node",
    "--robot_name=anymal_b",
    "--task_file={task_file}",
    "--reference_file={reference_file}",
    "--urdf_file={urdf_file}",
    "--gait_file={gait_file}",
    "--network_config={network_file}"
  ]
  required: true
}

processes {
  name: "gui"
  machine: MACHINE_LAPTOP
  command: [
    "{bin_dir}/humanoid_nmpc/remote_control/base_velocity_controller_gui",
    "--task_file={task_file}",
    "--reference_file={reference_file}",
    "--urdf_file={urdf_file}",
    "--walking_commands={gui_walking_commands}",
    "--network_config={network_file}"
  ]
  delay: 1.0
}

processes {
  name: "rerun"
  machine: MACHINE_LAPTOP
  command: [
    "{bin_dir}/humanoid_nmpc/humanoid_rerun_viewer/humanoid_rerun_viewer",
    "--urdf={urdf_file}",
    "--network_config={network_file}",
    "--rerun_sink={rerun_sink}",
    "--rrd_path={rrd_path}",
    "--plot_config={plot_config}"
  ]
}
# LINT.ThenChange(//Makefile:launch_binaries)
