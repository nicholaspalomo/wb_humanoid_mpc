# proto-file: legged_nmpc/legged_mpc_config/reference_file.proto
# proto-message: legged_mpc_config.ReferenceFile
ref_speed_base_rt_world: 0.5
ref_rate_yaw_base_rt_world: 0.5

# The command limits sit above the closed-loop validation's commands, a 0.5 m/s trot and a 0.5 rad/s turn in place, so
# that neither saturates.
cmd_max_linvel_base_rt_world_ewrt_heading_x: 1.0
cmd_max_linvel_base_rt_world_ewrt_heading_y: 0.5
cmd_max_err_pos_base_rt_surface_ewrt_world_z: 0.2
cmd_max_angvel_base_rt_world_ewrt_world_z: 1.0
# First-order low-pass filter on the operator's velocity command, run on the solver time ahead of the acceleration
# ramps: break frequency f_c [Hz], time constant 1 / (2 pi f_c). 0 switches it off and the command passes through
# unchanged, as on every other robot.
velocity_command_filter_break_frequency: 0.0  # [Hz] command low-pass filter, 0 = off
target_joint_state_interpolation_time_constant: 0.5

# The base height of the default posture standing on flat ground: the four FOOT frames on the ground at the joint
# angles below, by the URDF's forward kinematics (0.509697 m; robot_models/tests/test_default_stance.py checks it).
nom_pos_base_rt_surface_ewrt_world_z: 0.5097
# The default posture of the OCS2 legged_robot example's ANYmal C (task.info, initialState): the hip abduction HAA
# signed by side (-0.25 rad on the left, +0.25 rad on the right), the hip and knee flexion HFE and KFE signed front
# against hind (+0.6 / -0.85 rad on the front legs, -0.6 / +0.85 rad on the hind legs). ANYmal B's joints have the same
# axes (HAA about x, HFE and KFE about y), so ANYmal B uses the same signs: the front knees point back and the hind
# knees forward, every knee is 0.24 m below its hip, and every foot is 0.51 m below its hip, 4 mm outside it laterally
# and 0.1 m from it fore-aft, ahead of the front hips and behind the hind ones.
default_joint_state { joint: "LF_HAA" value: -0.25 }
default_joint_state { joint: "LF_HFE" value: 0.6 }
default_joint_state { joint: "LF_KFE" value: -0.85 }
default_joint_state { joint: "RF_HAA" value: 0.25 }
default_joint_state { joint: "RF_HFE" value: 0.6 }
default_joint_state { joint: "RF_KFE" value: -0.85 }
default_joint_state { joint: "LH_HAA" value: -0.25 }
default_joint_state { joint: "LH_HFE" value: -0.6 }
default_joint_state { joint: "LH_KFE" value: 0.85 }
default_joint_state { joint: "RH_HAA" value: 0.25 }
default_joint_state { joint: "RH_HFE" value: -0.6 }
default_joint_state { joint: "RH_KFE" value: 0.85 }

initial_mode_schedule {
  mode_sequence: "STANCE"
  mode_sequence: "STANCE"
  event_times: 0.5
}

default_mode_sequence_template {
  mode_sequence: "STANCE"
  switching_times: 0.0
  switching_times: 0.5
}
