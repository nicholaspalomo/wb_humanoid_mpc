# proto-file: tools/launch/proto/launch_file.proto
# proto-message: launch_proto.LaunchFile
#
# LimX Tron1, centroidal MPC against the dummy simulator: the MPC node, the robot played by the rollout of the
# MPC's own model (no MuJoCo) as the bus node "robot", the remote-control GUI and the Rerun bridge, all on the laptop.
#
#   make launch-tron1-dummy-sim
#   bazel run //tools/launch -- robot_models/limx_tron1/tron1_centroidal_mpc/launch/dummy_sim.textproto

variables { name: "bin_dir" value: ".bazel/bin" }
variables { name: "robot_dir" value: "robot_models/limx_tron1" }
variables { name: "config_dir" value: "{robot_dir}/tron1_centroidal_mpc/config" }
variables { name: "task_file" value: "{config_dir}/mpc/task.textproto" }
variables { name: "reference_file" value: "{config_dir}/command/reference.textproto" }
variables { name: "urdf_file" value: "{robot_dir}/tron1_description/urdf/tron1.urdf" }
# The shared gaits of the wheeled robots and their switching table: stance and drive, every wheel in contact.
# LINT.IfChange(gait_file)
variables { name: "gait_file" value: "humanoid_nmpc/humanoid_common_mpc/config/command/wheeled_gait.textproto" }
# LINT.ThenChange(//humanoid_nmpc/humanoid_centroidal_mpc/test/support/ShippedCentroidalRobot.cpp:wheeled_gait_file, //humanoid_nmpc/humanoid_common_mpc/test/config/testConfigRoots.cpp:wheeled_gait_file, //robot_models/limx_tron1/tron1_centroidal_mpc/launch/mpc.textproto:gait_file, //humanoid_nmpc/humanoid_mpc_validation/src/closed_loop/RobotConfiguration.cpp:wheeled_gait_file)
# The bus's network file: the shipped one is every node on this machine (config/ipc/network.textproto).
variables { name: "network_file" value: "config/ipc/network.textproto" }
# The Rerun bridge's sink, by name (humanoid_nmpc/humanoid_rerun_viewer/README.md): spawn, connect, serve_web, save;
# save writes the recording to rrd_path.
variables { name: "rerun_sink" value: "serve_web" }
variables { name: "rrd_path" value: "" }
variables { name: "plot_config" value: "humanoid_nmpc/humanoid_rerun_viewer/config/plot_config.textproto" }
# Whether the GUI publishes the walking command: publish, or off to leave it to a teleoperation publisher
# (humanoid_nmpc/remote_control/README.md).
variables { name: "gui_walking_commands" value: "publish" }

# The processes: their binaries are those the Makefile's launch target of this file builds first.
# LINT.IfChange(processes)
processes {
  name: "mpc"
  machine: MACHINE_LAPTOP
  command: [
    "{bin_dir}/humanoid_nmpc/humanoid_centroidal_mpc_app/humanoid_centroidal_mpc_node",
    "--robot_name=tron1",
    "--task_file={task_file}",
    "--reference_file={reference_file}",
    "--urdf_file={urdf_file}",
    "--gait_file={gait_file}",
    "--network_config={network_file}"
  ]
  required: true
}

processes {
  name: "dummy_sim"
  machine: MACHINE_LAPTOP
  command: [
    "{bin_dir}/humanoid_nmpc/humanoid_centroidal_mpc_app/humanoid_centroidal_mpc_dummy_sim",
    "--robot_name=tron1",
    "--task_file={task_file}",
    "--reference_file={reference_file}",
    "--urdf_file={urdf_file}",
    "--network_config={network_file}"
  ]
  required: true
}

processes {
  name: "gui"
  machine: MACHINE_LAPTOP
  command: [
    "{bin_dir}/humanoid_nmpc/remote_control/base_velocity_controller_gui",
    "--task_file={task_file}",
    "--reference_file={reference_file}",
    "--urdf_file={urdf_file}",
    "--walking_commands={gui_walking_commands}",
    "--network_config={network_file}"
  ]
  delay: 1.0
}

processes {
  name: "rerun"
  machine: MACHINE_LAPTOP
  command: [
    "{bin_dir}/humanoid_nmpc/humanoid_rerun_viewer/humanoid_rerun_viewer",
    "--urdf={urdf_file}",
    "--network_config={network_file}",
    "--rerun_sink={rerun_sink}",
    "--rrd_path={rrd_path}",
    "--plot_config={plot_config}"
  ]
}
# LINT.ThenChange(//Makefile:launch_binaries)
