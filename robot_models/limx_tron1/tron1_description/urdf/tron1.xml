<mujoco model="tron1">
  <!-- Modified from LimX Dynamics' tron1-robot-description, pointfoot/WF_TRON1A/xml/robot.xml at commit
       ac417d44656d3c7494a095cecd62928e777a0f3a (Apache-2.0, LICENSE beside urdf/). The bodies, joint axes and the
       collision primitives of the legs follow that model; the inertials are the URDF's (urdf/tron1.urdf), with its
       fixed limx_imu link lumped into base_Link as Pinocchio lumps it. README.md beside urdf/ lists every change. -->
  <default>
    <default class="tron1">
      <site group="3" size="0.005" rgba="1 0 0 0.66"/>
      <joint type="hinge" damping="2"/>
      <!-- The wheel hinges spin freely: no range, and the light damping of a hub motor's bearings. -->
      <default class="wheel">
        <joint axis="0 1 0" limited="false" damping="0.1" frictionloss="0.01"/>
      </default>
      <!-- Visual-only geoms: no collision, group 1 for rendering. -->
      <default class="visual">
        <geom type="mesh" contype="0" conaffinity="0" group="1" density="0"/>
      </default>
      <!-- Collision geoms: simple primitives with the contact parameters of the other robots' collision class. -->
      <default class="collision">
        <geom group="2" rgba="0.5 0.5 0.5 0.3" density="0" friction="1.0 0.005 0.0001" solimp="0.95 0.99 0.001"
              solref="0.004 1.0"/>
        <!-- One cylinder per wheel, coaxial with the wheel joint (y) and centered at the wheel center: the rolling
             contact's wheel, radius 0.127 m and width 0.05 m as in the URDF. -->
        <default class="wheel_collision">
          <geom type="cylinder" size="0.127 0.025" quat="0.707106781 0.707106781 0 0" priority="1" condim="3"
                rgba="0.1 0.1 0.1 1"/>
        </default>
      </default>
    </default>
  </default>
  <compiler angle="radian" meshdir="../meshes"/>
  <option timestep="0.001" gravity="0 0 -9.81"/>

  <statistic center="0 0 0.5" extent="1.2"/>
  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.1 0.1 0.1" specular="0.9 0.9 0.9"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="-140" elevation="-20"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb2="0.835 0.761 0.612" rgb1="0.639 0.722 0.8" width="512" height="512"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="random"
             rgb1="0.25 0.3 0.35" rgb2="0.15 0.2 0.25"
             markrgb="0.6 0.7 0.8"
             width="512" height="512"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="2 2" reflectance="0.05"/>
    <material name="light_blue" rgba="0.79216 0.81961 0.93333 1"/>
    <material name="white" rgba="1 1 1 1"/>
    <material name="tire" rgba="0.26667 0.26667 0.26667 1"/>
    <mesh class="tron1" file="base_Link.stl"/>
    <mesh class="tron1" file="abad_L_Link.stl"/>
    <mesh class="tron1" file="hip_L_Link.stl"/>
    <mesh class="tron1" file="knee_L_Link.stl"/>
    <mesh class="tron1" file="wheel_L_Link.stl"/>
    <mesh class="tron1" file="abad_R_Link.stl"/>
    <mesh class="tron1" file="hip_R_Link.stl"/>
    <mesh class="tron1" file="knee_R_Link.stl"/>
    <mesh class="tron1" file="wheel_R_Link.stl"/>
  </asset>

  <worldbody>
    <light pos="1 0 3.5" dir="0 0 -1" directional="true"/>
    <geom name="floor" size="10 10 0.05" type="plane" material="groundplane"/>

    <!-- The floating base, unyawed: the URDF's base_Link frame (x forward, y left, z up). -->
    <body name="base_Link" pos="0 0 0.92" childclass="tron1">
      <freejoint name="floating_base_joint"/>
      <inertial mass="9.595" pos="0.0457123085 0.000139854091 -0.163809098" fullinertia="0.140380093 0.110931981 0.0989664601 0.000534875003 0.028259075 -2.70486673e-05"/>
      <site name="limx_imu"/>
      <geom class="visual" mesh="base_Link" material="light_blue"/>
      <geom name="base_collision" class="collision" type="box" size="0.135 0.13 0.095" pos="0.03 0 -0.072"/>

      <body name="abad_L_Link" pos="0.05556 0.105 -0.2602">
        <inertial mass="1.469" pos="-0.06977 0.04479 0.00057" fullinertia="0.001555384 0.00235925 0.00208092 0.00039778 -1.31e-05 -9.8e-07"/>
        <joint name="abad_L_Joint" axis="1 0 0" range="-0.38397 1.39626"/>
        <geom class="visual" mesh="abad_L_Link" material="light_blue"/>
        <geom name="abad_L_collision" class="collision" type="cylinder" size="0.05 0.025" pos="-0.08 0 0" euler="1.57 0 0"/>
        <body name="hip_L_Link" pos="-0.077 0.0205 0">
          <inertial mass="2.3" pos="-0.02869 -0.0477 -0.03992" fullinertia="0.01693728 0.02285328 0.00933419 0.00164703 -0.00923253 0.0022024"/>
          <joint name="hip_L_Joint" axis="0 1 0" range="-1.012291 1.396263"/>
          <geom class="visual" mesh="hip_L_Link" material="white"/>
          <geom name="hip_L_collision" class="collision" type="cylinder" size="0.035 0.075" pos="-0.1 -0.025 -0.14" euler="0 0.53 0"/>
          <body name="knee_L_Link" pos="-0.15 -0.0205 -0.25981">
            <inertial mass="1.49" pos="0.11913 0.01106 -0.20363" fullinertia="0.0132328 0.01766137 0.00501698 -0.00043546 0.00693569 0.00079087"/>
            <joint name="knee_L_Joint" axis="0 -1 0" range="-0.872665 1.361357"/>
            <geom class="visual" mesh="knee_L_Link" material="light_blue"/>
            <geom name="knee_L_collision" class="collision" type="cylinder" size="0.015 0.13" pos="0.078 0 -0.12" euler="0 -0.55 0"/>
            <!-- The hub motor housing on the knee, around the wheel axle. -->
            <geom name="knee_L_motor_collision" class="collision" type="cylinder" size="0.052 0.0281" pos="0.15 0.0149 -0.25981" quat="0.707106781 0.707106781 0 0"/>
            <body name="wheel_L_Link" pos="0.15 0.0435 -0.25981">
              <inertial mass="1.08" pos="3e-05 0.00807 -2e-05" fullinertia="0.00515512 0.00974272 0.005154 1e-08 -9.7e-07 -1e-08"/>
              <joint name="wheel_L_Joint" class="wheel"/>
              <geom class="visual" mesh="wheel_L_Link" material="tire"/>
              <!-- The wheel: its lowest point is the rolling contact point. -->
              <geom name="wheel_L_collision" class="wheel_collision" pos="0 0.00707 0"/>
              <site name="wheel_L_center" pos="0 0.00707 0"/>
            </body>
          </body>
        </body>
      </body>

      <body name="abad_R_Link" pos="0.05556 -0.105 -0.2602">
        <inertial mass="1.469" pos="-0.06977 -0.04479 0.00057" fullinertia="0.001555384 0.00235925 0.00208092 -0.00039778 -1.31e-05 9.8e-07"/>
        <joint name="abad_R_Joint" axis="1 0 0" range="-1.39626 0.38397"/>
        <geom class="visual" mesh="abad_R_Link" material="light_blue"/>
        <geom name="abad_R_collision" class="collision" type="cylinder" size="0.05 0.025" pos="-0.08 0 0" euler="1.57 0 0"/>
        <body name="hip_R_Link" pos="-0.077 -0.0205 0">
          <inertial mass="2.3" pos="-0.02869 0.0477 -0.03992" fullinertia="0.01693728 0.02285328 0.00933419 -0.00164703 -0.00923253 -0.0022024"/>
          <joint name="hip_R_Joint" axis="0 -1 0" range="-1.396263 1.012291"/>
          <geom class="visual" mesh="hip_R_Link" material="white"/>
          <geom name="hip_R_collision" class="collision" type="cylinder" size="0.035 0.075" pos="-0.1 0.025 -0.14" euler="0 0.53 0"/>
          <body name="knee_R_Link" pos="-0.15 0.0205 -0.25981">
            <inertial mass="1.49" pos="0.11913 -0.01106 -0.20363" fullinertia="0.0132328 0.01766137 0.00501698 0.00043546 0.00693569 -0.00079087"/>
            <joint name="knee_R_Joint" axis="0 1 0" range="-1.361357 0.872665"/>
            <geom class="visual" mesh="knee_R_Link" material="light_blue"/>
            <geom name="knee_R_collision" class="collision" type="cylinder" size="0.015 0.13" pos="0.078 0 -0.12" euler="0 -0.55 0"/>
            <!-- The hub motor housing on the knee, around the wheel axle. -->
            <geom name="knee_R_motor_collision" class="collision" type="cylinder" size="0.052 0.0281" pos="0.15 -0.0149 -0.25981" quat="0.707106781 0.707106781 0 0"/>
            <body name="wheel_R_Link" pos="0.15 -0.0435 -0.25981">
              <inertial mass="1.08" pos="3e-05 -0.00807 -2e-05" fullinertia="0.00515512 0.00974272 0.005154 -1e-08 -9.7e-07 1e-08"/>
              <joint name="wheel_R_Joint" class="wheel"/>
              <geom class="visual" mesh="wheel_R_Link" material="tire"/>
              <!-- The wheel: its lowest point is the rolling contact point. -->
              <geom name="wheel_R_collision" class="wheel_collision" pos="0 -0.00707 0"/>
              <site name="wheel_R_center" pos="0 -0.00707 0"/>
            </body>
          </body>
        </body>
      </body>
    </body>
  </worldbody>

  <!-- One torque motor per joint (gear 1): the simulator writes each joint's torque into its ctrl, limited to the
       URDF's effort (80 N m on the legs, 40 N m on the wheels). -->
  <actuator>
    <motor name="abad_L_Joint" joint="abad_L_Joint" ctrlrange="-80 80" forcerange="-80 80"/>
    <motor name="hip_L_Joint" joint="hip_L_Joint" ctrlrange="-80 80" forcerange="-80 80"/>
    <motor name="knee_L_Joint" joint="knee_L_Joint" ctrlrange="-80 80" forcerange="-80 80"/>
    <motor name="wheel_L_Joint" joint="wheel_L_Joint" ctrlrange="-40 40" forcerange="-40 40"/>
    <motor name="abad_R_Joint" joint="abad_R_Joint" ctrlrange="-80 80" forcerange="-80 80"/>
    <motor name="hip_R_Joint" joint="hip_R_Joint" ctrlrange="-80 80" forcerange="-80 80"/>
    <motor name="knee_R_Joint" joint="knee_R_Joint" ctrlrange="-80 80" forcerange="-80 80"/>
    <motor name="wheel_R_Joint" joint="wheel_R_Joint" ctrlrange="-40 40" forcerange="-40 40"/>
  </actuator>

  <!-- Virtual gantry. A real weld the constraint solver satisfies inside mj_step, so the base is supported
       WHILE the dynamics are integrated. MujocoSimInterface drives eq_active from the lock state and writes
       the suspension height into the relpose translation, so the values here are only a starting point. -->
  <equality>
    <weld name="gantry" body1="world" body2="base_Link" relpose="0 0 0.92 1 0 0 0" active="false"/>
  </equality>
</mujoco>
