# proto-file: humanoid_nmpc/humanoid_mpc_config/joint_pd_gains_file.proto
# proto-message: humanoid_mpc_config.JointPdGainsFile
# Unitree G1 (29-DoF) Joint Proportional and Derivative (PD) Controller Gains
# Units: Kp in [N*m/rad], Kd in [N*m*s/rad]

# max_joint_torque bounds the feedforward torque the whole-body MRT joint controller commands each joint, in every mode, as
# in the centroidal controller (|ff| <= max_joint_torque). The values are the model's own actuatorfrcrange, which MuJoCo
# enforces in the simulation (MujocoSimInterface) and the drives enforce on the robot. default_gains sets kp, kd and
# max_joint_torque: the controller has no gains of its own and does not start without them.
default_gains {
  kp: 150.0
  kd: 8.0
  max_joint_torque: 139.0
}
# Left Leg
joint_gains { joint: "left_hip_pitch_joint" kp: 150.0 kd: 10.0 max_joint_torque: 88.0 }
joint_gains { joint: "left_hip_roll_joint" kp: 150.0 kd: 10.0 max_joint_torque: 88.0 }
joint_gains { joint: "left_hip_yaw_joint" kp: 150.0 kd: 10.0 max_joint_torque: 88.0 }
joint_gains { joint: "left_knee_joint" kp: 200.0 kd: 12.0 max_joint_torque: 139.0 }
joint_gains { joint: "left_ankle_pitch_joint" kp: 80.0 kd: 6.0 max_joint_torque: 50.0 }
joint_gains { joint: "left_ankle_roll_joint" kp: 80.0 kd: 6.0 max_joint_torque: 50.0 }

# Right Leg
joint_gains { joint: "right_hip_pitch_joint" kp: 150.0 kd: 10.0 max_joint_torque: 88.0 }
joint_gains { joint: "right_hip_roll_joint" kp: 150.0 kd: 10.0 max_joint_torque: 88.0 }
joint_gains { joint: "right_hip_yaw_joint" kp: 150.0 kd: 10.0 max_joint_torque: 88.0 }
joint_gains { joint: "right_knee_joint" kp: 200.0 kd: 12.0 max_joint_torque: 139.0 }
joint_gains { joint: "right_ankle_pitch_joint" kp: 80.0 kd: 6.0 max_joint_torque: 50.0 }
joint_gains { joint: "right_ankle_roll_joint" kp: 80.0 kd: 6.0 max_joint_torque: 50.0 }

# Waist / Torso
joint_gains { joint: "waist_yaw_joint" kp: 120.0 kd: 8.0 max_joint_torque: 88.0 }
joint_gains { joint: "waist_roll_joint" kp: 120.0 kd: 8.0 max_joint_torque: 50.0 }
joint_gains { joint: "waist_pitch_joint" kp: 120.0 kd: 8.0 max_joint_torque: 50.0 }

# Left Arm
joint_gains { joint: "left_shoulder_pitch_joint" kp: 60.0 kd: 4.0 max_joint_torque: 25.0 }
joint_gains { joint: "left_shoulder_roll_joint" kp: 60.0 kd: 4.0 max_joint_torque: 25.0 }
joint_gains { joint: "left_shoulder_yaw_joint" kp: 60.0 kd: 4.0 max_joint_torque: 25.0 }
joint_gains { joint: "left_elbow_joint" kp: 40.0 kd: 3.0 max_joint_torque: 25.0 }
joint_gains { joint: "left_wrist_roll_joint" kp: 20.0 kd: 1.5 max_joint_torque: 25.0 }
joint_gains { joint: "left_wrist_pitch_joint" kp: 20.0 kd: 1.5 max_joint_torque: 5.0 }
joint_gains { joint: "left_wrist_yaw_joint" kp: 20.0 kd: 1.5 max_joint_torque: 5.0 }

# Right Arm
joint_gains { joint: "right_shoulder_pitch_joint" kp: 60.0 kd: 4.0 max_joint_torque: 25.0 }
joint_gains { joint: "right_shoulder_roll_joint" kp: 60.0 kd: 4.0 max_joint_torque: 25.0 }
joint_gains { joint: "right_shoulder_yaw_joint" kp: 60.0 kd: 4.0 max_joint_torque: 25.0 }
joint_gains { joint: "right_elbow_joint" kp: 40.0 kd: 3.0 max_joint_torque: 25.0 }
joint_gains { joint: "right_wrist_roll_joint" kp: 20.0 kd: 1.5 max_joint_torque: 25.0 }
joint_gains { joint: "right_wrist_pitch_joint" kp: 20.0 kd: 1.5 max_joint_torque: 5.0 }
joint_gains { joint: "right_wrist_yaw_joint" kp: 20.0 kd: 1.5 max_joint_torque: 5.0 }
