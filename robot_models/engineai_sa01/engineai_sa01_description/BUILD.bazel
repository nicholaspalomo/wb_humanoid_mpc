load("//bazel:robot_files.bzl", "ROBOT_FILE_EXCLUDES")
# engineai_sa01_description - URDF, meshes, launch, rviz data files for EngineAI SA01

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "engineai_sa01_description",
    srcs = glob([
        "urdf/**",
        "meshes/**",
        "launch/**",
        "rviz/**",
    ], exclude = ROBOT_FILE_EXCLUDES, allow_empty = True),
)
