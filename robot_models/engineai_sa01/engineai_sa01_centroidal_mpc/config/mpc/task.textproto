# proto-file: humanoid_nmpc/humanoid_mpc_config/task_file.proto
# proto-message: humanoid_mpc_config.TaskFile
# EngineAI SA01 centroidal MPC task configuration.
#
# SA01 is a LEGS-ONLY biped: 12 revolute joints, no arms, no waist and no head. The MPC state is therefore
# 6 (normalized centroidal momentum) + 6 (base pose) + 12 (joint positions) = 24. The wrench-space input would be
# 2 x 6 (contact wrenches) + 12 (joint velocities) = 24; with the basis-vector contact inputs this file selects it is
# 2 x 11 (basis scalings per foot, num_basis_vectors + 7) + 12 = 34. Total mass 33.11 kg, 0.725 m from the hip pitch axis
# to the sole, a 0.27 x 0.10 m sole and only 0.150 m between the hips - it is a narrow, short-legged, long-footed robot.
#
# This file starts from the baseline formulation the Unitree R1 runs - base-pose tracking and a gait schedule - with two
# of the newer formulations switched ON: basis-vector contact inputs (contact_input_parameterization: basis_vectors) and
# the DCM terminal cost (dcm_terminal_cost in `costs`), so SA01 does NOT run R1's wrench inputs and quadratic terminal
# cost. Every other newer feature is off, pre-parameterized, and documented where it is switched on (the formulation
# toggles below), so they can be enabled ONE AT A TIME and validated in MuJoCo. The weights are R1's, which is the
# closest robot by mass (28.8 kg against SA01's 33.1 kg); they are a starting point, not a tuned set.

# Simulation & Telemetry Configuration
# Where the robot process sends its telemetry (robot/state), by name (TelemetrySinkRegistry.h): bus publishes it on
# the IPC bus for the visualization publisher, the Rerun bridge and ipc_tool; no telemetry_sinks line turns the
# telemetry off.
# LINT.IfChange(telemetry_sinks)
telemetry_sinks: "bus"
# LINT.ThenChange(//humanoid_nmpc/humanoid_common_mpc_app/robot/include/humanoid_common_mpc_app/robot/TelemetrySinkRegistry.h:telemetry_sink_names)
telemetry_frequency: 100  # [Hz] robot/state, decimated from the control loop
# MuJoCo backend of the robot process only. The viewer's contact timeline ('b' toggles it) shows, per contact point,
# the contact state the executed MPC policy plans against the simulator's ground truth over a sliding window of time.
sim_contact_timeline_window: 5.0  # [s] width of the sliding window
sim_contact_force_threshold: 5.0  # [N] normal force above which a contact point counts as touching (ground truth).
                                  #     SA01 weighs 324.8 N, so this is 1.5% of body weight.
# Fall recovery (SimFallRecovery, humanoid_nmpc/docs/mpc_reset/README.md). sim_max_base_tilt_angle is the tilt of the base
# past which the simulator catches the robot on the gantry, holding it upright where it is at the gantry height,
# switching to JOINT_PD (the whole-body MPC is overconstrained against a pinned base) and resetting the controller, which
# holds the robot until it has planned from where the robot is now. The simulator's own resets (base below the floor
# limit, an unstable step) are caught the same way. The remote control follows the lock and re-centers its joysticks,
# so a stick left forward cannot keep commanding a walk into a robot hanging from the harness. The measure is the angle
# between the base's own vertical and the world vertical, so it is heading independent: 0 upright, pi/2 on its side, pi
# upside down. 0 disables the catch and leaves a fallen robot where it lands, which is what you want when the fall
# itself is the thing being studied. 1.0 rad (57 deg) is past any recoverable lean.
# sim_gantry_catch_lift is how far the gantry then lifts the caught robot so that its feet clear the ground: JOINT_PD brings
# the legs back to the nominal posture, the gantry lowers the robot back onto its feet, and WB_MPC is refused until it
# rests there. Caught at its standing height with its feet loaded where they landed, the robot hung pitched and fell
# again within two seconds of the unlock. 0 skips the sequence and accepts WB_MPC at once. Simulation only.
sim_max_base_tilt_angle: 1.0  # [rad] 0 disables
sim_gantry_catch_lift: 0.15  # [m] 0 skips the settle sequence
# Measured contact state of the controller, by name (robot_model/ContactEstimatorRegistry.h): the MPC observation mode and
# which planned contact wrenches the inverse dynamics projects into feedforward torques. One of:
#   cheater_sim        the ground truth of the physics (normal force above sim_contact_force_threshold); required for the
#                      phase_resetting execution rule of contact_planning.textproto
#   robot_state        the contact flags of the RobotState (in MuJoCo the same ground truth)
#   always_in_contact  every contact point touching: the executed schedule is taken as the measured contact state
# How the virtual gantry holds the floating base while it is locked. Two different physical models, so the name selects
# one rather than a boolean switching a feature on:
#   weld_constraint    a MuJoCo weld the solver satisfies INSIDE mj_step, so the base is really supported while the
#                      dynamics are integrated. This is what a physical gantry does, and the only setting under which
#                      GRAVITY_COMP holds the limbs still.
#   kinematic_teleport legacy: qpos/qvel are overwritten just BEFORE mj_step, leaving the base unsupported during the
#                      step. The robot is then in free fall while integrating, and a free-falling chain in uniform
#                      gravity needs zero joint torque to keep its shape, so the commanded gravity torque is entirely
#                      surplus lift: measured ~130 deg of joint drift in 3 s, into the stops. Kept only to reproduce
#                      recorded runs.
# LINT.IfChange(gantry_hold)
gantry_hold: "weld_constraint"
# LINT.ThenChange(//robot_runtime/mujoco_sim_interface/include/mujoco_sim_interface/MujocoSimInterface.h:gantry_hold_names)
# LINT.IfChange(contact_estimator)
contact_estimator: "cheater_sim"
# LINT.ThenChange(//robot_runtime/robot_model/src/ContactEstimatorRegistry.cpp:contact_estimator_names, //robot_runtime/mujoco_sim_interface/src/CheaterSimContactEstimator.cpp:cheater_sim_contact_estimator_name)

# The ball the GUI's Dodgeball tab throws, by name (robot_runtime/mujoco_sim_interface/.../Projectile.h). MuJoCo
# compiles its model once at load and bodies cannot be added afterwards, so naming one here appends a free-floating
# sphere to the scene BEFORE it is compiled. Until a throw arms it, it is parked 100 m above the scene with its
# collisions off and its weight held by gravity compensation; it is parked again once it has come to rest, after ten
# seconds in play at most, and whenever the robot is caught on the gantry.
#
#   dodgeball   a regulation 0.216 m sphere of 0.45 kg (the GUI's mass slider sets 0.1-5 kg per throw) that bounces
#               back at 0.80 of the speed it arrived at. MuJoCo has no restitution parameter: it is converted to the
#               contact damping ratio solref needs by the logarithmic decrement (0.80 gives 0.0708), and the ball's
#               contact parameters take priority over the floor's and the robot's so that it is the bounce it gets.
#
# Remove the key, or set it empty, to compile the scene exactly as it is on disk. The Throw button then still works:
# with no ball to fly, the simulator applies the momentum the ball would have ARRIVED with as a one-step force on the
# base - a lower bound on the push, since a real ball that bounces off hands over more.
#
# Simulation only. It changes nothing about the MPC, and a contact with the ball is excluded from the ground-truth
# contact mask and from the ZMP marker, so a ball against a swing foot is never mistaken for the ground.
# LINT.IfChange(sim_projectile)
sim_projectile: "dodgeball"
# LINT.ThenChange(//robot_runtime/mujoco_sim_interface/src/Projectile.cpp:projectile_names)

# Viewer visualizations (each listed one starts on; the key in brackets toggles it, 'p' prints the cheatsheet). Every
# marker is a class in robot_runtime/mujoco_sim_interface/.../visualization; the names are those of VisualizationRegistry.
# LINT.IfChange(sim_visualizations)
sim_visualizations: "metrics"  # render/sim FPS, real-time factor and drift (top-left text)
sim_visualizations: "external_forces"  # arrows of the external forces applied to the bodies (pushes)
sim_visualizations: "contact_forces"  # arrows of the physical contact forces on the robot
sim_visualizations: "base_velocity"  # measured (red) vs commanded (green) base velocity and yaw rate at the CoM
sim_visualizations: "contact_timeline"  # [b] barcode of planned vs ground-truth contact per contact point
sim_visualizations: "target_contact_patches"  # [g] contact patch of every foot at the planner's target position and yaw
sim_visualizations: "center_of_mass"  # [o] whole-body center of mass: sphere, vertical, and its shadow on the ground
sim_visualizations: "zmp"  # [z] zero moment point of the physical ground reaction, on the ground
# The ZMP marker earns its place on SA01 more than on any other robot here: with a 24 N.m ankle under 324.8 N of
# body weight the ankle can only hold the center of pressure within 0.074 m of itself in single support, so watch
# whether the ZMP is running to the toe. See contacts.contact_rectangle below.
# sim_visualizations: "dcm"                   # [d] divergent component of motion (capture point) of the measured CoM, on the ground
# MuJoCo's own markers, off unless listed:
# sim_visualizations: "mj_contact_points"     # [c] markers at the physical contact points
# sim_visualizations: "mj_contact_forces"     # [f] MuJoCo's normal and friction force arrows at the contacts
# sim_visualizations: "mj_com"                # [m] center of mass markers of the bodies
# sim_visualizations: "mj_inertia"            # [i] equivalent inertia ellipsoids
# sim_visualizations: "mj_convex_hull"        # [h] convex hulls of the meshes
# sim_visualizations: "mj_transparent"        # [t] model transparency (x-ray view)
# LINT.ThenChange(//robot_runtime/mujoco_sim_interface/src/visualization/VisualizationRegistry.cpp:visualization_names)
enable_online_tuning: true  # Enable runtime parameter and gain tuning in Controller GUI

# ---------------------------------------------------------------------------------------------------------------
# Formulation choices. Basis-vector contact inputs (contact_input_parameterization: basis_vectors) and the DCM terminal
# cost (dcm_terminal_cost in `costs`) are ON; the contact schedule is the gait schedule (contact_schedule_source:
# gait_schedule, not the online contact planner), and CoM + ACoM tracking (the cost com_and_acom_tracking_cost, which
# `costs` below does not list) is off. SA01 has never been run on hardware.
# ---------------------------------------------------------------------------------------------------------------
# How the MPC parameterizes its contact inputs, by name (ContactInputParameterization.h): `wrench` (each foot's 6-D
# wrench, the default) or `basis_vectors` (the scalings lambda of wrench-cone generators, W = B lambda, as shipped: the
# cone is then the lambda >= 0 barrier rather than a soft constraint). The `contacts` block below carries
# basis_generator_set, basis_non_negativity_barrier, basis_scaling_regularization and basis_regularization. It fixes the input
# dimension, so it takes effect at start-up only. See humanoid_nmpc/docs/contact_basis_vectors/README.md.
# LINT.IfChange(contact_input_parameterization_config)
contact_input_parameterization: "basis_vectors"
# LINT.ThenChange(//humanoid_nmpc/humanoid_common_mpc/include/humanoid_common_mpc/common/ContactInputParameterization.h:contact_input_parameterization_names, //robot_models/engineai_sa01/README.md:sa01_formulation_toggles)
# LINT.IfChange(sa01_formulation_toggles)
# CoM + Angular Center of Mass (ACoM) tracking in place of base-pose tracking is the cost com_and_acom_tracking_cost of
# `costs` below (it replaced the useComAndAcomTracking key, which the loader now refuses).
#
# NOT VALIDATED - KEEP IT OUT OF `costs`. AcomSirenWeightsSa01.h exists and is registered in AngularCenterOfMass.cpp,
# so the cost no longer fails for want of a network, but the network misses the acceptance bounds the Atlas network
# meets: its joint Jacobian is 51 % off the centroidal connection on average (Atlas: 22 %) and 53 % off at the nominal
# crouch, where it predicts the hip-pitch-to-yaw coupling at about a third of its true size.
# testAcomAngularVelocityConsistency fails if costs lists it while SA01 is marked unvalidated there. Enabling it means
# retraining
#   bazel run //humanoid_learning/acom:train_main -- --robot sa01 --install_header
# until it meets Atlas's bounds, and writing com_weights / acom_weights. They are deliberately absent while the cost is unlisted -
# nothing reads them, and Q's base-pose block (6..11) is live - but once it is listed the factory zeroes that block and
# they are all that regulates the base pose; start-up refuses the cost without them. See
# robot_models/engineai_sa01/README.md.
#
# The horizon ends with the DCM (capture point) viability cost, parameterized for SA01 in the dcm_terminal_cost block
# below: `costs` lists dcm_terminal_cost in place of terminal_cost (final_state_weights), and the two are never listed together
# (start-up refuses both). It replaced the useDcmTerminalCost key, which the loader now refuses.
# LINT.ThenChange(//robot_models/engineai_sa01/README.md:sa01_formulation_toggles)
# Where the mode schedule and the footholds come from, by name (MpcFormulationConfig.h): gait_schedule (the gait
# schedule of the reference files, as shipped, and the default) or contact_planner (plan the contact sequence, timing
# and footholds online with the reduced-order contact planner that planner.type in contact_planning.textproto names). The
# planner's parameters are contact_planning.textproto next to this file, which is shipped with
# SA01's geometry already worked out (hot-reloaded and edited by the tuning GUI like this file). It replaced the
# useContactPlanning key, which start-up now refuses, and takes effect at start-up only.
# LINT.IfChange(contact_schedule_source_config)
contact_schedule_source: "gait_schedule"
# LINT.ThenChange(//humanoid_nmpc/humanoid_common_mpc/include/humanoid_common_mpc/common/MpcFormulationConfig.h:contact_schedule_source_names, //robot_models/engineai_sa01/README.md:sa01_formulation_toggles)

# The visualization publisher of the MPC node (humanoid_nmpc/humanoid_common_mpc_app/visualization/README.md), read at
# start-up. rerun_scene_frequency bounds how often the Rerun scene (robots and markers) is sent; the plots follow every
# robot/state sample. telemetry_frames are the frames whose pose, twist, acceleration and wrench are plotted, measured,
# reference and plan; rerun_plan_frames (the contact frames when absent) those whose planned paths the scene draws.
rerun_scene_frequency: 30  # [Hz] viz/scene at most this often
# Targeted Pinocchio frames for telemetry logging (position, orientation, twist, accel, wrench). SA01 has no pelvis
# and no torso link - base_link IS the floating base.
telemetry_frames: "foot_l_contact"
telemetry_frames: "foot_r_contact"
telemetry_frames: "base_link"

centroidal_model: "full_centroidal_dynamics"  # or "single_rigid_body_dynamics"

# MPC Problem Formulation Tasks
# The schedule-gated contact formulation: the swing foot's wrench is forced to zero and the stance foot is held still,
# both from the gait schedule, so the MPC cannot depart from that schedule. The contact-implicit alternative
# (arXiv:2502.15630, humanoid_nmpc/docs/contact_implicit_mpc/README.md) replaces those with relaxed complementarity
# conditions and lets the solver decide where each foot carries load. To switch, drop zero_wrench, zero_velocity AND
# normal_velocity here, add normal_velocity plus contact_complementarity, force_weighted_slip and ground_penetration
# to soft_constraints, and give nominal_foothold.step_width a positive value and task_space_foot_cost.weights.pos_y a
# non-zero weight (or set contact_schedule_source: contact_planner) - nothing else would then hold SA01's feet apart.
# The MPC's start-up (mpcFormulationTasksFromConfig) refuses the half-way combinations;
# humanoid_nmpc/docs/contact_implicit_mpc/README.md section 5 lists what else has to be set.
hard_constraints: "zero_wrench"
hard_constraints: "zero_velocity"
hard_constraints: "normal_velocity"

# The names below are the soft-constraint registry's (MpcFormulationConfig.cpp).
# LINT.IfChange(contact_implicit_soft_constraints)
soft_constraints: "joint_limits"
soft_constraints: "foot_collision"
soft_constraints: "contact_wrench_cone"  # wrench inputs: friction, CoP and torsion in one relaxed-barrier term.
                                 # Under basis_vectors (as shipped) the lambda >= 0 barrier is the cone and this
                                 # entry builds nothing.
# soft_constraints: "normal_velocity"              # contact-implicit: the swing-foot vertical servo, PRICED instead of imposed
# soft_constraints: "contact_complementarity"      # contact-implicit: f_n * h = 0, load only where the foot touches the ground
# soft_constraints: "force_weighted_slip"          # contact-implicit: f_n * v_xy = 0, a loaded foot is held still
# soft_constraints: "ground_penetration"           # contact-implicit: h >= 0; the three contact-implicit terms are listed together or
                               #   not at all
# LINT.ThenChange(//humanoid_nmpc/humanoid_common_mpc/src/common/MpcFormulationConfig.cpp:soft_constraint_registry, //humanoid_nmpc/humanoid_common_mpc/src/common/MpcFormulationConfig.cpp:soft_constraint_names)
costs: "state_quadratic_cost"
costs: "input_quadratic_cost"
# The horizon ends on the DCM (capture point) viability cost (the dcm_terminal_cost block). Its alternative is
# terminal_cost, the quadratic final_state_weights cost; the two are never listed together (start-up refuses both).
# LINT.IfChange(sa01_dcm_terminal_cost)
costs: "dcm_terminal_cost"
# LINT.ThenChange(//robot_models/engineai_sa01/README.md:sa01_formulation_toggles)
costs: "icp_cost"
costs: "task_space_foot_cost"
costs: "external_torque_cost"
# LINT.IfChange(sa01_acom_cost)
# com_and_acom_tracking_cost is deliberately absent: SA01's ACoM network is NOT VALIDATED (formulation toggles above).
# LINT.ThenChange(//robot_models/engineai_sa01/README.md:sa01_formulation_toggles)
# task_space_torso_cost is deliberately absent: SA01 has no torso or waist link to track. Its only body above the
# legs is base_link, which IS the floating base and is already regulated by Q(6,6)..Q(11,11). Listing the cost
# without a matching `task_space_costs` block throws (CentroidalMpcInterface::addTaskSpaceKinematicsCosts calls
# pt.get_child("task_space_costs")), so the block is absent too.

# The nominal foothold reference, used only under contact_schedule_source: gait_schedule. With zero_velocity in
# hard_constraints the stance foot is pinned by the schedule and foot placement follows from it, which is why R1 and G1
# leave this at 0 and SA01 does too. It only becomes load-bearing for the contact-implicit formulation, which removes
# that pin: a positive step_width then places each foot a whole step_width to its own side of the stance foot.
#
# step_width is the FULL distance between the feet. SA01's natural stance - both legs vertical - is 0.160 m, so 0.18
# is the value to set here when that day comes, not Atlas's 0.45. How hard the foot is held to the target is
# task_space_foot_cost.weights.pos_x / pos_y, which are 0 below for the same reason.
nominal_foothold {
  step_width: 0.0  # [m] lateral distance between the feet; 0 disables the nominal reference
}

# [m] Where the ground is, for everything that needs to know: the swing trajectories, the landing targets, and the
# contact-implicit complementarity and ground-penetration terms. A flat ground is correct here because every layer of
# this stack assumes one. Hot-reloadable: the reference manager owns the ground and rebuilds the swing trajectories and
# the landing targets on it at the next solve, and the contact-implicit terms follow it in that solve. The base-height
# reference follows it: default_base_height and the commanded pelvis height are heights above this ground
# (TargetTrajectoriesCalculatorBase::commandedBaseHeight, which in the MPC reads the reference manager's applied
# ground), and a reload moves the target in use once (SwitchedModelReferenceManager::adaptToCurrentGroundHeight).
terrain_height: 0.0

# Weights of the contact-implicit terms; read whether or not those terms are listed, ignored when they are not. Every
# key is hot-reloadable, and a key the block does not define (ModelSettings::contactImplicitKeys()) is refused at
# start-up and on a reload rather than ignored.
# The two residuals are normalized before they are penalized - (f_n/f_ref)(h/h_ref) and (f_n/f_ref)(v/v_ref), with
# f_ref the robot's weight taken from the model - so these weights are dimensionless and comparable with each other,
# though NOT with task_space_foot_cost, whose residuals are in meters
# (humanoid_nmpc/docs/contact_implicit_mpc/README.md, section 4).
contact_implicit {
  complementarity_weight: 50  # the price of carrying full body weight at the reference height
  slip_weight: 150  # the price of sliding at the reference speed under full body weight
  # Weight of the one-sided quadratic hinge on h >= 0: the cost is penetration_weight * h^2 / 2 below the ground and
  # exactly zero on or above it. Scaled from Atlas's 5e4 by the mass ratio (33.1 / 159.7), so that a 1 cm penetration
  # produces the same gradient relative to body weight.
  penetration_weight: 1.0e4
  height_reference: 0.08  # swing trajectory height reference [m]; tracks swing_trajectory_config.swing_height
  velocity_reference: 0.3  # [m/s] a sliding speed that would already be a failure
  angular_velocity_reference: 1.0  # [rad/s] a pivot rate that would already be a failure
  gap_smoothing: 1.0e-3  # [m] length scale the footprint corners' minimum height is blended over
}

# ---------------------------------------------------------------------------------------------------------------
# Locomotion heuristics: the regularization heuristics of Gerardo Bledt, "Regularized Predictive Control Framework
# for Robust Dynamic Legged Locomotion", MIT 2020, Appendix C. Derivations, a block diagram and the seam of every
# name below are in humanoid_nmpc/docs/locomotion_heuristics/README.md.
#
# This is a reference-SHAPING layer, not a new cost family. Nothing here adds a term to the optimal control problem:
# every name modifies a reference that a cost this file ALREADY lists regularizes against, which is what RPC means
# by regularization. Three channels, three lists, three seams:
#
#   base_pose  the roll, pitch and height of the base-pose reference that Q(11,11), Q(10,10) and Q(8,8) track - and
#              final_state_weights and the torso task-space cost with them - shaped per shooting node in
#              SwitchedModelReferenceManager::shapeBasePose(). Without a heuristic that reference carries a HARD ZERO
#              for roll and pitch - the target calculator writes targetPose[4] = targetPose[5] = 0.0 on every call - so
#              anything listed here is the first opinion this MPC has about how the base is carried. It is a function
#              of the operator's COMMANDED velocity. Inert while costs lists com_and_acom_tracking_cost, because
#              the cost factory zeroes Q's base-pose block in that mode; start-up warns.
#   foothold   the landing target of the swing foot, shaped in nominalFoothold() and re-evaluated at every solve, which
#              the foot task-space cost tracks through task_space_foot_cost.weights.pos_x / pos_y. The target is the
#              base PREDICTED at touch-down plus the heuristics' offsets, so it holds still through the swing. REQUIRES
#              contact_schedule_source: gait_schedule and is rejected at start-up under contact_planner: the online
#              planner supplies footholds itself and never consults these. Also rejected: a list without
#              hip_centered_stepping on a robot whose nominal_foothold.step_width is 0, since nothing would then keep the
#              feet apart. They do nothing while pos_x and pos_y are 0; start-up warns.
#   wrench     the contact-force reference the input costs regularize against, shaped in getDesiredInput(). That
#              reference is otherwise weight compensation and nothing else: m*g split evenly over the feet the mode
#              schedule calls stance feet, purely vertical.
#
# THE COEFFICIENTS BELOW ARE DERIVED FOR THIS ROBOT, AND ALL THREE LISTS ARE STILL EMPTY. Those are two separate
# switches on purpose: `make derive-heuristic-parameters ROBOT=engineai_sa01` regenerates every number below from this
# robot's URDF, gait and command limits, so the starting point is ready - but nothing is turned on until a name is
# uncommented, and each of these still changes the closed loop. SA01 has never been run at all, so that matters more
# here than anywhere else.
#
# ALL THREE LISTS ARE EMPTY, deliberately. Each changes the closed loop and none has been validated in simulation
# under hardware-like conditions on this robot; Bledt's own coefficients were fitted to a 9 kg quadruped. Uncomment
# ONE name - just its `base_pose:`, `foothold:` or `wrench:` line, each of which adds one entry to its list - sweep its
# block in MuJoCo, and only then move to the next, which is how the dissertation itself proceeds (section 4.3,
# figure 4-13: one heuristic per panel, the viable operating region measured after each).
#
# The list is the switch and the block is the tuning. The blocks below carry DERIVED, non-zero coefficients, so on this
# robot uncommenting a name IS the closed-loop change: the number is live the moment the name is listed. To check that
# listing a name changes nothing by itself - a useful first experiment - zero its block before uncommenting it. The
# analytic heuristics of Table C.1 (hip_centered_stepping, capture_point, impulse_scaling, centripetal_acceleration)
# have no fitted coefficients, only unit scales, so for those four the list entry is the change either way.
#
#
# SA01 NOTES. nominal_foothold.step_width is 0 here and the contact schedule is the gait schedule, so a foothold
# heuristic is the ONLY thing in this configuration with an opinion about where the feet go sideways - and it still
# needs task_space_foot_cost.weights.pos_x / pos_y raised off 0 to reach anything. Because the step width is 0, a
# foothold list must include hip_centered_stepping, which takes the feet's separation from the hips; start-up refuses
# one without it, since the other foothold heuristics would otherwise aim the swing foot at the stance foot.
# capture_point.com_height_override may be left at 0 to use the measured height; the value it would otherwise take is
# 0.6124 m, the model's CoM height above its feet at initial_state, which dcm_terminal_cost and
# contact_planning.textproto shared resolve their absent com_height to. With 24 N.m ankles under 324.8 N of body weight this robot
# has the least center-of-pressure authority of the five here, which makes the base-pose family the first worth trying -
# periodic_orientation's roll above all, see its block - and the foothold family, which needs the foot cost raised as
# well, the second.
#
# Note for the tuning GUI: slider ranges are derived from the value, so a coefficient at 0 gets a (0, 1) slider and
# cannot be dragged negative. Several of these are physically negative (height_compensation.height_per_speed, for one).
# Type the value into the entry box, which widens the bounds.
#
# Orientation sign: the base pose is Euler ZYX about a z-up world, so a POSITIVE pitch puts the nose DOWN. Leaning
# into a forward command is therefore a POSITIVE pitch_per_forward_velocity - the sign of Bledt's own fitted +0.0725.
locomotion_heuristics {
  # Each list ships empty, its candidate names commented out below, one line per entry, so that uncommenting a line
  # adds that name to its list. The offsets within a list are SUMMED, so the order here is
  # documentary only - unlike the contact planner's `costs` list, where order is the floating-point accumulation order.
  # base_pose: "orientation_compensation"   # H_Theta(pdot): roll from lateral speed, pitch from forward speed
  # base_pose: "periodic_orientation"       # H_Theta(Phi):  roll/pitch limit cycle in the gait phase
  # base_pose: "height_compensation"        # H_z(v):        base height against speed
  # foothold: "hip_centered_stepping"      # H_r(Theta):        foot under its own hip - READ ITS BLOCK BELOW FIRST
  # foothold: "capture_point"              # H_r(pdot, Phi):    step into the velocity ERROR
  # foothold: "translational_stepping"     # H_r(pdot):         step in the direction of travel
  # foothold: "in_place_turning"           # H_r(psidot):       step along the turn arc
  # foothold: "high_speed_turning"         # H_r(pdot x omega): step outward along the turn radius
  # wrench: "impulse_scaling"            # H_f(Phi):            stance force scaled by 1 / duty factor
  # wrench: "centripetal_acceleration"   # H_f(Theta x pdot):   the horizontal force of a turn - SEE ITS BLOCK BELOW

  # ---- one parameter block per heuristic, keyed by the heuristic's own registry name ----

  # H_Theta(pdot) = a1 * pdot + a0  (Table C.2, equations 4.11 and 4.12). The velocity is the COMMANDED CoM velocity
  # in the reference base's yaw frame, so a1 is a lean per unit of commanded speed and a0 a standing trim. Bledt did
  # not design this one, he regressed it out of the optimizer's own choices (R^2 of 0.98 and 0.95) and found that
  # injecting it back both enlarged the viable operating region and improved the simplified orientation dynamics'
  # own validity, because the body sits closer to level at speed.
  orientation_compensation {
    # 0, and deliberately so rather than for want of a number. At a CONSTANT sidestep velocity there is no net lateral
    # force to lean against, and what a biped's roll actually does in single support is oscillate at gait frequency -
    # which is periodic_orientation's job below and not this one's.
    roll_per_lateral_velocity: 0.0  # a1 [rad s/m] roll reference per commanded lateral speed
    roll_offset: 0.0  # a0 [rad] standing roll trim
    # 0.0611 puts the nose down 0.049 rad (2.8 deg) at the 0.8 m/s of reference.textproto max_displacement_velocity_x, and
    # POSITIVE is nose-down here (Euler ZYX about a z-up world). The coefficient is HALF AGAIN Atlas's 0.0407 purely
    # because SA01's stick is smaller (0.8 against 1.2 m/s): the lean at full command is the same 2.8 deg on both.
    pitch_per_forward_velocity: 0.0611  # a1 [rad s/m] pitch per commanded forward speed
    pitch_offset: 0.0  # a0 [rad] standing pitch trim
    # 0.15 rad = 8.6 deg. The control model replaces R(Theta) with R_z(psi), so a reference tilt large enough to make
    # that approximation wrong is a reference the dynamics cannot follow.
    maximum_tilt: 0.15  # [rad] each of roll and pitch is clamped to +/- this; the command is not rate limited
  }

  # H_Theta(Phi) = b1 * sin(c1 * Phi + d1)  (Table C.2, equation 4.13), with Phi the gait phase in [0, 1). [0, 0.5)
  # is the LF mode and [0.5, 1) the RF mode, and those name the foot IN CONTACT, not the one swinging - so the first
  # half of the cycle is left stance with the RIGHT foot in the air. Phi FREEZES at 0.0 or 0.5 through double support
  # rather than advancing, so this holds a constant offset there instead of continuing its cycle.
  # The two rates are pre-wired to the two shapes that make sense, so only the amplitudes have to be found.
  periodic_orientation {
    # 0.03 rad = 1.7 deg of pelvic obliquity. The PHASE follows from the mode semantics with nothing left to fit:
    # phase [0, 0.5) is LF, i.e. LEFT STANCE, so its midpoint is 0.25; a positive roll raises the left side (rotation
    # about +x carries +y towards +z), which is the stance side; and with rate 2*pi and offset 0 the sinusoid peaks at
    # exactly 0.25. So the reference drops the hip on the SWING side through each single support.
    #
    # This is the heuristic to watch first on SA01. Its hips are 0.150 m apart - the narrowest of the four robots -
    # so the lateral pendulum has the least to work with and the roll is the channel most worth shaping.
    roll_amplitude: 0.03  # b1 [rad]
    roll_phase_rate: 6.2831853  # c1 [rad per unit phase]; 2*pi = one period per left-right cycle
    roll_phase_offset: 0.0  # d1 [rad]; 0 puts the peak at mid left stance - see above
    # 0, because the phase cannot be derived the way roll's can: pitch oscillates once per STEP and where in the step
    # its extremum falls is a property of this robot's mass distribution and cadence. A sinusoid at the wrong phase is
    # worse than none, so this is the coefficient Bledt's extraction framework exists to produce (R^2 = 0.835).
    pitch_amplitude: 0.0  # b1 [rad]
    pitch_phase_rate: 12.5663706  # c1 [rad per unit phase]; 4*pi = one period per step
    pitch_phase_offset: 0.0  # d1 [rad]
  }

  # H_z(v) = a2*v^2 + a1*v + a0  (Table C.2) in the MAGNITUDE of the commanded horizontal velocity, applied as an
  # OFFSET to the reference height and never as an absolute height - the same channel carries the terrain that
  # adaptToCurrentGroundHeight() writes, and an absolute value would silently become a terrain override.
  # Crouching with speed buys the swing leg vertical room within the same joint range; it costs knee torque headroom.
  height_compensation {
    # 0, until a sweep of the linear term shows curvature worth fitting.
    height_per_speed_squared: 0.0  # a2 [m s^2/m^2]
    # -0.0375 lowers the base 0.03 m at the 0.8 m/s stick, i.e. 3.7% of the 0.8135 m default_base_height. On a robot
    # with only 0.725 m from hip pitch to sole that is a real fraction of the leg, so watch the knee torque: SA01's
    # actuators are the smallest here and the crouch is paid for in exactly the joint that is already working hardest.
    height_per_speed: -0.0375  # a1 [m s/m]
    height_offset: 0.0  # a0 [m]
    maximum_height_offset: 0.05  # [m] clamped to +/- this; 0.05 leaves the clamp off the value above at full stick
  }

  # H_r(Theta) = PTP(R(Theta) * r_hip)  (Table C.1): the foot under its own hip, ground-projected. r_hip is derived
  # from the robot model at start-up and is never a key here; these two scales stretch it.
  #
  # WARNING. This is the one heuristic in the family that is not a small correction: it MOVES THE ANCHOR of the
  # foothold reference. With it listed the landing target is the base predicted at touch-down plus this hip offset, so
  # the lateral separation comes from the hips (times lateral_scale) instead of from the stance foot plus
  # nominal_foothold.step_width. On a robot whose step_width is 0 it is what makes the rest of the foothold family
  # usable at all: start-up refuses a foothold list without it there. Bledt never uses it alone; it is the base term the Table C.2 velocity terms
  # are summed on top of (figure 4-8), and alone it walks a few slow steps and falls as soon as it has speed. The
  # layer prints a warning when it is listed alone, and another when the others are listed without it.
  hip_centered_stepping {
    # 1.0, and here that is not a placeholder: SA01's hip yaw joints sit at y = +/-0.075 m and the legs stand very
    # nearly vertical, so an unscaled hip-centered stance is 0.150 m - the stance the robot already has. And since
    # nominal_foothold.step_width is 0 on this robot there is no other stance for the heuristic to reproduce, which
    # makes SA01 the one robot here where switching this on does not resize anything. Use 1.27 to match the 0.19 m
    # orbit the contact planner would place (contact_planning.textproto hlip.step_width; 0.19 / 0.150), which is the wider
    # and more forgiving of the two on a robot whose lateral pendulum diverges as fast as this one's.
    lateral_scale: 1.0  # multiplies the model's hip lateral offset; 0 removes the lateral part
    longitudinal_scale: 1.0  # inert on SA01: both hip joints sit at x = 0, so the fore-aft offset is zero
  }

  # H_r(pdot, Phi) = gain * sqrt(p_z / g) * (pdot - pdot_d)  (Table C.1): the capture-point offset of the VELOCITY
  # ERROR, and the only heuristic here that reacts to a push rather than to a command - it is identically zero
  # whenever the robot is going as fast as it was asked to. sqrt(z/g) is 1/omega, the same pendulum time constant
  # the DCM terminal cost and the ZMP/DCM viewer markers already use.
  capture_point {
    gain: 1.0  # 1.0 is the textbook capture point
    # 0.6124 m, the model's center of mass above its feet at `initial_state` (computeComHeightAboveFeet) - the pendulum
    # dcm_terminal_cost and contact_planning.textproto shared resolve their absent com_height to, so all three agree by
    # construction, and derive_parameters.py computes it the same way. omega is then
    # sqrt(9.81 / 0.6124) = 4.00 rad/s and the offset is 0.250 s per m/s of velocity error - the fastest pendulum of
    # the four robots, so the capture step is correspondingly small and this heuristic correspondingly gentle.
    com_height_override: 0.6124  # [m] 0: use the CoM height measured each solve; positive: use this fixed value
    gravity: 9.81  # [m/s^2]
    # 0.232 m = 40% of contact_planning.textproto foot_separation.max_step_length (0.58 m). Unlike the Atlas the lateral room
    # here is symmetric enough not to bind: nominal_foothold.step_width is 0, so nothing is pinned against
    # foot_separation.max_step_width to begin with.
    maximum_offset: 0.232  # [m] clamped in MAGNITUDE, which preserves the direction of the step into the error
  }

  # H_r(pdot) = a1 * pdot + a0  (Table C.2): step in the direction of travel, in the base's yaw frame. The largest
  # single effect in the dissertation: a foot placed under the hip at lift-off is behind the robot by touch-down, so
  # the stance that follows tips the robot the way it is already going. Roughly doubled the usable stance per step
  # and multiplied the top speed (figure 4-9). Expect a1 near half the stance duration.
  translational_stepping {
    # Raibert's rule, expressed so that it follows the gait: the foot lands half a stance of travel ahead of the hip it
    # lands under, a1 = T_stance / 2 - 0.25 s on the shipped `trot`, 0.4 s on `walk`, 0.15 s on `run`. The anchor this
    # is added to is the base PREDICTED at touch-down, i.e. the hip at the moment of landing, which is Bledt's anchor
    # too, so the lead means the same thing with and without hip_centered_stepping. It is written as a stance FRACTION
    # of 0.5 rather than as Bledt's constant a1 because the gait scheduler moves between six gaits by commanded speed
    # (slow_walk ... run), and one constant is right in only one of them; the constant is left at 0 and remains
    # available for a fitted value on top.
    forward_per_forward_velocity: 0.0  # a1 [m s/m], Bledt's constant
    forward_stance_fraction: 0.5  # [-] adds this times the upcoming stance duration to a1; 0.5 is Raibert's rule
    forward_offset: 0.0  # a0 [m]
    lateral_per_lateral_velocity: 0.0  # a1 [m s/m], Bledt's constant
    lateral_stance_fraction: 0.5  # [-] the same rule on the lateral axis
    lateral_offset: 0.0  # a0 [m] applied to this foot's OWN SIDE; 0 because hip_centered_stepping already
                          #     sets the separation on this robot
  }

  # H_r(psidot) = a1 * psidot + a0  (Table C.2): step along the turn arc while turning on the spot (figure 4-10).
  # psidot is the COMMANDED yaw rate. The FORWARD term is signed per foot and the lateral one is not, which is what
  # makes it a rotation: on a turn in place the two feet must move fore-aft in opposite directions.
  #
  # DIRECTION. A foot at r relative to the base moves at omega x r, so the LEFT foot at (0, +d) moves at
  # (0,0,psidot) x (0,d,0) = (-psidot*d, 0) - BACKWARDS for a counter-clockwise turn, while the right foot moves
  # forwards. (To turn left you swing the right foot forward and around it and the left foot back.) The code carries
  # that sign, so a POSITIVE forward_per_yaw_rate leads each hip into the turn, which is the point of the heuristic; the
  # opposite convention would make a positive number drive the feet to trail the hips by twice the intended amount.
  in_place_turning {
    # Raibert's rule applied to the speed the HIP travels at: a foot 0.075 m from the center moves at 0.075 * psidot,
    # and half a stance of that is 0.0375 * T_stance per rad/s - 0.019 m per foot at the 1.0 rad/s stick on `trot`,
    # THREE TIMES SMALLER than the Atlas's entirely because SA01's stance is a third as wide. A narrow robot has
    # little to gain here.
    forward_per_yaw_rate: 0.0  # a1 [m s/rad], Bledt's constant; positive leads each hip into the turn
    forward_stance_lever: 0.0375  # [m/rad] adds this times the upcoming stance duration to a1; Raibert's is half the
                                 #     hip's lever arm
    forward_offset: 0.0  # a0 [m]
    lateral_per_yaw_rate: 0.0  # a1 [m s/rad]; 0 - a turn on the spot has no net lateral drift to follow
    lateral_offset: 0.0  # a0 [m] applied to this foot's own side
  }

  # H_r(pdot x omega) = a1 * (pdot x omega) + a0  (Table C.2): throw the feet out along the turn radius at speed.
  # The heuristic the extraction framework found and the designer had not: without it the robot "tended to fall
  # outwards along the turning radius as if it were an object slipping off a spinning plate" (section 4.3), and
  # Bledt only afterwards recognized it as the placement that lines up with the resultant of gravity and the
  # centripetal acceleration (equation 4.31). Zero at zero speed however fast the robot spins, which is what
  # distinguishes it from in_place_turning. With omega = psidot e_z the cross product is (v_y*psidot, -v_x*psidot).
  high_speed_turning {
    # A closed form rather than a fitted number: Bledt's equation 4.31 places the foot along the resultant of gravity
    # and the centripetal acceleration, displacing it by (z_com / g) * (pdot x omega). With SA01's 0.6124 m CoM that
    # is 0.0624 s^2, the SAME on both axes because the two entries are components of one vector. At the stick limits
    # (0.8 m/s, 1.0 rad/s) it throws the foot 0.050 m outwards - half the Atlas's 0.104 m, and well inside a
    # 0.5 m step. (capture_point.maximum_offset does not bound this one: each heuristic clamps only its own offset.)
    forward_per_cross_term: 0.0624  # a1 [m s^2/(m rad)] on   v_y * psidot
    forward_offset: 0.0  # a0 [m]
    lateral_per_cross_term: 0.0624  # a1 [m s^2/(m rad)] on  -v_x * psidot
    lateral_offset: 0.0  # a0 [m] applied to this foot's own side
  }

  # H_f(Phi) = m*g / (F * beta)  (Table C.1): the vertical stance force reference of a foot that is on the ground for
  # a fraction beta of the gait cycle, because the vertical impulse over the cycle has to add up to the weight.
  #
  # F IS THE NUMBER OF FEET THE ROBOT HAS, a constant - not the number in contact at this instant. The existing
  # reference divides the weight over the feet in contact NOW, so it sums to W at every instant; Bledt's is the same
  # value on every stance foot whatever n_stance is, so its total is below W in single support and above it in double
  # support and averages to exactly W over the cycle, because the mean number of feet on the ground is F * beta.
  # Standing (beta = 1) and a pure alternating single support (beta = 1/2) both give back today's reference exactly,
  # so the correction bites only in a gait that has double support - where it asks the feet to push a little harder
  # than static equilibrium because a single-support phase is coming.
  #
  # Applied as the difference from today's reference, so an empty list is exactly today's behavior. beta is measured
  # over each foot's OWN STRIDE, lift-off to lift-off, in the schedule being solved: on a periodic gait that is the gait's
  # duty factor at every node and for both feet, which is what makes the average come out at exactly W. Purely vertical, which is what keeps the cheap yaw-invariant input-frame path valid.
  impulse_scaling {
    scale: 1.0  # blends between today's reference (0) and Bledt's W/(F*beta) (1); must be >= 0
    # 0.3 sits just below the smallest duty factor any shipped gait produces: `run` (gait.textproto: LF 0.3 s, FLY 0.1 s,
    # RF 0.3 s, FLY 0.1 s) puts each foot down for 0.3 of a 0.8 s stride, i.e. beta = 0.375. So the clamp never binds
    # on a gait this robot actually walks with, and still bounds W / (F beta) at 541 N per foot if one ever does.
    minimum_duty_factor: 0.3  # beta is clamped up to this; 1/beta is unbounded as a flight phase opens
    # The binding case among the shipped gaits is `walk`, whose double support runs at beta = 0.571 against a W/2
    # baseline and therefore asks for 1.75 x weight compensation. (`trot` has no double support, so there beta = 0.5
    # and the correction is identically zero.)
    maximum_force_ratio: 2.0  # the reference is clamped to this many times weight compensation
  }

  # H_f(Theta x pdot) = m * omega x pdot  (Table C.1): the horizontal force that holds the robot on a circular path,
  # shared over the stance feet. The companion of high_speed_turning - one says where to put the foot for a fast
  # turn, the other which way to push once it is there.
  #
  # TWO THINGS TO KNOW BEFORE LISTING IT. First, it is the only heuristic of the ten whose force is HORIZONTAL, so under
  # contact_input_parameterization: basis_vectors the reference has to be rotated into the local contact frame and the
  # whole contact-force reference starts paying a forward-kinematics pass per shooting node per SQP iteration. The layer
  # switches to that path by itself and warns; watch the solve time. Second, and more important: this may be the wrong
  # thing to want HERE. Bledt's control model is a single rigid body whose force reference is the only thing telling the
  # QP how hard to push, whereas these dynamics are full centroidal and the state cost already tracks the commanded
  # linear and angular momentum - so m*omega x v is the derivative of a momentum this problem already regulates, an
  # output the optimizer must produce rather than information the reference lacks. It is implemented because it is one
  # of Bledt's ten and the seam is clean; `scale` is the knob for finding out in simulation whether it earns its place.
  centripetal_acceleration {
    scale: 1.0  # scales m * omega x v; 0 disables it
    maximum_force: 0.0  # [N] per-foot clamp; 0 uses maximum_force_ratio_of_weight instead
    # 0.2 of the 324.8 N body weight is 65 N per foot, which is 40% of the friction budget a single stance foot has at
    # this file's friction_coefficient of 0.5 - so the reference stays inside the cone the wrench-cone barrier is
    # enforcing rather than fighting it. For scale, the largest centripetal force SA01 can legitimately need is
    # m * v * psidot = 33.1 * 0.8 * 1.0 = 26 N, i.e. 0.08 of body weight, so this clamp does not bind in normal use.
    maximum_force_ratio_of_weight: 0.2  # the clamp as a fraction of body weight
  }
}

# The feedforward torques of WB_MPC, by name: inverse_dynamics (the planned wrenches through the inverse dynamics) or
# gravity_compensation (pure gravity compensation, to isolate a problem of the inverse dynamics).
wb_mpc_feedforward: "inverse_dynamics"
# [s] Hand-over into the MPC from a passive mode. Entering WB_MPC resets the MPC from the robot as it is and always holds
# the previous mode's action until the first policy solved after that reset is in use (a solve or two); this duration
# then ramps targets, gains and feedforward torques from the held action into the MPC action. 0 switches in one control
# cycle once that policy is in use, which is what SA01 starts on. Try 0.3 to 0.5 once the robot stands in MuJoCo.
mpc_entry_blend_time: 0.0

# SAFETY mode: time constant [s] of the exponential decay applied to both joint PD gains once SAFETY is entered. The
# robot holds the posture it had at entry with torque alpha * (kp * (q_hold - q) - kd * qd), alpha = exp(-t / tau), and
# is commanded true zero torque once alpha falls below 2%, i.e. after about 4 * tau seconds.
safety_decay_time_constant: 0.5
# Touch-down shaping of the planned contact wrenches in the inverse dynamics of the MRT joint controller. Both at 0
# apply the planned wrench in full from the first control cycle of measured contact, i.e. as a step at the first heel
# or toe strike. debounce_time: measured contact must persist this long before the wrench is applied. ramp_time: the
# wrench then rises linearly from zero to the planned value over this time. Lift-off is never shaped.
# Hot-reloadable (GUI: Solver & Horizon).
contact_wrench_gate {
  debounce_time: 0.0  # [s]
  ramp_time: 0.0  # [s]
}

interface {
  verbose: true  # show the loaded parameters
}

model_settings {
  # The key the ACoM network registry dispatches on (AngularCenterOfMass.cpp), and the robot train_main.py trains for.
  # LINT.IfChange(acom_robot_name)
  robot_name: "engineai_sa01"
  # LINT.ThenChange(//humanoid_nmpc/humanoid_common_mpc/src/acom/AngularCenterOfMass.cpp:acom_robot_dispatch, //humanoid_learning/acom/train_main.py:robot_paths)

  foot_constraint {
    # Swing: the only regulation of the swing-foot height is the normal-velocity constraint
    # zdot = zdot_ref + position_error_gain_z * (z_ref - z). The remaining gains act on the stance (zero-velocity)
    # constraint only. These are R1's values.
    position_error_gain_z: 5.0
    orientation_error_gain: 20.0
    linear_velocity_error_gain_z: 1.0
    linear_velocity_error_gain_xy: 1.0
    angular_velocity_error_gain: 1.0
    linear_acceleration_error_gain_z: 0.0
    linear_acceleration_error_gain_xy: 0.0
    angular_acceleration_error_gain: 0.0
    soft_constraint_weight: 250
    # Weight of the SOFT `normal_velocity` term, read only when it is listed in soft_constraints (the
    # contact-implicit formulation). The residual is the same row the hard constraint imposes, so this one number
    # buys the swing-foot vertical servo as a cost the solver can trade off instead of an equality it cannot.
    normal_velocity_soft_constraint_weight: 500
    # What the stance foot's zero_velocity constraint holds: "position" (3D), "position_and_tilt" or
    # "position_and_orientation" (6D). The orientation error to the ground plane only measures the tilt of the foot
    # normal, so under "position_and_tilt" the last row of the 6D stance constraint is identically zero and the foot may
    # pivot about the contact normal. "position_and_orientation" fills that row with the yaw rate about the contact
    # normal, which removes one input degree of freedom per stance foot. Atlas chooses it together with the contact
    # planner's ACoM dynamics; SA01 runs neither, so it stays at "position_and_tilt" until yaw behavior has been looked at
    # in MuJoCo.
    stance_constraint: "position_and_tilt"
  }

  phase_transition_stance_time: 0.0

  verbose_cpp_ad: true
  recompile_libraries_cpp_ad: false

  # Exclude these joints from MPC model. SA01 has twelve joints and the MPC uses all of them.
  # The ACoM network (AcomSirenWeightsSa01.h) was trained with exactly these joints fixed - train_main.py reads this
  # list. Changing it needs a retrain; AngularCenterOfMass::Create refuses the mismatch at start-up.

  # Pinocchio Frame names for the contact frames
  contact_names_6dof: "foot_l_contact"
  contact_names_6dof: "foot_r_contact"

  # The Parent frames on which the contact frames are added. leg_?6_joint is the ankle ROLL joint, whose origin
  # coincides with the ankle pitch joint, so contacts.contact_frame_translation below is measured from there.
  contact_parent_joint_names: "leg_l6_joint"
  contact_parent_joint_names: "leg_r6_joint"

  # arm_joint_names is deliberately absent: SA01 has no arms, so there is no procedural arm swing to configure.
  # ModelSettings treats the whole block as optional and leaves the swing disabled (hasArmSwingJoints false); naming
  # only some of the four, or naming a joint that is not in the MPC model, still fails loudly at load time.
}

# The height reference is tracked at foot_*_contact, the CENTER of the sole. SA01's toe is 0.125 m ahead of it - the
# longest foot relative to its leg of any robot here (0.27 m of sole on a 0.725 m leg) - so the toe height is not
# regulated by anything here and one degree of foot droop drops the toe 2.2 mm.
swing_trajectory_config {
  lift_off_velocity: 0.05
  # A zero touch-down velocity makes the descent flatten out asymptotically, so the sole hovers within a few
  # millimeters of the ground for the last stretch of the swing while the foot is still translating forward. Landing
  # with a real descent rate shortens that window (negative is downward; lift_off_velocity is +0.05 upward).
  touch_down_velocity: -0.05
  # 0.08 m is 11.0% of SA01's 0.725 m leg, inside the 9.1-12.6% band Atlas, G1 and R1 span at the same 0.08. Do not
  # go below 0.06: SA01's long foot needs the clearance more than they do, not less.
  swing_height: 0.08
  touch_down_height_offset: 0.0
  # Swings shorter than this are scaled down in height AND velocity by swingDuration / swing_time_scale
  # (SwingTrajectoryPlanner::swingTrajectoryScaling), so it must stay at or below the shortest swing the gait
  # schedule (humanoid_common_mpc/config/command/gait.textproto) or the contact planner can produce. It is tied to
  # contact_planning.textproto's gait_limits.min_swing_duration and hlip.ssp_duration, both 0.22 s: raising the cadence
  # without lowering this silently shrinks the foot clearance. ContactPlanningReferenceManager warns when it exceeds the
  # shortest swing the configured planner emits.
  # LINT.IfChange(sa01_swing_time_scale)
  swing_time_scale: 0.22
  # LINT.ThenChange(//robot_models/engineai_sa01/engineai_sa01_centroidal_mpc/config/mpc/contact_planning.textproto:sa01_gait_cadence, //robot_models/engineai_sa01/engineai_sa01_centroidal_mpc/config/mpc/contact_planning.textproto:sa01_hlip_cadence)
  impact_proximity_factor_lift_off_velocity: -0.15
  impact_proximity_factor_touch_down_velocity: 0.3
  impact_proximity_factor_mid_point_value: 0.0

  # Toe-up pitch of the swing foot reference, tilting the plane that task_space_foot_cost.weights.orientation_x / _y
  # track. It raises the toe by 0.125 * sin(angle) without lowering the sole center: 0.08 rad buys 10.0 mm.
  # Off by default (0.0 reproduces a flat-foot reference exactly). Enable it only if the toe catches, and start
  # around 0.08. Watch that the heel does not strike first - the contact model assumes a flat landing.
  swing_pitch_angle: 0.0
  swing_pitch_rise_fraction: 0.25
  swing_pitch_fall_fraction: 0.15
}

# multiple_shooting settings. SA01's problem is the smallest in the repository (24 states, 24 inputs against Atlas's
# 36/36), so four threads at 80 Hz is comfortable.
multiple_shooting {
  n_threads: 4
  dt: 0.02
  sqp_iteration: 1
  delta_tol: 1.0e-4
  g_max: 1.0e-2
  g_min: 1.0e-6
  project_state_input_equality_constraints: true
  print_solver_statistics: true
  print_solver_status: false
  print_linesearch: false
  use_feedback_policy: true
  integrator_type: "RK4"
  thread_priority: 50
}

# Rollout settings
rollout {
  abs_tol_ode: 5.0e-5
  rel_tol_ode: 5.0e-3
  time_step: 0.015
  integrator_type: "ODE45"
  max_num_steps_per_second: 10000
  check_numerical_stability: false
}

mpc {
  time_horizon: 1.0  # [s] about two strides of the default walk
  solution_time_window: -1  # maximum [s]
  cold_start: false

  debug_print: false

  mpc_desired_frequency: 80  # [Hz]
  mrt_desired_frequency: 100  # [Hz]
}

# The nominal standing state. The joint block must stay equal to reference.textproto's default_joint_state and (8,0) to its
# default_base_height, which is also the MuJoCo spawn height in zq_sa01.xml.
initial_state {
  # ; Normalized Centroidal Momentum: [linear, angular] ;;
  normalized_linear_momentum {
    x: 0.0  # h_com_x / robotMass
    y: 0.0  # h_com_y / robotMass
    z: 0.0  # h_com_z / robotMass
  }
  normalized_angular_momentum {
    x: 0.0  # L_x / robotMass
    y: 0.0  # L_y / robotMass
    z: 0.0  # L_z / robotMass
  }

  # ; Base Pose: [position, orientation] ;;
  base_position {
    x: 0.0  # p_base_x
    y: 0.0  # p_base_y
    z: 0.8135  # p_base_z
  }
  base_orientation {
    yaw: 0.0  # theta_base_z
    pitch: 0.0  # theta_base_y
    roll: 0.0  # theta_base_x
  }

  # ; Joint Positions: ;;
  joint_positions { joint: "leg_l1_joint" value: 0.0 }  # leg_l1_joint - left hip roll
  joint_positions { joint: "leg_l2_joint" value: 0.0 }  # leg_l2_joint - left hip yaw
  joint_positions { joint: "leg_l3_joint" value: -0.30 }  # leg_l3_joint - left hip pitch
  joint_positions { joint: "leg_l4_joint" value: 0.70 }  # leg_l4_joint - left knee
  joint_positions { joint: "leg_l5_joint" value: -0.40 }  # leg_l5_joint - left ankle pitch
  joint_positions { joint: "leg_l6_joint" value: 0.0 }  # leg_l6_joint - left ankle roll
  joint_positions { joint: "leg_r1_joint" value: 0.0 }  # leg_r1_joint - right hip roll
  joint_positions { joint: "leg_r2_joint" value: 0.0 }  # leg_r2_joint - right hip yaw
  joint_positions { joint: "leg_r3_joint" value: -0.30 }  # leg_r3_joint - right hip pitch
  joint_positions { joint: "leg_r4_joint" value: 0.70 }  # leg_r4_joint - right knee
  joint_positions { joint: "leg_r5_joint" value: -0.40 }  # leg_r5_joint - right ankle pitch
  joint_positions { joint: "leg_r6_joint" value: 0.0 }  # leg_r6_joint - right ankle roll
}

# standard state weight matrix
state_weights {
  scaling: 1

  # ; Normalized Centroidal Momentum: [linear, angular] ;;
  # The linear entries are the only thing asking the MPC to reach the commanded CoM velocity, so they must stay
  # within an order of magnitude of the largest joint entry below or under-striding becomes the cheap option.
  normalized_linear_momentum {
    x: 15.0  # h_com_x / robotMass
    y: 15.0  # h_com_y / robotMass
    z: 15.0  # h_com_z / robotMass
  }
  normalized_angular_momentum {
    x: 15.0  # L_x / robotMass
    y: 40.0  # L_y / robotMass
    z: 4.0  # L_z / robotMass
  }

  # ; Base Pose: [position, orientation] ;;
  # Live, because `costs` does not list com_and_acom_tracking_cost. Roll is weighted hardest: with only 0.150 m
  # between the hips SA01 has less lateral base motion available than any other robot here before a foot has to move.
  base_position {
    x: 20.0  # p_base_x
    y: 20.0  # p_base_y
    z: 30.0  # p_base_z
  }
  # euler angles for base to world rotation
  base_orientation {
    yaw: 0.0  # theta_base_z
    pitch: 5.0  # theta_base_y
    roll: 85.0  # theta_base_x
  }

  # ; Joint Positions ;;
  # Hip roll and hip yaw are regularized, the sagittal chain is left almost free so the leg can stride. Keep hip roll
  # low: its nominal is 0, i.e. legs vertical in the frontal plane, so a large weight here directly opposes the
  # lateral pelvis shift that unloads the swing foot. Self-collision is enforced by collision_constraint, not by this.
  joint_positions { joint: "leg_l1_joint" value: 1.25 }  # leg_l1_joint - left hip roll
  joint_positions { joint: "leg_l2_joint" value: 4.0 }  # leg_l2_joint - left hip yaw
  joint_positions { joint: "leg_l3_joint" value: 0.02 }  # leg_l3_joint - left hip pitch
  joint_positions { joint: "leg_l4_joint" value: 0.02 }  # leg_l4_joint - left knee
  joint_positions { joint: "leg_l5_joint" value: 0.01 }  # leg_l5_joint - left ankle pitch
  joint_positions { joint: "leg_l6_joint" value: 0.01 }  # leg_l6_joint - left ankle roll
  joint_positions { joint: "leg_r1_joint" value: 1.25 }  # leg_r1_joint - right hip roll
  joint_positions { joint: "leg_r2_joint" value: 4.0 }  # leg_r2_joint - right hip yaw
  joint_positions { joint: "leg_r3_joint" value: 0.02 }  # leg_r3_joint - right hip pitch
  joint_positions { joint: "leg_r4_joint" value: 0.02 }  # leg_r4_joint - right knee
  joint_positions { joint: "leg_r5_joint" value: 0.01 }  # leg_r5_joint - right ankle pitch
  joint_positions { joint: "leg_r6_joint" value: 0.01 }  # leg_r6_joint - right ankle roll
}

# control weight matrix
input_weights {
  scaling: 0.01

  # ; Feet Contact Forces: [LF, RF] ;;
  contact_wrenches {
    contact: "foot_l_contact"
    force {
      x: 0.05  # left_force_x
      y: 0.05  # left_force_y
      z: 0.01  # left_force_z
    }
    moment {
      x: 0.05  # left_moment_x
      y: 0.05  # left_moment_y
      z: 0.2  # left_moment_z
    }
  }
  contact_wrenches {
    contact: "foot_r_contact"
    force {
      x: 0.05  # right_force_x
      y: 0.05  # right_force_y
      z: 0.01  # right_force_z
    }
    moment {
      x: 0.05  # right_moment_x
      y: 0.05  # right_moment_y
      z: 0.2  # right_moment_z
    }
  }

  # ; Joint Velocities ;;
  # Hip yaw is held an order of magnitude stiffer than the rest: it is the one leg degree of freedom the gait does
  # not need and the one that scuffs the foot when it moves.
  joint_velocities { joint: "leg_l1_joint" value: 20.0 }  # leg_l1_joint - left hip roll
  joint_velocities { joint: "leg_l2_joint" value: 200.0 }  # leg_l2_joint - left hip yaw
  joint_velocities { joint: "leg_l3_joint" value: 10.0 }  # leg_l3_joint - left hip pitch
  joint_velocities { joint: "leg_l4_joint" value: 10.0 }  # leg_l4_joint - left knee
  joint_velocities { joint: "leg_l5_joint" value: 20.0 }  # leg_l5_joint - left ankle pitch
  joint_velocities { joint: "leg_l6_joint" value: 20.0 }  # leg_l6_joint - left ankle roll
  joint_velocities { joint: "leg_r1_joint" value: 20.0 }  # leg_r1_joint - right hip roll
  joint_velocities { joint: "leg_r2_joint" value: 200.0 }  # leg_r2_joint - right hip yaw
  joint_velocities { joint: "leg_r3_joint" value: 10.0 }  # leg_r3_joint - right hip pitch
  joint_velocities { joint: "leg_r4_joint" value: 10.0 }  # leg_r4_joint - right knee
  joint_velocities { joint: "leg_r5_joint" value: 20.0 }  # leg_r5_joint - right ankle pitch
  joint_velocities { joint: "leg_r6_joint" value: 20.0 }  # leg_r6_joint - right ankle roll
}

# DCM (capture point) terminal cost, active when costs lists dcm_terminal_cost (as shipped; it is the alternative to
# terminal_cost / final_state_weights, and the two are never listed together). At the end of the horizon the DCM
#   xi = p_com + v_com / omega,  omega = sqrt(g / com_height),
# is pulled towards the center of the terminal support plus velocity_offset_factor * v_cmd / omega, so that the horizon
# ends in a capturable state consistent with the commanded walking speed.
#
# com_height left out is the model's own pendulum: its center of mass above the mean height of its soles at
# initial_state (computeComHeightAboveFeet), which the interface logs at start-up with omega, and which a hot reload
# without it means too. For SA01 that is 0.6124 m - the value this block used to write out by hand, measured with MuJoCo
# on zq_sa01.xml: the CoM sits 0.201 m below base_link, so 0.8135 - 0.2011 = 0.6124 - and omega = sqrt(9.81 / 0.6124) =
# 4.00 rad/s. contact_planning.textproto shared resolves its absent com_height with the same function. A positive
# com_height is an explicit override of the model; give the planner's shared.com_height the same one then.
dcm_terminal_cost {
  # LINT.IfChange(sa01_dcm_pendulum)
  # com_height [m], the pendulum height for omega: left out, the model's center of mass above its feet at initial_state.
  gravity: 9.81  # [m/s^2]
  # LINT.ThenChange(//robot_models/engineai_sa01/engineai_sa01_centroidal_mpc/config/mpc/contact_planning.textproto:sa01_pendulum)
  # Scaled from Atlas's 400 by the mass ratio (33.11 / 159.70): the cost is quadratic in a position error in meters,
  # so it has to be commensurate with the robot's weight to trade off against the same Q.
  weight_x: 85  # weight on the longitudinal DCM error
  weight_y: 85  # weight on the lateral DCM error
  velocity_offset_factor: 0  # 0..1, scales the v_cmd / omega offset of the DCM reference
  support_blend_time: 0.1  # [s] support weights ramp through lift-off / touch-down so the reference never jumps
}

# Quadratic terminal cost on the full state (terminal_cost). Read only while costs lists terminal_cost, which SA01 does
# not: it ends the horizon on dcm_terminal_cost. The hot reload applies it to a running quadratic terminal cost only.
terminal_cost_scaling: 3
final_state_weights {
  scaling: 1

  # ; Normalized Centroidal Momentum: [linear, angular] ;;
  normalized_linear_momentum {
    x: 15.0  # h_com_x / robotMass
    y: 15.0  # h_com_y / robotMass
    z: 15.0  # h_com_z / robotMass
  }
  normalized_angular_momentum {
    x: 15.0  # L_x / robotMass
    y: 40.0  # L_y / robotMass
    z: 4.0  # L_z / robotMass
  }

  # ; Base Pose: [position, orientation] ;;
  # The horizontal position is free at the terminal node - pinning where the base ends up fights the gait - while
  # height and roll stay regulated.
  base_position {
    x: 0.0  # p_base_x
    y: 0.0  # p_base_y
    z: 30.0  # p_base_z
  }
  # euler angles for base to world rotation
  base_orientation {
    yaw: 0.0  # theta_base_z
    pitch: 5.0  # theta_base_y
    roll: 85.0  # theta_base_x
  }

  # ; Joint Positions ;;
  joint_positions { joint: "leg_l1_joint" value: 1.25 }  # leg_l1_joint - left hip roll
  joint_positions { joint: "leg_l2_joint" value: 4.0 }  # leg_l2_joint - left hip yaw
  joint_positions { joint: "leg_l3_joint" value: 0.02 }  # leg_l3_joint - left hip pitch
  joint_positions { joint: "leg_l4_joint" value: 0.02 }  # leg_l4_joint - left knee
  joint_positions { joint: "leg_l5_joint" value: 0.01 }  # leg_l5_joint - left ankle pitch
  joint_positions { joint: "leg_l6_joint" value: 0.01 }  # leg_l6_joint - left ankle roll
  joint_positions { joint: "leg_r1_joint" value: 1.25 }  # leg_r1_joint - right hip roll
  joint_positions { joint: "leg_r2_joint" value: 4.0 }  # leg_r2_joint - right hip yaw
  joint_positions { joint: "leg_r3_joint" value: 0.02 }  # leg_r3_joint - right hip pitch
  joint_positions { joint: "leg_r4_joint" value: 0.02 }  # leg_r4_joint - right knee
  joint_positions { joint: "leg_r5_joint" value: 0.01 }  # leg_r5_joint - right ankle pitch
  joint_positions { joint: "leg_r6_joint" value: 0.01 }  # leg_r6_joint - right ankle roll
}

icp_cost_weights {
  icp_error_weight: 0.0
}

task_space_foot_cost {
  active_phases: "swing"  # or "swing_and_stance"
  weights {
    # pos_x / pos_y weigh the swing foot against wherever it is being told to land, and are switched off inside the cost
    # when nothing supplies a horizontal target - which is the case here, because the contact schedule is the gait
    # schedule (contact_schedule_source: gait_schedule) and nominal_foothold.step_width is 0. They are written as 0 so that
    # turning either of those on is a deliberate act.
    pos_x: 0.0
    pos_y: 0.0
    # 0 because the swing height is imposed exactly by the HARD normal_velocity constraint; nothing is left for a cost
    # to shape. It only becomes load-bearing in the contact-implicit formulation, where normal_velocity moves to
    # soft_constraints.
    pos_z: 0.0
    # This is the only thing holding the swing foot level, and it matters more on SA01 than on any other robot here:
    # its toe is 0.125 m ahead of the contact frame, so a degree of droop drops the toe 2.2 mm - more than Atlas's
    # 2.1 mm on a leg 0.15 m shorter. 1000 is G1's and R1's value.
    orientation_x: 1000.0
    orientation_y: 1000.0
    orientation_z: 0.0
    lin_velocity_x: 10.0
    lin_velocity_y: 10.0
    lin_velocity_z: 0.0
    ang_velocity_x: 1.0
    ang_velocity_y: 1.0
    ang_velocity_z: 0.005
    lin_acceleration_x: 0.0
    lin_acceleration_y: 0.0
    lin_acceleration_z: 0.0
    ang_acceleration_x: 0.0
    ang_acceleration_y: 0.0
    ang_acceleration_z: 0.0
  }
}

left_leg_torque_cost {
  scaling: 1.0e-4

  joints { joint: "leg_l1_joint" value: 2.0 }  # leg_l1_joint - left hip roll
  joints { joint: "leg_l2_joint" value: 1.0 }  # leg_l2_joint - left hip yaw
  joints { joint: "leg_l3_joint" value: 2.0 }  # leg_l3_joint - left hip pitch
  joints { joint: "leg_l4_joint" value: 8.0 }  # leg_l4_joint - left knee
  # The ankle entries are 5x R1's 0.2. SA01's ankle actuators are 24 N.m against R1's 50 N.m while the robot is
  # 15% heavier, so ankle torque is the scarcest resource on this machine and the cost has to say so. Scaled by the
  # ratio of the squared torque limits, (50/24)^2 = 4.3.
  joints { joint: "leg_l5_joint" value: 1.0 }  # leg_l5_joint - left ankle pitch
  joints { joint: "leg_l6_joint" value: 1.0 }  # leg_l6_joint - left ankle roll
}

right_leg_torque_cost {
  scaling: 1.0e-4

  joints { joint: "leg_r1_joint" value: 2.0 }  # leg_r1_joint - right hip roll
  joints { joint: "leg_r2_joint" value: 1.0 }  # leg_r2_joint - right hip yaw
  joints { joint: "leg_r3_joint" value: 2.0 }  # leg_r3_joint - right hip pitch
  joints { joint: "leg_r4_joint" value: 8.0 }  # leg_r4_joint - right knee
  joints { joint: "leg_r5_joint" value: 1.0 }  # leg_r5_joint - right ankle pitch
  joints { joint: "leg_r6_joint" value: 1.0 }  # leg_r6_joint - right ankle roll
}

contacts {
  contact_frame_translation {
    # ; Translation vector from parent joint to contact frame (center of foot support polygon) ;;
    # From leg_?6_joint (ankle roll, coincident with ankle pitch) to the center of the sole. The four contact spheres
    # of zq_sa01.xml sit at ankle-frame x = -0.065 / +0.185 with radius 0.010 at z = -0.045, so the sole plane is
    # 0.055 below the ankle and its center is 0.060 ahead of it.
    # y is 0 even though each sole is 5 mm outboard of its ankle: ContactCenterPoint reads one shared translation for
    # both feet, so the mirrored offset cannot be expressed and is absorbed into the rectangle below.
    x: 0.06
    y: 0.0
    z: -0.055
  }
  contact_rectangle {
    # ; length specified in contact frame ;;
    # The geometric support polygon is x in [-0.125, +0.125], y in [-0.035, +0.035] about the frame above (the y
    # bounds are the rectangle inscribed in BOTH soles, each of which spans -0.035..+0.045 or -0.045..+0.035 because
    # of the 5 mm outboard offset).
    #
    # x_max is NOT the geometric +0.125. SA01's ankle pitch actuator is 24 N.m and the robot weighs 324.8 N, so in
    # SINGLE support the ankle can only hold the center of pressure within 24 / 324.8 = 0.074 m of the ankle joint,
    # i.e. contact-frame x in [-0.134, +0.014]; in double support, with half the weight per foot, the budget doubles
    # to +-0.148 m and x_max becomes +0.088. Nothing in the MPC knows about ankle torque limits - the wrench cone
    # bounds the center of pressure geometrically only - so a geometric x_max of +0.125 would let the solver plan a
    # forward CoP the ankle physically cannot hold and SA01 would pitch over its toes. 0.09 is the double-support
    # budget, which is the regime in which the forward CoP is actually used, during weight transfer.
    #
    # If the 24 N.m in the URDF turns out to be a motor-side figure ahead of a reduction, raise this to the geometric
    # 0.125 and delete this note. If SA01 still pitches forward in single support, lower it towards +0.014.
    # The heel side needs no such cap: the geometric -0.125 is already inside the -0.134 the ankle can hold.
    # Laterally the ankle roll actuator is the same 24 N.m, giving a +-0.074 m budget against a +-0.035 rectangle,
    # so the y bounds are purely geometric.
    x_max: 0.09
    x_min: -0.125
    y_max: 0.035
    y_min: -0.035
  }

  contact_wrench_cone_soft_constraint {
    # The ground of the whole-body constraints. Its five geometry keys (all but mu and delta) are required: the
    # loader refuses a missing one rather than keep a library default. Under contact_input_parameterization: wrench
    # they are the soft constraint contact_wrench_cone; under basis_vectors (as shipped) the same values build the
    # wrench-cone generators instead and that soft constraint is not built. Every generator lies inside the cone, so its friction,
    # center-of-pressure and torsional limits are never exceeded; with the shipped conservative_inner_approximation set
    # the MPC can use only a small part of the cone (no tangential force with the CoP at the toe, none at the torsional
    # limit), with exact_wrench_cone all of it (contacts.basis_generator_set below). min_normal_force and gripper_force are
    # then NOT enforced: a conic combination is homogeneous and cannot represent an affine offset of the cone. The
    # interface logs a warning when they are non-zero. The online contact planner derives its friction and torsion
    # bounds from this block as well.
    # 0.5 against the 1.0 the MuJoCo floor actually provides (zq_sa01.xml), so the plan stays inside what the ground
    # can deliver.
    friction_coefficient: 0.5
    torsional_friction_coefficient: 0.05
    min_normal_force: 5
    gripper_force: 0
    num_basis_vectors: 4  # friction pyramid facets (and the pyramid edges of the basis generators)
    # relaxed log barrier parameters
    mu: 0.2
    delta: 5
  }

  # Generator set of the basis-vector contact inputs, by registry name (contact_input_parameterization: basis_vectors):
  #   conservative_inner_approximation  N + 7 generators per foot: sound, but a strongly conservative inner
  #                                     approximation of the cone above (shipped)
  #   exact_wrench_cone                 8N generators spanning exactly that cone (32 scalings per foot for N = 4)
  # It fixes the input dimension, so it takes effect at start-up only. exact_wrench_cone has not been validated in
  # closed loop yet. See humanoid_nmpc/docs/contact_basis_vectors/README.md.
  # LINT.IfChange(basis_generator_set_config)
  basis_generator_set: "conservative_inner_approximation"
  # LINT.ThenChange(//humanoid_nmpc/humanoid_common_mpc/include/humanoid_common_mpc/contact/ContactWrenchConeBasisMatrix.h:basis_generator_set_names)

  # Barrier penalty enforcing lambda >= 0 for basis-vector contact inputs (contact_input_parameterization: basis_vectors).
  # Under that parameterization this barrier IS the contact wrench cone, so it is built for every contact whatever
  # soft_constraints lists, and gated on the mode schedule exactly when zero_wrench is. Hot-reloaded.
  basis_non_negativity_barrier {
    mu: 0.01
    delta: 0.001
  }

  # Regularization of the basis-vector scalings lambda in the input cost (contact_input_parameterization: basis_vectors).
  # R is written for the contact-frame wrench W = B*lambda and becomes R_basis = M^T*R*M + basis_scaling_regularization *
  # blkdiag(S, 0). Each foot has more generators than wrench components, so M^T*R*M alone is singular; S removes that,
  # chosen by name (basis_regularization):
  #   full_diagonal  S = I (shipped). The optimizer then sees R + reg * (B*B^T)^-1 on the wrench, and the second term
  #                  can dominate R's tangential and moment weights (it does on the DRC Atlas).
  #   null_space     S = I - B^+ B: only the lambda that produce no wrench are penalized, and R acts unchanged on the
  #                  wrench. Not validated in closed loop yet.
  # Both are hot-reloaded; a reload naming an unknown shape, or leaving the lambda block indefinite, is refused and the
  # running R kept. See humanoid_nmpc/docs/contact_basis_vectors/README.md, section 5.
  basis_scaling_regularization: 0.0001
  # LINT.IfChange(basis_regularization_config)
  basis_regularization: "full_diagonal"
  # LINT.ThenChange(//humanoid_nmpc/humanoid_common_mpc/include/humanoid_common_mpc/common/BasisInputsCostTransform.h:basis_regularization_names)

  # Read only when friction_force_cone / contact_moment_xy are listed in soft_constraints instead of the combined
  # contact_wrench_cone above.
  friction_force_cone_soft_constraint {
    friction_coefficient: 0.5
    # relaxed log barrier parameters
    mu: 0.2
    delta: 5.0
  }

  contact_moment_xy_soft_constraint {
    # relaxed log barrier parameters
    mu: 0.6
    delta: 0.03
  }
}

joint_limits {
  # relaxed log barrier parameters. delta is 0.1 rad, so the barrier starts paying 0.1 rad before a limit: the knee's
  # 0.0 rad lower bound is 0.70 rad away at the nominal crouch, and the ankle pitch's -1.0 rad bound 0.60 rad away.
  mu: 1200.0
  delta: 0.1
}

collision_constraint {
  foot {
    left_ankle_frame: "leg_l6_joint"
    right_ankle_frame: "leg_r6_joint"

    # The constraint keeps the two contact frames 2 * radius apart. SA01's ankles are 0.1503 m apart at the nominal
    # stance. The MuJoCo contact spheres nearest the centerline sit 0.035 m inboard of each ankle with a 0.010 m
    # radius, so the feet physically touch once the ankles close to 0.1503 - 0.0802 + 0.020 = 0.0901 m.
    # 0.045 puts the bound at exactly 0.090 m, i.e. the constraint engages essentially where the feet really meet -
    # there is no margin beyond it, which is what SA01's 0.150 m hip spacing allows and no more. It cannot simply be
    # raised: the relaxed barrier is 0.05 m wide (delta below), so a radius above 0.050 would have the term pushing
    # the feet apart while the robot merely stands at its 0.1503 m nominal stance.
    foot_collision_sphere_radius: 0.045
  }
  knee {
    left_knee_frame: "leg_l4_joint"
    right_knee_frame: "leg_r4_joint"

    # Same reasoning: the knees are 0.150 m apart at the nominal stance and the 0.04 m thigh capsules of zq_sa01.xml
    # touch at 0.080 m.
    knee_collision_sphere_radius: 0.045
  }
  # relaxed log barrier parameters
  mu: 30000
  delta: 0.05
}
