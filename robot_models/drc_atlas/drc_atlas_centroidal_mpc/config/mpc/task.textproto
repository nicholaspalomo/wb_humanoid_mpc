# proto-file: humanoid_nmpc/humanoid_mpc_config/task_file.proto
# proto-message: humanoid_mpc_config.TaskFile
# Simulation & Telemetry Configuration
# Where the robot process sends its telemetry (robot/state), by name (TelemetrySinkRegistry.h): bus publishes it on
# the IPC bus for the visualization publisher, the Rerun bridge and ipc_tool; no telemetry_sinks line turns the
# telemetry off.
# LINT.IfChange(telemetry_sinks)
telemetry_sinks: "bus"
# LINT.ThenChange(//humanoid_nmpc/humanoid_common_mpc_app/robot/include/humanoid_common_mpc_app/robot/TelemetrySinkRegistry.h:telemetry_sink_names)
telemetry_frequency: 100  # [Hz] robot/state, decimated from the control loop
# MuJoCo backend of the robot process only. The viewer's contact timeline ('b' toggles it) shows, per contact point,
# the contact state the executed MPC policy plans against the simulator's ground truth over a sliding window of time.
sim_contact_timeline_window: 5  # [s] width of the sliding window
sim_contact_force_threshold: 5  # [N] normal force above which a contact point counts as touching (ground truth)
# Fall recovery (SimFallRecovery, humanoid_nmpc/docs/mpc_reset/README.md). sim_max_base_tilt_angle is the tilt of the base
# past which the simulator catches the robot on the gantry, holding it upright where it is at the gantry height,
# switching to JOINT_PD (the whole-body MPC is overconstrained against a pinned base) and resetting the controller, which
# holds the robot until it has planned from where the robot is now. The simulator's own resets (base below the floor
# limit, an unstable step) are caught the same way. The remote control follows the lock and re-centers its joysticks,
# so a stick left forward cannot keep commanding a walk into a robot hanging from the harness. The measure is the angle
# between the base's own vertical and the world vertical, so it is heading independent: 0 upright, pi/2 on its side, pi
# upside down. 0 disables the catch and leaves a fallen robot where it lands, which is what you want when the fall
# itself is the thing being studied. 1.0 rad (57 deg) is past any recoverable lean.
# sim_gantry_catch_lift is how far the gantry then lifts the caught robot so that its feet clear the ground: JOINT_PD brings
# the legs back to the nominal posture, the gantry lowers the robot back onto its feet, and WB_MPC is refused until it
# rests there. Caught at its standing height with its feet loaded where they landed, the robot hung pitched and fell
# again within two seconds of the unlock. 0 skips the sequence and accepts WB_MPC at once. Simulation only.
sim_max_base_tilt_angle: 1  # [rad] 0 disables
sim_gantry_catch_lift: 0.15  # [m] 0 skips the settle sequence
# Measured contact state of the controller, by name (robot_model/ContactEstimatorRegistry.h): the MPC observation mode and
# which planned contact wrenches the inverse dynamics projects into feedforward torques. One of:
#   cheater_sim        the ground truth of the physics (normal force above sim_contact_force_threshold); required for the
#                      phase_resetting execution rule of contact_planning.textproto
#   robot_state        the contact flags of the RobotState (in MuJoCo the same ground truth)
#   always_in_contact  every contact point touching: the executed schedule is taken as the measured contact state
# How the virtual gantry holds the floating base while it is locked. Two different physical models, so the name selects
# one rather than a boolean switching a feature on:
#   weld_constraint    a MuJoCo weld the solver satisfies INSIDE mj_step, so the base is really supported while the
#                      dynamics are integrated. This is what a physical gantry does, and the only setting under which
#                      GRAVITY_COMP holds the limbs still.
#   kinematic_teleport legacy: qpos/qvel are overwritten just BEFORE mj_step, leaving the base unsupported during the
#                      step. The robot is then in free fall while integrating, and a free-falling chain in uniform
#                      gravity needs zero joint torque to keep its shape, so the commanded gravity torque is entirely
#                      surplus lift: measured ~130 deg of joint drift in 3 s, into the stops. Kept only to reproduce
#                      recorded runs.
# LINT.IfChange(gantry_hold)
gantry_hold: "weld_constraint"
# LINT.ThenChange(//robot_runtime/mujoco_sim_interface/include/mujoco_sim_interface/MujocoSimInterface.h:gantry_hold_names)
# LINT.IfChange(contact_estimator)
contact_estimator: "cheater_sim"
# LINT.ThenChange(//robot_runtime/robot_model/src/ContactEstimatorRegistry.cpp:contact_estimator_names, //robot_runtime/mujoco_sim_interface/src/CheaterSimContactEstimator.cpp:cheater_sim_contact_estimator_name)

# The ball the GUI's Dodgeball tab throws, by name (robot_runtime/mujoco_sim_interface/.../Projectile.h). MuJoCo
# compiles its model once at load and bodies cannot be added afterwards, so naming one here appends a free-floating
# sphere to the scene BEFORE it is compiled. Until a throw arms it, it is parked 100 m above the scene with its
# collisions off and its weight held by gravity compensation; it is parked again once it has come to rest, after ten
# seconds in play at most, and whenever the robot is caught on the gantry.
#
#   dodgeball   a regulation 0.216 m sphere of 0.45 kg (the GUI's mass slider sets 0.1-5 kg per throw) that bounces
#               back at 0.80 of the speed it arrived at. MuJoCo has no restitution parameter: it is converted to the
#               contact damping ratio solref needs by the logarithmic decrement (0.80 gives 0.0708), and the ball's
#               contact parameters take priority over the floor's and the robot's so that it is the bounce it gets.
#
# Remove the key, or set it empty, to compile the scene exactly as it is on disk. The Throw button then still works:
# with no ball to fly, the simulator applies the momentum the ball would have ARRIVED with as a one-step force on the
# base - a lower bound on the push, since a real ball that bounces off hands over more.
#
# Simulation only. It changes nothing about the MPC, and a contact with the ball is excluded from the ground-truth
# contact mask and from the ZMP marker, so a ball against a swing foot is never mistaken for the ground.
# LINT.IfChange(sim_projectile)
sim_projectile: "dodgeball"
# LINT.ThenChange(//robot_runtime/mujoco_sim_interface/src/Projectile.cpp:projectile_names)

# Viewer visualizations (each listed one starts on; the key in brackets toggles it, 'p' prints the cheatsheet). Every
# marker is a class in robot_runtime/mujoco_sim_interface/.../visualization; the names are those of VisualizationRegistry.
# LINT.IfChange(sim_visualizations)
sim_visualizations: "metrics"  # render/sim FPS, real-time factor and drift (top-left text)
sim_visualizations: "external_forces"  # arrows of the external forces applied to the bodies (pushes)
sim_visualizations: "contact_forces"  # arrows of the physical contact forces on the robot
sim_visualizations: "base_velocity"  # measured (red) vs commanded (green) base velocity and yaw rate at the CoM
sim_visualizations: "contact_timeline"  # [b] barcode of planned vs ground-truth contact per contact point
sim_visualizations: "target_contact_patches"  # [g] contact patch of every foot at the planner's target position and yaw
sim_visualizations: "center_of_mass"  # [o] whole-body center of mass: sphere, vertical, and its shadow on the ground
sim_visualizations: "zmp"  # [z] zero moment point of the physical ground reaction, on the ground
sim_visualizations: "dcm"  # [d] divergent component of motion (capture point) of the measured CoM, on the ground
# MuJoCo's own markers, off unless listed:
# sim_visualizations: "mj_contact_points"     # [c] markers at the physical contact points
# sim_visualizations: "mj_contact_forces"     # [f] MuJoCo's normal and friction force arrows at the contacts
# sim_visualizations: "mj_com"                # [m] center of mass markers of the bodies
# sim_visualizations: "mj_inertia"            # [i] equivalent inertia ellipsoids
# sim_visualizations: "mj_convex_hull"        # [h] convex hulls of the meshes
# sim_visualizations: "mj_transparent"        # [t] model transparency (x-ray view)
# LINT.ThenChange(//robot_runtime/mujoco_sim_interface/src/visualization/VisualizationRegistry.cpp:visualization_names)
enable_online_tuning: true  # Enable runtime parameter and gain tuning in Controller GUI
# How the MPC parameterizes its contact inputs, by name (ContactInputParameterization.h):
#   wrench         each foot's input is its 6-D contact wrench, and the contact wrench cone is a soft constraint of the
#                  lists below (the default when the key is absent)
#   basis_vectors  each foot's input is the scalings lambda of wrench-cone generators, W = B lambda; the cone becomes
#                  the lambda >= 0 barrier (contacts.basis_non_negativity_barrier), and contacts.basis_generator_set and
#                  contacts.basis_regularization choose B and the regularization of the input cost (shipped here)
# It fixes the input dimension, so it takes effect at start-up only.
# See humanoid_nmpc/docs/contact_basis_vectors/README.md.
# LINT.IfChange(contact_input_parameterization_config)
contact_input_parameterization: "basis_vectors"
# LINT.ThenChange(//humanoid_nmpc/humanoid_common_mpc/include/humanoid_common_mpc/common/ContactInputParameterization.h:contact_input_parameterization_names)
# CoM + Angular Center of Mass (ACoM) tracking in place of base-pose tracking is the cost com_and_acom_tracking_cost,
# listed in `costs` below (it replaced the useComAndAcomTracking key, which the loader now refuses). Likewise the DCM
# (capture point) terminal cost is the entry dcm_terminal_cost of `costs`, in place of terminal_cost (it replaced the
# useDcmTerminalCost key, which the loader now refuses).
# Where the mode schedule and the footholds come from, by name (MpcFormulationConfig.h):
#   gait_schedule    the clock-driven gait schedule of the reference files, with the nominal footholds (shipped here,
#                    and the default when the key is absent)
#   contact_planner  plan the contact sequence, timing and footholds online with the contact planner that planner.type
#                    in contact_planning.textproto names (hlip, the closed-form H-LIP planner, as shipped); it replaces the
#                    gait schedule. Raise task_space_foot_cost.weights.pos_x / pos_y first: at 0, as shipped, the
#                    planned footholds carry no weight in the MPC (CentroidalMpcInterface warns at start-up).
# It replaced the useContactPlanning key, which start-up now refuses, and takes effect at start-up only. The planner's
# parameters are contact_planning.textproto next to this file (hot-reloaded and edited by the
# tuning GUI like this file). See humanoid_nmpc/docs/README.md, section 2.
# LINT.IfChange(contact_schedule_source_config)
contact_schedule_source: "gait_schedule"
# LINT.ThenChange(//humanoid_nmpc/humanoid_common_mpc/include/humanoid_common_mpc/common/MpcFormulationConfig.h:contact_schedule_source_names)

# Weights for CoM and ACoM tracking (read while com_and_acom_tracking_cost is listed in `costs`).
#
# With the cost listed, the factory zeroes the base pose block of BOTH Q and
# final_state_weights (indices 6..11), so the weights below are the only thing regulating base
# position and orientation. They start out mirroring the Q entries they replace.
# Under terminal_cost the terminal node gets its own ComAndAcomTrackingCost, weighted by
# terminal_cost_scaling times these; under the DCM terminal cost (dcm_terminal_cost, as
# shipped) there is none, and the DCM cost is what the horizon ends on.
#
# Tuning note: the aCOM coordinate is essentially an integral of the centroidal
# angular momentum that Q entries (3,3) and (4,4) already penalize, so the two
# terms compete. If torso rotation feels over-damped, lower L_x / L_y before
# lowering acom_weights. Expect acom_weights to need reducing relative to the base pose
# weights it replaces, because the learned coordinate carries roughly 17% model
# error that the directly measured base pose did not.
# Every entry here is multiplied by `scaling`, so the effective weights are 2125, 2125 and 1275. The x and y entries
# carried the word "unpenalized" while sitting at 2125 - they were 0 until the tuning pass in 4a94058 raised them, and
# the comment was not updated. They are NOT unpenalized: the horizontal CoM is regulated hard against p_com(q_ref),
# which for a walking robot is a moving target the gait is meant to be free to lead or lag. If stepping feels like it
# is fighting a horizontal spring, this is the first place to look.
com_weights {
  scaling: 85
  x: 25  # p_com_x - effective weight 2125, matches p_base_x
  y: 25  # p_com_y - effective weight 2125, matches p_base_y
  z: 15  # p_com_z - effective weight 1275, matches p_base_z
}

# ACoM rows follow the centroidal state's ZYX Euler convention, the same ordering
# as Q entries (9,9) through (11,11). Row 0 is yaw, not roll.
acom_weights {
  scaling: 100
  yaw: 25  # theta_acom_z / yaw (matches theta_base_z)
  pitch: 150  # theta_acom_y / pitch (matches theta_base_y)
  roll: 50  # theta_acom_x / roll (matches theta_base_x)
}

# The visualization publisher of the MPC node (humanoid_nmpc/humanoid_common_mpc_app/visualization/README.md), read at
# start-up. rerun_scene_frequency bounds how often the Rerun scene (robots and markers) is sent; the plots follow every
# robot/state sample. telemetry_frames are the frames whose pose, twist, acceleration and wrench are plotted, measured,
# reference and plan; rerun_plan_frames (the contact frames when absent) those whose planned paths the scene draws.
rerun_scene_frequency: 30  # [Hz] viz/scene at most this often
# Targeted Pinocchio frames for telemetry logging (position, orientation, twist, accel, wrench)
telemetry_frames: "foot_l_contact"
telemetry_frames: "foot_r_contact"
telemetry_frames: "pelvis"
telemetry_frames: "utorso"

centroidal_model: "full_centroidal_dynamics"  # or "single_rigid_body_dynamics"

# MPC Problem Formulation Tasks
# Which contact formulation runs. As shipped the mode schedule gates the contact constraints: the swing foot's wrench is
# forced to zero and the stance foot is held still, both from the schedule the contact planner produced, so the MPC cannot
# depart from that schedule. The contact-implicit alternative below replaces those two with the relaxed complementarity
# conditions of rigid contact and lets the solver decide where each foot carries load, which is the second half of
# arXiv:2502.15630 (humanoid_nmpc/docs/contact_implicit_mpc/README.md). It changes the closed loop, so it is off until it
# has been validated in MuJoCo: to switch, drop zero_wrench, zero_velocity AND normal_velocity below and add the four
# entries marked `contact-implicit` (normal_velocity among them) to soft_constraints;
# humanoid_nmpc/docs/contact_implicit_mpc/README.md section 5 lists what else has to be set. The MPC's start-up
# (mpcFormulationTasksFromConfig) refuses the half-way combinations.
#
# normal_velocity has to go from hard_constraints with the other two. It is a HARD equality on the contact frame's
# vertical velocity for every foot the schedule calls a swing foot, so - the foot's height at lift-off being given - it
# fixes the entire height profile of the swing. The solver can then neither land early, nor land late, nor keep a foot
# down, which are the three freedoms the contact-implicit formulation exists to provide; and where it does want load
# early, the only variable left is the normal force, so the complementarity product gets driven to zero by removing the
# force instead of by closing the gap.
#
# But it must be LISTED IN soft_constraints in its place, and that is not optional either. Deleting it outright leaves
# nothing with the authority to lift a foot: the only remaining vertical term is task_space_foot_cost.weights.pos_z at
# 150, against the leg-joint entries of Q, which regularize the swing leg towards a standing crouch whose reference is
# the foot ON THE FLOOR. That is roughly a 100:1 fight, the static equilibrium swing height is a couple of millimeters,
# and - because the same leg is about eighty times more compliant horizontally than vertically at this crouch - the
# solver slides the foot instead of lifting it. The robot shuffles. As a soft constraint the same row shapes the swing
# and is overruled whenever anything else pays more, which is what the formulation wants of a schedule-derived
# reference; its weight is model_settings.foot_constraint.normal_velocity_soft_constraint_weight.
hard_constraints: "zero_wrench"  # remove for the contact-implicit formulation
hard_constraints: "normal_velocity"  # remove for the contact-implicit formulation
hard_constraints: "zero_velocity"  # remove for the contact-implicit formulation

# The names below are the soft-constraint registry's (MpcFormulationConfig.cpp).
# LINT.IfChange(contact_implicit_soft_constraints)
soft_constraints: "joint_limits"
soft_constraints: "foot_collision"
soft_constraints: "contact_wrench_cone"  # wrench inputs: friction, CoP and torsion in one relaxed-barrier term.
                                    # Under basis_vectors (as shipped) the lambda >= 0 barrier is the cone and
                                    # this entry builds nothing.
# soft_constraints: "normal_velocity"                 # contact-implicit: the swing-foot vertical servo, PRICED instead of imposed.
                                  #   Required whenever normal_velocity is dropped from hard_constraints above, or
                                  #   nothing has the authority to lift a foot and the robot shuffles.
# soft_constraints: "contact_complementarity"         # contact-implicit: f_n * h = 0, load only where the foot touches the ground
# soft_constraints: "force_weighted_slip"             # contact-implicit: f_n * v_xy = 0, a loaded foot is held still
# soft_constraints: "ground_penetration"              # contact-implicit: h >= 0; the three contact-implicit terms are listed together
                                  #   or not at all
# LINT.ThenChange(//humanoid_nmpc/humanoid_common_mpc/src/common/MpcFormulationConfig.cpp:soft_constraint_registry, //humanoid_nmpc/humanoid_common_mpc/src/common/MpcFormulationConfig.cpp:soft_constraint_names)

# The nominal foothold reference, used only under contact_schedule_source: gait_schedule. Without a contact planner the
# swing foot has no horizontal target at all - the foot cost switches its xy position weights off - and the only thing
# that ever fixed foot placement was the stance foot being pinned by the zero_velocity constraint. The contact-implicit
# terms below remove that pin by design, so with both off nothing has an opinion about where the feet go sideways: they
# drift together until the robot falls. A positive step_width restores a target, placing each foot that far to its own
# side of the reference base pose and letting forward placement follow the commanded motion.
#
# It is a foot placement heuristic, which is what the reduced-order planner exists to avoid. It ships at 0.45, which is
# inert while task_space_foot_cost.weights.pos_y is 0: to test the contact-implicit formulation without the contact
# planner, set pos_y as well.
#
# step_width is the full distance between the feet: each foot is placed a whole step_width to its own side of the STANCE
# foot, carried forward at the commanded velocity over one step (SwitchedModelReferenceManager::nominalFoothold). How hard
# the foot is held to that target is task_space_foot_cost.weights.pos_x / pos_y, the same weights the planned foothold
# uses, so tuning them here carries over to contact_schedule_source: contact_planner. pos_y is the one that keeps the feet
# apart.
nominal_foothold {
  step_width: 0.45  # [m] lateral distance between the feet; 0 disables the nominal reference
}

# [m] Where the ground is, for everything that needs to know: the swing trajectories, the landing targets, and the
# contact-implicit complementarity and ground-penetration terms. There used to be two answers - the reference manager
# computed an estimate from the stance feet and discarded it, returning a hard-coded 0, while the contact-implicit
# terms read their own `contact_implicit.terrain_height`. They agreed only because both were pinned to the same
# constant. A flat ground is correct here because every layer of this stack assumes one, the reduced-order contact
# planner most of all; a measured estimator would belong here as a named selection, not as a second constant.
# Hot-reloadable: the parameter updater hands a new value to the reference manager, which owns the ground and rebuilds
# the swing trajectories and the landing targets on it at the next solve, and the contact-implicit terms follow it in
# that same solve - so the two never see different grounds. The base-height reference follows it: default_base_height and
# the commanded pelvis height are heights above this ground (TargetTrajectoriesCalculatorBase::commandedBaseHeight,
# which in the MPC reads the reference manager's applied ground), and a reload moves the target in use once
# (SwitchedModelReferenceManager::adaptToCurrentGroundHeight).
terrain_height: 0

# Weights of the contact-implicit terms above; read whether or not they are listed, ignored when they are not. Every
# key is hot-reloadable, and a key the block does not define (ModelSettings::contactImplicitKeys()) is refused at
# start-up and on a reload rather than ignored.
contact_implicit {
  # The two residuals are normalized before they are penalized: (f_n/f_ref)(h/h_ref) and (f_n/f_ref)(v/v_ref), with
  # f_ref the robot's weight taken from the model. So the two weights below are dimensionless and comparable with each
  # other - though NOT with task_space_foot_cost, whose residuals are in meters (README section 4: pos_z prices
  # a foot at the swing apex at 0.5 * pos_z * height_reference^2, and the two break even at a swing-foot load of
  # f_n / f_ref = height_reference * sqrt(pos_z / complementarity_weight)) - and each is the cost of the worst case its
  # term can describe - a foot at the reference height, or sliding at the reference speed, carrying full body weight.
  #
  # They used to weight the raw products in N m and N m/s, which no single number could do. A quadratic penalty on
  # f_n h puts a curvature of w f_n^2 on the foot height, and on this robot f_n^2 ranges over nine orders of magnitude
  # between a foot in flight and a foot carrying all 160 kg. Even at 50, a swing foot leaking 50 N was held in z more
  # than a thousand times as stiffly as by pos_z - and since f_n h = 0 is satisfied just as well by putting the foot
  # down as by taking the force off it, the cheapest way to pay was to land early. See
  # humanoid_nmpc/docs/contact_implicit_mpc/README.md.
  complementarity_weight: 50  # the price of carrying full body weight at the reference height
  slip_weight: 150  # the price of sliding at the reference speed under full body weight
  # Weight of the one-sided quadratic hinge on h >= 0: the cost is penetration_weight * h^2 / 2 below the ground and
  # exactly zero on or above it. This was a relaxed log barrier (mu 0.1, delta 0.01), which is the wrong object for a
  # condition whose solution lies ON the boundary: a log barrier never reaches zero, so its derivative was
  # -2*mu/delta = -20 at h = 0 and upward at every height. The only term pulling a foot back down was the
  # complementarity penalty, and balancing the two left a fully loaded foot 2.3 mm off the ground and a foot at half
  # body weight - i.e. both feet, throughout double support - 6.8 mm off it, carrying a permanent complementarity
  # residual that no weight could tune away. The hinge is zero in value AND gradient at h = 0, so it simply does nothing
  # until the foot is actually below ground.
  #
  # 5e4 puts a 1 cm penetration at a gradient of 500, decisively above everything that could push a foot down there
  # (task_space_foot_cost.weights.pos_z contributes about 1 at that depth), while its curvature is the same order as
  # the complementarity term's own (complementarity_weight / height_reference^2 = 7.8e3), so it does not wreck the QP's
  # conditioning.
  penetration_weight: 5.0e4  # weight of the hinge on h >= 0
  # Where the ground is is NOT here: it is the top-level `terrain_height` above, so that the complementarity conditions
  # and the swing trajectories cannot be configured against two different grounds.
  # The references the residuals are measured in. height_reference should track swing_trajectory_config.swing_height:
  # it is the height at which a fully loaded foot is as wrong as this term can describe.
  height_reference: 0.08  # swing trajectory height reference [m]
  # A slide and a pivot that would already be failures. These are what make the residual dimensionless, so they belong
  # at the scale of a real failure rather than at the scale of solver noise: at 0.03 m/s the slip term's curvature on a
  # loaded foot's tangential velocity is slip_weight / 0.03^2 = 1.7e5, which is effectively a hard constraint and a
  # hundred times the scale the normalization argument in the README was written for.
  velocity_reference: 0.3  # [m/s] a sliding speed that would already be a failure
  angular_velocity_reference: 1.0  # [rad/s] a pivot rate that would already be a failure
  # The gap in the complementarity product is the height of the LOWEST footprint corner, the same points the
  # penetration hinge uses - not the center of the sole. A foot rocked onto its heel reads a positive center height
  # while it is carrying the whole robot, and the product then charges for a contact that physically exists. The exact
  # minimum of the four corners is not differentiable at a flat foot, which is most of stance, so it is blended over
  # this length. The blend never reports less clearance than the true minimum, and over-reports by
  # gap_smoothing * log(4 / k) where k is how many corners are down: nothing for a flat foot, 0.69 mm for an edge - the
  # ordinary heel strike - and 1.39 mm in the worst case of a single corner. The penetration hinge answers those with
  # about 0.05 mm and 0.19 mm of penetration respectively.
  gap_smoothing: 1.0e-3  # [m] length scale the footprint corners' minimum height is blended over
}
costs: "state_quadratic_cost"
# Regulates the whole-body CoM and the ACoM (com_weights, acom_weights) instead of the base pose: Q's and final_state_weights's base-pose
# blocks are zeroed and the procedural arm swing is off. Atlas's is the one validated ACoM network
# (robot_models/drc_atlas/README.md); centroidal MPC only (humanoid_learning/acom/README.md, section 4).
costs: "com_and_acom_tracking_cost"
costs: "input_quadratic_cost"
# The horizon ends on the DCM (capture point) viability cost (the dcm_terminal_cost block). Its alternative is
# terminal_cost, the quadratic final_state_weights cost; the two are never listed together (start-up refuses both).
costs: "dcm_terminal_cost"
costs: "icp_cost"
costs: "task_space_foot_cost"
costs: "task_space_torso_cost"
costs: "external_torque_cost"

# ---------------------------------------------------------------------------------------------------------------
# Locomotion heuristics: the regularization heuristics of Gerardo Bledt, "Regularized Predictive Control Framework
# for Robust Dynamic Legged Locomotion", MIT 2020, Appendix C. Derivations, a block diagram and the seam of every
# name below are in humanoid_nmpc/docs/locomotion_heuristics/README.md.
#
# This is a reference-SHAPING layer, not a new cost family. Nothing here adds a term to the optimal control problem:
# every name modifies a reference that a cost this file ALREADY lists regularizes against, which is what RPC means
# by regularization. Three channels, three lists, three seams:
#
#   base_pose  the roll, pitch and height of the base-pose reference that Q(11,11), Q(10,10) and Q(8,8) track - and
#              final_state_weights and the torso task-space cost with them - shaped per shooting node in
#              SwitchedModelReferenceManager::shapeBasePose(). Without a heuristic that reference carries a HARD ZERO
#              for roll and pitch - the target calculator writes targetPose[4] = targetPose[5] = 0.0 on every call - so
#              anything listed here is the first opinion this MPC has about how the base is carried. It is a function
#              of the operator's COMMANDED velocity. Inert while costs lists com_and_acom_tracking_cost, because
#              the cost factory zeroes Q's base-pose block in that mode; start-up warns.
#   foothold   the landing target of the swing foot, shaped in nominalFoothold() and re-evaluated at every solve, which
#              the foot task-space cost tracks through task_space_foot_cost.weights.pos_x / pos_y. The target is the
#              base PREDICTED at touch-down plus the heuristics' offsets, so it holds still through the swing. REQUIRES
#              contact_schedule_source: gait_schedule and is rejected at start-up under contact_planner: the online
#              planner supplies footholds itself and never consults these. Also rejected: a list without
#              hip_centered_stepping on a robot whose nominal_foothold.step_width is 0, since nothing would then keep the
#              feet apart. They do nothing while pos_x and pos_y are 0; start-up warns.
#   wrench     the contact-force reference the input costs regularize against, shaped in getDesiredInput(). That
#              reference is otherwise weight compensation and nothing else: m*g split evenly over the feet the mode
#              schedule calls stance feet, purely vertical.
#
# THE COEFFICIENTS BELOW ARE DERIVED FOR THIS ROBOT, AND ALL THREE LISTS ARE STILL EMPTY. Those are two separate
# switches on purpose: `make derive-heuristic-parameters ROBOT=drc_atlas` regenerates every number below from this
# robot's URDF, gait and command limits, so the starting point is ready - but nothing is turned on until a name is
# uncommented, and each of these still changes the closed loop.
#
# ALL THREE LISTS ARE EMPTY, deliberately. Each changes the closed loop and none has been validated in simulation
# under hardware-like conditions on this robot; Bledt's own coefficients were fitted to a 9 kg quadruped. Uncomment
# ONE name - just its `base_pose:`, `foothold:` or `wrench:` line, each of which adds one entry to its list - sweep its
# block in MuJoCo, and only then move to the next, which is how the dissertation itself proceeds (section 4.3,
# figure 4-13: one heuristic per panel, the viable operating region measured after each).
#
# The list is the switch and the block is the tuning. The blocks below carry DERIVED, non-zero coefficients, so on this
# robot uncommenting a name IS the closed-loop change: the number is live the moment the name is listed. To check that
# listing a name changes nothing by itself - a useful first experiment - zero its block before uncommenting it. The
# analytic heuristics of Table C.1 (hip_centered_stepping, capture_point, impulse_scaling, centripetal_acceleration)
# have no fitted coefficients, only unit scales, so for those four the list entry is the change either way.
#
#
# ATLAS NOTES. This robot already ships nominal_foothold.step_width: 0.45 - the only one that does - so the foothold
# heuristics here keep that lateral separation from the stance foot, unless hip_centered_stepping is listed, which
# takes it from the hips instead. Both are inert today regardless: task_space_foot_cost.weights.pos_x and pos_y are 0,
# so the landing target is computed and then multiplied by zero, and start-up says so. Raise those weights before
# drawing any conclusion from a foothold heuristic on this robot. Likewise costs lists com_and_acom_tracking_cost here,
# which makes the three base-pose heuristics inert (start-up warns); remove it to try them.
#
# Note for the tuning GUI: slider ranges are derived from the value, so a coefficient at 0 gets a (0, 1) slider and
# cannot be dragged negative. Several of these are physically negative (height_compensation.height_per_speed, for one).
# Type the value into the entry box, which widens the bounds.
#
# Orientation sign: the base pose is Euler ZYX about a z-up world, so a POSITIVE pitch puts the nose DOWN. Leaning
# into a forward command is therefore a POSITIVE pitch_per_forward_velocity - the sign of Bledt's own fitted +0.0725.
locomotion_heuristics {
  # Each list ships empty, its candidate names commented out below, one line per entry, so that uncommenting a line
  # adds that name to its list. The offsets within a list are SUMMED, so the order here is
  # documentary only - unlike the contact planner's `costs` list, where order is the floating-point accumulation order.
  # base_pose: "orientation_compensation"   # H_Theta(pdot): roll from lateral speed, pitch from forward speed
  # base_pose: "periodic_orientation"       # H_Theta(Phi):  roll/pitch limit cycle in the gait phase
  # base_pose: "height_compensation"        # H_z(v):        base height against speed
  # foothold: "hip_centered_stepping"      # H_r(Theta):        foot under its own hip - READ ITS BLOCK BELOW FIRST
  # foothold: "capture_point"              # H_r(pdot, Phi):    step into the velocity ERROR
  # foothold: "translational_stepping"     # H_r(pdot):         step in the direction of travel
  # foothold: "in_place_turning"           # H_r(psidot):       step along the turn arc
  # foothold: "high_speed_turning"         # H_r(pdot x omega): step outward along the turn radius
  # wrench: "impulse_scaling"            # H_f(Phi):            stance force scaled by 1 / duty factor
  # wrench: "centripetal_acceleration"   # H_f(Theta x pdot):   the horizontal force of a turn - SEE ITS BLOCK BELOW

  # ---- one parameter block per heuristic, keyed by the heuristic's own registry name ----

  # H_Theta(pdot) = a1 * pdot + a0  (Table C.2, equations 4.11 and 4.12). The velocity is the COMMANDED CoM velocity
  # in the reference base's yaw frame, so a1 is a lean per unit of commanded speed and a0 a standing trim. Bledt did
  # not design this one, he regressed it out of the optimizer's own choices (R^2 of 0.98 and 0.95) and found that
  # injecting it back both enlarged the viable operating region and improved the simplified orientation dynamics'
  # own validity, because the body sits closer to level at speed.
  orientation_compensation {
    # 0, and deliberately so rather than for want of a number. Bledt's own -0.339 is a TROTTING QUADRUPED's fitted
    # lean, and at a CONSTANT sidestep velocity there is no net lateral force to lean against: what a biped's roll
    # actually does in single support is oscillate at gait frequency, which is periodic_orientation's job below and
    # not this one's. Fit it here only if a sweep shows a velocity-proportional component the sinusoid cannot absorb.
    roll_per_lateral_velocity: 0.0  # a1 [rad s/m] roll reference per commanded lateral speed
    roll_offset: 0.0  # a0 [rad] standing roll trim
    # 0.04 puts the nose down 0.048 rad (2.8 deg) at the 1.2 m/s of reference.textproto max_displacement_velocity_x, and
    # POSITIVE is nose-down here (Euler ZYX about a z-up world). Sized from the stick rather than scaled from Bledt's
    # +0.0725, which was fitted to a 9 kg quadruped: a few degrees of lean into the command carries the CoM towards the
    # leading edge of the support and, per section 4.3, keeps the body closer to the small-roll-and-pitch
    # approximation the yaw-only rotation of this control model is built on.
    pitch_per_forward_velocity: 0.0407  # a1 [rad s/m] pitch per commanded forward speed
    pitch_offset: 0.0  # a0 [rad] standing pitch trim
    # 0.15 rad = 8.6 deg, tighter than the 0.35 generic default. The control model replaces R(Theta) with R_z(psi), so
    # a reference tilt large enough to make that approximation wrong is a reference the dynamics cannot follow.
    maximum_tilt: 0.15  # [rad] each of roll and pitch is clamped to +/- this; the command is not rate limited
  }

  # H_Theta(Phi) = b1 * sin(c1 * Phi + d1)  (Table C.2, equation 4.13), with Phi the gait phase in [0, 1). [0, 0.5)
  # is the LF mode and [0.5, 1) the RF mode, and those name the foot IN CONTACT, not the one swinging - so the first
  # half of the cycle is left stance with the RIGHT foot in the air. Phi FREEZES at 0.0 or 0.5 through double support
  # rather than advancing, so this holds a constant offset there instead of continuing its cycle.
  # The two rates are pre-wired to the two shapes that make sense, so only the amplitudes have to be found.
  periodic_orientation {
    # 0.03 rad = 1.7 deg of pelvic obliquity, conservative against the 4-8 deg of human gait. The PHASE follows from
    # the mode semantics with nothing left to fit: phase [0, 0.5) is LF, i.e. LEFT STANCE, so its midpoint is 0.25; a
    # positive roll raises the left side (rotation about +x carries +y towards +z), which is the stance side; and with
    # rate 2*pi and offset 0 the sinusoid peaks at exactly 0.25. So the reference drops the hip on the SWING side
    # through each single support, which is what a walking biped does.
    roll_amplitude: 0.03  # b1 [rad]
    roll_phase_rate: 6.2831853  # c1 [rad per unit phase]; 2*pi = one period per left-right cycle
    roll_phase_offset: 0.0  # d1 [rad]; 0 puts the peak at mid left stance - see above
    # 0, because the phase cannot be derived the way roll's can: pitch oscillates once per STEP and where in the step
    # its extremum falls is a property of this robot's mass distribution and cadence, not of the gait's geometry. A
    # sinusoid at the wrong phase is worse than none, so this is exactly the coefficient Bledt's extraction framework
    # exists to produce (section 4.2, R^2 = 0.835). Expect an amplitude of order 0.02 rad once fitted.
    pitch_amplitude: 0.0  # b1 [rad]
    pitch_phase_rate: 12.5663706  # c1 [rad per unit phase]; 4*pi = one period per step
    pitch_phase_offset: 0.0  # d1 [rad]
  }

  # H_z(v) = a2*v^2 + a1*v + a0  (Table C.2) in the MAGNITUDE of the commanded horizontal velocity, applied as an
  # OFFSET to the reference height and never as an absolute height - the same channel carries the terrain that
  # adaptToCurrentGroundHeight() writes, and an absolute value would silently become a terrain override.
  # Crouching with speed buys the swing leg vertical room within the same joint range; it costs knee torque headroom.
  height_compensation {
    # 0, until a sweep of the linear term shows curvature worth fitting - the degree-9 fit of section 4.5 is the
    # cautionary tale for reaching past a straight line on this kind of data.
    height_per_speed_squared: 0.0  # a2 [m s^2/m^2]
    # -0.025 lowers the base 0.03 m at the 1.2 m/s stick, i.e. 3.4% of the 0.8952 m default_base_height. That buys the
    # swing leg vertical room inside the same joint range - worth having on a robot whose 0.878 m leg is already
    # nearly straight at the nominal height - and costs knee torque headroom, which is the trade to watch.
    height_per_speed: -0.025  # a1 [m s/m]
    height_offset: 0.0  # a0 [m]
    maximum_height_offset: 0.05  # [m] clamped to +/- this; 0.05 leaves the clamp off the value above at full stick
  }

  # H_r(Theta) = PTP(R(Theta) * r_hip)  (Table C.1): the foot under its own hip, ground-projected. r_hip is derived
  # from the robot model at start-up and is never a key here; these two scales stretch it.
  #
  # WARNING. This is the one heuristic in the family that is not a small correction: it MOVES THE ANCHOR of the
  # foothold reference. With it listed the landing target is the base predicted at touch-down plus this hip offset, so
  # the lateral separation comes from the hips (times lateral_scale) instead of from the stance foot plus
  # nominal_foothold.step_width. On a robot whose step_width is 0 it is what makes the rest of the foothold family
  # usable at all: start-up refuses a foothold list without it there. Bledt never uses it alone; it is the base term the Table C.2 velocity terms
  # are summed on top of (figure 4-8), and alone it walks a few slow steps and falls as soon as it has speed. The
  # layer prints a warning when it is listed alone, and another when the others are listed without it.
  hip_centered_stepping {
    # Atlas's hip yaw joints sit at y = +/-0.089 m, so an unscaled hip-centered stance is 0.178 m wide - against the
    # 0.45 m of nominal_foothold.step_width that this heuristic REPLACES. Listing it at scale 1.0 would therefore cut
    # the robot's stance to two fifths the moment it is switched on, which is not a correction but a different gait.
    # 2.528 is 0.45 / (2 * 0.089): it reproduces the stance the robot already walks with, so the heuristic changes the
    # ANCHOR without changing the nominal geometry. Two narrower alternatives, both defensible: 1.25 gives the 0.223 m
    # the legs naturally splay to at the nominal posture, and 1.40 the 0.25 m orbit the contact planner would place
    # (contact_planning.textproto hlip.step_width).
    lateral_scale: 2.528  # multiplies the model's hip lateral offset; 0 removes the lateral part
    longitudinal_scale: 1.0  # inert on Atlas: both hip joints sit at x = 0, so the fore-aft offset is zero
  }

  # H_r(pdot, Phi) = gain * sqrt(p_z / g) * (pdot - pdot_d)  (Table C.1): the capture-point offset of the VELOCITY
  # ERROR, and the only heuristic here that reacts to a push rather than to a command - it is identically zero
  # whenever the robot is going as fast as it was asked to. sqrt(z/g) is 1/omega, the same pendulum time constant
  # the DCM terminal cost and the ZMP/DCM viewer markers already use.
  capture_point {
    gain: 1.0  # 1.0 is the textbook capture point
    # 1.0805 m, the model's center of mass above its feet at `initial_state` (computeComHeightAboveFeet) - the same
    # pendulum dcm_terminal_cost and contact_planning.textproto shared resolve their absent com_height to, so that the
    # three places this controller reasons about an inverted pendulum agree on its length; `derive_parameters.py`
    # computes it the same way. omega is then sqrt(9.81 / 1.0805) = 3.01 rad/s and the offset is 0.332 s per m/s of
    # velocity error. Fixed rather than measured because a robot recovering from a push is exactly when the measurement
    # is worth having and exactly when it can also be nonsense; set 0 to use the per-solve measurement once that has
    # been watched in simulation. (It was 0.85 while the other two were hand-set to that, 23 cm below the model.)
    com_height_override: 1.0805  # [m] 0: use the CoM height measured each solve; positive: use this fixed value
    gravity: 9.81  # [m/s^2]
    # 0.28 m = 40% of contact_planning.textproto foot_separation.max_step_length (0.70 m), i.e. of the REACH bound rather
    # than of hlip.max_step_length (0.50 m), which is the closed-form planner's own clip on the step it emits and does
    # not apply with the planner off.
    #
    # The lateral room is NOT symmetric and this clamp does not fit both ways: the 0.45 m nominal stance is already AT
    # foot_separation.max_step_width, so there is 0.30 m inward to min_step_width 0.15 and nothing outward. A capture step
    # pushed outward therefore runs past a bound the planner would have enforced. Narrowing nominal_foothold.step_width
    # towards the 0.223 m the robot naturally stands in would fix that and is worth doing before sweeping this.
    maximum_offset: 0.28  # [m] clamped in MAGNITUDE, which preserves the direction of the step into the error
  }

  # H_r(pdot) = a1 * pdot + a0  (Table C.2): step in the direction of travel, in the base's yaw frame. The largest
  # single effect in the dissertation: a foot placed under the hip at lift-off is behind the robot by touch-down, so
  # the stance that follows tips the robot the way it is already going. Roughly doubled the usable stance per step
  # and multiplied the top speed (figure 4-9). Expect a1 near half the stance duration.
  translational_stepping {
    # Raibert's rule, expressed so that it follows the gait: the foot lands half a stance of travel ahead of the hip it
    # lands under, a1 = T_stance / 2 - 0.25 s on the shipped `trot`, 0.4 s on `walk`, 0.15 s on `run`. The anchor this
    # is added to is the base PREDICTED at touch-down, i.e. the hip at the moment of landing, which is Bledt's anchor
    # too, so the lead means the same thing with and without hip_centered_stepping. It is written as a stance FRACTION
    # of 0.5 rather than as Bledt's constant a1 because the gait scheduler moves between six gaits by commanded speed
    # (slow_walk ... run), and one constant is right in only one of them; the constant is left at 0 and remains
    # available for a fitted value on top.
    forward_per_forward_velocity: 0.0  # a1 [m s/m], Bledt's constant
    forward_stance_fraction: 0.5  # [-] adds this times the upcoming stance duration to a1; 0.5 is Raibert's rule
    forward_offset: 0.0  # a0 [m]
    lateral_per_lateral_velocity: 0.0  # a1 [m s/m], Bledt's constant
    lateral_stance_fraction: 0.5  # [-] the same rule on the lateral axis
    lateral_offset: 0.0  # a0 [m] applied to this foot's OWN SIDE; 0 because nominal_foothold.step_width
                          #     already sets the separation and this would add to it
  }

  # H_r(psidot) = a1 * psidot + a0  (Table C.2): step along the turn arc while turning on the spot (figure 4-10).
  # psidot is the COMMANDED yaw rate. The FORWARD term is signed per foot and the lateral one is not, which is what
  # makes it a rotation: on a turn in place the two feet must move fore-aft in opposite directions.
  #
  # DIRECTION. A foot at r relative to the base moves at omega x r, so the LEFT foot at (0, +d) moves at
  # (0,0,psidot) x (0,d,0) = (-psidot*d, 0) - BACKWARDS for a counter-clockwise turn, while the right foot moves
  # forwards. (To turn left you swing the right foot forward and around it and the left foot back.) The code carries
  # that sign, so a POSITIVE forward_per_yaw_rate leads each hip into the turn, which is the point of the heuristic; the
  # opposite convention would make a positive number drive the feet to trail the hips by twice the intended amount.
  in_place_turning {
    # Raibert's rule applied to the speed the HIP travels at rather than the body: a foot at the 0.225 m lever of half
    # the 0.45 m stance moves at 0.225 * psidot, and half a stance of that is 0.1125 * T_stance per rad/s - 0.056 m
    # per foot at the 1.0 rad/s stick on `trot`, equal and opposite between the two. Per unit of stance, for the
    # same reason as translational_stepping.
    forward_per_yaw_rate: 0.0  # a1 [m s/rad], Bledt's constant; positive leads each hip into the turn
    forward_stance_lever: 0.1125  # [m/rad] adds this times the upcoming stance duration to a1; Raibert's is half the
                                 #     hip's lever arm
    forward_offset: 0.0  # a0 [m]
    lateral_per_yaw_rate: 0.0  # a1 [m s/rad]; 0 - a turn on the spot has no net lateral drift to follow
    lateral_offset: 0.0  # a0 [m] applied to this foot's own side
  }

  # H_r(pdot x omega) = a1 * (pdot x omega) + a0  (Table C.2): throw the feet out along the turn radius at speed.
  # The heuristic the extraction framework found and the designer had not: without it the robot "tended to fall
  # outwards along the turning radius as if it were an object slipping off a spinning plate" (section 4.3), and
  # Bledt only afterwards recognized it as the placement that lines up with the resultant of gravity and the
  # centripetal acceleration (equation 4.31). Zero at zero speed however fast the robot spins, which is what
  # distinguishes it from in_place_turning. With omega = psidot e_z the cross product is (v_y*psidot, -v_x*psidot).
  high_speed_turning {
    # This one has a closed form, so it is not a fitted number at all: Bledt's equation 4.31 places the foot along the
    # resultant of gravity and the centripetal acceleration, which displaces it by (z_com / g) * (pdot x omega). With
    # Atlas's 1.0805 m CoM height (the model's, as capture_point above) that coefficient is 1.0805 / 9.81 = 0.1101 s^2,
    # the SAME on both axes because the two entries are components of one vector. At the stick limits (1.2 m/s,
    # 1.0 rad/s) it throws the foot 0.132 m outwards along the turn radius, well inside a 0.5 m step.
    # (capture_point.maximum_offset does not bound this one: each heuristic clamps only its own offset.)
    forward_per_cross_term: 0.1101  # a1 [m s^2/(m rad)] on   v_y * psidot
    forward_offset: 0.0  # a0 [m]
    lateral_per_cross_term: 0.1101  # a1 [m s^2/(m rad)] on  -v_x * psidot
    lateral_offset: 0.0  # a0 [m] applied to this foot's own side
  }

  # H_f(Phi) = m*g / (F * beta)  (Table C.1): the vertical stance force reference of a foot that is on the ground for
  # a fraction beta of the gait cycle, because the vertical impulse over the cycle has to add up to the weight.
  #
  # F IS THE NUMBER OF FEET THE ROBOT HAS, a constant - not the number in contact at this instant. The existing
  # reference divides the weight over the feet in contact NOW, so it sums to W at every instant; Bledt's is the same
  # value on every stance foot whatever n_stance is, so its total is below W in single support and above it in double
  # support and averages to exactly W over the cycle, because the mean number of feet on the ground is F * beta.
  # Standing (beta = 1) and a pure alternating single support (beta = 1/2) both give back today's reference exactly,
  # so the correction bites only in a gait that has double support - where it asks the feet to push a little harder
  # than static equilibrium because a single-support phase is coming.
  #
  # Applied as the difference from today's reference, so an empty list is exactly today's behavior. beta is measured
  # over each foot's OWN STRIDE, lift-off to lift-off, in the schedule being solved: on a periodic gait that is the gait's
  # duty factor at every node and for both feet, which is what makes the average come out at exactly W. Purely vertical, which is what keeps the cheap yaw-invariant input-frame path valid.
  impulse_scaling {
    scale: 1.0  # blends between today's reference (0) and Bledt's W/(F*beta) (1); must be >= 0
    # 0.3 sits just below the smallest duty factor any shipped gait produces: `run` (gait.textproto: LF 0.3 s, FLY 0.1 s,
    # RF 0.3 s, FLY 0.1 s) puts each foot down for 0.3 of a 0.8 s stride, i.e. beta = 0.375. So the clamp never binds
    # on a gait this robot actually walks with, and still bounds W / (F beta) at 2.6 kN per foot if one ever does.
    minimum_duty_factor: 0.3  # beta is clamped up to this; 1/beta is unbounded as a flight phase opens
    # The binding case among the shipped gaits is `walk`, whose double support runs at beta = 0.571 against a
    # W/2 baseline and therefore asks for 1.75 x weight compensation. 2.0 clears that with margin and still refuses
    # anything beyond it. (`trot` has no double support, so there beta = 0.5 and the correction is identically zero.)
    maximum_force_ratio: 2.0  # the reference is clamped to this many times weight compensation
  }

  # H_f(Theta x pdot) = m * omega x pdot  (Table C.1): the horizontal force that holds the robot on a circular path,
  # shared over the stance feet. The companion of high_speed_turning - one says where to put the foot for a fast
  # turn, the other which way to push once it is there.
  #
  # TWO THINGS TO KNOW BEFORE LISTING IT. First, it is the only heuristic of the ten whose force is HORIZONTAL, so under
  # contact_input_parameterization: basis_vectors the reference has to be rotated into the local contact frame and the
  # whole contact-force reference starts paying a forward-kinematics pass per shooting node per SQP iteration. The layer
  # switches to that path by itself and warns; watch the solve time. Second, and more important: this may be the wrong
  # thing to want HERE. Bledt's control model is a single rigid body whose force reference is the only thing telling the
  # QP how hard to push, whereas these dynamics are full centroidal and the state cost already tracks the commanded
  # linear and angular momentum - so m*omega x v is the derivative of a momentum this problem already regulates, an
  # output the optimizer must produce rather than information the reference lacks. It is implemented because it is one
  # of Bledt's ten and the seam is clean; `scale` is the knob for finding out in simulation whether it earns its place.
  centripetal_acceleration {
    scale: 1.0  # scales m * omega x v; 0 disables it
    maximum_force: 0.0  # [N] per-foot clamp; 0 uses maximum_force_ratio_of_weight instead
    # 0.2 of the 1.57 kN body weight is 313 N per foot, which is 40% of the friction budget a single stance foot has
    # at this file's friction_coefficient of 0.5 - so the reference stays well inside the cone the wrench-cone barrier
    # is enforcing rather than fighting it. For scale, the largest centripetal force Atlas can legitimately need is
    # m * v * psidot = 159.7 * 1.2 * 1.0 = 192 N, i.e. 0.12 of body weight, so this clamp does not bind in normal
    # operation and is there for the command transients that would otherwise reach the solver.
    maximum_force_ratio_of_weight: 0.2  # the clamp as a fraction of body weight
  }
}

# The feedforward torques of WB_MPC, by name: inverse_dynamics (the planned wrenches through the inverse dynamics) or
# gravity_compensation (pure gravity compensation, to isolate a problem of the inverse dynamics).
wb_mpc_feedforward: "inverse_dynamics"
# [s] Hand-over into WB_MPC from a passive mode. Entering WB_MPC resets the MPC from the robot as it is and always holds
# the previous mode's action until the first policy solved after that reset is in use (a solve or two); targets, gains
# and feedforward torques are then ramped linearly into the MPC action over this duration. 0 (default) switches in one
# control cycle once that policy is in use. The same ramp follows every other hold of the controller: after a fall caught
# on the gantry, a clock that ran backwards, and a solver that recovers from repeated failures. Try 0.3 to 0.5 once
# validated in MuJoCo.
mpc_entry_blend_time: 2

# SAFETY mode: time constant [s] of the exponential decay applied to both joint PD gains once SAFETY is entered. The
# robot holds the posture it had at entry with torque alpha * (kp * (q_hold - q) - kd * qd), alpha = exp(-t / tau), and
# is commanded true zero torque once alpha falls below 2%, i.e. after about 4 * tau seconds.
safety_decay_time_constant: 0.5
# Touch-down shaping of the planned contact wrenches in the inverse dynamics of the MRT joint controller. A foot's planned
# wrench is projected into feedforward torques only while the foot is measured in contact (contact_estimator above). By
# default it is applied in full from the first control cycle of measured contact, i.e. as a step at the first heel or toe
# strike; both times at 0 keep that. debounce_time: measured contact must persist this long before the wrench is applied
# (a bounce across the detection threshold restarts it). ramp_time: the wrench then rises linearly from zero to the
# planned value over this time. Lift-off is never shaped. Hot-reloadable (GUI: Solver & Horizon). The 10 ms debounce
# rides out a heel or toe bounce across the 5 N detection threshold (sim_contact_force_threshold), and the 40 ms ramp brings
# the wrench in over the first half of the 0.1 s double support, when the other foot still carries the weight; the whole
# onset stays well inside the phase_resetting debounce of the schedule (early_touchdown_min_contact_duration) plus one node.
contact_wrench_gate {
  debounce_time: 0.01  # [s]
  ramp_time: 0.04  # [s]
}

interface {
  verbose: true  # show the loaded parameters
}

model_settings {
  # The key the ACoM network registry dispatches on (AngularCenterOfMass.cpp), and the robot train_main.py trains for.
  # LINT.IfChange(acom_robot_name)
  robot_name: "atlas"
  # LINT.ThenChange(//humanoid_nmpc/humanoid_common_mpc/src/acom/AngularCenterOfMass.cpp:acom_robot_dispatch, //humanoid_learning/acom/train_main.py:robot_paths)

  foot_constraint {
    # Swing: the only regulation of the swing-foot height is the normal-velocity constraint
    # zdot = zdot_ref + position_error_gain_z * (z_ref - z). At 1.0 that is a 1 s time constant, so barely a fifth of any
    # height error accumulated at lift-off is corrected over a 0.25 s descent and the foot arrives low. 5.0 matches the
    # other robots. The remaining gains below act on the stance (zero-velocity) constraint only.
    # Lowered from 5. This gain is proportional feedback injected straight into the
    # swing foot's commanded vertical velocity by a HARD equality constraint:
    #   v_z = zdot_ref + position_error_gain_z * (z_ref - z)
    # With touch_down_velocity restored below, zdot_ref carries the descent and this
    # term only trims the residual. At 5 with zdot_ref = 0 the entire touch-down
    # velocity was 5x the tracking lag, so the foot kicked into the ground and the
    # zero_velocity constraint then had to absorb that velocity in one 0.02 s
    # shooting interval, which threw the body upward once per step.
    position_error_gain_z: 5.0
    orientation_error_gain: 0.1
    linear_velocity_error_gain_z: 0.1
    linear_velocity_error_gain_xy: 0.1
    angular_velocity_error_gain: 0.01
    linear_acceleration_error_gain_z: 0
    linear_acceleration_error_gain_xy: 0
    angular_acceleration_error_gain: 0
    soft_constraint_weight: 250
    # Weight of the SOFT `normal_velocity` term, when it is listed in soft_constraints. The residual is the same row
    # the hard constraint imposes - v_z - zdot_ref - position_error_gain_z * (z_ref - z) - so this one number buys the
    # swing-foot vertical servo as a cost the solver can trade off, instead of an equality it cannot.
    #
    # Why one weight rather than two task-space weights: the hard row combines a velocity feedforward and a position
    # feedback in a fixed ratio, and the foot cost cannot reproduce that at ANY pair of pos_z / lin_velocity_z, because
    # only its velocity rows are faded by the impact-proximity factor while its position rows are not. Splitting the
    # servo across two differently-faded channels gives a different controller at every point of the swing.
    #
    # Sizing: the residual is in m/s and is essentially affine in the input (the joint velocities ARE inputs of the
    # centroidal model), so a large Gauss-Newton weight here is well conditioned even with a single SQP iteration per solve. A foot stuck
    # on the ground at mid-swing has a residual of -position_error_gain_z * swing_height = -0.16 m/s. The term has to
    # outbid the leg-joint entries of Q, which regularize the swing leg towards the standing crouch - a posture whose
    # reference is the foot ON THE FLOOR (default_base_height equals the pelvis-to-sole distance at default_joint_state),
    # so every millimeter of lift is charged against Q at an effective vertical stiffness of order 1e4.
    # 500 is a starting point, not a tuned value. Sweep it; it is hot-reloadable.
    normal_velocity_soft_constraint_weight: 500
    # What the stance foot's zero_velocity constraint holds: "position" (3D), "position_and_tilt" or
    # "position_and_orientation" (6D). The orientation error to the ground plane only measures the tilt of the foot
    # normal, so under "position_and_tilt" the last row of the 6D stance constraint is identically zero and the foot may
    # pivot about the contact normal. "position_and_orientation" fills that row with the yaw rate about the contact
    # normal. It removes one input degree of freedom per stance foot, so choose it deliberately and re-check yaw
    # behavior. Chosen together with the contact planner's heading_double_integrator dynamics: the planner budgets its
    # yaw torque against the torsional friction each stance foot can carry.
    stance_constraint: "position_and_orientation"
  }

  phase_transition_stance_time: 0

  verbose_cpp_ad: true
  recompile_libraries_cpp_ad: false

  # Exclude these joints from MPC model.
  # The ACoM network (AcomSirenWeightsAtlas.h) was trained with exactly these joints fixed - train_main.py reads this
  # list. Changing it needs a retrain; AngularCenterOfMass::Create refuses the mismatch at start-up.
  fixed_joint_names: "l_arm_wry"
  fixed_joint_names: "l_arm_wrx"
  fixed_joint_names: "r_arm_wry"
  fixed_joint_names: "r_arm_wrx"

  # Pinocchio Frame names for the contact frames
  contact_names_6dof: "foot_l_contact"
  contact_names_6dof: "foot_r_contact"

  # The Parent frames on which the contact frames are added.
  contact_parent_joint_names: "l_leg_akx"
  contact_parent_joint_names: "r_leg_akx"

  # ; Used for arm swing reference
  arm_joint_names {
    left_shoulder_y: "l_arm_shx"
    right_shoulder_y: "r_arm_shx"
    left_elbow_y: "l_arm_ely"
    right_elbow_y: "r_arm_ely"
  }
}

# The height reference is tracked at foot_*_contact, the CENTER of the sole. The toe contact points are 0.12 m ahead of
# it, so the toe height is not regulated by anything here -- it is the sole center height minus 0.12 * sin(foot pitch).
# Everything in this section is therefore about not leaving the sole center near the ground for longer than necessary.
swing_trajectory_config {
  lift_off_velocity: 0.05
  # A zero touch-down velocity makes the descent flatten out asymptotically, so the sole hovers within a few millimeters
  # of the ground for the last ~30 ms of the swing while the foot is still translating forward at ~0.2 m/s. Landing with
  # a real descent rate shortens that window and roughly doubles the clearance at 90% of the swing.
  # Restored to a real descent rate (negative is downward; lift_off_velocity is +0.05
  # upward). At 0 the height spline arrived with zero terminal slope, so the sole
  # flattened out and hovered millimeters above the ground for the last stretch of
  # swing while still translating forward, and every bit of the landing velocity had
  # to come from position_error_gain_z acting on the tracking error.
  touch_down_velocity: -0.05
  swing_height: 0.08  # was 0.16; the higher apex made the descent steeper and widened the foot-pitch excursion
  touch_down_height_offset: 0.02
  # Swings shorter than this are scaled down in height AND velocity by swingDuration / swing_time_scale
  # (SwingTrajectoryPlanner::swingTrajectoryScaling). It must stay <= the shortest swing the contact planner emits:
  # contact_planning.textproto hlip.ssp_duration under planner.type: hlip, shared.gait_limits.min_swing_duration (rounded up to
  # planner.dt) under lip_miqp. ContactPlanningReferenceManager warns when it does not, at start-up, on every
  # contact_planning reload and after a reload of this file that moves it. At swing_time_scale 0.4 a 0.3 s swing would
  # clear only 0.75 * 0.08 = 0.06 m.
  # LINT.IfChange(atlas_swing_time_scale)
  swing_time_scale: 0.25  # was 0.4
  # LINT.ThenChange(//robot_models/drc_atlas/drc_atlas_centroidal_mpc/config/mpc/contact_planning.textproto:atlas_gait_cadence, //robot_models/drc_atlas/drc_atlas_centroidal_mpc/config/mpc/contact_planning.textproto:atlas_hlip_cadence)
  impact_proximity_factor_lift_off_velocity: -0.15
  impact_proximity_factor_touch_down_velocity: 0.3
  impact_proximity_factor_mid_point_value: 0

  # Toe-up pitch of the swing foot reference, tilting the plane that task_space_foot_cost.weights.orientation_x / _y
  # track. It raises the toe by 0.12 * sin(angle) without lowering the sole center: 0.10 rad buys ~12 mm at the peak.
  # The profile is flat at lift-off, ramps up over swing_pitch_rise_fraction of the swing, holds, and is back to flat at
  # touch-down so that contact is still made with the whole sole, as the contact model assumes.
  #
  # DISABLED BY DEFAULT (0.0 reproduces the previous flat-foot reference exactly). The gains and the trajectory shape
  # above should be validated in MuJoCo on their own first; enable this only if the toe still catches, and start around
  # 0.08-0.12 rad. Watch that the heel does not strike first -- the contact model assumes a flat landing.
  swing_pitch_angle: 0.08
  swing_pitch_rise_fraction: 0.25
  swing_pitch_fall_fraction: 0.15
}

# multiple_shooting settings
multiple_shooting {
  n_threads: 8
  dt: 0.02
  sqp_iteration: 1
  delta_tol: 0.0001
  g_max: 0.01
  g_min: 1.0e-06
  project_state_input_equality_constraints: true
  print_solver_statistics: true
  print_solver_status: false
  print_linesearch: false
  use_feedback_policy: true
  integrator_type: "RK4"
  thread_priority: 50
}

# Rollout settings
rollout {
  abs_tol_ode: 5e-5
  rel_tol_ode: 5e-3
  time_step: 0.015
  integrator_type: "ODE45"
  max_num_steps_per_second: 10000
  check_numerical_stability: false
}

mpc {
  time_horizon: 1  # [s]
  solution_time_window: -1  # maximum [s]
  cold_start: false

  debug_print: false

  mpc_desired_frequency: 50  # [Hz]
  mrt_desired_frequency: 100  # [Hz]
}

initial_state {
  # ; Normalized Centroidal Momentum: [linear, angular] ;;
  normalized_linear_momentum {
    x: 0  # h_com_x / robotMass
    y: 0  # h_com_y / robotMass
    z: 0  # h_com_z / robotMass
  }
  normalized_angular_momentum {
    x: 0  # L_x / robotMass
    y: 0  # L_y / robotMass
    z: 0  # L_z / robotMass
  }

  # ; Base Pose: [position, orientation] ;;
  base_position {
    x: 0  # p_base_x
    y: 0  # p_base_y
    z: 0.8952  # p_base_z
  }
  base_orientation {
    yaw: 0  # theta_base_z
    pitch: 0  # theta_base_y
    roll: 0  # theta_base_x
  }

  # ; Joint Positions: ;;
  joint_positions { joint: "back_bkz" value: 0 }
  joint_positions { joint: "back_bky" value: 0 }
  joint_positions { joint: "back_bkx" value: 0 }
  joint_positions { joint: "l_arm_shz" value: 0.3 }
  joint_positions { joint: "l_arm_shx" value: -1.2 }
  joint_positions { joint: "l_arm_ely" value: 2.2 }
  joint_positions { joint: "l_arm_elx" value: 0.55 }
  joint_positions { joint: "neck_ry" value: 0 }
  joint_positions { joint: "r_arm_shz" value: -0.3 }
  joint_positions { joint: "r_arm_shx" value: 1.2 }
  joint_positions { joint: "r_arm_ely" value: 2.2 }
  joint_positions { joint: "r_arm_elx" value: -0.55 }
  joint_positions { joint: "l_leg_hpz" value: 0 }
  joint_positions { joint: "l_leg_hpx" value: 0 }
  joint_positions { joint: "l_leg_hpy" value: -0.42 }
  joint_positions { joint: "l_leg_kny" value: 0.84 }
  joint_positions { joint: "l_leg_aky" value: -0.42 }
  joint_positions { joint: "l_leg_akx" value: 0 }
  joint_positions { joint: "r_leg_hpz" value: 0 }
  joint_positions { joint: "r_leg_hpx" value: 0 }
  joint_positions { joint: "r_leg_hpy" value: -0.42 }
  joint_positions { joint: "r_leg_kny" value: 0.84 }
  joint_positions { joint: "r_leg_aky" value: -0.42 }
  joint_positions { joint: "r_leg_akx" value: 0 }
}

# standard state weight matrix
state_weights {
  scaling: 85

  # ; Normalized Centroidal Momentum: [linear, angular] ;;
  # Raised from 2. The linear entries are the ONLY thing asking the MPC to reach the
  # commanded CoM velocity, and at 2 (170 after scaling) they were outvoted 125:1 by
  # the hip roll regularization below. Under-striding was then the cheap option: a
  # short step keeps every joint near nominal and only costs a little velocity error,
  # so the robot walked with small strides no matter how large the command. G1 and R1
  # keep their largest joint weight within 1.3-2.5x of this entry; Atlas was at 125x.
  normalized_linear_momentum {
    x: 10  # h_com_x / robotMass
    y: 10  # h_com_y / robotMass
    z: 15  # h_com_z / robotMass
  }
  # Reduced for CoM + ACoM tracking: the aCOM coordinate is the integral of the
  # locked angular velocity, so penalizing angular momentum heavily fights the
  # torso and arm counter-rotation the aCOM cost is there to produce. What is
  # left provides damping only; orientation itself is regulated by acom_weights.
  normalized_angular_momentum {
    x: 20  # L_x / robotMass
    y: 25  # L_y / robotMass
    z: 5  # L_z / robotMass
  }

  # ; Base Pose: [position, orientation] ;;
  # Ignored while costs lists com_and_acom_tracking_cost: the factory zeroes this
  # 6x6 block and com_weights / acom_weights regulate base pose instead.
  base_position {
    x: 0  # p_base_x
    y: 0  # p_base_y
    z: 0  # p_base_z -> com_weights.z
  }
  # euler angles for base to world rotation
  base_orientation {
    yaw: 0  # theta_base_z -> acom_weights.yaw
    pitch: 0  # theta_base_y -> acom_weights.pitch
    roll: 0  # theta_base_x -> acom_weights.roll
  }

  # ; Joint Positions ;;
  # Reduced for CoM + ACoM tracking: the torso is the main contributor to the
  # learned orientation offset, so it must be free to rotate.
  joint_positions { joint: "back_bkz" value: 5 }
  joint_positions { joint: "back_bky" value: 5 }
  joint_positions { joint: "back_bkx" value: 15 }
  joint_positions { joint: "l_arm_shz" value: 0.1 }
  joint_positions { joint: "l_arm_shx" value: 0.1 }
  joint_positions { joint: "l_arm_ely" value: 0.1 }
  joint_positions { joint: "l_arm_elx" value: 0.1 }
  joint_positions { joint: "neck_ry" value: 2 }
  joint_positions { joint: "r_arm_shz" value: 0.1 }
  joint_positions { joint: "r_arm_shx" value: 0.1 }
  joint_positions { joint: "r_arm_ely" value: 0.1 }
  joint_positions { joint: "r_arm_elx" value: 0.1 }
  joint_positions { joint: "l_leg_hpz" value: 10 }
  # Lowered from 250. Nominal hip roll is 0, i.e. legs vertical in the frontal plane,
  # so this entry directly opposed the lateral pelvis shift that unloads the swing
  # foot. At 21250 a mere 0.1 rad of shift cost ~213, more than closing a 0.7 m/s
  # velocity error was worth, so single support stayed short and strides with it.
  # Self-collision is NOT what this weight was doing: collision_constraint.foot and
  # .knee enforce that with their own barrier (mu 30000), and the contact planner
  # additionally bounds min_step_width (0.15 m) and reach_y_inner (0.05 m).
  joint_positions { joint: "l_leg_hpx" value: 25 }
  joint_positions { joint: "l_leg_hpy" value: 1 }
  joint_positions { joint: "l_leg_kny" value: 2 }
  joint_positions { joint: "l_leg_aky" value: 5 }
  joint_positions { joint: "l_leg_akx" value: 5 }
  joint_positions { joint: "r_leg_hpz" value: 10 }
  joint_positions { joint: "r_leg_hpx" value: 25 }
  joint_positions { joint: "r_leg_hpy" value: 1 }
  joint_positions { joint: "r_leg_kny" value: 2 }
  joint_positions { joint: "r_leg_aky" value: 5 }
  joint_positions { joint: "r_leg_akx" value: 5 }
}

# control weight matrix
input_weights {
  scaling: 1

  # ; Feet Contact Forces: [LF, RF, LH, RH] ;;
  contact_wrenches {
    contact: "foot_l_contact"
    force {
      x: 1.0e-05  # left_force_x
      y: 2.0e-05  # left_force_y
      z: 5.0e-05  # left_force_z
    }
    moment {
      x: 2.0e-05  # left_moment_x
      y: 1.0e-05  # left_moment_y
      z: 0.0002  # left_moment_z
    }
  }
  contact_wrenches {
    contact: "foot_r_contact"
    force {
      x: 1.0e-05  # right_force_x
      y: 2.0e-05  # right_force_y
      z: 5.0e-05  # right_force_z
    }
    moment {
      x: 2.0e-05  # right_moment_x
      y: 1.0e-05  # right_moment_y
      z: 0.0002  # right_moment_z
    }
  }

  # ; Joint Velocities ;;
  joint_velocities { joint: "back_bkz" value: 1 }
  joint_velocities { joint: "back_bky" value: 1 }
  joint_velocities { joint: "back_bkx" value: 1 }
  joint_velocities { joint: "l_arm_shz" value: 1 }
  joint_velocities { joint: "l_arm_shx" value: 1 }
  joint_velocities { joint: "l_arm_ely" value: 2 }
  joint_velocities { joint: "l_arm_elx" value: 2 }
  joint_velocities { joint: "neck_ry" value: 100 }
  joint_velocities { joint: "r_arm_shz" value: 1 }
  joint_velocities { joint: "r_arm_shx" value: 1 }
  joint_velocities { joint: "r_arm_ely" value: 2 }
  joint_velocities { joint: "r_arm_elx" value: 2 }
  joint_velocities { joint: "l_leg_hpz" value: 500 }
  joint_velocities { joint: "l_leg_hpx" value: 5 }
  joint_velocities { joint: "l_leg_hpy" value: 0.001 }
  joint_velocities { joint: "l_leg_kny" value: 1 }
  joint_velocities { joint: "l_leg_aky" value: 5 }
  joint_velocities { joint: "l_leg_akx" value: 50 }
  joint_velocities { joint: "r_leg_hpz" value: 500 }
  joint_velocities { joint: "r_leg_hpx" value: 5 }
  joint_velocities { joint: "r_leg_hpy" value: 0.001 }
  joint_velocities { joint: "r_leg_kny" value: 1 }
  joint_velocities { joint: "r_leg_aky" value: 5 }
  joint_velocities { joint: "r_leg_akx" value: 50 }
}

# DCM (capture point) terminal cost, active when costs lists dcm_terminal_cost (as shipped; it is the alternative to
# terminal_cost / final_state_weights, and the two are never listed together).
# At the end of the horizon the DCM  xi = p_com + v_com / omega  (omega = sqrt(g / com_height)) is pulled towards the center
# of the terminal support (feet in contact at the final time) plus velocity_offset_factor * v_cmd / omega, so that the horizon
# ends in a capturable state that is consistent with the commanded walking speed. velocity_offset_factor: 0 is the pure
# "can come to rest over its feet" condition; 1 keeps a steady walk unbiased. Cost = 0.5 * (weight_x * e_x^2 + weight_y * e_y^2).
#
# com_height left out is the model's own pendulum: its center of mass above the mean height of its soles at initial_state
# (computeComHeightAboveFeet), 1.0805 m for this URDF, so omega = sqrt(9.81 / 1.0805) = 3.01 rad/s; the interface logs
# both at start-up, and a hot reload without it means the same. contact_planning.textproto shared resolves its absent
# com_height with the same function, so the two agree by construction. A positive com_height is an explicit override of
# the model; give the planner's shared.com_height the same one then. (Both were hand-set to 0.85 m until the height was
# derived: 23 cm below the model's center of mass, omega 3.40 rad/s.)
dcm_terminal_cost {
  # LINT.IfChange(atlas_dcm_pendulum)
  # com_height [m], the pendulum height for omega: left out, the model's center of mass above its feet at initial_state.
  gravity: 9.81  # [m/s^2]
  # LINT.ThenChange(//robot_models/drc_atlas/drc_atlas_centroidal_mpc/config/mpc/contact_planning.textproto:atlas_pendulum)
  weight_x: 400  # weight on the longitudinal DCM error
  weight_y: 400  # weight on the lateral DCM error
  velocity_offset_factor: 0  # 0..1, scales the v_cmd / omega offset of the DCM reference
  support_blend_time: 0.1  # [s] support weights ramp through lift-off / touch-down so the reference never jumps
}

# Quadratic terminal cost on the full state (terminal_cost). Read only while costs lists terminal_cost, which Atlas does
# not: it ends the horizon on dcm_terminal_cost. The hot reload applies it to a running quadratic terminal cost only.
terminal_cost_scaling: 4
final_state_weights {
  scaling: 85

  # ; Normalized Centroidal Momentum: [linear, angular] ;;
  # Raised from 2. The linear entries are the ONLY thing asking the MPC to reach the
  # commanded CoM velocity, and at 2 (170 after scaling) they were outvoted 125:1 by
  # the hip roll regularization below. Under-striding was then the cheap option: a
  # short step keeps every joint near nominal and only costs a little velocity error,
  # so the robot walked with small strides no matter how large the command. G1 and R1
  # keep their largest joint weight within 1.3-2.5x of this entry; Atlas was at 125x.
  normalized_linear_momentum {
    x: 10  # h_com_x / robotMass
    y: 10  # h_com_y / robotMass
    z: 15  # h_com_z / robotMass
  }
  # Reduced for CoM + ACoM tracking: the aCOM coordinate is the integral of the
  # locked angular velocity, so penalizing angular momentum heavily fights the
  # torso and arm counter-rotation the aCOM cost is there to produce. What is
  # left provides damping only; orientation itself is regulated by acom_weights.
  normalized_angular_momentum {
    x: 5  # L_x / robotMass
    y: 5  # L_y / robotMass
    z: 2  # L_z / robotMass
  }

  # ; Base Pose: [position, orientation] ;;
  # Ignored while costs lists com_and_acom_tracking_cost: the factory zeroes this
  # 6x6 block and com_weights / acom_weights regulate base pose instead.
  base_position {
    x: 0  # p_base_x
    y: 0  # p_base_y
    z: 0  # p_base_z -> com_weights.z
  }
  # euler angles for base to world rotation
  base_orientation {
    yaw: 0  # theta_base_z -> acom_weights.yaw
    pitch: 0  # theta_base_y -> acom_weights.pitch
    roll: 0  # theta_base_x -> acom_weights.roll
  }

  # ; Joint Positions ;;
  # Reduced for CoM + ACoM tracking: the torso is the main contributor to the
  # learned orientation offset, so it must be free to rotate.
  joint_positions { joint: "back_bkz" value: 10 }
  joint_positions { joint: "back_bky" value: 25 }
  joint_positions { joint: "back_bkx" value: 25 }
  joint_positions { joint: "l_arm_shz" value: 0.1 }
  joint_positions { joint: "l_arm_shx" value: 0.1 }
  joint_positions { joint: "l_arm_ely" value: 0.1 }
  joint_positions { joint: "l_arm_elx" value: 0.1 }
  joint_positions { joint: "neck_ry" value: 2 }
  joint_positions { joint: "r_arm_shz" value: 0.1 }
  joint_positions { joint: "r_arm_shx" value: 0.1 }
  joint_positions { joint: "r_arm_ely" value: 0.1 }
  joint_positions { joint: "r_arm_elx" value: 0.1 }
  joint_positions { joint: "l_leg_hpz" value: 10 }
  # Lowered from 250. Nominal hip roll is 0, i.e. legs vertical in the frontal plane,
  # so this entry directly opposed the lateral pelvis shift that unloads the swing
  # foot. At 21250 a mere 0.1 rad of shift cost ~213, more than closing a 0.7 m/s
  # velocity error was worth, so single support stayed short and strides with it.
  # Self-collision is NOT what this weight was doing: collision_constraint.foot and
  # .knee enforce that with their own barrier (mu 30000), and the contact planner
  # additionally bounds min_step_width (0.15 m) and reach_y_inner (0.05 m).
  joint_positions { joint: "l_leg_hpx" value: 25 }
  joint_positions { joint: "l_leg_hpy" value: 1 }
  joint_positions { joint: "l_leg_kny" value: 2 }
  joint_positions { joint: "l_leg_aky" value: 5 }
  joint_positions { joint: "l_leg_akx" value: 5 }
  joint_positions { joint: "r_leg_hpz" value: 10 }
  joint_positions { joint: "r_leg_hpx" value: 25 }
  joint_positions { joint: "r_leg_hpy" value: 1 }
  joint_positions { joint: "r_leg_kny" value: 2 }
  joint_positions { joint: "r_leg_aky" value: 5 }
  joint_positions { joint: "r_leg_akx" value: 5 }
}

icp_cost_weights {
  icp_error_weight: 0
}

task_space_foot_cost {
  active_phases: "swing"  # or "swing_and_stance"
  weights {
    # pos_x / pos_y weigh the swing foot against wherever it is being told to land. They are live whenever something
    # supplies a horizontal target, and switched off inside the cost when nothing does:
    #
    #   contact_schedule_source: contact_planner
    #                                     the planned foothold (the contact planner decides where the foot goes)
    #   nominal_foothold.step_width > 0    the nominal foothold, half that width to the foot's own side of the reference
    #                                     base pose (see the nominal_foothold block above)
    #   neither                           no xy target exists, and these two weights are forced to 0 per solve
    #
    # pos_y is what holds the feet apart, and it is competing with the whole-body costs, which would often rather move the
    # base than swing the leg out; raise it if the feet converge. pos_x tracks the foot to the target's forward position,
    # which without a planner means following the reference base as it advances, on top of the swing velocity reference
    # (lin_velocity_x / _y) that the no-target branch would otherwise provide on its own.
    #
    # Both ship at 0 (the tuning commit 50d7022 took them there from 30), so as shipped a planned foothold carries no
    # weight at all: with contact_schedule_source: contact_planner the planner's landing targets reach the MPC through
    # nothing but the lin_velocity_y ramp below, and CentroidalMpcInterface warns at start-up. Raise them before switching
    # the planner on; when last tried at 0 with a target supplied, the swing foot had no longitudinal guidance,
    # under-reached, and was still traveling forward when its height reference hit zero. If a planned landing target
    # jitters, damp it with contact_planning.textproto previous_foothold_consistency.weight / plan_consistency.cost rather than
    # by zeroing these.
    pos_x: 0
    pos_y: 0
    pos_z: 150
    # Raised from 100. This is the only thing holding the swing foot level, and it competes with the joint regularization
    # Q(28,28) = 5 * 85 = 425 that pulls l_leg_aky back to its nominal -0.42 -- which, with the knee more extended than
    # nominal at the end of a long step, IS a toe-down foot. Atlas has a 0.24 m long sole, so every degree of droop drops
    # the toe 2.1 mm. G1 and R1 use 1000 here with a much shorter foot.
    orientation_x: 800
    orientation_y: 800
    orientation_z: 150
    lin_velocity_x: 0
    lin_velocity_y: 5
    lin_velocity_z: 0
    ang_velocity_x: 1
    ang_velocity_y: 1
    ang_velocity_z: 1
    lin_acceleration_x: 0
    lin_acceleration_y: 0
    lin_acceleration_z: 0
    ang_acceleration_x: 0
    ang_acceleration_y: 0
    ang_acceleration_z: 0
  }
}
# The torso orientation terms are zeroed for CoM + ACoM tracking. Whole-body
# orientation is regulated by acom_weights, and the aCOM offset is generated largely
# by torso rotation, so holding the torso to a reference orientation directly
# cancels the behavior the aCOM cost exists to produce. The angular velocity
# terms are kept, heavily reduced, purely as damping.
task_space_costs {
  name: "torso"
  link_name: "utorso"
  weights {
    pos_x: 0
    pos_y: 0
    pos_z: 0
    orientation_x: 0  # was 50, now handled by acom_weights.roll
    orientation_y: 0  # was 50, now handled by acom_weights.pitch
    orientation_z: 0
    lin_velocity_x: 0.1
    lin_velocity_y: 0.1
    lin_velocity_z: 0.005
    ang_velocity_x: 0.5  # was 5
    ang_velocity_y: 0.5  # was 5
    ang_velocity_z: 0.5  # was 2
    lin_acceleration_x: 0
    lin_acceleration_y: 0
    lin_acceleration_z: 0
    ang_acceleration_x: 0
    ang_acceleration_y: 0
    ang_acceleration_z: 0
  }
}

left_leg_torque_cost {
  scaling: 1.0e-06

  joints { joint: "l_leg_hpz" value: 1 }
  joints { joint: "l_leg_hpx" value: 2 }
  joints { joint: "l_leg_hpy" value: 2 }
  joints { joint: "l_leg_kny" value: 8 }
  joints { joint: "l_leg_aky" value: 0.2 }
  joints { joint: "l_leg_akx" value: 0.2 }
}

right_leg_torque_cost {
  scaling: 1.0e-06

  joints { joint: "r_leg_hpz" value: 1 }
  joints { joint: "r_leg_hpx" value: 2 }
  joints { joint: "r_leg_hpy" value: 2 }
  joints { joint: "r_leg_kny" value: 8 }
  joints { joint: "r_leg_aky" value: 0.2 }
  joints { joint: "r_leg_akx" value: 0.2 }
}

contacts {
  contact_frame_translation {
    # ; Translation vector from parent joint to contact frame (center of foot support polygon) ;;
    x: 0.04
    y: 0
    z: -0.082
  }
  contact_rectangle {
    # ; length specified in contact frame ;;
    # Matched to the actual sole contact geometry in atlas.xml: the four contact spheres sit at ankle-frame
    # x = -0.08 / +0.16, y = +-0.055, and the contact frame is 0.04 ahead of the ankle, so the real support polygon is
    # +-0.12 x +-0.055 in this frame. The previous +-0.13 / +-0.065 gave the MPC about a centimeter of CoP range fore,
    # aft and to each side that the foot does not have.
    x_max: 0.12
    x_min: -0.12
    y_max: 0.055
    y_min: -0.055
  }

  contact_wrench_cone_soft_constraint {
    # The ground of the whole-body constraints. Its five geometry keys (all but mu and delta) are required: the
    # loader refuses a missing one rather than keep a library default. Under contact_input_parameterization: wrench
    # they are the soft constraint contact_wrench_cone; under basis_vectors (as shipped) the same values build the
    # wrench-cone generators instead and that soft constraint is not built. Every generator lies inside the cone, so its friction,
    # center-of-pressure and torsional limits are never exceeded; with the shipped conservative_inner_approximation set
    # the MPC can use only a small part of the cone (no tangential force with the CoP at the toe, none at the torsional
    # limit), with exact_wrench_cone all of it (contacts.basis_generator_set below). min_normal_force and gripper_force are
    # then NOT enforced: a conic combination is homogeneous and cannot represent an affine offset of the cone
    # (lambda = 0 always yields the zero wrench); the interface logs a warning when they are non-zero. The online
    # contact planner derives its friction and torsion bounds from this block as well.
    friction_coefficient: 0.5
    torsional_friction_coefficient: 0.05
    min_normal_force: 5
    gripper_force: 0
    num_basis_vectors: 4  # friction pyramid facets (and the pyramid edges of the basis generators)
    # relaxed log barrier parameters
    mu: 0.2
    delta: 5
  }

  # Generator set of the basis-vector contact inputs, by registry name (contact_input_parameterization: basis_vectors):
  #   conservative_inner_approximation  N + 7 generators per foot: sound, but a strongly conservative inner
  #                                     approximation of the cone above (shipped)
  #   exact_wrench_cone                 8N generators spanning exactly that cone (32 scalings per foot for N = 4)
  # It fixes the input dimension, so it takes effect at start-up only. exact_wrench_cone has not been validated in
  # closed loop yet. See humanoid_nmpc/docs/contact_basis_vectors/README.md.
  # LINT.IfChange(basis_generator_set_config)
  basis_generator_set: "conservative_inner_approximation"
  # LINT.ThenChange(//humanoid_nmpc/humanoid_common_mpc/include/humanoid_common_mpc/contact/ContactWrenchConeBasisMatrix.h:basis_generator_set_names)

  # Barrier penalty enforcing lambda >= 0 for basis-vector contact inputs (contact_input_parameterization: basis_vectors).
  # Under that parameterization this barrier IS the contact wrench cone, so it is built for every contact whatever
  # soft_constraints lists, and gated on the mode schedule exactly when zero_wrench is.
  # The PieceWisePolynomialBarrierPenalty returns non-zero cost for lambda < delta,
  # and zero cost for lambda >= delta. Decrease delta for a tighter barrier region;
  # increase mu for stronger penalty on constraint violation. Hot-reloaded.
  basis_non_negativity_barrier {
    mu: 0.01
    delta: 0.001
  }

  # Regularization of the basis-vector scalings lambda in the input cost (contact_input_parameterization: basis_vectors).
  # R is written for the contact-frame wrench W = B*lambda and becomes R_basis = M^T*R*M + basis_scaling_regularization *
  # blkdiag(S, 0). Each foot has more generators than wrench components, so M^T*R*M alone is singular and the optimal
  # lambda would not be unique; S removes that, chosen by name (basis_regularization):
  #   full_diagonal  S = I (shipped). The optimizer then sees R + reg * (B*B^T)^-1 on the wrench; at reg = 1e-4 that
  #                  second term is about 5x to 10x R's tangential force weights and 100x to 400x its moment weights
  #                  here, so those entries of R barely act.
  #   null_space     S = I - B^+ B: only the lambda that produce no wrench are penalized, and R acts unchanged on the
  #                  wrench. Not validated in closed loop yet.
  # Both are hot-reloaded; a reload naming an unknown shape, or leaving the lambda block indefinite, is refused and the
  # running R kept. See humanoid_nmpc/docs/contact_basis_vectors/README.md, section 5.
  basis_scaling_regularization: 0.0001
  # LINT.IfChange(basis_regularization_config)
  basis_regularization: "full_diagonal"
  # LINT.ThenChange(//humanoid_nmpc/humanoid_common_mpc/include/humanoid_common_mpc/common/BasisInputsCostTransform.h:basis_regularization_names)

  friction_force_cone_soft_constraint {
    friction_coefficient: 0.5
    # relaxed log barrier parameters
    mu: 0.2
    delta: 5
  }

  contact_moment_xy_soft_constraint {
    # relaxed log barrier parameters
    mu: 0.6
    delta: 0.03
  }
}

joint_limits {
  # relaxed log barrier parameters
  mu: 1200
  delta: 0.1
}

collision_constraint {
  foot {
    left_ankle_frame: "l_leg_akx"
    right_ankle_frame: "r_leg_akx"

    foot_collision_sphere_radius: 0.05
  }
  knee {
    left_knee_frame: "l_leg_kny"
    right_knee_frame: "r_leg_kny"

    knee_collision_sphere_radius: 0.07
  }
  # relaxed log barrier parameters
  mu: 30000
  delta: 0.05
}
