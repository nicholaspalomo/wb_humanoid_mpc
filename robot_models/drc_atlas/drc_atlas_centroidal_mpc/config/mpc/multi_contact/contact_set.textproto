# proto-file: humanoid_nmpc/humanoid_multi_contact/contact_set/contact_set.proto
# proto-message: humanoid_multi_contact.ContactSet
# The contact candidates of the DRC Atlas for multi-contact planning (humanoid_nmpc/docs/multi_contact_planning/
# README.md, section 3.1), in the order that numbers the bits of a contact mode. The offsets and radii are those of the
# collision geoms of robot_models/drc_atlas/drc_atlas_description/urdf/atlas.xml, whose body frames are the URDF's
# joint frames; //humanoid_nmpc/humanoid_multi_contact/stability:robot_stance_model_test checks every parent joint
# against atlas.urdf.
#
# A pad's frame has z = -normal_pad_ewrt_link (the terrain's normal when the pad rests on it) and x = x_axis_pad_ewrt_link; a surface
# candidate's rectangle is in that frame.

robot: "drc_atlas"

# The soles: the foot frames of task.textproto's contacts block (pos_contact_rt_link_ewrt_link, contact_rectangle).
# LINT.IfChange(foot_contacts)
candidates {
  name: "foot_l_contact"
  kind: KIND_SURFACE
  parent_joint: "l_leg_akx"
  pos_pad_rt_link_ewrt_link: [0.04, 0, -0.082]
  normal_pad_ewrt_link: [0, 0, -1]
  x_axis_pad_ewrt_link: [1, 0, 0]
  rectangle { min_pos_corners_rt_pad_ewrt_pad_x: -0.12 max_pos_corners_rt_pad_ewrt_pad_x: 0.12 min_pos_corners_rt_pad_ewrt_pad_y: -0.055 max_pos_corners_rt_pad_ewrt_pad_y: 0.055 }
}
candidates {
  name: "foot_r_contact"
  kind: KIND_SURFACE
  parent_joint: "r_leg_akx"
  pos_pad_rt_link_ewrt_link: [0.04, 0, -0.082]
  normal_pad_ewrt_link: [0, 0, -1]
  x_axis_pad_ewrt_link: [1, 0, 0]
  rectangle { min_pos_corners_rt_pad_ewrt_pad_x: -0.12 max_pos_corners_rt_pad_ewrt_pad_x: 0.12 min_pos_corners_rt_pad_ewrt_pad_y: -0.055 max_pos_corners_rt_pad_ewrt_pad_y: 0.055 }
}
# LINT.ThenChange(//robot_models/drc_atlas/drc_atlas_centroidal_mpc/config/mpc/task.textproto, //robot_models/drc_atlas/drc_atlas_centroidal_mpc/config/mpc/multi_contact/task.textproto:multi_contact_candidates)

# Every other candidate is a contact of the multi-contact task file too (task.textproto beside this file), with the
# same parent, offset and pad: //humanoid_nmpc/humanoid_centroidal_mpc:test_multi_contact_task_file checks them.
# LINT.IfChange(other_candidates)

# The front of the shin capsule (l_lleg / r_lleg: radius 0.055, from the knee down to z = -0.42), 6 cm below the knee.
candidates {
  name: "knee_l_contact"
  kind: KIND_POINT
  parent_joint: "l_leg_kny"
  pos_pad_rt_link_ewrt_link: [0.055, 0, -0.06]
  normal_pad_ewrt_link: [1, 0, 0]
  geom_radius: 0.055
}
candidates {
  name: "knee_r_contact"
  kind: KIND_POINT
  parent_joint: "r_leg_kny"
  pos_pad_rt_link_ewrt_link: [0.055, 0, -0.06]
  normal_pad_ewrt_link: [1, 0, 0]
  geom_radius: 0.055
}

# The hand sphere (l_hand / r_hand: radius 0.04 at the body origin), on the side that continues the arm.
candidates {
  name: "hand_l_contact"
  kind: KIND_POINT
  parent_joint: "l_arm_wrx"
  pos_pad_rt_link_ewrt_link: [0, 0.04, 0]
  normal_pad_ewrt_link: [0, 1, 0]
  geom_radius: 0.04
}
candidates {
  name: "hand_r_contact"
  kind: KIND_POINT
  parent_joint: "r_arm_wrx"
  pos_pad_rt_link_ewrt_link: [0, -0.04, 0]
  normal_pad_ewrt_link: [0, -1, 0]
  geom_radius: 0.04
}

# The middle of the l_larm / r_larm capsule (radius 0.04, 0.10 long along +y / -y), on its front (+x) side: the side
# that faces the floor with the arms at the sides of a robot lying face down.
candidates {
  name: "forearm_l_contact"
  kind: KIND_POINT
  parent_joint: "l_arm_elx"
  pos_pad_rt_link_ewrt_link: [0.04, 0.05, 0]
  normal_pad_ewrt_link: [1, 0, 0]
  geom_radius: 0.04
}
candidates {
  name: "forearm_r_contact"
  kind: KIND_POINT
  parent_joint: "r_arm_elx"
  pos_pad_rt_link_ewrt_link: [0.04, -0.05, 0]
  normal_pad_ewrt_link: [1, 0, 0]
  geom_radius: 0.04
}

# Under the pelvis (the base), 0.24 x 0.20 m, at the height of the underside of the thighs when seated: the thigh
# capsules (radius 0.06, from z = -0.066) reach below the pelvis box (bottom at z = -0.07), so a seated Atlas rests on
# them and on this pad, not on the box.
candidates {
  name: "seat_contact"
  kind: KIND_SURFACE
  parent_joint: "root_joint"
  pos_pad_rt_link_ewrt_link: [-0.02, 0, -0.143]
  normal_pad_ewrt_link: [0, 0, -1]
  x_axis_pad_ewrt_link: [1, 0, 0]
  rectangle { min_pos_corners_rt_pad_ewrt_pad_x: -0.12 max_pos_corners_rt_pad_ewrt_pad_x: 0.12 min_pos_corners_rt_pad_ewrt_pad_y: -0.10 max_pos_corners_rt_pad_ewrt_pad_y: 0.10 }
}

# The back of the thigh capsule (l_uleg / r_uleg: radius 0.06, from the hip to (-0.05, 0, -0.37)), at its middle, along
# the capsule's normal in the sagittal plane. Its parent joint is the hip pitch joint, whose frame is l_uleg's.
candidates {
  name: "thigh_l_contact"
  kind: KIND_POINT
  parent_joint: "l_leg_hpy"
  pos_pad_rt_link_ewrt_link: [-0.0845, 0, -0.177]
  normal_pad_ewrt_link: [-0.99100, 0, 0.13392]
  geom_radius: 0.06
}
candidates {
  name: "thigh_r_contact"
  kind: KIND_POINT
  parent_joint: "r_leg_hpy"
  pos_pad_rt_link_ewrt_link: [-0.0845, 0, -0.177]
  normal_pad_ewrt_link: [-0.99100, 0, 0.13392]
  geom_radius: 0.06
}

# The back and chest faces of the utorso collision box (half extents 0.18 0.22 0.30 at (-0.04, 0, 0.30) in the
# back_bkx frame): x = -0.22 and x = +0.14. The pads, 0.36 x 0.30 m, lie inside the faces (0.60 x 0.44 m), with their x
# axis up the torso.
candidates {
  name: "torso_back_contact"
  kind: KIND_SURFACE
  parent_joint: "back_bkx"
  pos_pad_rt_link_ewrt_link: [-0.22, 0, 0.30]
  normal_pad_ewrt_link: [-1, 0, 0]
  x_axis_pad_ewrt_link: [0, 0, 1]
  rectangle { min_pos_corners_rt_pad_ewrt_pad_x: -0.18 max_pos_corners_rt_pad_ewrt_pad_x: 0.18 min_pos_corners_rt_pad_ewrt_pad_y: -0.15 max_pos_corners_rt_pad_ewrt_pad_y: 0.15 }
}
candidates {
  name: "torso_front_contact"
  kind: KIND_SURFACE
  parent_joint: "back_bkx"
  pos_pad_rt_link_ewrt_link: [0.14, 0, 0.30]
  normal_pad_ewrt_link: [1, 0, 0]
  x_axis_pad_ewrt_link: [0, 0, 1]
  rectangle { min_pos_corners_rt_pad_ewrt_pad_x: -0.18 max_pos_corners_rt_pad_ewrt_pad_x: 0.18 min_pos_corners_rt_pad_ewrt_pad_y: -0.15 max_pos_corners_rt_pad_ewrt_pad_y: 0.15 }
}
# The right-side roll of the get-up from the back (design section 8.1, scenario 4; only get_up_supine allows them).
# Atlas's torso is a box, so it rolls quasi-statically on the back-right edge of the utorso box (x = -0.22, y = -0.22
# in the back_bkx frame): on pads whose normals lie 25 degrees (at z = 0.10 and 0.50) and 65 degrees (at z = 0.03 and
# 0.57, the ends of the edge: apart from the others, as the planner keeps the pads of one surface apart, and as far
# apart as the edge allows, since on them and the left foot alone the CoM must stay over the line between them) from
# the back face's toward the side face's, so that within their 30 degree cones they carry the roll from the back to
# about 45 degrees, where the right hand, the arm raised along the head, and then the right foot in front hold the
# robot. The pads are corners of the box: their geometry is a point (a 1 mm sphere), which rests on the floor where
# the box does.
candidates {
  name: "torso_edge_r_low_25_contact"
  kind: KIND_POINT
  parent_joint: "back_bkx"
  pos_pad_rt_link_ewrt_link: [-0.22, -0.22, 0.10]
  normal_pad_ewrt_link: [-0.90631, -0.42262, 0]
  geom_radius: 0.001
}
candidates {
  name: "torso_edge_r_high_25_contact"
  kind: KIND_POINT
  parent_joint: "back_bkx"
  pos_pad_rt_link_ewrt_link: [-0.22, -0.22, 0.50]
  normal_pad_ewrt_link: [-0.90631, -0.42262, 0]
  geom_radius: 0.001
}
candidates {
  name: "torso_edge_r_low_65_contact"
  kind: KIND_POINT
  parent_joint: "back_bkx"
  pos_pad_rt_link_ewrt_link: [-0.22, -0.22, 0.03]
  normal_pad_ewrt_link: [-0.42262, -0.90631, 0]
  geom_radius: 0.001
}
candidates {
  name: "torso_edge_r_high_65_contact"
  kind: KIND_POINT
  parent_joint: "back_bkx"
  pos_pad_rt_link_ewrt_link: [-0.22, -0.22, 0.57]
  normal_pad_ewrt_link: [-0.42262, -0.90631, 0]
  geom_radius: 0.001
}
# LINT.ThenChange(//robot_models/drc_atlas/drc_atlas_centroidal_mpc/config/mpc/multi_contact/task.textproto:multi_contact_candidates)
