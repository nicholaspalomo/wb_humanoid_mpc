                <joint name="l_leg_aky" pos="0 0 0" axis="0 1 0" range="-1 0.7" actuatorfrcrange="-740 740" damping="0.1"/>
                <geom pos="0.014 0 0.008" type="mesh" mesh="l_talus"/>
                <body name="l_foot">
                  <inertial pos="0.027 0 -0.067" quat="0 0.707107 0 0.707107" mass="2.05" diaginertia="0.008 0.007 0.002"/>
                  <joint name="l_leg_akx" pos="0 0 0" axis="1 0 0" range="-0.8 0.8" actuatorfrcrange="-360 360" damping="0.1"/>
                  <geom pos="-0.008 0.002 0.024" type="mesh" mesh="l_foot"/>
