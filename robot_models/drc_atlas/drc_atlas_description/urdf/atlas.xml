             markrgb="0.6 0.7 0.8"
             width="512" height="512"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="2 2" reflectance="0.05"/>
    <mesh name="base_link" content_type="model/stl" file="base_link.STL"/>
    <mesh name="l_clav" content_type="model/stl" file="l_clav.stl"/>
    <mesh name="l_farm" content_type="model/stl" file="l_farm.stl"/>
