                    <geom pos="-0.037 -0.141 -0.372" type="mesh" mesh="l_larm"/>
                    <body name="l_farm">
                      <inertial pos="-0.004 0.126 -0.0004" mass="2.428" diaginertia="0.004 0.003 0.004"/>
                      <joint name="l_arm_wry" pos="0 0 0" axis="0 1 0" range="-0.785398 0.785398" actuatorfrcrange="-60 60" damping="0.1"/>
