                  <geom pos="-0.037 0.141 -0.372" type="mesh" mesh="r_uarm"/>
                  <body name="r_larm">
                    <inertial pos="0.0004 -0.065 0.003" mass="2.476" diaginertia="0.004 0.003 0.004"/>
                    <joint name="r_arm_elx" pos="0 0 0" axis="1 0 0" range="-2.35619 0" actuatorfrcrange="-114 114" damping="0.1"/>
