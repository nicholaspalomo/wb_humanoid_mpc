# The robots' launch files: one robot, MPC and dummy-simulator launch file per robot configuration and a model sandbox
# per description; each parses, runs on the machines of the hardware split, starts built binaries with flags they define
# and files that exist, and the robot side exports to the robot-runtime image's script. Large in what it builds (every
# launched binary), quick to run.
py_test(
    name = "test_launch_files",
    size = "small",
    srcs = ["test_launch_files.py"],
    # The Rerun bridge it starts runs on this test's runfiles, where humanoid_multi_contact must be a namespace package
    # (humanoid_nmpc/humanoid_rerun_viewer/BUILD.bazel, _NAMESPACE_PACKAGES).
    legacy_create_init = False,
    data = [
        "//config/ipc:network.textproto",
        "//humanoid_nmpc/humanoid_centroidal_mpc_app:humanoid_centroidal_mpc_dummy_sim",
        "//humanoid_nmpc/humanoid_centroidal_mpc_app:humanoid_centroidal_mpc_node",
        "//humanoid_nmpc/humanoid_centroidal_mpc_app:humanoid_centroidal_mpc_robot",
        "//humanoid_nmpc/docs/distributed_runtime:README.md",
        "//humanoid_nmpc/humanoid_common_mpc:gait_config",
        "//humanoid_nmpc/humanoid_common_mpc:quadruped_gait_config",
        "//humanoid_nmpc/humanoid_common_mpc:wheeled_gait_config",
        "//humanoid_nmpc/humanoid_common_mpc:wheeled_quadruped_gait_config",
        "//humanoid_nmpc/humanoid_rerun_viewer",
        "//humanoid_nmpc/humanoid_rerun_viewer:model_sandbox",
        # The multi-contact scenarios of the DRC Atlas's multi-contact dummy sims.
        "//humanoid_nmpc/humanoid_multi_contact/scenarios:scenario_files",
        "//humanoid_nmpc/humanoid_wb_mpc_app:humanoid_wb_mpc_dummy_sim",
        "//humanoid_nmpc/humanoid_wb_mpc_app:humanoid_wb_mpc_node",
        "//humanoid_nmpc/humanoid_wb_mpc_app:humanoid_wb_mpc_robot",
        "//humanoid_nmpc/remote_control:base_velocity_controller_gui",
        "//robot_models/anybotics_anymal_b/anymal_b_centroidal_mpc",
        "//robot_models/anybotics_anymal_b/anymal_b_description",
        "//robot_models/anybotics_anymal_b/anymal_b_description:launch/sandbox.textproto",
        "//robot_models/anybotics_anymal_c_wheels/anymal_c_wheels_centroidal_mpc",
        "//robot_models/anybotics_anymal_c_wheels/anymal_c_wheels_description",
        "//robot_models/anybotics_anymal_c_wheels/anymal_c_wheels_description:launch/sandbox.textproto",
        "//robot_models/drc_atlas/drc_atlas_centroidal_mpc",
        "//robot_models/drc_atlas/drc_atlas_description",
        "//robot_models/drc_atlas/drc_atlas_description:launch/sandbox.textproto",
        "//robot_models/engineai_sa01/engineai_sa01_centroidal_mpc",
        "//robot_models/engineai_sa01/engineai_sa01_description",
        "//robot_models/engineai_sa01/engineai_sa01_description:launch/sandbox.textproto",
        "//robot_models/limx_tron1/tron1_centroidal_mpc",
        "//robot_models/limx_tron1/tron1_description",
        "//robot_models/limx_tron1/tron1_description:launch/sandbox.textproto",
        "//robot_models/unitree_g1/g1_centroidal_mpc",
        "//robot_models/unitree_g1/g1_description",
        "//robot_models/unitree_g1/g1_description:launch/sandbox.textproto",
        "//robot_models/unitree_g1/g1_wb_mpc",
        "//robot_models/unitree_r1/unitree_r1_centroidal_mpc",
        "//robot_models/unitree_r1/unitree_r1_description",
        "//robot_models/unitree_r1/unitree_r1_description:launch/sandbox.textproto",
    ],
    deps = ["//tools/launch:launch_lib"],
)

# The wheels of every wheeled robot: continuous URDF joints, and unlimited MJCF hinges whose bodies roll on one coaxial
# collision cylinder each.
py_test(
    name = "test_wheels",
    size = "small",
    srcs = ["test_wheels.py"],
    data = [
        "//robot_models/anybotics_anymal_c_wheels/anymal_c_wheels_description",
        "//robot_models/limx_tron1/tron1_description",
    ],
    deps = [
        requirement("mujoco"),
        requirement("numpy"),
    ],
)

# The default stance of every robot configuration (reference default and task initial state) on flat ground, by the
# URDF's forward kinematics; the MPC contact rectangle of each 6-DoF contact inside the MJCF's sole spheres, each 3-DoF
# point contact on the lowest point of its foot's single sphere, and each rolling contact's lowest wheel point on the
# ground with the wheel's single collision cylinder of its wheel radius.
py_test(
    name = "test_default_stance",
    size = "small",
    srcs = ["test_default_stance.py"],
    data = [
        "//robot_models/anybotics_anymal_b/anymal_b_centroidal_mpc",
        "//robot_models/anybotics_anymal_b/anymal_b_description",
        "//robot_models/anybotics_anymal_c_wheels/anymal_c_wheels_centroidal_mpc",
        "//robot_models/anybotics_anymal_c_wheels/anymal_c_wheels_description",
        "//robot_models/drc_atlas/drc_atlas_centroidal_mpc",
        "//robot_models/drc_atlas/drc_atlas_description",
        "//robot_models/engineai_sa01/engineai_sa01_centroidal_mpc",
        "//robot_models/engineai_sa01/engineai_sa01_description",
        "//robot_models/limx_tron1/tron1_centroidal_mpc",
        "//robot_models/limx_tron1/tron1_description",
        "//robot_models/unitree_g1/g1_centroidal_mpc",
        "//robot_models/unitree_g1/g1_description",
        "//robot_models/unitree_g1/g1_wb_mpc",
        "//robot_models/unitree_r1/unitree_r1_centroidal_mpc",
        "//robot_models/unitree_r1/unitree_r1_description",
    ],
    deps = [
        "//humanoid_nmpc/humanoid_mpc_config:config_py_proto",
        "//tools/nproto:nproto_textproto",
        requirement("mujoco"),
        requirement("numpy"),
    ],
)

