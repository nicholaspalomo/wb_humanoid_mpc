load("@rules_cc//cc:cc_binary.bzl", "cc_binary")
# unitree_r1_centroidal_mpc - Unitree R1 robot centroidal MPC configuration and tests

package(default_visibility = ["//visibility:public"])

# Configuration and launch files
filegroup(
    name = "unitree_r1_centroidal_mpc",
    srcs = glob([
        "config/**",
        "launch/**",
    ], allow_empty = True),
)

# Test executable for Pinocchio model
cc_binary(
    name = "test_pinocchio_model",
    srcs = ["test/testPinocchioModel.cpp"],
    copts = [
        "-std=c++20",
        "-Wall",
        "-Wextra",
        "-Wpedantic",
        "-Werror=return-type",
    ],
    data = [
        ":unitree_r1_centroidal_mpc",
        "//robot_models/unitree_r1/unitree_r1_description",
    ],
    deps = [
        "//humanoid_nmpc/humanoid_common_mpc",
        "//humanoid_nmpc/humanoid_centroidal_mpc",
        "//humanoid_nmpc/humanoid_centroidal_mpc_ros2:humanoid_centroidal_mpc_dummy_sim_node",
        "//lib/ocs2:ocs2_pinocchio_interface",
        "//lib/ocs2:ocs2_centroidal_model",
        "//lib/ocs2:ocs2_core",
        "@eigen",
        "@pinocchio",
        "@urdf",
        "@ros2_rclcpp",
        "@ros2_ament_index_cpp",
    ],
)
