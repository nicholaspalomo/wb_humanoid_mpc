# proto-file: humanoid_nmpc/humanoid_mpc_config/reference_file.proto
# proto-message: humanoid_mpc_config.ReferenceFile
target_displacement_velocity: 0.5
target_rotation_velocity: 0.5

max_displacement_velocity_x: 2.0
max_displacement_velocity_y: 1.0
max_delta_pelvis_height: 0.3
max_rotation_velocity: 1.0
# First-order low-pass filter on the operator's velocity command, run on the solver time ahead of the acceleration
# ramps: break frequency f_c [Hz], time constant 1 / (2 pi f_c). 0 switches it off and the command passes through
# unchanged, which is what every robot has effectively run so far: the "5 Hz" filter this key replaces never updated
# its state and scaled the command by t / (t + 0.032 s), t the wall-clock time since start-up - within 3% of the
# identity after a second. A filter lags every command, a stop included, by about its time constant: try e.g. 2.0
# (80 ms) in simulation before a robot. Reloaded with the limits above while the controller runs.
velocity_command_filter_break_frequency: 0.0  # [Hz] command low-pass filter, 0 = off
target_joint_state_interpolation_time_constant: 0.5

# The base height of the default posture standing on flat ground: the contact frames of both soles on the ground at the
# hip, knee and ankle pitch below, with the ankles leveling the soles: the URDF rolls the hip pitch joint's frame by 25
# degrees, so ankle pitch = hip pitch = -knee / 2 left each sole pitched by 0.79 and rolled by 0.30 degrees and its
# contact frame 6.2 mm above the ground (robot_models/tests/test_default_stance.py).
default_base_height: 0.7337
default_joint_state { joint: "left_hip_pitch_joint" value: -0.15 }
default_joint_state { joint: "left_hip_roll_joint" value: 0.0 }
default_joint_state { joint: "left_hip_yaw_joint" value: 0.0 }
default_joint_state { joint: "left_knee_joint" value: 0.30 }
default_joint_state { joint: "left_ankle_pitch_joint" value: -0.1641 }
default_joint_state { joint: "left_ankle_roll_joint" value: 0.0043 }
default_joint_state { joint: "right_hip_pitch_joint" value: -0.15 }
default_joint_state { joint: "right_hip_roll_joint" value: 0.0 }
default_joint_state { joint: "right_hip_yaw_joint" value: 0.0 }
default_joint_state { joint: "right_knee_joint" value: 0.30 }
default_joint_state { joint: "right_ankle_pitch_joint" value: -0.1641 }
default_joint_state { joint: "right_ankle_roll_joint" value: -0.0043 }
default_joint_state { joint: "waist_roll_joint" value: 0.0 }
default_joint_state { joint: "waist_yaw_joint" value: 0.0 }
default_joint_state { joint: "left_shoulder_pitch_joint" value: 0.12 }
default_joint_state { joint: "left_shoulder_roll_joint" value: 0.15 }
default_joint_state { joint: "left_shoulder_yaw_joint" value: 0.0 }
default_joint_state { joint: "left_elbow_joint" value: 1.2 }
default_joint_state { joint: "right_shoulder_pitch_joint" value: 0.12 }
default_joint_state { joint: "right_shoulder_roll_joint" value: -0.15 }
default_joint_state { joint: "right_shoulder_yaw_joint" value: 0.0 }
default_joint_state { joint: "right_elbow_joint" value: 1.2 }

initial_mode_schedule {
  mode_sequence: "STANCE"
  mode_sequence: "STANCE"
  event_times: 0.5
}

default_mode_sequence_template {
  mode_sequence: "STANCE"
  switching_times: 0.0
  switching_times: 0.5
}
