# LINT.IfChange(sim_rate_targets)
# One target per placement of ThreadAffinity.h's default viewer cores, each a process of its own: llvmpipe's rasterizer
# threads, started once per process, keep the cores and the scheduling of the first render thread. The viewer on cores
# of its own (above 16 cores), on the physics' two simulation cores (8 to 16) and on its one (4 to 7), each with as many
# rasterizer threads as viewer cores (at least 2), as the robot binaries set LP_NUM_THREADS; _oversubscribed runs 8 on
# the viewer's own two cores. More rasterizer threads than cores on the physics' cores is not a default (README.md).
cc_test(
    name = "test_web_viewer_sim_rate",
    size = "medium",
    srcs = ["test/testWebViewerSimRate.cpp"],
    args = ["--gtest_filter=WebViewerSimRate.TheWebViewerOnCoresOfItsOwnDoesNotDelayThePhysics"],
    copts = FIRST_PARTY_COPTS,
    data = ["//robot_models/drc_atlas/drc_atlas_description"],
    env = {"LP_NUM_THREADS": "2"},
    tags = ["exclusive"],
    deps = WEB_VIEWER_SIM_RATE_DEPS,
)

cc_test(
    name = "test_web_viewer_sim_rate_oversubscribed",
    size = "medium",
    srcs = ["test/testWebViewerSimRate.cpp"],
