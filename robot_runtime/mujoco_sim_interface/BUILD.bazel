# The Khronos EGL headers, with EGL_NO_X11 for every translation unit that sees an EGL type: eglplatform.h then
# includes no Xlib, and its native types agree in all of them. Nothing links EGL: EglLibrary dlopen()s libEGL.so.1.
cc_library(
    name = "egl_headers",
    copts = FIRST_PARTY_COPTS,
    defines = ["EGL_NO_X11"],
    deps = ["@egl-registry//:EGL_headers"],
)

