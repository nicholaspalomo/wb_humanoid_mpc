# How the simulator and its viewer fail to start: Create()'s Status for every scene and configuration error, and a viewer
# without a display that logs why instead of ending the process; which scenes can hold the robot by the gantry weld
# (checkSceneSupportsGantryHold()), and the hold a scene without one falls back to.
cc_test(
    name = "test_mujoco_sim_startup",
    size = "small",
    srcs = ["test/testMujocoSimStartup.cpp"],
    copts = FIRST_PARTY_COPTS,
    deps = [
        ":mujoco_sim_interface",
        "@abseil-cpp//absl/base:nullability",
        "@abseil-cpp//absl/status",
        "@abseil-cpp//absl/status:status_matchers",
        "@abseil-cpp//absl/status:statusor",
        "@abseil-cpp//absl/strings",
        "@googletest//:gtest_main",
    ],
)
