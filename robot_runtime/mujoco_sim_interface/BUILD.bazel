load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc//cc:cc_test.bzl", "cc_test")
load("//bazel:copts.bzl", "FIRST_PARTY_COPTS")

# mujoco_sim_interface - MuJoCo simulation interface library

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "mujoco_sim_interface",
    srcs = [
        "src/MujocoContactUtils.cpp",
        "src/Projectile.cpp",
        "src/MujocoContactPatch.cpp",
        "src/CheaterSimContactEstimator.cpp",
        "src/MujocoSimInterface.cpp",
        "src/MujocoRenderer.cpp",
        "src/visualization/VisualizationRegistry.cpp",
        "src/visualization/MetricsOverlay.cpp",
        "src/visualization/ExternalForceVisualization.cpp",
        "src/visualization/ContactForceVisualization.cpp",
        "src/visualization/BaseVelocityVisualization.cpp",
        "src/visualization/ContactTimelineVisualization.cpp",
        "src/visualization/TargetContactPatchVisualization.cpp",
        "src/visualization/GroundMarkerGeoms.cpp",
        "src/visualization/CenterOfMassVisualization.cpp",
        "src/visualization/ZmpVisualization.cpp",
        "src/visualization/DcmVisualization.cpp",
        "src/visualization/MujocoOptionFlagVisualization.cpp",
    ],
    hdrs = glob(["include/**"], allow_empty = True),
    includes = ["include"],
    copts = FIRST_PARTY_COPTS,
    deps = [
        "//lib/mujoco_vendor",
        "//robot_runtime/robot_core",
        "//robot_runtime/robot_model",
        "@eigen",
        "@abseil-cpp//absl/base:no_destructor",
        "@abseil-cpp//absl/base:nullability",
        "@abseil-cpp//absl/log:check",
        "@abseil-cpp//absl/log:die_if_null",
        "@abseil-cpp//absl/log:log",
        "@abseil-cpp//absl/log:globals",
        "@abseil-cpp//absl/log:initialize",
        "@abseil-cpp//absl/memory",
        "@abseil-cpp//absl/status",
        "@abseil-cpp//absl/status:statusor",
        "@abseil-cpp//absl/strings",
        "@abseil-cpp//absl/strings:str_format",
        "@urdf",
        "@glfw",
        "@glew",
    ],
)

cc_test(
