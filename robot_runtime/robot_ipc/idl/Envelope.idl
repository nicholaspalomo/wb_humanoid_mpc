// The one DDS type of the bus (robot_runtime/robot_ipc/README.md, "Wire protocol"): every bus topic is a DDS topic of
// the same name carrying robot_ipc::Envelope, and the payload is a serialized Protocol Buffers message. idlc generates
// the C type support of the C++ bus from this file (:envelope_type in BUILD.bazel); the Python bus declares the same
// struct (python/robot_ipc/envelope.py). Changing a member is a new wire protocol: bump kWireProtocolVersion.
// LINT.IfChange(envelope)
module robot_ipc {
  @final
  struct Envelope {
    // kWireProtocolVersion of the publisher (WireProtocol.h); a bus refuses another version.
    uint32 protocol_version;
    // 1, 2, 3, ... per writer (one bus publishing one topic): a gap is a sample the reader never took.
    uint64 sequence_number;
    // The full protobuf type name of the payload, e.g. "humanoid_mpc_msgs.MpcPolicy".
    string type_name;
    // The serialized protobuf message.
    sequence<octet> payload;
  };
};
// LINT.ThenChange(//robot_runtime/robot_ipc/python/robot_ipc/envelope.py:envelope, //robot_runtime/robot_ipc/include/robot_ipc/WireProtocol.h:wire_protocol)
