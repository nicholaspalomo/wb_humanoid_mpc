load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc//cc:cc_test.bzl", "cc_test")
# robot_model - Robot description and state library

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "robot_model",
    srcs = [
        "src/RobotDescription.cpp",
        "src/RobotState.cpp",
    ],
    hdrs = glob(["include/**"], allow_empty = True),
    includes = ["include"],
    copts = [
        "-std=c++20",
        "-Wall",
        "-Wextra",
        "-Wpedantic",
        "-Werror=return-type",
    ],
    deps = [
        "//robot_runtime/robot_core",
        "@eigen",
        "@abseil-cpp//absl/container:flat_hash_map",
        "@urdf",
        "@ros2_ament_index_cpp",
    ],
)

cc_test(
    name = "test_robot_description",
    size = "small",
    srcs = ["test/testRobotDescription.cpp"],
    deps = [
        ":robot_model",
        "@googletest//:gtest_main",
        "@urdf",
    ],
)
