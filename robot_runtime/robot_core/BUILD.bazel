load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc//cc:cc_test.bzl", "cc_test")
# robot_core - Header-only library (no source files)

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "robot_core",
    hdrs = glob(["include/**"], allow_empty = True),
    includes = ["include"],
    deps = [
        "@eigen",
        "@ros2_ament_index_cpp",
    ],
)

cc_test(
    name = "triple_buffer_test",
    srcs = ["test/TripleBufferTest.cpp"],
    copts = ["-std=c++20"],
    deps = [
        ":robot_core",
        "@googletest//:gtest_main",
    ],
)
