load("@rules_cc//cc:cc_binary.bzl", "cc_binary")
load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc//cc:cc_test.bzl", "cc_test")
load("@rules_python//python:defs.bzl", "py_binary", "py_library", "py_test")
load("//bazel:copts.bzl", "FIRST_PARTY_COPTS")

# web_viewer - the HTTP side of the MuJoCo web viewer (README.md): the server that serves the page and the frames and
# queues the browsers' input, the frame and input hand-over to the render thread, the JPEG codec and the thread
# placement. MuJoCo-free and EGL-free: the render thread lives in //robot_runtime/mujoco_sim_interface.

package(default_visibility = ["//visibility:public"])

# ==============================================================================
# The page
# ==============================================================================

# The generator that compiles page/index.html into the library. `import embed_page`: the import root is tools/.
py_library(
    name = "embed_page_lib",
    srcs = ["tools/embed_page.py"],
    imports = ["tools"],
    visibility = ["//visibility:private"],
)

py_binary(
    name = "embed_page",
    srcs = ["tools/embed_page.py"],
    main = "tools/embed_page.py",
    visibility = ["//visibility:private"],
    deps = [":embed_page_lib"],
)

# WebViewerPage.cpp: webViewerPage() over the page, a raw string literal (WebViewerPage.h).
genrule(
    name = "web_viewer_page_source",
    srcs = ["page/index.html"],
    outs = ["WebViewerPage.cpp"],
    cmd = "$(execpath :embed_page) --input $(location page/index.html) --output $@",
    tools = [":embed_page"],
    visibility = ["//visibility:private"],
)

# ==============================================================================
# C++
# ==============================================================================

# The scheduling of the viewer's threads, apart from the server so that the viewer's options can name it
# (//robot_runtime/mujoco_sim_interface:viewer_settings).
cc_library(
    name = "viewer_thread_priority",
    hdrs = ["include/web_viewer/ViewerThreadPriority.h"],
    copts = FIRST_PARTY_COPTS,
    includes = ["include"],
)

# How the server binds and whom it serves (include/web_viewer/WebViewerServerOptions.h), apart from the server so that
# the MuJoCo viewer's options take its defaults (//robot_runtime/mujoco_sim_interface:viewer_settings).
cc_library(
    name = "web_viewer_server_options",
    hdrs = ["include/web_viewer/WebViewerServerOptions.h"],
    copts = FIRST_PARTY_COPTS,
    includes = ["include"],
    deps = [":viewer_thread_priority"],
)

cc_library(
    name = "web_viewer",
    srcs = [
        "src/JpegEncoder.cpp",
        "src/ThreadPlacement.cpp",
        "src/ViewerCameraMode.cpp",
        "src/ViewerFrameMailbox.cpp",
        "src/ViewerInputParsing.cpp",
        "src/ViewerInputQueue.cpp",
        "src/ViewerStatus.cpp",
        "src/WebViewerServer.cpp",
        ":web_viewer_page_source",
    ],
    hdrs = glob(
        ["include/web_viewer/*.h"],
        exclude = [
            "include/web_viewer/JpegDecoder.h",
            "include/web_viewer/ViewerThreadPriority.h",
            "include/web_viewer/WebViewerServerOptions.h",
        ],
    ),
    copts = FIRST_PARTY_COPTS,
    includes = ["include"],
    deps = [
        ":viewer_thread_priority",
        ":web_viewer_server_options",
        "//lib/ocs2:ocs2_dimensions",
        "@abseil-cpp//absl/base:core_headers",
        "@abseil-cpp//absl/base:nullability",
        "@abseil-cpp//absl/cleanup",
        "@abseil-cpp//absl/container:flat_hash_map",
        "@abseil-cpp//absl/container:flat_hash_set",
        "@abseil-cpp//absl/log",
        "@abseil-cpp//absl/log:absl_check",
        "@abseil-cpp//absl/memory",
        "@abseil-cpp//absl/status",
        "@abseil-cpp//absl/status:statusor",
        "@abseil-cpp//absl/strings",
        "@abseil-cpp//absl/strings:str_format",
        "@abseil-cpp//absl/strings:string_view",
        "@abseil-cpp//absl/synchronization",
        "@abseil-cpp//absl/time",
        "@abseil-cpp//absl/types:span",
        # The server's TU includes httplib.h; the patched module (MODULE.bazel) builds it without TLS and zlib.
        "@cpp-httplib//:httplib",
        "@libjpeg_turbo//:turbojpeg",
    ],
)

