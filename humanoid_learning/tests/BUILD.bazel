# ==============================================================================
# Humanoid Learning - Tests
# ==============================================================================

load("@rl_deps//:requirements.bzl", "requirement")
load("@rules_python//python:defs.bzl", "py_test")

package(default_visibility = ["//visibility:public"])

py_test(
    name = "test_rl_imports",
    size = "medium",
    srcs = ["test_rl_imports.py"],
    deps = [
        "//humanoid_learning/envs",
        "//humanoid_learning/training:training_lib",
        requirement("absl-py"),
        requirement("brax"),
        requirement("flax"),
        requirement("jax"),
        requirement("jaxlib"),
        requirement("mujoco"),
        requirement("mujoco-mjx"),
        requirement("numpy"),
        requirement("onnx"),
        requirement("optax"),
        requirement("playground"),
    ],
)

# The actor-critic network, the behavioral cloning warmstart and the ONNX export of its policy.
py_test(
    name = "test_actor_critic",
    size = "medium",
    srcs = ["test_actor_critic.py"],
    deps = [
        "//humanoid_learning/export:export_lib",
        "//humanoid_learning/training:training_lib",
        requirement("flax"),
        requirement("jax"),
        requirement("jaxlib"),
        requirement("numpy"),
        requirement("onnx"),
        requirement("optax"),
    ],
)

py_test(
    name = "test_cartpole",
