# ==============================================================================
# Humanoid Learning - Training Pipelines
# ==============================================================================

load("@rules_python//python:defs.bzl", "py_binary", "py_library")

package(default_visibility = ["//visibility:public"])

py_library(
    name = "training_lib",
    srcs = [
        "__init__.py",
        "bc_warmstart.py",
        "train_ppo.py",
    ],
    deps = [
        "//humanoid_learning/envs",
        "@rl_deps//:absl_py",
        "@rl_deps//:brax",
        "@rl_deps//:flax",
        "@rl_deps//:h5py",
        "@rl_deps//:jax",
        "@rl_deps//:jaxlib",
        "@rl_deps//:mujoco",
        "@rl_deps//:mujoco_mjx",
        "@rl_deps//:numpy",
        "@rl_deps//:optax",
        "@rl_deps//:orbax_checkpoint",
        "@rl_deps//:playground",
    ],
)

py_binary(
    name = "train_ppo",
    srcs = ["train_ppo.py"],
    deps = [
        ":training_lib",
    ],
)

py_binary(
    name = "bc_warmstart",
    srcs = ["bc_warmstart.py"],
    deps = [
        ":training_lib",
    ],
)
