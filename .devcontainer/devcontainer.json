{
  "name": "Whole Body MPC Dev Container",
  "initializeCommand": [
    "bash",
    "-c",
    "xhost +local:"
  ],
  "dockerComposeFile": [
    "docker-compose.yml"
  ],
  "service": "app",
  "remoteUser": "ubuntu",
  "containerUser": "ubuntu",
  "updateRemoteUserUID": false,
  "workspaceFolder": "/wb_humanoid_mpc_ws/src/wb_humanoid_mpc",
  "customizations": {
    "vscode": {
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash",
        "editor.formatOnSave": true,
        "files.trimTrailingWhitespace": true
      },
      "extensions": [
        "ms-vscode.cpptools",
        "ms-vscode.cmake-tools",
        "ms-vscode-remote.remote-containers",
        "ms-azuretools.vscode-docker",
        "ms-python.python",
        "ms-python.vscode-pylance",
        "eamodio.gitlens",
        "GitHub.copilot",
        "GitHub.copilot-chat"
      ]
    }
  },
  "mounts": [
    "source=${localWorkspaceFolder}/../..,target=/wb_humanoid_mpc_ws,type=bind,consistency=delegated",
    "source=${localEnv:HOME}/.gitconfig,target=/tmp/host.gitconfig,type=bind,consistency=cached,readOnly=true",
    "source=${localEnv:HOME}/.ssh,target=/tmp/host_ssh,type=bind,consistency=cached"
  ],
  "containerEnv": {
    "COLCON_HOME": "/wb_humanoid_mpc_ws",
    "COLCON_DEFAULTS_FILE": "/wb_humanoid_mpc_ws/src/wb_humanoid_mpc/colcon.defaults.yaml"
  },
  "postCreateCommand": "chmod +x ${containerWorkspaceFolder}/.devcontainer/post_create.sh"
}
