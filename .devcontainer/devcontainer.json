{
  "name": "Whole Body MPC Dev Container",
  "dockerComposeFile": [
    "docker-compose.yml"
  ],
  "service": "app",
  "remoteUser": "ubuntu",
  "containerUser": "ubuntu",
  "updateRemoteUserUID": false,
  "workspaceFolder": "/wb_humanoid_mpc_ws/src/wb_humanoid_mpc",
  "customizations": {
    "vscode": {
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash",
        "terminal.integrated.profiles.linux": {
          "bash": {
            "path": "/bin/bash",
            "icon": "terminal-bash"
          }
        },
        "editor.formatOnSave": true,
        "files.trimTrailingWhitespace": true,
        "[cpp]": {
          "editor.defaultFormatter": "xaver.clang-format"
        },
        "[c]": {
          "editor.defaultFormatter": "xaver.clang-format"
        }
      },
      "extensions": [
        "ms-vscode.cpptools",
        "ms-vscode.cmake-tools",
        "ms-vscode-remote.remote-containers",
        "ms-azuretools.vscode-docker",
        "ms-python.python",
        "ms-python.vscode-pylance",
        "xaver.clang-format",
        "eamodio.gitlens",
        "GitHub.copilot",
        "GitHub.copilot-chat",
        "twxs.cmake",
        "cheshirekow.cmake-format",
        "ms-toolsai.jupyter-keymap",
        "ms-vscode-remote.remote-ssh",
        "ms-vscode-remote.remote-ssh-edit",
        "ms-vscode.remote-explorer",
        "sankethdev.vscode-proto",
        "Continue.continue"
      ]
    }
  },
  "mounts": [
    "source=${localWorkspaceFolder}/../..,target=/wb_humanoid_mpc_ws,type=bind,consistency=delegated",
    "source=${localEnv:HOME}/.gitconfig,target=/tmp/host.gitconfig,type=bind,consistency=cached,readOnly=true",
    "source=${localEnv:HOME}/.ssh,target=/tmp/host_ssh,type=bind,consistency=cached"
  ],
  "containerEnv": {
    "DISPLAY": ":99",
    "ROS_DOMAIN_ID": "0",
    "LIBGL_ALWAYS_SOFTWARE": "1",
    "MESA_LOADER_DRIVER_OVERRIDE": "llvmpipe",
    "LIBGL_ALWAYS_INDIRECT": "0"
  },
  "forwardPorts": [
    5901,
    6080
  ],
  "portsAttributes": {
    "6080": {
      "label": "noVNC (RViz)",
      "onAutoForward": "notify"
    },
    "5901": {
      "label": "VNC",
      "onAutoForward": "silent"
    }
  },
  "postCreateCommand": "bash -c 'chmod +x ${containerWorkspaceFolder}/.devcontainer/post_create.sh && ${containerWorkspaceFolder}/.devcontainer/post_create.sh'"
}
