{
  "name": "Whole Body MPC Dev Container",
  "initializeCommand": [
    "bash",
    "-c",
    "xhost +local:"
  ],
  "build": {
    "dockerfile": "${localWorkspaceFolder}/docker/Dockerfile",
    "context": "..",
    "args": {
      "WB_HUMANOID_MPC_DIR": "/wb_humanoid_mpc_ws",
      "PYTHON_VERSION": "3.12"
    }
  },
  "runArgs": [
    "--rm",
    "-it",
    "--net=host",
    "--privileged",
    "-e",
    "DISPLAY",
    "-e",
    "QT_X11_NO_MITSHM=1",
    "-e",
    "XDG_RUNTIME_DIR=${localEnv:XDG_RUNTIME_DIR}",
    "-v",
    "/tmp/.X11-unix:/tmp/.X11-unix",
    "-v",
    "${localEnv:XDG_RUNTIME_DIR}:${localEnv:XDG_RUNTIME_DIR}"
  ],
  "remoteUser": "ubuntu",
  "containerUser": "ubuntu",
  "updateRemoteUserUID": false,
  "workspaceFolder": "/wb_humanoid_mpc_ws/src/wb_humanoid_mpc",
  "customizations": {
    "vscode": {
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash",
        "terminal.integrated.profiles.linux": {
          "bash": {
            "path": "/bin/bash",
            "icon": "terminal-bash"
          }
        },
        "editor.formatOnSave": true,
        "files.trimTrailingWhitespace": true
      },
      "extensions": [
        "ms-vscode.cpptools",
        "ms-vscode.cmake-tools",
        "ms-vscode-remote.remote-containers",
        "ms-azuretools.vscode-docker",
        "ms-python.python",
        "ms-python.vscode-pylance",
        "eamodio.gitlens",
        "twxs.cmake",
        "cheshirekow.cmake-format",
        "xaver.clang-format",
        "ms-toolsai.jupyter-keymap",
        "ms-vscode-remote.remote-ssh",
        "ms-vscode-remote.remote-ssh-edit",
        "ms-vscode.remote-explorer",
        "sankethdev.vscode-proto",
        "Continue.continue",
        "ms-vscode.cpptools-extension-pack",
        "ms-vscode.makefile-tools",
        "GitHub.copilot",
        "GitHub.copilot-chat"
      ]
    }
  },
  "mounts": [
    "source=${localWorkspaceFolder}/../..,target=/wb_humanoid_mpc_ws,type=bind,consistency=cached"
  ],
  "postCreateCommand": "${containerWorkspaceFolder}/.devcontainer/post_create.sh"
}
