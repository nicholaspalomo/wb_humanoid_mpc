# proto-file: legged_nmpc/legged_mpc_config/gait_file.proto
# proto-message: legged_mpc_config.GaitFile
#
# The gait file of the wheeled quadrupeds: four rolling contacts (model_settings.contacts_rolling,
# legged_nmpc/docs/rolling_contact/README.md) ordered LF, RF, LH, RH, with one leg of the same name per contact, so
# the mode bits are LF = 8, RF = 4, LH = 2 and RH = 1 (as in quadruped_gait.textproto). A mode names the legs in
# stance, joined by '_'; STANCE is every contact (mode_sequence_template_config.proto).
#
# A quadruped's four wheel axles are parallel to the base's y axis and its legs have no yaw joint, so the no-slip
# constraint of each wheel lets a wheel's contact point move only along the wheel's heading. A yaw of the base about
# its center moves the front and hind wheels sideways at the yaw rate times their distance from the center, which no
# wheel can roll, so the robot drives straight on its wheels and turns by stepping (rolling_contact/README.md,
# section 8). The bipeds of wheeled_gait.textproto turn by differential wheel speed instead: their two axles share one
# line through the center.

gait_list: "stance"
gait_list: "drive"
gait_list: "turning_trot"

# Standing in place, every wheel on the ground.
gaits {
  name: "stance"
  mode_sequence: "STANCE"
  switching_times: 0.0
  switching_times: 0.5
}

# Driving straight: every wheel stays on the ground while the base moves, as in wheeled_gait.textproto.
gaits {
  name: "drive"
  mode_sequence: "STANCE"
  switching_times: 0.0
  switching_times: 0.5
}

# Turning: a trot with a phase on all four wheels after each diagonal pair's swing. A wheel in swing lands where it
# stands at the nominal posture, turned with the base (nominal_foothold), and the stance phases on four wheels keep the
# base from pitching about the axle of a diagonal pair. The trot of quadruped_gait.textproto, with no stance phase, let
# the base of the wheeled ANYmal C pitch by 0.7 rad within 2 s of turning in closed loop (legged_mpc_validation,
# label 2026-11-12_anymal_c_wheels).
gaits {
  name: "turning_trot"
  mode_sequence: "LF_RH"
  mode_sequence: "STANCE"
  mode_sequence: "RF_LH"
  mode_sequence: "STANCE"
  switching_times: 0.0
  switching_times: 0.30
  switching_times: 0.45
  switching_times: 0.75
  switching_times: 0.90
}

# The gaits the walking velocity command switches between, one row at a time (gait_switching_table_config.proto):
# - stance takes a command within 0.1 m/s and 0.1 rad/s of rest and leaves for drive on the command alone (error
#   thresholds of 10), as the other gait files' stance rows do;
# - drive takes every linear command (upper bound 10 m/s, above any command the reference files allow) and a yaw-rate
#   command up to 0.15 rad/s. It leaves for turning_trot on a faster yaw-rate command alone (yaw-rate error threshold
#   of 10), since the base cannot yaw while it drives, and gives way to stance as wheeled_gait.textproto's drive does,
#   once the command is below 0.05 m/s and 0.05 rad/s and the stride-mean speed below 0.1 m/s;
# - turning_trot takes every yaw-rate command above 0.1 rad/s and gives way to drive once the yaw-rate command is below
#   0.1 rad/s and the stride-mean yaw rate below 0.15 rad/s. Its linear lower bound of 10 m/s is above any command, so
#   the linear command does not keep it.
# Each row's lower bounds sit below the upper bounds of the row before, so that a command near one bound does not switch
# back and forth.
gait_switching {
  rows {
    gait: "stance"
    cmd_min_linvel_base_rt_world_ewrt_heading_xy: -0.1
    cmd_max_linvel_base_rt_world_ewrt_heading_xy: 0.1
    cmd_min_angvel_base_rt_world_ewrt_world_z: -0.1
    cmd_max_angvel_base_rt_world_ewrt_world_z: 0.1
    max_err_linvel_base_rt_world_ewrt_heading_xy: 10.0
    max_err_angvel_base_rt_world_ewrt_world_z: 10.0
  }
  rows {
    gait: "drive"
    cmd_min_linvel_base_rt_world_ewrt_heading_xy: 0.05
    cmd_max_linvel_base_rt_world_ewrt_heading_xy: 10.0
    cmd_min_angvel_base_rt_world_ewrt_world_z: 0.05
    cmd_max_angvel_base_rt_world_ewrt_world_z: 0.15
    max_err_linvel_base_rt_world_ewrt_heading_xy: 0.05
    max_err_angvel_base_rt_world_ewrt_world_z: 10.0
  }
  rows {
    gait: "turning_trot"
    cmd_min_linvel_base_rt_world_ewrt_heading_xy: 10.0
    cmd_max_linvel_base_rt_world_ewrt_heading_xy: 10.0
    cmd_min_angvel_base_rt_world_ewrt_world_z: 0.1
    cmd_max_angvel_base_rt_world_ewrt_world_z: 10.0
    max_err_linvel_base_rt_world_ewrt_heading_xy: 10.0
    max_err_angvel_base_rt_world_ewrt_world_z: 0.05
  }
}
