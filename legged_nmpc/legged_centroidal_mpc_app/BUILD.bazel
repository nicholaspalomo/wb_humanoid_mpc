# The node on the DRC Atlas task file with the SQP solver, over loopback buses: a scripted robot and operator
# (observation in, policy out, resets through the observation's counters, the velocity command reaching the motion
# manager, a parameter document applied before the next solve, the visualization fed), the reset target the controller
# gives its in-process link, the dummy simulator standing on the node's policies for a few seconds without a reset, and
# the hardware topology end to end: the node binary and the robot binary (MuJoCo, headless) as two processes, the robot
# standing, walking and stopping on the node's policies. Large: it builds the Atlas MPC's CppAD libraries on a cold
# cache, once; the end-to-end case's node binary loads them from the same working directory. About 300 s on a 20-core
# workstation; CI's 4-vCPU runner starts with no CppAD cache, so the timeout is the longest Bazel has (3600 s).
cc_test(
    name = "test_centroidal_mpc_node",
    size = "large",
    timeout = "eternal",
    srcs = ["test/testCentroidalMpcNode.cpp"],
    copts = FIRST_PARTY_COPTS,
    data = [
        ":legged_centroidal_mpc_node",
        ":legged_centroidal_mpc_robot",
        "//legged_nmpc/legged_common_mpc:gait_config",
        "//robot_models/drc_atlas/drc_atlas_centroidal_mpc",
        "//robot_models/drc_atlas/drc_atlas_description",
    ],
    deps = [
        "//legged_nmpc/legged_common_mpc:legged_common_mpc_types",
        "//legged_nmpc/legged_mpc_config:config_cc_proto",
        "//legged_nmpc/legged_mpc_config:config_nproto",
        "//legged_nmpc/legged_mpc_ipc:mpc_server",
        "//lib/ocs2:ocs2_core_types",
        "//robot_runtime/robot_ipc:test_network",
        ":centroidal_mpc_node",
        "//legged_nmpc/legged_centroidal_mpc",
        "//legged_nmpc/legged_common_mpc",
        "//legged_nmpc/legged_common_mpc_app/node:mpc_node",
        "//legged_nmpc/legged_common_mpc_app/node:node_process",
        "//legged_nmpc/legged_common_mpc_app/node:scripted_robot",
        "//legged_nmpc/legged_common_mpc_app/robot:end_to_end_test_support",
        "//legged_nmpc/legged_common_mpc_app/teleop",
        "//legged_nmpc/legged_common_mpc_app/visualization",
        "//legged_nmpc/legged_mpc_ipc",
        "//legged_nmpc/legged_mpc_msgs:messages_cc_proto",
        "//lib/ocs2:ocs2_centroidal_model",
        "//lib/ocs2:ocs2_core",
        "//lib/ocs2:ocs2_mpc",
        "//lib/ocs2:ocs2_mpc_test_support",
        "//lib/ocs2:ocs2_sqp",
        "//robot_runtime/robot_core:resource_paths",
        "//robot_runtime/robot_ipc",
        "//robot_runtime/robot_model",
        "//tools/nproto:nproto_runtime",
        "@abseil-cpp//absl/functional:function_ref",
        "@abseil-cpp//absl/status",
        "@abseil-cpp//absl/status:statusor",
        "@abseil-cpp//absl/strings",
        "@abseil-cpp//absl/time",
        "@googletest//:gtest_main",
        "@pinocchio",
    ],
)

# The shipped DRC Atlas MPC's feedback policy over the network link: an MpcServer serves its ManifoldLinearController to
# a RemoteMpcLink on the robot's own state manifold, and the robot's RealtimePolicyEvaluator on the decoded policy
# computes what MPC_MRT_Interface's MRT_BASE::evaluatePolicy() computes in process, on both sides of a contact event, bit
# for bit. Exclusive and large: it builds the Atlas MPC's CppAD libraries on a cold cache, as the node test does.
cc_test(
    name = "test_centroidal_mpc_manifold_policy_over_bus",
    size = "large",
    timeout = "eternal",
    srcs = ["test/testCentroidalMpcManifoldPolicyOverBus.cpp"],
    copts = FIRST_PARTY_COPTS,
    data = [
        "//robot_models/drc_atlas/drc_atlas_centroidal_mpc",
        "//robot_models/drc_atlas/drc_atlas_description",
    ],
    tags = ["exclusive"],
    deps = [
        "//legged_nmpc/legged_centroidal_mpc",
        "//legged_nmpc/legged_common_mpc",
        "//legged_nmpc/legged_common_mpc:legged_common_mpc_types",
        "//legged_nmpc/legged_common_mpc:mpc_reset_supervisor",
        "//legged_nmpc/legged_mpc_ipc",
        "//legged_nmpc/legged_mpc_ipc:mpc_link_test_support",
        "//legged_nmpc/legged_mpc_ipc:mpc_server",
        "//legged_nmpc/legged_mpc_ipc:realtime_policy_evaluator",
        "//legged_nmpc/legged_mpc_ipc:remote_mpc_link",
        "//lib/ocs2:ocs2_core",
        "//lib/ocs2:ocs2_core_types",
        "//lib/ocs2:ocs2_mpc",
        "//lib/ocs2:ocs2_oc",
        "//lib/ocs2:ocs2_sqp",
        "//robot_runtime/robot_core:resource_paths",
        "//robot_runtime/robot_ipc",
        "@abseil-cpp//absl/log",
        "@abseil-cpp//absl/status",
        "@abseil-cpp//absl/status:statusor",
        "@abseil-cpp//absl/time",
        "@googletest//:gtest_main",
        "@pinocchio",
    ],
)

