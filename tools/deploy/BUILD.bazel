    size = "small",
    srcs = ["test_deploy_files.py"],
    data = [
        "deploy_robot.sh",
        "in_dev_container.sh",
        "netem.sh",
        "robot_entrypoint.sh",
        "session.sh",
        "wb-humanoid-robot@.service",
        "//:Makefile",
        "//:docker-compose.robot.netem.yaml",
        "//:docker-compose.robot.sim.yaml",
        "//:docker-compose.robot.yaml",
        "//:docker/Dockerfile",
        "//:.devcontainer/README.md",
        "//config/ipc:network.textproto",
        "//config/ipc:two_machine.example.textproto",
        # The launch files the Makefile's launch targets run, against the binaries they build first.
        "//robot_models/drc_atlas/drc_atlas_centroidal_mpc:launch/dummy_sim.textproto",
        "//robot_models/drc_atlas/drc_atlas_centroidal_mpc:launch/mpc.textproto",
        "//robot_models/drc_atlas/drc_atlas_centroidal_mpc:launch/robot.textproto",
        "//robot_models/drc_atlas/drc_atlas_description:launch/sandbox.textproto",
        "//robot_models/engineai_sa01/engineai_sa01_centroidal_mpc:launch/dummy_sim.textproto",
        "//robot_models/engineai_sa01/engineai_sa01_centroidal_mpc:launch/mpc.textproto",
        "//robot_models/engineai_sa01/engineai_sa01_description:launch/sandbox.textproto",
        "//robot_models/unitree_g1/g1_centroidal_mpc:launch/dummy_sim.textproto",
        "//robot_models/unitree_g1/g1_centroidal_mpc:launch/mpc.textproto",
        "//robot_models/unitree_g1/g1_description:launch/sandbox.textproto",
        "//robot_models/unitree_g1/g1_wb_mpc:launch/dummy_sim.textproto",
        "//robot_models/unitree_g1/g1_wb_mpc:launch/mpc.textproto",
        "//robot_models/unitree_r1/unitree_r1_centroidal_mpc:launch/dummy_sim.textproto",
        "//robot_models/unitree_r1/unitree_r1_centroidal_mpc:launch/mpc.textproto",
        "//robot_models/unitree_r1/unitree_r1_description:launch/sandbox.textproto",
    ],
    deps = [requirement("pyyaml")],
)
