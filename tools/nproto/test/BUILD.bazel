load("@operator_deps//:requirements.bzl", "requirement")
load("@protobuf//bazel:cc_proto_library.bzl", "cc_proto_library")
load("@protobuf//bazel:proto_library.bzl", "proto_library")
load("@protobuf//bazel:py_proto_library.bzl", "py_proto_library")
load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc//cc:cc_test.bzl", "cc_test")
load("@rules_python//python:defs.bzl", "py_test")
load("//bazel:copts.bzl", "FIRST_PARTY_COPTS")
load("//tools/nproto:nproto.bzl", "nproto_cc_library")

# The tests of nproto: protos that exercise every mapping (README.md), the round trips, defaults, equality, errors and
# allocation-freedom of their generated code, the textproto helpers, the generator's errors, and the generated code's
# style.

package(default_visibility = ["//visibility:public"])

# The configuration file the parser tests read, which other packages' tests read too.
exports_files(glob(["testdata/*.textproto"]))

# proto3, proto2 (defaults.proto) and edition 2023 (editions.proto), imported as "tools/nproto/test/<file>.proto".
proto_library(
    name = "test_protos",
    testonly = True,
    srcs = glob(["*.proto"]),
    deps = [
        "//tools/nproto:options_proto",
        "//tools/nproto/test/other:other_protos",
    ],
)

cc_proto_library(
    name = "test_cc_protos",
    testonly = True,
    deps = [":test_protos"],
)

# `from tools.nproto.test import scalars_pb2`, for the tests of the Python parser (:test_nproto_textproto).
py_proto_library(
    name = "test_py_protos",
    testonly = True,
    deps = [":test_protos"],
)

nproto_cc_library(
    name = "test_structs",
    testonly = True,
    deps = [":test_protos"],
)

# Every file generated for the test protos (and the protos they import), for test_generated_code.
filegroup(
    name = "test_nproto_files",
    testonly = True,
    srcs = [":test_structs"],
    output_group = "nproto_files",
)

# Test values for any message, the round-trip checks and the allocation checks; also used by the packages whose protos
# nproto generates structs for.
cc_library(
    name = "proto_test_values",
    testonly = True,
    srcs = ["ProtoTestValues.cpp"],
    hdrs = ["ProtoTestValues.h"],
    copts = FIRST_PARTY_COPTS,
    deps = [
        "@abseil-cpp//absl/base:nullability",
        "@abseil-cpp//absl/status",
        "@abseil-cpp//absl/strings",
        "@abseil-cpp//absl/strings:str_format",
        "@googletest//:gtest",
        "@protobuf",
    ],
)

cc_library(
    name = "proto_allocations",
    testonly = True,
    hdrs = ["ProtoAllocations.h"],
    copts = FIRST_PARTY_COPTS,
    deps = [
        ":proto_test_values",
        "//robot_runtime/robot_realtime:allocation_counter",
        "@abseil-cpp//absl/base:nullability",
        "@abseil-cpp//absl/status",
        "@googletest//:gtest",
    ],
)

cc_test(
    name = "test_nproto",
    size = "small",
    srcs = ["testNproto.cpp"],
    copts = FIRST_PARTY_COPTS,
    deps = [
        ":proto_test_values",
        ":test_cc_protos",
        ":test_structs",
        "@abseil-cpp//absl/base:nullability",
        "@abseil-cpp//absl/status",
        "@eigen",
        "@googletest//:gtest_main",
    ],
)

# nproto/Schema.h: the unknown fields of a message by their paths, and the schema fingerprint the Python twin pins alike.
cc_test(
    name = "test_schema",
    size = "small",
    srcs = ["testSchema.cpp"],
    copts = FIRST_PARTY_COPTS,
    deps = [
        ":test_cc_protos",
        "//tools/nproto:nproto_runtime",
        "@googletest//:gtest_main",
    ],
)

py_test(
    name = "test_nproto_schema",
    size = "small",
    srcs = ["test_nproto_schema.py"],
    deps = [
        ":test_py_protos",
        "//tools/nproto:nproto_schema",
        requirement("protobuf"),
    ],
)

# The realtime property. A binary of its own, because the allocation counter replaces malloc for the whole process.
cc_test(
    name = "test_nproto_allocations",
    size = "small",
    srcs = ["testNprotoAllocations.cpp"],
    copts = FIRST_PARTY_COPTS,
    linkstatic = True,
    deps = [
        ":proto_allocations",
        ":test_cc_protos",
        ":test_structs",
        "//robot_runtime/robot_realtime:allocation_counter",
        "@abseil-cpp//absl/base:nullability",
        "@googletest//:gtest_main",
    ],
)

cc_test(
    name = "test_textproto",
    size = "small",
    srcs = ["testTextproto.cpp"],
    copts = FIRST_PARTY_COPTS,
    data = glob(["testdata/*.textproto"]),
    deps = [
        ":proto_test_values",
        ":test_cc_protos",
        ":test_structs",
        "//tools/nproto:nproto_runtime",
        "@abseil-cpp//absl/base:nullability",
        "@abseil-cpp//absl/status",
        "@abseil-cpp//absl/status:statusor",
        "@abseil-cpp//absl/strings",
        "@googletest//:gtest_main",
    ],
)

# The struct headers alone compile under FIRST_PARTY_COPTS (-Wpedantic included) with every warning an error, and pull
# in neither protobuf nor Abseil.
cc_test(
    name = "test_struct_headers",
    size = "small",
    srcs = ["testStructHeaders.cpp"],
    copts = FIRST_PARTY_COPTS + ["-Werror"],
    deps = [
        ":test_structs",
        "@googletest//:gtest_main",
    ],
)

# The Python parser (//tools/nproto:nproto_textproto) on the inputs of :test_textproto, answered the same way.
py_test(
    name = "test_nproto_textproto",
    size = "small",
    srcs = ["test_nproto_textproto.py"],
    data = ["testdata/scalars.textproto"],
    deps = [
        ":test_py_protos",
        "//tools/nproto:nproto_textproto",
        requirement("protobuf"),
    ],
)

# The generator's errors and output, on requests built in the test.
py_test(
    name = "test_nproto_generator",
    size = "small",
    srcs = ["test_nproto_generator.py"],
    data = ["//tools/nproto:protoc-gen-nproto"],
    deps = [
        "//tools/nproto:nproto_generator",
        "//tools/nproto:options_py_proto",
        requirement("protobuf"),
    ],
)

# The generated code of the test protos, of humanoid_mpc_msgs and of humanoid_mpc_config is clang-format clean and
# follows the repository's rules: every C++ lint check of the registry finds nothing, and the struct headers include no
# protobuf.
py_test(
    name = "test_generated_code",
    size = "small",
    srcs = ["test_generated_code.py"],
    data = [
        ":test_nproto_files",
        "//:.clang-format",
        "//humanoid_nmpc/humanoid_mpc_config:config_nproto_files",
        "//humanoid_nmpc/humanoid_mpc_msgs:messages_nproto_files",
    ],
    deps = ["//tools/hooks:checks"],
)
