load("@operator_deps//:requirements.bzl", "requirement")
load("@protobuf//bazel:cc_proto_library.bzl", "cc_proto_library")
load("@protobuf//bazel:proto_library.bzl", "proto_library")
load("@protobuf//bazel:py_proto_library.bzl", "py_proto_library")
load("@protobuf//bazel/toolchains:proto_lang_toolchain.bzl", "proto_lang_toolchain")
load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_python//python:defs.bzl", "py_binary", "py_library")
load("//bazel:copts.bzl", "FIRST_PARTY_COPTS")

# nproto: plain C++ structs generated from the repository's protos, their conversions to and from the protobuf
# messages, and strict textproto parsing for the configuration files (README.md). nproto_cc_library (nproto.bzl)
# is the one entry point; the targets below are its parts.

package(default_visibility = ["//visibility:public"])

# The import path drops tools/, so a proto imports "nproto/options.proto". The options that name the structs and ask for
# presence (options.proto), and the retired fields of a message (retired_field_options.proto with its RetiredField
# message, retired_field.proto): one library, so that Python finds every module under one `nproto` package.
proto_library(
    name = "options_proto",
    srcs = [
        "options.proto",
        "retired_field.proto",
        "retired_field_options.proto",
    ],
    strip_import_prefix = "/tools",
    deps = ["@protobuf//:descriptor_proto"],
)

# `from nproto import options_pb2, retired_field_options_pb2`, for the generator and the Python parser to read the
# options.
py_proto_library(
    name = "options_py_proto",
    deps = [":options_proto"],
)

# The retired-field options as C++ extensions, which the textproto parser of :nproto_runtime reads.
cc_proto_library(
    name = "options_cc_proto",
    deps = [":options_proto"],
)

# ==============================================================================
# The generator
# ==============================================================================

# The code generator, plain Python on the protobuf descriptor API, shared by the protoc plugin and the tests.
py_library(
    name = "nproto_generator",
    srcs = ["nproto_generator.py"],
    imports = ["."],
    deps = [
        ":options_py_proto",
        requirement("protobuf"),
    ],
)

# The protoc plugin, `protoc --plugin=protoc-gen-nproto=... --nproto_out=...`.
py_binary(
    name = "protoc-gen-nproto",
    srcs = ["protoc_gen_nproto.py"],
    main = "protoc_gen_nproto.py",
    deps = [
        ":nproto_generator",
        requirement("protobuf"),
    ],
)

# How nproto_cc_library runs the plugin. The protos of protobuf itself and the options library get no structs: they set
# no option or are only read as options, and nproto has no use for them.
proto_lang_toolchain(
    name = "nproto_toolchain",
    command_line = "--nproto_out=$(OUT)",
    denylisted_protos = [
        ":options_proto",
        "@protobuf//:any_proto",
        "@protobuf//:api_proto",
        "@protobuf//:compiler_plugin_proto",
        "@protobuf//:cpp_features_proto",
        "@protobuf//:descriptor_proto",
        "@protobuf//:duration_proto",
        "@protobuf//:empty_proto",
        "@protobuf//:field_mask_proto",
        "@protobuf//:java_features_proto",
        "@protobuf//:source_context_proto",
        "@protobuf//:struct_proto",
        "@protobuf//:timestamp_proto",
        "@protobuf//:type_proto",
        "@protobuf//:wrappers_proto",
    ],
    mnemonic = "GenNproto",
    output_files = "multiple",
    plugin = ":protoc-gen-nproto",
    plugin_format_flag = "--plugin=protoc-gen-nproto=%s",
    progress_message = "Generating nproto structs of %{label}",
    runtime = ":nproto_runtime",
)

# ==============================================================================
# The runtime
# ==============================================================================

# What the generated code calls (nproto/Conversions.h) and the textproto helpers (nproto/Textproto.h). The generated
# code depends on it through :nproto_toolchain, and with it on protobuf, Eigen and Abseil, absl/base:nullability for
# the annotated output parameters of its signatures included. The parser reads the retired-field options of the message
# it parses into (:options_cc_proto).
cc_library(
    name = "nproto_runtime",
    srcs = [
        "src/Conversions.cpp",
        "src/Schema.cpp",
        "src/Textproto.cpp",
    ],
    hdrs = [
        "include/nproto/Conversions.h",
        "include/nproto/Schema.h",
        "include/nproto/Textproto.h",
    ],
    copts = FIRST_PARTY_COPTS,
    includes = ["include"],
    deps = [
        ":options_cc_proto",
        "@abseil-cpp//absl/base:nullability",
        "@abseil-cpp//absl/status",
        "@abseil-cpp//absl/status:statusor",
        "@abseil-cpp//absl/strings",
        "@abseil-cpp//absl/strings:str_format",
        "@abseil-cpp//absl/strings:string_view",
        "@eigen",
        "@protobuf",
    ],
)

# ==============================================================================
# The Python twin of the textproto parser
# ==============================================================================

# `import nproto_textproto`: the strict textproto parsing of nproto/Textproto.h for Python (the tuning GUI, the
# configuration tools), with the same errors, retired-field answers and header check. Beside the generator, which also
# imports by this directory (`imports = ["."]`); its test is //tools/nproto/test:test_nproto_textproto.
py_library(
    name = "nproto_textproto",
    srcs = ["nproto_textproto.py"],
    imports = ["."],
    deps = [
        ":options_py_proto",
        requirement("protobuf"),
    ],
)

# `import nproto_schema`: the schema fingerprint of nproto/Schema.h for Python, which the tuning GUI puts in the payloads
# it publishes; its test is //tools/nproto/test:test_nproto_schema.
py_library(
    name = "nproto_schema",
    srcs = ["nproto_schema.py"],
    imports = ["."],
    deps = [requirement("protobuf")],
)
