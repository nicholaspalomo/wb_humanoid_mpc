# The lint tools' hashed lock. Regenerate it with: bazel run //tools/hooks:lint_requirements.update
compile_pip_requirements(
    name = "lint_requirements",
    src = "lint_requirements.txt",
    requirements_txt = "lint_requirements_lock.txt",
    tags = ["manual"],
)

# The configurations work with the real tools, from the lock (the @lint_deps hub), hermetically.
py_test(
    name = "test_lint_tool_configs",
    size = "small",
    srcs = ["test_lint_tool_configs.py"],
    data = [
        "//:.clang-format",
        "//:.isort.cfg",
        "//:.pylintrc",
        "//:CPPLINT.cfg",
        "//:mypy.ini",
    ],
    deps = [
        ":check_test_support",
        ":lint_code",
        lint_requirement("black"),
        lint_requirement("cpplint"),
        lint_requirement("isort"),
        lint_requirement("mypy"),
        lint_requirement("pylint"),
    ],
)

