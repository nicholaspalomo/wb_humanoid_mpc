load("@lint_deps//:requirements.bzl", lint_requirement = "requirement")
load("@rules_python//python:defs.bzl", "py_library", "py_test")
load("@rules_python//python:pip.bzl", "compile_pip_requirements")

# The repository's lint checks and formatters, plain Python, so that `bazel test //...` - and with it CI - exercises
# them. They run from the repository root as modules (`python3 -m tools.hooks.lint_code`) and import each other as
# `from tools.hooks import ...`.

# ----------------------------------------------------------------------------------------------------------------------
# Shared infrastructure
# ----------------------------------------------------------------------------------------------------------------------
py_library(
    name = "lint_files",
    srcs = ["lint_files.py"],
    # The clang-tidy collector groups findings by Bazel package, and its tests check the aspect's file lists against
    # this one.
    visibility = ["//tools/clang_tidy:__pkg__"],
)

py_library(
    name = "check_types",
    srcs = ["check_types.py"],
    deps = [":lint_files"],
)

py_library(
    name = "cpp_source",
    srcs = ["cpp_source.py"],
)

py_library(
    name = "nolint",
    srcs = ["nolint.py"],
    deps = [
        ":check_types",
        ":cpp_source",
    ],
)

# The registry: every check module below, concatenated. //tools/nproto/test:test_generated_code runs every check over
# the generated code, which make lint cannot see.
py_library(
    name = "checks",
    srcs = ["checks.py"],
    visibility = ["//tools/nproto/test:__pkg__"],
    deps = [
        ":american_spelling",
        ":argument_comments",
        ":boost_usage",
        ":check_types",
        ":cpp_google_style",
        ":cpp_totw",
        ":include_style",
        ":inclusive_language",
        ":license_header",
        ":lint_files",
        ":no_auto",
        ":nolint",
        ":pointer_nullability",
        ":proto_file_layout",
        ":proto_next_id",
        ":python_docstrings",
        ":python_imports",
        ":python_language",
        ":textproto_headers",
        ":todo_format",
        ":yaml_usage",
    ],
)

py_library(
    name = "lint_code",
    srcs = ["lint_code.py"],
    deps = [
        ":check_types",
        ":checks",
        ":lint_files",
    ],
)

py_library(
    name = "format_code",
    srcs = ["format_code.py"],
    deps = [
        ":check_types",
        ":checks",
        ":lint_code",
        ":lint_files",
    ],
)

py_library(
