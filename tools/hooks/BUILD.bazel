# First-party BUILD files keep headers at their source paths, which the clang-tidy aspect's header filter matches, and
# compile every C++ target with FIRST_PARTY_COPTS and no warning flag of their own. It reads every BUILD and .bzl file
# of the checkout, which it finds through MODULE.bazel's runfiles link.
py_test(
    name = "test_first_party_build_files",
    size = "small",
    srcs = ["test_first_party_build_files.py"],
    data = [
        "//:MODULE.bazel",
        "//bazel:copts.bzl",
    ],
    deps = [
        ":check_test_support",
        ":lint_files",
    ],
)

# Every rule is enforced: no pending list, no sweep configuration, no relaxed mypy module, one clang-tidy configuration,
# and make lint, the pre-commit hook and CI run every check. It reads the checkout through MODULE.bazel's runfiles link
# for what must not exist, and its data for the rest.
py_test(
    name = "test_lint_enforcement",
    size = "small",
    srcs = ["test_lint_enforcement.py"],
    data = [
        "pre-commit",
        "//:.bazelrc",
        "//:.clang-tidy",
        "//:.github/workflows/format_test.yml",
        "//:.isort.cfg",
        "//:.pylintrc",
        "//:CPPLINT.cfg",
        "//:MODULE.bazel",
        "//:Makefile",
        "//:mypy.ini",
        "//tools/clang_tidy:clang_tidy.bzl",
    ],
    deps = [
        ":check_test_support",
        ":check_types",
        ":checks",
        ":lint_code",
        ":lint_files",
    ],
)

