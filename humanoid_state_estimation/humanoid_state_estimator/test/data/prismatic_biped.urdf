<?xml version="1.0"?>
<!--
  A biped whose legs are three prismatic joints each, along the base's x, y and z axes: the foot of a leg is at
  origin + (q_x, q_y, q_z) in the base frame for any joint positions, so a test can drive the leg kinematics with
  joint positions computed in closed form from a base and foot trajectory (WalkingTrajectory).
-->
<robot name="prismatic_biped">
  <link name="base">
    <inertial><origin xyz="0 0 0"/><mass value="10.0"/><inertia ixx="0.1" ixy="0" ixz="0" iyy="0.1" iyz="0" izz="0.1"/></inertial>
  </link>
  <link name="left_x_link">
    <inertial><origin xyz="0 0 0"/><mass value="0.1"/><inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/></inertial>
  </link>
  <link name="left_y_link">
    <inertial><origin xyz="0 0 0"/><mass value="0.1"/><inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/></inertial>
  </link>
  <link name="left_foot">
    <inertial><origin xyz="0 0 0"/><mass value="0.1"/><inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/></inertial>
  </link>
  <link name="right_x_link">
    <inertial><origin xyz="0 0 0"/><mass value="0.1"/><inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/></inertial>
  </link>
  <link name="right_y_link">
    <inertial><origin xyz="0 0 0"/><mass value="0.1"/><inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/></inertial>
  </link>
  <link name="right_foot">
    <inertial><origin xyz="0 0 0"/><mass value="0.1"/><inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/></inertial>
  </link>
  <joint name="left_x" type="prismatic">
    <parent link="base"/><child link="left_x_link"/><origin xyz="0 0.1 -0.8"/><axis xyz="1 0 0"/>
    <limit lower="-10" upper="10" effort="100" velocity="100"/>
  </joint>
  <joint name="left_y" type="prismatic">
    <parent link="left_x_link"/><child link="left_y_link"/><origin xyz="0 0 0"/><axis xyz="0 1 0"/>
    <limit lower="-10" upper="10" effort="100" velocity="100"/>
  </joint>
  <joint name="left_z" type="prismatic">
    <parent link="left_y_link"/><child link="left_foot"/><origin xyz="0 0 0"/><axis xyz="0 0 1"/>
    <limit lower="-10" upper="10" effort="100" velocity="100"/>
  </joint>
  <joint name="right_x" type="prismatic">
    <parent link="base"/><child link="right_x_link"/><origin xyz="0 -0.1 -0.8"/><axis xyz="1 0 0"/>
    <limit lower="-10" upper="10" effort="100" velocity="100"/>
  </joint>
  <joint name="right_y" type="prismatic">
    <parent link="right_x_link"/><child link="right_y_link"/><origin xyz="0 0 0"/><axis xyz="0 1 0"/>
    <limit lower="-10" upper="10" effort="100" velocity="100"/>
  </joint>
  <joint name="right_z" type="prismatic">
    <parent link="right_y_link"/><child link="right_foot"/><origin xyz="0 0 0"/><axis xyz="0 0 1"/>
    <limit lower="-10" upper="10" effort="100" velocity="100"/>
  </joint>
</robot>
