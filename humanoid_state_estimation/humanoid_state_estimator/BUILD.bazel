    deps = [
        ":state_estimator",
        ":walking_trajectory",
        "//robot_runtime/robot_model",
        "@abseil-cpp//absl/status:statusor",
        "@abseil-cpp//absl/strings",
        "@eigen",
        "@googletest//:gtest_main",
    ],
)

cc_test(
    name = "test_kalman_base_estimator",
