load("@rules_cc//cc:cc_binary.bzl", "cc_binary")
load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc//cc:cc_test.bzl", "cc_test")
load("//bazel:copts.bzl", "FIRST_PARTY_COPTS")
# humanoid_state_estimator - State estimation for the humanoid controllers.

package(default_visibility = ["//visibility:public"])

# A linear Kalman filter whose state, inputs and measurements are organized in named channels.
cc_library(
    name = "kalman_filter",
    srcs = ["src/KalmanFilter.cpp"],
    hdrs = ["include/humanoid_state_estimator/KalmanFilter.h"],
    includes = ["include"],
    copts = FIRST_PARTY_COPTS,
    deps = [
        "//humanoid_nmpc/humanoid_common_mpc:humanoid_common_mpc_types",
        "//lib/ocs2:ocs2_core_types",
        "@abseil-cpp//absl/base:nullability",
        "@abseil-cpp//absl/container:flat_hash_map",
        "@abseil-cpp//absl/functional:function_ref",
        "@abseil-cpp//absl/status",
        "@abseil-cpp//absl/status:statusor",
        "@abseil-cpp//absl/strings",
        "@abseil-cpp//absl/strings:string_view",
        "@abseil-cpp//absl/types:span",
        "@eigen",
    ],
)

# The leg kinematics, the contact-aided base estimator around the Kalman filter, and the robot process's state
# estimator stage by name (StateEstimatorRegistry: ground_truth, kalman). Pinocchio stays behind ContactKinematics.cpp:
# no public header includes it.
cc_library(
    name = "state_estimator",
    srcs = [
        "src/ContactKinematics.cpp",
        "src/KalmanBaseEstimator.cpp",
        "src/KalmanStateEstimator.cpp",
        "src/StateEstimatorRegistry.cpp",
    ],
    hdrs = [
        "include/humanoid_state_estimator/ContactKinematics.h",
        "include/humanoid_state_estimator/GroundTruthStateEstimator.h",
        "include/humanoid_state_estimator/KalmanBaseEstimator.h",
        "include/humanoid_state_estimator/KalmanStateEstimator.h",
        "include/humanoid_state_estimator/StateEstimator.h",
        "include/humanoid_state_estimator/StateEstimatorNames.h",
        "include/humanoid_state_estimator/StateEstimatorRegistry.h",
    ],
    includes = ["include"],
    copts = FIRST_PARTY_COPTS,
    deps = [
        ":kalman_filter",
        "//humanoid_nmpc/humanoid_common_mpc:humanoid_common_mpc_types",
        "//lib/ocs2:ocs2_core_types",
        "//robot_runtime/robot_model",
        "@abseil-cpp//absl/base:nullability",
        "@abseil-cpp//absl/container:flat_hash_map",
        "@abseil-cpp//absl/memory",
        "@abseil-cpp//absl/status",
        "@abseil-cpp//absl/status:statusor",
        "@abseil-cpp//absl/strings",
        "@abseil-cpp//absl/strings:string_view",
        "@eigen",
        "@pinocchio",
    ],
)

# A closed-form walk of test/data/prismatic_biped.urdf, and the states a backend without a position sensor publishes.
cc_library(
    name = "walking_trajectory",
    testonly = True,
    srcs = [
        "test/MeasuredState.cpp",
        "test/WalkingTrajectory.cpp",
    ],
    hdrs = [
        "test/MeasuredState.h",
        "test/WalkingTrajectory.h",
    ],
    copts = FIRST_PARTY_COPTS,
    data = ["test/data/prismatic_biped.urdf"],
    deps = [
        "//humanoid_nmpc/humanoid_common_mpc:humanoid_common_mpc_types",
        "//lib/ocs2:ocs2_core_types",
        "//robot_runtime/robot_model",
        "@eigen",
    ],
)

cc_test(
